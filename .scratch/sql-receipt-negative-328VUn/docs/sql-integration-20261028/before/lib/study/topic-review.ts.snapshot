export type Stage='Foundation'|'Applied'|'Advanced'|'Reference';
export type TopicReview={stage:Stage;prepare:string[];entrySkill:string;reason:string;evidence:string[]};
// Reviewed conceptual preparation, not a product-runtime requirement, mastery lock,
// or approval/publication of an Atlas relation. Evidence keys resolve in evidence.ts.
const row=(stage:Stage,prepare:string[],entrySkill:string,reason:string,evidence:string[]):TopicReview=>({stage,prepare,entrySkill,reason,evidence});
export const TOPIC_REVIEW:Record<string,TopicReview>={
 'analysis.overview':row('Foundation',[],'Read a simple table and explain the decision it should support.','Begin with the question and observation grain before a tool.',['analytics','viz-foundations']),
 'excel.overview':row('Foundation',[],'Recognize a row, column, cell and a simple arithmetic expression.','The current local offering is a question set; use the linked foundation reading where instruction is missing.',['excel']),
 'sql.overview':row('Foundation',[],'Recognize a table, row and column.','Introductory query practice does not require completion of Fabric or Power BI.',['sql']),
 'python.overview':row('Applied',[],'Understand basic programming ideas: variables, conditions and iteration.','The official Python tutorial targets existing programmers; it is not evidence that a complete novice programming course exists here.',['python']),
 'fabric.foundations':row('Foundation',['analysis.overview'],'Distinguish a dataset, table, analytical workload and storage from processing.','Fabric orientation precedes workload-specific choices; the official entry path recommends basic data terminology.',['fabric-start','fabric-architecture']),
 'fabric.ingestion':row('Applied',['fabric.foundations'],'Distinguish referencing, replicating and retaining data; identify source and access constraints.','Movement choices use OneLake/item boundaries. Transformation is not a universal prerequisite for learning ingestion.',['fabric-ingestion','ingestion-lesson']),
 'fabric.transform':row('Applied',['fabric.foundations','fabric.ingestion'],'Identify table state, source data and the intended output of a transformation.','Transformation lessons operate on data whose storage and arrival are already understood.',['fabric-architecture','fabric-notes']),
 'fabric.query':row('Applied',['fabric.foundations','sql.overview'],'Read SELECT, filtering, grouping and join intent.','Query surfaces require relational-query concepts; a full transformation course is not mandatory.',['sql','fabric-warehouse']),
 'fabric.model':row('Applied',['fabric.foundations','power-bi.model'],'Explain fact/dimension grain, relationships and a measure.','Semantic-model decisions build on dimensional concepts, not just platform vocabulary.',['star-schema','fabric-notes']),
 'fabric.security':row('Applied',['fabric.foundations'],'Identify the principal, object, access path and least-privilege requirement.','Security concepts are needed before production access; they are not postponed until after advanced streaming.',['fabric-architecture','fabric-notes']),
 'fabric.delivery':row('Advanced',['fabric.foundations','fabric.security'],'Understand workspace boundaries, permissions and the item being promoted or monitored.','Operational deployment integrates platform and access concepts. This preparation does not claim every item supports every deployment feature.',['fabric-notes']),
 'fabric.streaming':row('Applied',['fabric.foundations','fabric.ingestion'],'Distinguish events, streams, ingestion and an analytical query.','The official RTI introductory module expects Fabric core concepts, not prior completion of all SQL, DAX or deployment lessons.',['fabric-rti']),
 'fabric.overview':row('Reference',['fabric.foundations'],'Identify the workload and constraints in a cross-topic decision.','Cross-topic collections are reference/transfer material, not a final mandatory prerequisite node.',['fabric-notes']),
 'statistics.foundations':row('Foundation',[],'Read a table and basic arithmetic.','Population, sample, variable and parameter are the entry vocabulary of the source.',['stats-s1','stats-s2']),
 'statistics.describe':row('Foundation',['statistics.foundations'],'Identify the observational unit and variable type.','Center and spread describe data before inference is attempted.',['stats-s4','stats-s5','nist-eda']),
 'statistics.probability':row('Foundation',['statistics.foundations'],'Interpret proportions and distinguish an event from an observation.','Probability supplies the language for distributions and uncertainty.',['stats-s6']),
 'statistics.distributions':row('Applied',['statistics.probability','statistics.describe'],'Distinguish a discrete count from a continuous measurement; interpret center/spread.','PMF, density and distribution parameters require probability and descriptive vocabulary.',['stats-s7','stats-s8','stats-s9','stats-s10']),
 'statistics.sampling':row('Applied',['statistics.distributions','statistics.foundations'],'Distinguish one sample, a population and a statistic across repeated samples.','Standard error and intervals require a sampling distribution, rather than treating data spread as estimator uncertainty.',['stats-s11','stats-s12','stats-s13','stats-s14','nist-inference']),
 'statistics.hypothesis':row('Applied',['statistics.sampling','statistics.probability'],'Distinguish a null model, sampling variability, statistic and standard error.','A test statistic and p-value belong after sampling, not in elementary population/sample vocabulary.',['stats-s18','stats-s19','stats-s20','nist-inference']),
 'statistics.experiments':row('Applied',['statistics.foundations','statistics.probability'],'Distinguish assignment, treatment, outcome and chance variation.','Design and randomization can be introduced before formal testing; inferential interpretation additionally uses the hypothesis topic.',['stats-s24','stats-s26','stats-s28']),
 'statistics.relationships':row('Applied',['statistics.describe'],'Read a paired observation and distinguish association from a causal claim.','Describing correlation does not require completing experimental design; causal interpretation needs its safeguards.',['stats-s30','stats-s32','stats-s35']),
 'statistics.synthesis':row('Advanced',['statistics.hypothesis','statistics.experiments','statistics.relationships'],'Choose a method and state assumptions, uncertainty and the decision boundary.','The integrated source case combines description, inference and interpretation. Reference sheets remain available earlier.',['stats-s36','stats-s40']),
 'visualization.foundations':row('Foundation',[],'Identify the decision, observational grain and variable types.','Start with the question, not a preferred chart or software tool.',['viz-foundations','nist-eda']),
 'visualization.comparison':row('Foundation',['visualization.foundations'],'Recognize categories, numerical values and a comparison baseline.','Comparison requires suitable encodings and scale rather than advanced probability.',['viz-core-chart-types']),
 'visualization.distribution':row('Applied',['visualization.foundations','statistics.describe'],'Interpret a numerical variable, center, spread and outliers.','A histogram or box plot explains variation, not just a categorical ranking.',['viz-core-chart-types','stats-s4','stats-s5','nist-eda']),
 'visualization.relationships':row('Applied',['visualization.foundations','statistics.relationships'],'Read paired observations and explain association without a causal claim.','Scatter/multivariate interpretation uses relationship concepts.',['viz-advanced-multivariate','stats-s32']),
 'visualization.time':row('Foundation',['visualization.foundations'],'Distinguish ordered time from an arbitrary category and identify a baseline.','Time-series reading needs time ordering and context, not completion of all distribution labs.',['viz-core-chart-types']),
 'visualization.composition':row('Advanced',['visualization.foundations','visualization.comparison','visualization.accessibility'],'Name the audience, comparison task and accessible encoding.','Dashboard/story synthesis integrates simpler views; the audience lesson itself may be read at the start.',['viz-audience-story','viz-dashboard-design']),
 'visualization.accessibility':row('Foundation',['visualization.foundations'],'Distinguish color, label and non-color cues.','Accessibility and visual integrity are design constraints from the start, not an optional advanced afterthought.',['viz-accessibility-color-qa','viz-visual-integrity']),
 'visualization.overview':row('Reference',[],'Choose a topic or a source collection.','Library maps, references and interview collections are not prerequisite bottlenecks.',['viz-overview']),
 'power-bi.prepare':row('Foundation',[],'Identify data types, rows and the intended analytical output.','Preparation is an entry capability; no Fabric course completion is required.',['star-schema']),
 'power-bi.model':row('Applied',['power-bi.prepare'],'Explain grain, keys and the difference between a fact and dimension.','The star-schema guidance ties model structure to analytical meaning and preparation.',['star-schema']),
 'power-bi.report':row('Applied',['power-bi.model','visualization.foundations','visualization.accessibility'],'Identify the measure and audience, and read a model relationship.','A report is built on model meaning and usable visual encoding.',['star-schema','viz-power-bi-playbook']),
 'power-bi.govern':row('Advanced',['power-bi.model','power-bi.report'],'Distinguish model, report, workspace, user and access boundary.','Governance depends on knowing which artifact and audience is being secured or delivered.',['star-schema','viz-power-bi-playbook']),
 'power-bi.overview':row('Reference',['power-bi.prepare'],'Identify which Power BI capability the question is testing.','Mixed-topic practice is not a separate advanced subject or a universal prerequisite.',['star-schema']),
};
