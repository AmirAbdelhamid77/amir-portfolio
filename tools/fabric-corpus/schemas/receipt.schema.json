{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hansa.local/schemas/fabric-compiler/receipt.schema.json",
  "title": "Compile receipt (FC03 compiler)",
  "description": "Per-family compile receipt: source hashes, transforms applied, blocks removed, quarantine reasons, dependency edges, unsupported constructs and commented directives. Deterministic: no clocks, no absolute paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "compiler", "family", "corpusRevision", "files", "totals", "unsupportedSummary", "quarantineSummary", "orphanConstructEndsSummary", "dependencySummary"],
  "properties": {
    "schema": { "const": "hansa.fabric-compiler/receipt" },
    "version": { "const": 1 },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "family": { "type": "string", "minLength": 1 },
    "corpusRevision": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sizeBytes", "parseWarnings", "quarantined", "quarantineEntries", "sanitizationLog", "edges", "unsupported", "commentedDirectives", "orphanConstructEnds", "dependencyHolds", "counts"],
        "properties": {
          "path": { "type": "string", "description": "Corpus-relative posix path" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "parseWarnings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "span"],
              "properties": {
                "reason": { "type": "string" },
                "detail": { "type": ["string", "null"] },
                "span": { "$ref": "#/$defs/span" }
              }
            }
          },
          "quarantined": { "type": "boolean" },
          "quarantineEntries": { "type": "array", "items": { "$ref": "#/$defs/quarantineEntry" } },
          "sanitizationLog": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "span", "detail", "sha256", "snippet"],
              "properties": {
                "kind": { "enum": ["url-neutralized", "html-removed", "html-transformed"] },
                "span": { "$ref": "#/$defs/span" },
                "detail": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the removed/transformed text" },
                "snippet": { "type": "string" }
              }
            }
          },
          "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
          "unsupported": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "reason", "detail", "snippet", "span", "removedSha256"],
              "properties": {
                "type": { "enum": ["unsupported", "htmlRemoved", "inlineHtmlRemoved"] },
                "reason": { "type": ["string", "null"] },
                "detail": { "type": ["string", "null"] },
                "snippet": { "type": ["string", "null"] },
                "span": { "$ref": "#/$defs/span" },
                "removedSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "commentedDirectives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["span", "directiveText"],
              "properties": {
                "span": { "$ref": "#/$defs/span" },
                "directiveText": { "type": "string" },
                "viaInclude": { "type": "string", "description": "Present when the commented directive was found inside a resolved include fragment" }
              }
            }
          },
          "orphanConstructEnds": {
            "type": "array",
            "description": "Orphan construct-end markers (`:::kind-end` with no matching open) rendered as literal-text paragraphs in the AST. Accounted here, never quarantined.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "span"],
              "properties": {
                "kind": { "type": "string", "description": "The construct kind from the end marker, e.g. zone or image" },
                "span": { "$ref": "#/$defs/span" }
              }
            }
          },
          "dependencyHolds": {
            "type": "array",
            "description": "Structured per-include rows for includes into sibling repositories that are not pinned (reason include-tilde-path). The article stays quarantined until the dependency is acquired; nothing publishes partially.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "kind", "targetRepo", "inRepoPath", "span"],
              "properties": {
                "target": { "type": "string", "description": "The include target exactly as written in the source" },
                "kind": { "const": "cross-repo-include" },
                "targetRepo": { "type": ["string", "null"], "description": "Sibling repository named by the ~/../<repo>/ prefix, or null when the shape is unclassifiable" },
                "inRepoPath": { "type": ["string", "null"], "description": "Path inside the target repository (after the repo prefix)" },
                "span": { "$ref": "#/$defs/span" }
              }
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blocks", "byType", "dependencyEdges", "sanitizationActions", "unsupported", "commentedDirectives", "orphanConstructEnds"],
            "properties": {
              "blocks": { "type": "integer", "minimum": 0 },
              "byType": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
              "dependencyEdges": { "type": "integer", "minimum": 0 },
              "sanitizationActions": { "type": "integer", "minimum": 0 },
              "unsupported": { "type": "integer", "minimum": 0 },
              "commentedDirectives": { "type": "integer", "minimum": 0 },
              "orphanConstructEnds": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "quarantinedFiles", "dependencyEdges", "sanitizationActions", "unsupported", "commentedDirectives", "orphanConstructEnds", "dependencyHoldFiles", "dependencyHoldIncludes", "dependencyHoldTargets"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "quarantinedFiles": { "type": "integer", "minimum": 0 },
        "dependencyEdges": { "type": "integer", "minimum": 0 },
        "sanitizationActions": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "commentedDirectives": { "type": "integer", "minimum": 0 },
        "orphanConstructEnds": { "type": "integer", "minimum": 0 },
        "dependencyHoldFiles": { "type": "integer", "minimum": 0, "description": "Files with at least one cross-repo dependency hold" },
        "dependencyHoldIncludes": { "type": "integer", "minimum": 0, "description": "Total cross-repo include occurrences under hold" },
        "dependencyHoldTargets": { "type": "integer", "minimum": 0, "description": "Distinct include targets under hold" }
      }
    },
    "unsupportedSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "count"],
        "properties": {
          "key": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "quarantineSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "count"],
        "properties": {
          "reason": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "orphanConstructEndsSummary": {
      "type": "array",
      "description": "Orphan construct-end markers by construct kind (benign literal-text paragraphs; not quarantines).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "count"],
        "properties": {
          "kind": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "dependencySummary": {
      "type": "array",
      "description": "Cross-repo dependency hold includes grouped by target repository (sorted by count, then repo).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetRepo", "includes"],
        "properties": {
          "targetRepo": { "type": "string" },
          "includes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line", "column"],
          "properties": { "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } }
        },
        "end": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line", "column"],
          "properties": { "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "quarantineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeType", "reason", "detail", "span"],
      "properties": {
        "nodeType": { "type": "string" },
        "reason": {
          "type": "string",
          "enum": [
            "include-missing-target", "include-cycle", "include-path-traversal",
            "include-tilde-path", "include-non-file-url", "include-chain",
            "unknown-directive", "unterminated-construct", "orphan-construct-end",
            "unterminated-code-fence"
          ]
        },
        "detail": { "type": ["string", "null"] },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "href", "resolved", "exists", "span"],
      "properties": {
        "kind": { "enum": ["include", "image", "image-lightbox", "link", "applicability", "video", "commented-directive"] },
        "classification": { "$ref": "#/$defs/linkClassification" },
        "href": { "type": ["string", "null"] },
        "resolved": { "type": ["string", "null"] },
        "exists": { "type": ["boolean", "null"] },
        "anchor": { "type": ["string", "null"] },
        "anchorExists": { "type": "boolean" },
        "blocked": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "marker": { "type": "string", "description": "applicability marker kind (pivot, moniker)" },
        "value": { "type": "string", "description": "applicability marker value" },
        "directiveText": { "type": "string" },
        "inline": { "type": "boolean" },
        "via": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "linkClassification": {
      "enum": ["anchor-only", "external", "mail", "site-absolute", "locale-ref", "relative-md", "relative-asset", "relative-other"]
    }
  }
}
