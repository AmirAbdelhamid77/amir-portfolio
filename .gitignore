# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# cloudflare
.wrangler/
.dev.vars*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private intake mirror: package files that carry answer keys, historical keys,
# review logs and agent guides. Kept on disk for review, never committed and
# never served — no file under this path is imported by any app code.
intake-private/

# fabric-corpus Wave 2 build outputs (FC05) — generated media, alias HTML and
# compiled content stay out of Git history (RELEASE_AND_STORAGE.md "Never in
# Git history: upstream checkouts, raw private evidence, generated
# HTML/indexes/media"). Regenerate with tools/fabric-corpus/route-registry/.
/public/fabric-docs-assets/
/public/fabric-aliases/
