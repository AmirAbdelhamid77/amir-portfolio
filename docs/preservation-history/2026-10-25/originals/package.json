{
  "name": "amir-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/export-segment-aliases.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test \"tests/data-viz/*.test.mjs\"",
    "test:statistics": "node --experimental-strip-types --test \"tests/statistics/*.test.mjs\"",
    "test:fabric": "node --experimental-strip-types --test \"tests/fabric/*.test.mjs\"",
    "test:content": "node --experimental-strip-types --test \"tests/content/*.test.mjs\"",
    "test:all": "npm test && npm run test:statistics && npm run test:fabric && npm run test:content",
    "inventory:routes": "node scripts/inventory-routes.mjs",
    "inventory:content": "node scripts/inventory-content.mjs",
    "inventory:compare": "node scripts/compare-inventory.mjs",
    "verify:metrics": "node scripts/verify-site-metrics.mjs",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:browser:dark": "node scripts/qa-browser.mjs --dark",
    "qa:search": "node scripts/qa-search.mjs",
    "qa:hse": "node scripts/qa-hse-explainer.mjs",
    "verify:statistics": "node --experimental-strip-types scripts/verify-statistics.mjs",
    "test:e2e:statistics": "node --experimental-strip-types tests/statistics/e2e.mjs",
    "test:e2e:fabric": "node --experimental-strip-types tests/fabric/e2e.mjs",
    "import:fabric": "node --experimental-strip-types scripts/import-fabric-bank.mjs",
    "report:fabric": "node --experimental-strip-types scripts/fabric-report.mjs",
    "import:statistics": "node scripts/import-notion-statistics.mjs",
    "docs:statistics": "node --experimental-strip-types scripts/generate-statistics-docs.mjs",
    "validate:data-viz": "node scripts/validate-data-viz.mjs",
    "import:data-viz": "node scripts/import-notion-data-viz.mjs --source \"Data Visualization\"",
    "build:data-viz": "node scripts/build-datasets.mjs",
    "preview": "node scripts/serve-out.mjs",
    "preview:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "perf:fabric": "node scripts/measure-payload.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "node-html-parser": "^9.0.5",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
