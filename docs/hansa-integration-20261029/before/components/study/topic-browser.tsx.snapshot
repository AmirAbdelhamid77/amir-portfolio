'use client';
import Link from 'next/link';import {useEffect,useMemo,useState} from 'react';import {SUBJECTS,type StudyRecord} from '@/lib/study/taxonomy';
export function TopicBrowser({items}:{items:StudyRecord[]}){
 const [mode,setMode]=useState('all'),[query,setQuery]=useState(''),[limit,setLimit]=useState(30);
 const [subject,setSubject]=useState('all'),[topic,setTopic]=useState('all');
 const multiSubject=new Set(items.map(r=>r.subject)).size>1;
 useEffect(()=>{const restore=()=>{const u=new URL(location.href);const m=u.searchParams.get('mode')??'all';setMode(['all','read','experiment','question','reference'].includes(m)?m:'all');setQuery(u.searchParams.get('q')??'');setLimit(30);};queueMicrotask(restore);addEventListener('popstate',restore);return()=>removeEventListener('popstate',restore);},[]);
 const filtered=useMemo(()=>items.filter(r=>(subject==='all'||r.subject===subject)&&(topic==='all'||r.topic===topic)&&(mode==='all'||r.kind===mode)&&query.toLowerCase().split(/\s+/).every(w=>[r.title,r.context,r.source].join(' ').toLowerCase().includes(w))),[items,mode,query,subject,topic]);
 function update(m:string,q:string){setMode(m);setQuery(q);setLimit(30);const u=new URL(location.href);if(m==='all')u.searchParams.delete('mode');else u.searchParams.set('mode',m);if(q)u.searchParams.set('q',q);else u.searchParams.delete('q');history.replaceState(null,'',u);}
 const labels=[['all','All material'],['read','Understand'],['experiment','Experiment'],['question','Practise'],['reference','Reference']];
 const href=(r:StudyRecord)=>{const url=new URL(r.href,'https://hansa.invalid');url.searchParams.set('learningContext',`${r.subject}.${r.topic}`);return url.pathname+url.search+url.hash;};
 const reviewFilters=multiSubject?<div className="study-controls"><label>Subject<select aria-label="Subject" value={subject} onChange={e=>{setSubject(e.target.value);setTopic('all');setLimit(30);}}><option value="all">All review subjects</option>{SUBJECTS.filter(s=>items.some(r=>r.subject===s.id)).map(s=><option value={s.id} key={s.id}>{s.title}</option>)}</select></label><label>Topic<select aria-label="Topic" value={topic} onChange={e=>{setTopic(e.target.value);setLimit(30);}}><option value="all">All topics</option>{SUBJECTS.filter(s=>s.id===subject).flatMap(s=>s.topics.map(([id,title])=><option key={id} value={id}>{title}</option>))}</select></label></div>:null;
 return <section aria-label="Topic material">{reviewFilters}<div className="study-controls"><label>Find within this topic<input type="search" value={query} onChange={e=>update(mode,e.target.value.slice(0,160))}/></label><label>Learning activity<select aria-label="Learning activity" value={mode} onChange={e=>update(e.target.value,query)}>{labels.map(([id,label])=><option key={id} value={id}>{label} ({id==='all'?items.length:items.filter(r=>r.kind===id).length})</option>)}</select></label><button type="button" onClick={()=>{setSubject('all');setTopic('all');update('all','');}}>Reset filters</button></div><p role="status" className="study-result-count">{filtered.length} matching records. Showing {Math.min(limit,filtered.length)}.</p>
 {!filtered.length&&<p className="study-empty">No material matches this activity and search. Reset the filters, or return to the subject. A missing explanation is a coverage gap, not a prerequisite you have failed.</p>}
 <ol className="study-records">{filtered.slice(0,limit).map(r=><li key={r.id}><div><span className="study-eyebrow">{labels.find(x=>x[0]===r.kind)?.[1]} · {r.language==='ar'?'العربية':'English'}</span><h2 dir="auto"><Link href={href(r)}>{r.title}</Link></h2><p dir="auto">{r.context.slice(0,360)}{r.context.length>360?'…':''}</p><details><summary>Source, placement & review status</summary><p>{r.status}</p><p>Source: {r.source} · ID: {r.id}</p><p>{r.basis}. This grouping does not validate the answer or establish a prerequisite.</p></details></div><Link className="study-open" href={href(r)} aria-label={`Open ${r.title}`}>Open ↗</Link></li>)}</ol>{filtered.length>limit&&<button className="study-more" onClick={()=>setLimit(v=>v+30)}>Show 30 more</button>}
 </section>;
}
