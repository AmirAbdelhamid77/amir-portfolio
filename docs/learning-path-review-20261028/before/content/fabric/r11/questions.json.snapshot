    "id": "T1Q139",
    "type": "dragdrop",
    "stem": "You have a Fabric workspace that contains a Dataflow Gen2 query. The query returns the following data.\nYou need to filter the results to ensure that only the latest version of each customer’s record is retained. The solution must ensure that no new\ncolumns are loaded to the semantic model.\nWhich four actions should you perform in sequence in Power Query Editor? To answer, move the appropriate actions from the list of actions to the\nanswer area and arrange them in the correct order.",
    "drag": {
      "items": [
        "Filter the query where the version date value equals the max version date value.",
        "Remove the max version date column.",
        "Expand the All Rows detail column.",
        "Group by CustomerID and calculate the max version date per customer ID.",
        "Remove duplicates based on CustomerID.",
        "Group by CustomerID, use the All Rows operation, and calculate the max version date per customer ID."
      ],
      "reuse": false,
      "targets": [
        {
          "label": "1",
          "answer": "Group by CustomerID, use the All Rows operation, and calculate the max version date per customer ID."
        },
        {
          "label": "2",
          "answer": "Expand the All Rows detail column."
        },
        {
          "label": "3",
          "answer": "Filter the query where the version date value equals the max version date value."
        },
        {
          "label": "4",
          "answer": "Remove the max version date column."
        }
      ]
    },
    "semanticVisuals": [
      {
        "kind": "table",
        "title": "Dataflow Gen2 query columns",
        "headers": [
          "Column name",
          "Data type",
          "Description"
        ],
        "rows": [
          [
            "CustomerID",
            "Whole number",
            "Contains unique customer IDs"
          ],
          [
            "CustomerName",
