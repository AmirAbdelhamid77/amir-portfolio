        "content": "df = spark.read.format(\"delta\").load(\"Tables/nyctaxi_raw\")\ndf2 = [Dropdown 1](\"pickupDate\", df['tpepPickupDateTime'] \\\n    [Dropdown 2]) \\\n    [Dropdown 3]"
