    "id": "T1Q220",
    "type": "hotspot-dropdown",
    "stem": "You have a Fabric tenant that contains a lakehouse named LH1 and a notebook.\nYou have a Parquet file named invoice1 that contains a column named InvoiceDateKey of the timestamp data type.\nYou need to create a PySpark script that will import invoice1 and create a table named fact_sale in LH1. The solution must meet the following\nrequirements:\n• A new column named Year must be added to fact_sale.\n• The values in Year must use the InvoiceDateKey column.\nHow should you complete the script? To answer, select the appropriate options in the answer area.\nNOTE: Each correct selection is worth one point.",
    "blanks": [
      {
        "label": "df = df.[answer choice]('Year', year( … ('InvoiceDateKey')))",
        "options": [
          "transform",
          "withColumn",
          "withColumnRenamed",
          "withMetadata"
        ],
        "answer": "withColumn"
      },
      {
        "label": "df = df.withColumn('Year', year( [answer choice] ('InvoiceDateKey')))",
        "options": [
          "col",
          "extract",
          "lit"
        ],
        "answer": "col"
      }
    ],
    "semanticVisuals": [
      {
        "kind": "code",
        "title": "Original PySpark year-column completion template",
        "language": "python",
        "content": "from pyspark.sql.functions import *\n\ntable_name = 'Table/fact_sale'\ndf = spark.read.format(\"parquet\").load('Files/parquet/full/invoice1')\ndf = df.[Dropdown 1]('Year', year([Dropdown 2](\"InvoiceDateKey\")))\ndf.write.mode(\"overwrite\").format(\"delta\").partitionBy(\"Year\").save(table_name)"
      }
    ],
