      {
        "kind": "code",
        "title": "Source SQL answer template",
        "language": "sql",
        "content": "SELECT OrderID, CustomerID,\n       [Dropdown 1] (month, OrderDate) AS PeriodDate,\n       DATENAME ( [Dropdown 2], OrderDate ) AS DayName\nFROM Sales.Orders;"
