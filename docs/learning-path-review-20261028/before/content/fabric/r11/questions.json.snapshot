    "id": "T1Q214",
    "type": "mcq",
    "stem": "You have a Microsoft Power BI semantic model that contains a table named Date. Date contains the following data.\nYou need to ensure that the visuals that use the Date table appear in chronological order. The solutions must minimize administrative effort.\nWhat should you do?",
    "options": [
      {
        "letter": "A",
        "text": "Sort the Month Number column by Column."
      },
      {
        "letter": "B",
        "text": "Sort the visuals by using the Sort ascending option on Fiscal Month."
      },
      {
        "letter": "C",
        "text": "Sort the Fiscal Month column by Column."
      },
      {
        "letter": "D",
        "text": "Sort the Date table by Column."
      }
    ],
    "semanticVisuals": [
      {
        "kind": "table",
        "title": "Date table values",
        "headers": [
          "Fiscal Month",
          "Month Number"
        ],
        "rows": [
          [
            "Jan",
            "1"
          ],
          [
            "Feb",
            "2"
          ],
          [
            "Mar",
            "3"
          ],
          [
            "Apr",
            "4"
          ],
          [
            "May",
            "5"
          ],
          [
            "Jun",
            "6"
          ],
          [
            "Jul",
            "7"
          ],
          [
            "Aug",
            "8"
          ],
          [
            "Sep",
            "9"
          ],
          [
            "Oct",
