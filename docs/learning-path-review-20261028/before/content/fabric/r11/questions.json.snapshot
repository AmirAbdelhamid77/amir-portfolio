          "options": [
            "WHEN(ListPrice > 50 AND ListPrice < 1000) THEN 'medium'",
            "WHEN(ListPrice >= 50 AND ListPrice < 1000) THEN 'medium'",
            "WHEN ListPrice BETWEEN 50 AND 1000) THEN 'medium'"
