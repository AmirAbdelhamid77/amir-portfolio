        "content": "df = spark.read.format('csv').options(header=\"true\", inferSchema=\"true\") \\\n    .load(\"fs1@storage1.dfs.core.windows.net/files/productline1\")\ndf.write.mode(\"overwrite\").format(\"[Dropdown 1]\") \\\n    .save(\"[Dropdown 2]\")"
