  {
    "id": "T1Q10",
    "type": "mcq-image",
    "stem": "You have a Fabric warehouse that contains a table named Staging.Sales. Staging.Sales contains the following columns.\nYou need to write a T-SQL query that will return data for the year 2023 that displays ProductID and ProductName and has a summarized Amount\nthat is higher than 10,000.\nWhich query should you use?\nA.\nB.\nC.\nD.",
    "options": [
      {
        "letter": "A",
        "text": "WHERE DATEPART(YEAR, SaleDate) = '2023' · GROUP BY ProductID, ProductName · HAVING SUM(Amount) > 10000",
        "code": "SELECT ProductID, ProductName, SUM(Amount) AS TotalAmount\nFROM Staging.Sales\nWHERE DATEPART(YEAR, SaleDate) = '2023'\nGROUP BY ProductID, ProductName\nHAVING SUM(Amount) > 10000",
        "language": "sql"
      },
      {
        "letter": "B",
        "text": "GROUP BY ProductID, ProductName · HAVING DATEPART(YEAR, SaleDate) = '2023' AND SUM(Amount) > 10000",
        "code": "SELECT ProductID, ProductName, SUM(Amount) AS TotalAmount\nFROM Staging.Sales\nGROUP BY ProductID, ProductName\nHAVING DATEPART(YEAR, SaleDate) = '2023' AND SUM(Amount) > 10000",
        "language": "sql"
      },
      {
        "letter": "C",
        "text": "WHERE DATEPART(YEAR, SaleDate) = '2023' AND SUM(Amount) > 10000  (no GROUP BY)",
        "code": "SELECT ProductID, ProductName, SUM(Amount) AS TotalAmount\nFROM Staging.Sales\nWHERE DATEPART(YEAR, SaleDate) = '2023' AND SUM(Amount) > 10000",
        "language": "sql"
      },
      {
        "letter": "D",
        "text": "WHERE DATEPART(YEAR, SaleDate) = '2023' · GROUP BY ProductID, ProductName · HAVING TotalAmount > 10000",
        "code": "SELECT ProductID, ProductName, SUM(Amount) AS TotalAmount\nFROM Staging.Sales\nWHERE DATEPART(YEAR, SaleDate) = '2023'\nGROUP BY ProductID, ProductName\nHAVING TotalAmount > 10000",
        "language": "sql"
      }
    ],
    "semanticVisuals": [
