[{"id":"fb-v6-sec-001","sourceId":"V6-SEC-001","pack":"video06","topic":"SQL column grants","title":"SQL column grants","prompt":"A contractor has Warehouse item Read, no workspace role, and no SQL grants. They must query EmployeeID and Department from hr.Employees but must never read Salary. Which change meets the requirement with the fewest privileges?","type":"single","options":[{"id":"A","text":"GRANT SELECT ON hr.Employees (EmployeeID, Department) TO [contractor];","why":"Correct: a column-scoped SELECT grant adds only the approved columns."},{"id":"B","text":"Add the contractor to workspace Contributor.","why":"Gives broad workspace data and development capabilities; violates least privilege."},{"id":"C","text":"GRANT SELECT ON SCHEMA::hr TO [contractor];","why":"Grants access to other HR tables and columns, including potentially confidential data."},{"id":"D","text":"DENY SELECT ON OBJECT::hr.Employees (Salary) TO [contractor];","why":"Does not grant any access to the approved columns."}],"correct":["A"],"explanation":"The item Read permission establishes connectivity. Grant only SELECT on the two allowed columns; no broad schema or workspace role is needed.","videoSeconds":425,"refs":["vref_d42ef00915b2bd5a","vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=425s"},{"id":"fb-v6-sec-002","sourceId":"V6-SEC-002","pack":"video06","topic":"SELECT star and CLS","title":"SELECT star and CLS","prompt":"After the preceding grant, the contractor runs SELECT * FROM hr.Employees. What should be expected?","type":"single","options":[{"id":"A","text":"The query fails on a column permission check; an explicit approved-column projection succeeds.","why":"Correct: SELECT * references Salary as well."},{"id":"B","text":"The engine silently omits Salary.","why":"SQL column permissions do not automatically rewrite SELECT * into an allowed-column projection."},{"id":"C","text":"The query returns all columns because the user can connect.","why":"Connection permission is not permission to read all columns."},{"id":"D","text":"The query returns Salary as NULL for every row.","why":"That is not the semantics of SQL column-level SELECT permission."}],"correct":["A"],"explanation":"SQL CLS blocks references to forbidden columns, so SELECT * is not a workaround.","videoSeconds":1065,"refs":["vref_d42ef00915b2bd5a","vref_3c187dcb2c20c658"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"explicit-prerequisite-from-v6-sec-001","sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=1065s"},{"id":"fb-v6-sec-003","sourceId":"V6-SEC-003","pack":"video06","topic":"SQL REVOKE semantics","title":"SQL REVOKE semantics","prompt":"An analyst has SELECT on finance.Revenue through a database role and an explicit DENY SELECT on that object. An administrator REVOKEs the explicit DENY from the analyst, leaving the role assignment unchanged. What is the best prediction?","type":"single","options":[{"id":"A","text":"The user is always denied because REVOKE is a permanent ban.","why":"REVOKE removes a permission entry; it is not DENY."},{"id":"B","text":"The user needs workspace Admin before selecting any data.","why":"Workspace Admin is not required for granular SQL access."},{"id":"C","text":"All grants assigned through roles are also revoked.","why":"A direct permission REVOKE does not remove role-based grants."},{"id":"D","text":"The user can read Revenue through the role grant, assuming no other applicable denial.","why":"Correct: removing the denial reveals another surviving grant."}],"correct":["D"],"explanation":"DENY and REVOKE differ: REVOKE removes the explicitly specified rule and effective access must be reevaluated.","videoSeconds":318,"refs":["vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=318s"},{"id":"fb-v6-sec-004","sourceId":"V6-SEC-004","pack":"video06","topic":"schema/table inheritance","title":"schema/table inheritance","prompt":"A group has SELECT on SCHEMA::finance. A new finance.Forecast table is created tomorrow. No object-level DENY exists. What should happen?","type":"single","options":[{"id":"A","text":"New objects require a separate GRANT SELECT each time.","why":"True only for grants scoped to selected existing objects, not the schema."},{"id":"B","text":"The group gains write privileges on Forecast.","why":"SELECT does not grant INSERT or UPDATE."},{"id":"C","text":"The group can query Forecast only after receiving Build on a semantic model.","why":"Build is a semantic model permission and irrelevant to this SQL grant."},{"id":"D","text":"The group can query finance.Forecast because the schema grant encompasses future objects.","why":"Correct: schema-scoped grants cover present and later objects."}],"correct":["D"],"explanation":"A schema grant is broad and implicitly applies to newly created objects; this is a future-exposure risk.","videoSeconds":295,"refs":["vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=295s"},{"id":"fb-v6-sec-005","sourceId":"V6-SEC-005","pack":"video06","topic":"schema grant vs object exception","title":"schema grant vs object exception","prompt":"An auditor should query all finance tables except finance.SecretForecast. A SQL role already has schema-wide SELECT. Which additional permission most directly enforces the exception within SQL-native security?","type":"single","options":[{"id":"A","text":"REVOKE SELECT on finance.SecretForecast from the auditor without changing the role.","why":"Revoking a nonexistent direct grant does not negate inherited schema permission."},{"id":"B","text":"Hide finance.SecretForecast in the workspace item list.","why":"Workspace item visibility does not negate SQL table access."},{"id":"C","text":"Grant ReadAll on the underlying Lakehouse.","why":"Introduces another broad access path rather than blocking the object."},{"id":"D","text":"DENY SELECT ON OBJECT::finance.SecretForecast TO the auditor role.","why":"Correct: an applicable DENY can override a broad SQL grant."}],"correct":["D"],"explanation":"An explicit SQL DENY can limit a broader SQL GRANT. Audit alternative data paths separately.","videoSeconds":306,"refs":["vref_1c5d797a849bbf18","vref_3c187dcb2c20c658"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=306s"},{"id":"fb-v6-sec-006","sourceId":"V6-SEC-006","pack":"video06","topic":"SQL metadata inspection","title":"SQL metadata inspection","prompt":"A security reviewer queries sys.database_permissions and finds no row directly granting an analyst SELECT. The analyst can still read a table. Which interpretation is most defensible?","type":"single","options":[{"id":"A","text":"The analyst must be using a stale cached query.","why":"No such conclusion follows. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"The result proves a SQL engine defect.","why":"Effective permissions can come from workspace roles or groups rather than a direct grant row."},{"id":"C","text":"SELECT succeeds only for database owners.","why":"Granular grants and other access paths exist."},{"id":"D","text":"They may inherit access through a Fabric workspace role or a role/group grant that the query did not resolve into user-effective permissions.","why":"Correct: direct permission listings are not equivalent to effective rights."}],"correct":["D"],"explanation":"Inspect identity, group membership, roles, item permissions, and effective rights, not only a direct-user permission listing.","videoSeconds":255,"refs":["vref_1c5d797a849bbf18","vref_1c21e6dbc4aac4ca"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=255s"},{"id":"fb-v6-sec-007","sourceId":"V6-SEC-007","pack":"video06","topic":"least privilege multiselect","title":"least privilege multiselect","prompt":"Select TWO actions that genuinely reduce exposure for SQL-only analysts whose job requires three allowed Warehouse tables but not their peers' sensitive tables.","type":"multi","options":[{"id":"A","text":"Grant SELECT on the whole schema, then assume new tables will remain inaccessible.","why":"Schema-wide grants cover future tables too."},{"id":"B","text":"Share the Warehouse with basic item Read, then grant SELECT on only approved objects.","why":"Correct: limits the SQL data scope."},{"id":"C","text":"Use a dedicated SQL database role for approved table grants and assign users/groups to it.","why":"Correct: scales least privilege and audits better."},{"id":"D","text":"Give ReadAll on the files to ensure that SQL permissions work.","why":"ReadAll enables broader OneLake access not needed for SQL-only querying."},{"id":"E","text":"Add each analyst to workspace Contributor for convenience.","why":"Grants excessive workspace-wide capabilities."}],"correct":["B","C"],"explanation":"Combine item Read with narrowly scoped SQL grants administered through roles.","videoSeconds":940,"refs":["vref_1c5d797a849bbf18","vref_e8903e93a0480ba6"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=940s"},{"id":"fb-v6-sec-008","sourceId":"V6-SEC-008","pack":"video06","topic":"object security visibility","title":"object security visibility","prompt":"A consumer cannot list hr.Payroll in SQL metadata but knows its name and tries SELECT * FROM hr.Payroll. They lack any applicable SELECT grant. What is the safest expectation?","type":"single","options":[{"id":"A","text":"The user retrieves rows by naming the object directly.","why":"Knowing a table name is not permission."},{"id":"B","text":"They cannot read the table; metadata visibility and data access are both permission-governed.","why":"Correct. Hiding a table from discovery is not the only security control: SQL access must also be denied by lack of grant."},{"id":"C","text":"The SQL engine escalates to the item owner identity for permission checks.","why":"That is not the rule for a user querying Warehouse with no grant."},{"id":"D","text":"Fabric automatically returns masked values.","why":"Dynamic data masking requires separate configuration and cannot substitute for absent access."}],"correct":["B"],"explanation":"Hiding a table from discovery is not the only security control: SQL access must also be denied by lack of grant.","videoSeconds":238,"refs":["vref_1c5d797a849bbf18","vref_3c187dcb2c20c658"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=238s"},{"id":"fb-v6-sec-009","sourceId":"V6-SEC-009","pack":"video06","topic":"RLS implementation","title":"RLS implementation","prompt":"A Warehouse table sales.Transactions contains regions North and South. sales.UserRegion maps user principal names to allowed regions. The business wants any SQL client to retrieve only authorized rows without changing every report query. What should be implemented?","type":"single","options":[{"id":"A","text":"A report-level filter only.","why":"Can be bypassed by a direct SQL client."},{"id":"B","text":"An inline table-valued predicate function referencing the row region and current identity, attached through CREATE SECURITY POLICY.","why":"Correct: SQL-native RLS is enforced by the database engine."},{"id":"C","text":"Dynamic data masking on Region.","why":"Masking values does not filter rows."},{"id":"D","text":"DENY SELECT on sales.Transactions for all users.","why":"Blocks allowed rows too. This would not satisfy the access and security constraints in this scenario."}],"correct":["B"],"explanation":"Implement predicate-based SQL RLS at the Warehouse/SQL endpoint layer.","videoSeconds":520,"refs":["vref_6b11ae50991bee99","vref_40d7e16745fa5548"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=520s"},{"id":"fb-v6-sec-010","sourceId":"V6-SEC-010","pack":"video06","topic":"RLS evaluation and counting","title":"RLS evaluation and counting","prompt":"sales.Transactions contains North rows (100,200), South (300,400), West (500). An RLS policy exposes only North to Alice. Alice runs SELECT COUNT(*) AS N, SUM(Amount) AS Total FROM sales.Transactions. What result should she see?","type":"single","options":[{"id":"A","text":"N=5, Total=300.","why":"COUNT also operates on the filtered visible rows."},{"id":"B","text":"N=5, Total=1500.","why":"Ignores RLS. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"N=2, Total=300.","why":"Correct: only the two North rows contribute."},{"id":"D","text":"Permission error because aggregates are incompatible with RLS.","why":"Aggregates can query RLS-filtered data."}],"correct":["C"],"explanation":"SQL filter predicates apply before the user-visible query results and aggregates.","videoSeconds":1150,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=1150s"},{"id":"fb-v6-sec-011","sourceId":"V6-SEC-011","pack":"video06","topic":"RLS identity mismatch","title":"RLS identity mismatch","prompt":"A UPN-based row filter works for Alice in SSMS but returns no rows when a pipeline runs under a service principal. The table is populated. Which diagnostic is best first?","type":"single","options":[{"id":"A","text":"Disable the security policy to unblock the pipeline permanently.","why":"Destroys intended control. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"Compare the execution identity returned by the predicate context with entries in the user-to-region map.","why":"Correct: pipeline identity may not be mapped to a region."},{"id":"C","text":"Use a column DENY on Region.","why":"That does not resolve identity mapping."},{"id":"D","text":"Increase Fabric capacity.","why":"Compute capacity cannot fix a security identity mismatch."}],"correct":["B"],"explanation":"RLS predicates depend on the querying identity; nonhuman execution principals require deliberate authorization mapping.","videoSeconds":530,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=530s"},{"id":"fb-v6-sec-012","sourceId":"V6-SEC-012","pack":"video06","topic":"RLS late authorization","title":"RLS late authorization","prompt":"Bob has permission to SELECT sales.Transactions and sees zero rows. His mapping row was omitted from sales.UserRegion. Which option preserves fail-closed behavior?","type":"single","options":[{"id":"A","text":"Replace RLS with a report-level slicer.","why":"Does not prevent SQL clients from reading other regions."},{"id":"B","text":"Grant Bob workspace Admin.","why":"Broadens access and does not repair the mapping."},{"id":"C","text":"Add only the verified region mapping for Bob, maintaining the existing restrictive RLS predicate.","why":"Correct. RLS should default to no visible rows when the identity has no authorized mapping."},{"id":"D","text":"Add a predicate clause that returns all rows when no mapping exists.","why":"Violates fail-closed least privilege."}],"correct":["C"],"explanation":"RLS should default to no visible rows when the identity has no authorized mapping.","videoSeconds":527,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=527s"},{"id":"fb-v6-sec-013","sourceId":"V6-SEC-013","pack":"video06","topic":"RLS multiregion policy","title":"RLS multiregion policy","prompt":"Regional managers may belong to multiple regions. Which policy shape best models the requirement while preserving per-row authorization?","type":"single","options":[{"id":"A","text":"Grant all managers SELECT without enabling RLS.","why":"Allows all visible rows. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"Predicate Region = the alphabetically first mapped region.","why":"Drops legitimately authorized regions."},{"id":"C","text":"Predicate EXISTS a matching mapping row for the querying identity and the current transaction Region.","why":"Correct: handles multiple region mappings without hardcoded user logic."},{"id":"D","text":"Keep a separate manually filtered copy for every region and remove RLS.","why":"Creates data duplication and operational drift."}],"correct":["C"],"explanation":"An existence-based predicate against the mapping table supports one-to-many identity-to-region relationships.","videoSeconds":559,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=559s"},{"id":"fb-v6-sec-014","sourceId":"V6-SEC-014","pack":"video06","topic":"RLS across tables","title":"RLS across tables","prompt":"RLS exists on sales.Transactions. A direct SQL consumer can also SELECT sales.Forecasts, which has an unfiltered Region column. Which conclusion is correct?","type":"single","options":[{"id":"A","text":"The Transactions policy automatically filters all same-schema tables.","why":"Policies are defined for specified target tables."},{"id":"B","text":"The shared region name implicitly creates security inheritance.","why":"Column names do not cause RLS propagation in SQL."},{"id":"C","text":"Object DENY on Transactions automatically applies to Forecasts.","why":"A table-scoped DENY does not extend to unrelated tables."},{"id":"D","text":"The consumer can potentially see all rows of Forecasts; apply an appropriate policy to that table too.","why":"Correct. A SQL RLS policy applies to its target table(s), not every table in a schema."}],"correct":["D"],"explanation":"A SQL RLS policy applies to its target table(s), not every table in a schema.","videoSeconds":546,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=546s"},{"id":"fb-v6-sec-015","sourceId":"V6-SEC-015","pack":"video06","topic":"RLS vs masking vs CLS","title":"RLS vs masking vs CLS","prompt":"Select THREE controls for these distinct requirements: North users see only North transaction rows; Salary cannot be selected; permitted viewers see an obfuscated email rather than the full value.","type":"multi","options":[{"id":"A","text":"RLS filter predicate for transaction region.","why":"Correct. RLS, CLS, and DDM solve different requirements and should not be conflated."},{"id":"B","text":"SQL column-level permissions on Salary.","why":"Correct: prevents reading a column."},{"id":"C","text":"Replace row filtering with ORDER BY Region.","why":"Changes order, not access. This would not satisfy the access and security constraints in this scenario."},{"id":"D","text":"Dynamic data masking configured for Email when masking rather than withholding is the explicit requirement.","why":"Correct: changes presented values for nonprivileged queries."},{"id":"E","text":"Use only item Read for all three controls.","why":"Item Read grants connection, not fine-grained data rules."}],"correct":["A","B","D"],"explanation":"RLS, CLS, and DDM solve different requirements and should not be conflated.","videoSeconds":574,"refs":["vref_6b11ae50991bee99","vref_d42ef00915b2bd5a","vref_3c187dcb2c20c658"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=574s"},{"id":"fb-v6-sec-016","sourceId":"V6-SEC-016","pack":"video06","topic":"security changes and mode","title":"security changes and mode","prompt":"After implementing a SQL security policy on a lakehouse SQL analytics endpoint, a Spark notebook accessing the same Delta table returns all regions for a user with broad file access. What is the root cause?","type":"single","options":[{"id":"A","text":"SQL engine predicate restrictions do not automatically secure another compute engine; use OneLake security and appropriate roles/mode for consistent coverage.","why":"Correct. Separate data access paths are central to the video: SQL-layer security alone does not control unrestricted OneLake reads."},{"id":"B","text":"Spark must automatically honor SQL-layer RLS.","why":"SQL-only RLS is enforced through that SQL endpoint, not inherently through Spark."},{"id":"C","text":"A Spark bug must have bypassed universal OneLake security.","why":"OneLake security may not have been configured; SQL-only rules are not universal."},{"id":"D","text":"Warehouse SQL syntax uses incorrect region values.","why":"Not supported by the stated outcome."}],"correct":["A"],"explanation":"Separate data access paths are central to the video: SQL-layer security alone does not control unrestricted OneLake reads.","videoSeconds":565,"refs":["vref_f513e79bbf83ae3f","vref_6479b4656ce498ad","vref_f4801325c6b9ca57"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=565s"},{"id":"fb-v6-sec-017","sourceId":"V6-SEC-017","pack":"video06","topic":"RLS unauthorized changes","title":"RLS unauthorized changes","prompt":"An administrator enables RLS for SELECT queries, but analysts with write permission update a visible North row to Region=South. Which risk must be reviewed?","type":"single","options":[{"id":"A","text":"RLS only works for SELECT; UPDATE ignores all row filtering.","why":"The documentation describes restrictions on read/update/delete operations."},{"id":"B","text":"Changing the value causes the entire security policy to be deleted.","why":"No such behavior follows. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"Filter predicates always reject any update that would make a row invisible.","why":"Filter predicates alone can permit rows to be updated into a filtered-out state."},{"id":"D","text":"Filter predicates can hide the row after the update; investigate write/block predicate behavior and avoid granting unnecessary write access.","why":"Correct; this is a known nuance of filter-predicate RLS."}],"correct":["D"],"explanation":"For SQL RLS, filtering read visibility is not by itself a complete write-validation design.","videoSeconds":570,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=570s"},{"id":"fb-v6-sec-018","sourceId":"V6-SEC-018","pack":"video06","topic":"RLS with report users","title":"RLS with report users","prompt":"A report author says, “RLS can be implemented in the Power BI visual instead; users never need to connect to the warehouse.” What is the strongest architectural rebuttal?","type":"single","options":[{"id":"A","text":"Warehouse RLS requires a separate table per user.","why":"Predicate policies can dynamically use identity maps."},{"id":"B","text":"RLS is only available in paginated reports.","why":"SQL RLS is a warehouse feature. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"SQL RLS applies at the engine to authorized client queries and reduces dependence on individual report implementations.","why":"Correct. Secure the data tier for SQL consumers rather than rely solely on visual filters."},{"id":"D","text":"Visual filters are adequate because users cannot export underlying data.","why":"Visual/report filtering is not a data-tier access rule."}],"correct":["C"],"explanation":"Secure the data tier for SQL consumers rather than rely solely on visual filters.","videoSeconds":550,"refs":["vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=550s"},{"id":"fb-v6-sec-019","sourceId":"V6-SEC-019","pack":"video06","topic":"role model","title":"role model","prompt":"A lakehouse Viewer needs read access only to Tables/finance.PublicSummary through Spark and Direct Lake on OneLake. The admin wants one centrally defined data policy. What is the least-privilege pattern?","type":"single","options":[{"id":"A","text":"Give SQL-only SELECT to the table in delegated identity mode and assume Spark inherits it.","why":"SQL grants do not automatically apply across engines."},{"id":"B","text":"Make the user a workspace Contributor.","why":"Contributors already gain broad data access."},{"id":"C","text":"Share lakehouse item Read, create a OneLake security Read role scoped to PublicSummary, add the user, and use supported engines.","why":"Correct. A shared lakehouse with a narrowly scoped OneLake security role implements granular cross-engine data access for Viewers/read-only consumers."},{"id":"D","text":"Give item ReadAll without reviewing DefaultReader.","why":"Might expose the entire lakehouse through the default role."}],"correct":["C"],"explanation":"A shared lakehouse with a narrowly scoped OneLake security role implements granular cross-engine data access for Viewers/read-only consumers.","videoSeconds":690,"refs":["vref_1c21e6dbc4aac4ca","vref_cdd807ab8eaececd","vref_e8903e93a0480ba6"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=690s"},{"id":"fb-v6-sec-020","sourceId":"V6-SEC-020","pack":"video06","topic":"OneLake grant only","title":"OneLake grant only","prompt":"A user is in OneLake role RegionalRead permitting only North rows. The same user is also in a broad Read role for all rows of that table. What is the likely effective RLS scope?","type":"single","options":[{"id":"A","text":"Only North because the most restrictive grant always wins.","why":"OneLake combines compatible role grants using a least-restrictive union."},{"id":"B","text":"All rows because the broad role grants them; investigate and remove the overbroad membership.","why":"Correct. Overlapping roles can undermine intent; evaluate the union of grants, not just the restrictive role."},{"id":"C","text":"Neither role can be used, so the user sees no table.","why":"A broad role plus an RLS role does not necessarily imply a query error by itself."},{"id":"D","text":"No rows because any role that has RLS enforces a global DENY.","why":"OneLake does not have an overriding DENY role."}],"correct":["B"],"explanation":"Overlapping roles can undermine intent; evaluate the union of grants, not just the restrictive role.","videoSeconds":722,"refs":["vref_3444302757631152","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=722s"},{"id":"fb-v6-sec-021","sourceId":"V6-SEC-021","pack":"video06","topic":"role OR logic","title":"role OR logic","prompt":"In OneLake, RoleNorth allows rows where Region=North and RoleSouth allows rows where Region=South. Both roles grant the same table and a user belongs to both. Assume no conflicting CLS. Which rows may the user see?","type":"single","options":[{"id":"A","text":"North or South rows, according to the union of the compatible role predicates.","why":"Correct. Within each role access is intersected; across roles compatible RLS grants combine as union."},{"id":"B","text":"Only North, since the first role has priority.","why":"There is no first-role priority. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"All rows regardless of the role predicates.","why":"Both roles still restrict rows to the union of their allowed regions."},{"id":"D","text":"Only the intersection of North and South, generally no rows.","why":"Across roles RLS generally combines with OR/union, not AND."}],"correct":["A"],"explanation":"Within each role access is intersected; across roles compatible RLS grants combine as union.","videoSeconds":701,"refs":["vref_3444302757631152"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=701s"},{"id":"fb-v6-sec-022","sourceId":"V6-SEC-022","pack":"video06","topic":"cross-engine CLS discrepancy","title":"cross-engine CLS discrepancy","prompt":"A user has two OneLake roles on the same table. Role A allows Name and Salary; Role B allows Name and Department and hides Salary. No RLS is defined. Spark and a SQL endpoint configured in user identity mode may treat the combined CLS grant differently. Which statement best matches documentation?","type":"single","options":[{"id":"A","text":"Spark generally combines CLS allow-lists by union while SQL analytics endpoint applies a stricter hidden-column restriction.","why":"Correct. Engine-specific CLS behavior requires testing effective permissions in each path."},{"id":"B","text":"SQL endpoint always exposes every column if any role grants Name.","why":"The stricter rule can block a hidden column."},{"id":"C","text":"All engines always intersect allowed columns across roles.","why":"OneLake generally unions CLS across roles; SQL endpoint has stricter behavior."},{"id":"D","text":"Multi-role CLS is categorically unsupported even without RLS.","why":"The documented unsupported combination concerns certain RLS-plus-differing-CLS scenarios."}],"correct":["A"],"explanation":"Engine-specific CLS behavior requires testing effective permissions in each path.","videoSeconds":740,"refs":["vref_3444302757631152","vref_f4801325c6b9ca57"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=740s"},{"id":"fb-v6-sec-023","sourceId":"V6-SEC-023","pack":"video06","topic":"unsupported role shape","title":"unsupported role shape","prompt":"Role A grants ColA, ColB plus RLS North; Role B grants ColB, ColC on the same table. A user belongs to both. What should the designer do to avoid an unsupported combined security configuration?","type":"single","options":[{"id":"A","text":"Keep RLS and CLS policies that must apply together inside one suitable role and remove conflicting overlapping membership.","why":"Correct. Complex overlapping row and column rules should be consolidated into a compatible role configuration."},{"id":"B","text":"Remove RLS and rely solely on hiding ColA.","why":"Does not control row visibility. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"Assume the roles merge without errors because they both include ColB.","why":"Differing CLS along with RLS across roles is documented as problematic."},{"id":"D","text":"Promote the user to Contributor so RLS applies more strictly.","why":"Contributors typically have broad local data access."}],"correct":["A"],"explanation":"Complex overlapping row and column rules should be consolidated into a compatible role configuration.","videoSeconds":747,"refs":["vref_3444302757631152","vref_a2f1e44aa2e795c2"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=747s"},{"id":"fb-v6-sec-024","sourceId":"V6-SEC-024","pack":"video06","topic":"ReadWrite limitations","title":"ReadWrite limitations","prompt":"A Viewer must edit one public staging folder, but cannot obtain access to confidential finance tables. Which OneLake security option is most appropriate?","type":"single","options":[{"id":"A","text":"Assign Contributor workspace role.","why":"Makes all workspace data broadly accessible."},{"id":"B","text":"Assign ReadWrite with an RLS predicate to the folder.","why":"RLS is for tabular data and ReadWrite roles cannot contain RLS or CLS."},{"id":"C","text":"Assign a ReadWrite OneLake role scoped only to the staging folder and ensure item Read connectivity.","why":"Correct: folder-scoped write without workspace-wide promotion."},{"id":"D","text":"Grant SELECT on the SQL endpoint staging folder.","why":"Folders are not T-SQL tables and SELECT does not authorize OneLake file writes."}],"correct":["C"],"explanation":"OneLake ReadWrite can target particular lakehouse objects but cannot be combined with row/column restrictions.","videoSeconds":757,"refs":["vref_3444302757631152","vref_cdd807ab8eaececd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=757s"},{"id":"fb-v6-sec-025","sourceId":"V6-SEC-025","pack":"video06","topic":"roles supported items","title":"roles supported items","prompt":"Which assertion about defining OneLake security roles is correct under the current Microsoft Learn capabilities?","type":"single","options":[{"id":"A","text":"Lakehouse supports Read and ReadWrite roles, whereas the documented mirrored item types support Read.","why":"Correct. Consult the supported item matrix rather than extending Lakehouse capabilities indiscriminately."},{"id":"B","text":"Security rules can be assigned only to individual people, not Entra groups.","why":"Entra groups are supported as role members."},{"id":"C","text":"All Fabric items permit OneLake table- and column-level roles.","why":"Role support is item-type-specific."},{"id":"D","text":"Any Warehouse supports ReadWrite OneLake security roles identically to Lakehouse.","why":"The published OneLake security role creation matrix specifically covers Lakehouse and certain mirrored item types."}],"correct":["A"],"explanation":"Consult the supported item matrix rather than extending Lakehouse capabilities indiscriminately.","videoSeconds":716,"refs":["vref_cdd807ab8eaececd","vref_3444302757631152"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=716s"},{"id":"fb-v6-sec-026","sourceId":"V6-SEC-026","pack":"video06","topic":"no row restrictions for files","title":"no row restrictions for files","prompt":"A sensitive CSV exists in Lakehouse Files/ while an equivalent Delta table exists under Tables/. The organization wants North-only access for the report table. Which statement is technically sound?","type":"single","options":[{"id":"A","text":"The CSV automatically inherits SQL endpoint RLS through identical filenames.","why":"SQL endpoint filtering does not apply to raw files."},{"id":"B","text":"Apply OneLake RLS to the CSV file rows.","why":"OneLake RLS applies to tabular Delta tables, not arbitrary files."},{"id":"C","text":"Apply OneLake RLS to the Delta table and separately control raw CSV access at folder/object scope.","why":"Correct. Secure each independent data copy and access path; row rules cannot directly filter unstructured file contents."},{"id":"D","text":"Grant ReadAll and assume SQL policy protects both copies.","why":"Could expose raw files directly. This would not satisfy the access and security constraints in this scenario."}],"correct":["C"],"explanation":"Secure each independent data copy and access path; row rules cannot directly filter unstructured file contents.","videoSeconds":725,"refs":["vref_a2f1e44aa2e795c2","vref_3444302757631152"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=725s"},{"id":"fb-v6-sec-027","sourceId":"V6-SEC-027","pack":"video06","topic":"role restrictions multi","title":"role restrictions multi","prompt":"Select THREE statements that are accurate for OneLake security roles in supported Lakehouse items.","type":"multi","options":[{"id":"A","text":"Assigning restrictive roles to workspace Admins normally removes their broad local data permissions.","why":"Workspace higher roles generally have access already."},{"id":"B","text":"Users can be assigned through Microsoft Entra security groups.","why":"Correct. Grant-only roles, group membership, and tabular-only RLS are foundational OneLake rules."},{"id":"C","text":"RLS can be defined for Delta tables but not arbitrary unstructured folders.","why":"Correct. Grant-only roles, group membership, and tabular-only RLS are foundational OneLake rules."},{"id":"D","text":"OneLake RLS expressions can freely join arbitrary mapping tables.","why":"Current OneLake RLS has restricted syntax and does not support dynamic multitable rules."},{"id":"E","text":"Roles grant data access; they do not define DENY roles that defeat a different grant.","why":"Correct. Grant-only roles, group membership, and tabular-only RLS are foundational OneLake rules."}],"correct":["B","C","E"],"explanation":"Grant-only roles, group membership, and tabular-only RLS are foundational OneLake rules.","videoSeconds":725,"refs":["vref_3444302757631152","vref_a2f1e44aa2e795c2","vref_cdd807ab8eaececd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=725s"},{"id":"fb-v6-sec-028","sourceId":"V6-SEC-028","pack":"video06","topic":"dynamic predicate difference","title":"dynamic predicate difference","prompt":"A SQL Warehouse RLS function relies on a user-to-region mapping join. A developer copies that query unchanged into a OneLake role RLS editor. What is the main problem?","type":"single","options":[{"id":"A","text":"OneLake only supports securing files, never tables.","why":"OneLake table RLS is supported for Delta tables."},{"id":"B","text":"SQL RLS cannot use mapping tables either.","why":"Warehouse SQL predicate functions can reference mapping tables."},{"id":"C","text":"Nothing: OneLake supports every SQL inline TVF feature.","why":"OneLake RLS supports only a restricted SQL expression subset and not dynamic multitable policies."},{"id":"D","text":"The two systems use different RLS languages and capabilities; redesign the OneLake rule within supported single-table syntax and role membership.","why":"Correct. Do not assume SQL-native engine security and OneLake security have identical policy grammars."}],"correct":["D"],"explanation":"Do not assume SQL-native engine security and OneLake security have identical policy grammars.","videoSeconds":542,"refs":["vref_2a5406b70b6993d7","vref_a2f1e44aa2e795c2","vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=542s"},{"id":"fb-v6-sec-029","sourceId":"V6-SEC-029","pack":"video06","topic":"delegated vs user identity","title":"delegated vs user identity","prompt":"A Lakehouse SQL endpoint still runs in default delegated identity mode. Admin configures OneLake RLS allowing only North rows for a Viewer. The user queries through Spark and the SQL endpoint. Spark is filtered, SQL is not. What is the most likely explanation?","type":"single","options":[{"id":"A","text":"There is only one global security configuration across Fabric and this outcome is impossible.","why":"Modes can legitimately cause engine divergence."},{"id":"B","text":"RLS cannot function with Lakehouse tables.","why":"It can, depending on enforcement mode."},{"id":"C","text":"Spark ignores SQL permissions and must therefore be wrong.","why":"Spark reads secured OneLake data with OneLake roles."},{"id":"D","text":"Delegated SQL endpoint enforces SQL-native permissions rather than end-user OneLake roles; switch to user identity mode after reviewing the operational impact.","why":"Correct. Identity propagation differs: the delegated SQL endpoint uses owner context for OneLake and SQL-native security, while Spark can enforce OneLake data policy."}],"correct":["D"],"explanation":"Identity propagation differs: the delegated SQL endpoint uses owner context for OneLake and SQL-native security, while Spark can enforce OneLake data policy.","videoSeconds":703,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=703s"},{"id":"fb-v6-sec-030","sourceId":"V6-SEC-030","pack":"video06","topic":"mode switch blast radius","title":"mode switch blast radius","prompt":"An administrator will change a Lakehouse SQL endpoint from delegated to user identity mode during a production refresh window. Which operational risk is documented?","type":"single","options":[{"id":"A","text":"All semantic models are deleted and must be recreated.","why":"Not documented. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"Only the selected user session disconnects for less than one second.","why":"The effect is broader. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"SQL analytics endpoints in the workspace can become temporarily unavailable; running and queued queries can be canceled.","why":"Correct. Schedule a SQL endpoint mode change during an agreed maintenance window."},{"id":"D","text":"The workspace is automatically migrated to another capacity.","why":"Not part of access mode switching."}],"correct":["C"],"explanation":"Schedule a SQL endpoint mode change during an agreed maintenance window.","videoSeconds":732,"refs":["vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=732s"},{"id":"fb-v6-sec-031","sourceId":"V6-SEC-031","pack":"video06","topic":"SQL grants after mode change","title":"SQL grants after mode change","prompt":"After switching a Lakehouse SQL analytics endpoint to user identity mode, a team tries GRANT SELECT on a Delta table to override its OneLake roles. What should you tell them?","type":"single","options":[{"id":"A","text":"Continue: SQL table GRANT always overrides OneLake policies.","why":"SQL table GRANT/REVOKE is not the authority in user identity mode."},{"id":"B","text":"Replace the Lakehouse with Eventhouse because SQL endpoints cannot use OneLake security.","why":"Lakehouse SQL endpoint has a user identity mode for this purpose."},{"id":"C","text":"Promote everyone to workspace Admin before configuring roles.","why":"Unnecessary and excessive. This would not satisfy the access and security constraints in this scenario."},{"id":"D","text":"Manage base table access using OneLake security; SQL grants can still govern nondata objects such as views and procedures.","why":"Correct. Table access is governed by OneLake roles in user identity mode. SQL object permissions remain for certain nondata objects."}],"correct":["D"],"explanation":"Table access is governed by OneLake roles in user identity mode. SQL object permissions remain for certain nondata objects.","videoSeconds":726,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=726s"},{"id":"fb-v6-sec-032","sourceId":"V6-SEC-032","pack":"video06","topic":"delegated mode setup","title":"delegated mode setup","prompt":"A security migration cannot be completed until next month. For now, a Lakehouse SQL endpoint remains in delegated identity mode. The team needs SQL analysts to see North only. Which action is appropriate for the interim SQL path?","type":"single","options":[{"id":"A","text":"Define SQL-native RLS security policy and ensure proper SELECT rights on the endpoint, then separately review Spark access.","why":"Correct. SQL-native filtering works in delegated mode, but cross-engine governance must be reviewed independently."},{"id":"B","text":"Use a custom report filter and remove SQL policies.","why":"Does not secure direct SQL clients."},{"id":"C","text":"Set OneLake RLS alone and assert it will automatically filter delegated SQL.","why":"Delegated mode does not automatically honor user OneLake data roles."},{"id":"D","text":"Grant ReadAll to each analyst to activate SQL RLS.","why":"ReadAll is not SQL RLS activation."}],"correct":["A"],"explanation":"SQL-native filtering works in delegated mode, but cross-engine governance must be reviewed independently.","videoSeconds":733,"refs":["vref_f513e79bbf83ae3f","vref_6b11ae50991bee99"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=733s"},{"id":"fb-v6-sec-033","sourceId":"V6-SEC-033","pack":"video06","topic":"SQL endpoint item Read requirement","title":"SQL endpoint item Read requirement","prompt":"A user has a SQL GRANT SELECT permission on an endpoint table but receives a connection authorization error because they have no Fabric item Read and no workspace role. What is the smallest missing prerequisite?","type":"single","options":[{"id":"A","text":"Fabric item Read on the target Lakehouse or access through an appropriate workspace role.","why":"Correct: item control-plane access is needed to connect."},{"id":"B","text":"OneLake ReadWrite on every table.","why":"Not necessary for SQL connectivity."},{"id":"C","text":"Global administrator role.","why":"Excessive and irrelevant. This would not satisfy the access and security constraints in this scenario."},{"id":"D","text":"Workspace Contributor regardless of whether item sharing is possible.","why":"Basic item Read is more targeted."}],"correct":["A"],"explanation":"SQL grants alone do not establish permission to connect to the Fabric item.","videoSeconds":901,"refs":["vref_1c5d797a849bbf18","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=901s"},{"id":"fb-v6-sec-034","sourceId":"V6-SEC-034","pack":"video06","topic":"endpoint mode debugging multiselect","title":"endpoint mode debugging multiselect","prompt":"A reviewer detects different counts for the same identity in Spark and the Lakehouse SQL endpoint. Select THREE appropriate investigation steps.","type":"multi","options":[{"id":"A","text":"Inspect OneLake role membership, DefaultReader, and any broad workspace grants.","why":"Correct. Diagnose identity, access mode, and all independent grants before modifying permissions."},{"id":"B","text":"Confirm whether SQL endpoint mode is delegated or user identity.","why":"Correct. Diagnose identity, access mode, and all independent grants before modifying permissions."},{"id":"C","text":"Disable all security to make row counts match.","why":"Creates an exposure risk rather than diagnosing differences."},{"id":"D","text":"Assume the engine with more visible rows is always authoritative.","why":"More visible data could indicate overpermission."},{"id":"E","text":"Inspect SQL-side grants or SQL RLS policies when the endpoint is in delegated mode.","why":"Correct. Diagnose identity, access mode, and all independent grants before modifying permissions."}],"correct":["A","B","E"],"explanation":"Diagnose identity, access mode, and all independent grants before modifying permissions.","videoSeconds":735,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7","vref_3444302757631152"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=735s"},{"id":"fb-v6-sec-035","sourceId":"V6-SEC-035","pack":"video06","topic":"Direct Lake on OneLake","title":"Direct Lake on OneLake","prompt":"A Direct Lake on OneLake semantic model is used for self-service reports, and the source Lakehouse has OneLake RLS. What path enforces the source row restriction for consumers querying using their identity?","type":"single","options":[{"id":"A","text":"The report-page slicer alone.","why":"Slicers are not security controls."},{"id":"B","text":"The Warehouse T-SQL predicate function, even though the model never uses a SQL endpoint.","why":"Direct Lake on OneLake reads through OneLake, not the SQL endpoint."},{"id":"C","text":"Only a workspace Admin role on the semantic model.","why":"Admins have elevated permissions and are not the mechanism to enforce restrictive data access."},{"id":"D","text":"OneLake source security roles for the effective identity, assuming supported configuration and permissions.","why":"Correct. Direct Lake on OneLake evaluates OneLake source authorization without routing through the SQL analytics endpoint."}],"correct":["D"],"explanation":"Direct Lake on OneLake evaluates OneLake source authorization without routing through the SQL analytics endpoint.","videoSeconds":716,"refs":["vref_e3759055f59bc334","vref_f4801325c6b9ca57"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=716s"},{"id":"fb-v6-sec-036","sourceId":"V6-SEC-036","pack":"video06","topic":"semantic model vs source RLS","title":"semantic model vs source RLS","prompt":"A report consumer has semantic-model RLS that restricts access to North payroll rows, but separately has broad direct ReadAll to the Lakehouse Files folder containing all regions of payroll data. What is the fundamental security flaw?","type":"single","options":[{"id":"A","text":"ReadAll is equivalent to semantic-model Build permission.","why":"These grant different capabilities."},{"id":"B","text":"Model RLS protects all independent OneLake file clients.","why":"Semantic model rules apply to queries through that model, not arbitrary direct file reads."},{"id":"C","text":"Direct file access can bypass semantic-model-only restrictions; align source data permissions and remove unnecessary broad grants.","why":"Correct. Security must cover direct data-source access, not only what report consumers see through a model."},{"id":"D","text":"Hiding Salary at report visual level would solve direct file exposure.","why":"Visual presentation does not protect data outside the model."}],"correct":["C"],"explanation":"Security must cover direct data-source access, not only what report consumers see through a model.","videoSeconds":721,"refs":["vref_6479b4656ce498ad","vref_e3759055f59bc334","vref_e8903e93a0480ba6"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=721s"},{"id":"fb-v6-sec-037","sourceId":"V6-SEC-037","pack":"video06","topic":"Direct Lake vs SQL RLS fallback","title":"Direct Lake vs SQL RLS fallback","prompt":"A Direct Lake semantic model uses a Fabric Warehouse as its source, where T-SQL RLS is configured. What performance-related security behavior should architects consider?","type":"single","options":[{"id":"A","text":"The semantic model can fall back to DirectQuery so Warehouse SQL RLS can be enforced.","why":"Correct. Understand fallback behavior when Direct Lake semantic models rely on SQL-endpoint data security."},{"id":"B","text":"Direct Lake always bypasses RLS for speed.","why":"The engine must honor security. This would not satisfy the access and security constraints in this scenario."},{"id":"C","text":"SQL RLS compiles into a static Delta folder permission without any effect on query mode.","why":"Not how SQL RLS enforcement is documented for Direct Lake on a Warehouse."},{"id":"D","text":"The RLS predicate runs only when users open SSMS.","why":"It also governs SQL queries generated by reporting clients."}],"correct":["A"],"explanation":"Understand fallback behavior when Direct Lake semantic models rely on SQL-endpoint data security.","videoSeconds":712,"refs":["vref_6b11ae50991bee99","vref_e3759055f59bc334"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=712s"},{"id":"fb-v6-sec-038","sourceId":"V6-SEC-038","pack":"video06","topic":"shortcut target enforcement","title":"shortcut target enforcement","prompt":"A user is Contributor in ConsumerWorkspace but has no permission to ProducerWorkspace's secured Lakehouse. A shortcut in the consumer lakehouse points to a producer Delta table with OneLake security. What is the correct expectation?","type":"single","options":[{"id":"A","text":"Contributor in ConsumerWorkspace automatically overrides producer restrictions.","why":"Consumer workspace elevation does not grant rights at the producer target."},{"id":"B","text":"Access through the shortcut still depends on permitted target-side access; producer OneLake security can filter or deny.","why":"Correct. The effective shortcut access is an intersection between shortcut-side and target-side effective grants."},{"id":"C","text":"All shortcuts run as the tenant Global Admin.","why":"Not the published OneLake shortcut access model."},{"id":"D","text":"A shortcut copies the entire table so the producer roles no longer apply.","why":"A shortcut references target data; it is not automatically a copy."}],"correct":["B"],"explanation":"The effective shortcut access is an intersection between shortcut-side and target-side effective grants.","videoSeconds":710,"refs":["vref_3444302757631152","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=710s"},{"id":"fb-v6-sec-039","sourceId":"V6-SEC-039","pack":"video06","topic":"authorized external engines","title":"authorized external engines","prompt":"A third-party query tool reads Delta files directly and does not support OneLake authorized-engine enforcement. A protected table has RLS/CLS rules. What is the expected security stance?","type":"single","options":[{"id":"A","text":"Fine-grained table access is blocked if the engine cannot apply the required row/column restrictions.","why":"Correct. OneLake enforces or blocks secured reads rather than exposing protected Delta bytes to unsupported external consumers."},{"id":"B","text":"SQL endpoint grants are used automatically by all external engines.","why":"SQL permissions are not universal file-access permissions."},{"id":"C","text":"RLS is silently ignored, and the tool reads all data.","why":"Unauthorized external engines are not allowed to bypass the security rules."},{"id":"D","text":"OneLake automatically converts the CSV result into a masked file.","why":"Not documented behavior. This would not satisfy the access and security constraints in this scenario."}],"correct":["A"],"explanation":"OneLake enforces or blocks secured reads rather than exposing protected Delta bytes to unsupported external consumers.","videoSeconds":719,"refs":["vref_f4801325c6b9ca57","vref_a2f1e44aa2e795c2"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=719s"},{"id":"fb-v6-sec-040","sourceId":"V6-SEC-040","pack":"video06","topic":"metadata visibility precision","title":"metadata visibility precision","prompt":"A security engineer claims that OLS guarantees an unauthorized user cannot discover even the name of any protected table or column from any error message or UI. What is the most accurate assessment?","type":"single","options":[{"id":"A","text":"True only for workspace Contributors.","why":"Contributors have broader data permissions, not a metadata secrecy guarantee."},{"id":"B","text":"False as an absolute statement: data access is protected, but some metadata may be visible, so do not equate metadata invisibility with the entire security guarantee.","why":"Correct. Treat protection of data values as distinct from universal concealment of metadata."},{"id":"C","text":"Always true; metadata is never displayed in any situation.","why":"OneLake documentation cautions that some metadata or column names may remain visible in experiences/errors."},{"id":"D","text":"False because OLS permits querying every hidden object by a fully qualified name.","why":"Knowing the name is not equivalent to access."}],"correct":["B"],"explanation":"Treat protection of data values as distinct from universal concealment of metadata.","videoSeconds":235,"refs":["vref_3444302757631152","vref_a2f1e44aa2e795c2"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=235s"},{"id":"fb-v6-sec-041","sourceId":"V6-SEC-041","pack":"video06","topic":"SQL permission change sequence","title":"SQL permission change sequence","prompt":"Analyst Mei has an explicit SQL column-level GRANT for EmployeeName and an explicit DENY for Salary on hr.Employees. Later an admin REVOKEs that explicit Salary DENY. What does REVOKE alone establish?","type":"single","options":[{"id":"A","text":"The EmployeeName GRANT is automatically revoked.","why":"REVOKE on Salary does not alter EmployeeName."},{"id":"B","text":"Mei becomes a workspace Viewer.","why":"SQL permission change does not change workspace role."},{"id":"C","text":"Salary becomes visible immediately under any circumstances.","why":"Other grants/denies must be considered."},{"id":"D","text":"The specified explicit DENY entry is removed; final access depends on remaining effective grants and denies.","why":"Correct. SQL REVOKE should be interpreted as removal of a specified rule, not a positive grant."}],"correct":["D"],"explanation":"SQL REVOKE should be interpreted as removal of a specified rule, not a positive grant.","videoSeconds":340,"refs":["vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=340s"},{"id":"fb-v6-sec-042","sourceId":"V6-SEC-042","pack":"video06","topic":"ReadAll DefaultReader audit","title":"ReadAll DefaultReader audit","prompt":"A new Lakehouse OneLake role hides Employee.Salary, but testers with item ReadAll still retrieve Salary through Spark. What should the audit examine first?","type":"single","options":[{"id":"A","text":"Whether a permissive DefaultReader role or another effective grant still exposes the column.","why":"Correct: an additional broad role can undo intended restriction."},{"id":"B","text":"Whether SELECT * contains a syntax error.","why":"The query succeeded and exposed the value."},{"id":"C","text":"Whether the analyst has Build permission on a separate Power BI semantic model.","why":"Irrelevant. This would not satisfy the access and security constraints in this scenario."},{"id":"D","text":"Whether the file uses a .parquet extension.","why":"Not sufficient to diagnose entitlement."}],"correct":["A"],"explanation":"Review aggregate grants, particularly DefaultReader and any overlapping roles, when restrictive OneLake policies appear ineffective.","videoSeconds":728,"refs":["vref_cdd807ab8eaececd","vref_3444302757631152"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=728s"},{"id":"fb-v6-sec-043","sourceId":"V6-SEC-043","pack":"video06","topic":"OneLake and SQL mode case","title":"OneLake and SQL mode case","prompt":"Choose TWO changes that make a cross-engine security design more consistent for a Lakehouse used in Spark notebooks and the SQL endpoint.","type":"multi","options":[{"id":"A","text":"Switch the SQL analytics endpoint to user identity mode after impact assessment so it honors OneLake table security.","why":"Correct. OneLake data-plane rules plus appropriate engine configuration support aligned consumer behavior."},{"id":"B","text":"Define appropriate OneLake roles with least-privilege table/row/column access.","why":"Correct. OneLake data-plane rules plus appropriate engine configuration support aligned consumer behavior."},{"id":"C","text":"Grant workspace Contributor to every report consumer.","why":"Contributor gives broad local access and undermines restrictions."},{"id":"D","text":"Leave the endpoint in delegated mode and rely solely on OneLake RLS for its SQL results.","why":"Delegated mode is SQL-native security."},{"id":"E","text":"Replace security policies with a Power BI report filter.","why":"Visual filters do not protect SQL and Spark consumers."}],"correct":["A","B"],"explanation":"OneLake data-plane rules plus appropriate engine configuration support aligned consumer behavior.","videoSeconds":737,"refs":["vref_f513e79bbf83ae3f","vref_f4801325c6b9ca57","vref_e8903e93a0480ba6"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=737s"},{"id":"fb-v6-sec-044","sourceId":"V6-SEC-044","pack":"video06","topic":"OneLake SQL RLS multiselect","title":"OneLake SQL RLS multiselect","prompt":"Select TWO statements that are accurate when contrasting SQL-native Warehouse RLS and OneLake security RLS.","type":"multi","options":[{"id":"A","text":"OneLake RLS supports arbitrary dynamic joins to multiple identity-mapping tables.","why":"OneLake expression syntax is restricted."},{"id":"B","text":"OneLake RLS can be defined on any arbitrary CSV file inside Files.","why":"RLS targets supported tabular Delta tables, not files."},{"id":"C","text":"SQL-native DENY is an intrinsic OneLake role type.","why":"OneLake supports grant-only roles."},{"id":"D","text":"Warehouse RLS can use an inline TVF and a CREATE SECURITY POLICY binding.","why":"Correct. The systems have distinct authoring APIs and combine permissions differently."},{"id":"E","text":"OneLake roles generally resolve grants across roles by union, so broad role membership requires auditing.","why":"Correct. The systems have distinct authoring APIs and combine permissions differently."}],"correct":["D","E"],"explanation":"The systems have distinct authoring APIs and combine permissions differently.","videoSeconds":736,"refs":["vref_6b11ae50991bee99","vref_3444302757631152","vref_2a5406b70b6993d7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=736s"},{"id":"fb-v6-sec-045","sourceId":"V6-SEC-045","pack":"video06","topic":"role hierarchy vs data plane","title":"role hierarchy vs data plane","prompt":"Security architects plan to add all analysts to workspace Contributor but then create a restrictive OneLake Read role per analyst. What is wrong with the proposal?","type":"single","options":[{"id":"A","text":"OneLake security roles cannot include Microsoft Entra identities.","why":"They can. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"Contributor already has broad local workspace data rights, so a restrictive OneLake grant generally cannot subtract that inherited access.","why":"Correct. Use item Read/Viewer consumers with OneLake scoped roles; reserve Contributor for users needing broad development rights."},{"id":"C","text":"Contributor cannot execute notebooks.","why":"Contributors commonly can develop in workspace."},{"id":"D","text":"RLS always supersedes every workspace role.","why":"OneLake roles generally govern read-only consumers and are grant-only."}],"correct":["B"],"explanation":"Use item Read/Viewer consumers with OneLake scoped roles; reserve Contributor for users needing broad development rights.","videoSeconds":689,"refs":["vref_1c21e6dbc4aac4ca","vref_3444302757631152"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=689s"},{"id":"fb-v6-sec-046","sourceId":"V6-SEC-046","pack":"video06","topic":"separate security layers","title":"separate security layers","prompt":"A semantic-model designer creates a DAX role limiting data to the East region. An external ETL identity has broad SQL SELECT on the Warehouse and queries it directly. Which controls govern the ETL query?","type":"single","options":[{"id":"A","text":"OneLake's DefaultReader role automatically deletes disallowed SQL rows.","why":"No such behavior. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"The Power BI page filter.","why":"Irrelevant to direct ETL SQL queries."},{"id":"C","text":"DAX semantic-model RLS, because it applies tenant-wide.","why":"Semantic-model RLS applies to model queries, not arbitrary SQL clients."},{"id":"D","text":"Warehouse SQL item and SQL-native permissions/policies, not model RLS unless the query traverses the model.","why":"Correct. Model-level security and engine/source-layer security are not interchangeable."}],"correct":["D"],"explanation":"Model-level security and engine/source-layer security are not interchangeable.","videoSeconds":731,"refs":["vref_6479b4656ce498ad","vref_3c187dcb2c20c658","vref_e3759055f59bc334"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=731s"},{"id":"fb-v6-sec-047","sourceId":"V6-SEC-047","pack":"video06","topic":"security regression test matrix","title":"security regression test matrix","prompt":"Select THREE tests that best validate a new access-control deployment for restricted Lakehouse Delta tables.","type":"multi","options":[{"id":"A","text":"Test as the same Viewer on the SQL endpoint and confirm the active endpoint access mode.","why":"Correct. Use positive and negative tests with target identities across all permitted paths, not only privileged admin accounts."},{"id":"B","text":"Test only as workspace Admin; admin success proves restricted users are safe.","why":"Admins may not experience consumer restrictions."},{"id":"C","text":"Test source access through relevant shortcuts and semantic model connections.","why":"Correct: detects alternate paths."},{"id":"D","text":"Test as a real Viewer in Spark, confirming both rows and sensitive columns.","why":"Correct: tests OneLake enforcement in Spark."},{"id":"E","text":"Only inspect the configuration screen; no negative-access tests are needed.","why":"A configuration does not prove effective permissions."}],"correct":["A","C","D"],"explanation":"Use positive and negative tests with target identities across all permitted paths, not only privileged admin accounts.","videoSeconds":830,"refs":["vref_f4801325c6b9ca57","vref_f513e79bbf83ae3f","vref_3444302757631152"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=830s"},{"id":"fb-v6-sec-048","sourceId":"V6-SEC-048","pack":"video06","topic":"mixing source and model protections","title":"mixing source and model protections","prompt":"A model serves external report consumers through a fixed-identity connection, and report users have no direct Warehouse permissions. The goal is report-only dynamic region filtering. Which choice is most appropriate?","type":"single","options":[{"id":"A","text":"Use only page-level slicers without any RLS.","why":"Presentation filters are not security."},{"id":"B","text":"Apply semantic-model RLS for report access and keep report users without broad direct source grants.","why":"Correct for a report-only consumer design using the model security boundary."},{"id":"C","text":"Switch every report user to Contributor so DAX roles are enforced.","why":"Semantic-model Write permissions can bypass model RLS."},{"id":"D","text":"Give every report consumer direct Warehouse item ReadAll to activate DAX RLS.","why":"Broad source access is unnecessary and potentially unsafe."}],"correct":["B"],"explanation":"Model RLS is valid within the model access boundary when users do not have an independent source path.","videoSeconds":720,"refs":["vref_e3759055f59bc334","vref_e8903e93a0480ba6"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=720s"},{"id":"fb-v6-sec-049","sourceId":"V6-SEC-049","pack":"video06","topic":"operational controls","title":"operational controls","prompt":"A team must stop a contractor reading salary immediately. They have item Read, OneLake Read through multiple group roles, and a SQL endpoint in user identity mode. What is the robust action?","type":"single","options":[{"id":"A","text":"Add a narrower role but keep the broad roles.","why":"Grant-only union can leave broad access intact."},{"id":"B","text":"Remove all effective OneLake grants that expose Salary, audit group memberships and item permissions, and retest both SQL and Spark using the contractor identity.","why":"Correct. Access reviews must look at effective grants from all groups and surfaces."},{"id":"C","text":"Remove the salary column from a Power BI visual.","why":"Does not stop independent data reads."},{"id":"D","text":"REVOKE SELECT on the salary SQL table, leaving OneLake roles untouched.","why":"SQL table grants are not authoritative in user identity mode."}],"correct":["B"],"explanation":"Access reviews must look at effective grants from all groups and surfaces.","videoSeconds":852,"refs":["vref_3444302757631152","vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=852s"},{"id":"fb-v6-sec-050","sourceId":"V6-SEC-050","pack":"video06","topic":"privacy and permissions","title":"privacy and permissions","prompt":"Select TWO designs that minimize the chance that a team member with only reporting responsibilities can circumvent protection of sensitive payroll information.","type":"multi","options":[{"id":"A","text":"Grant ReadAll on the Lakehouse to everyone to simplify administration.","why":"Broad grants increase exposure. This would not satisfy the access and security constraints in this scenario."},{"id":"B","text":"Avoid unnecessary Contributor/Member access to the source workspace.","why":"Correct: elevated roles typically have broad local access."},{"id":"C","text":"Use a viewer role but share unprotected CSV copies of the same data in Files.","why":"Unprotected duplicate files defeat the policy."},{"id":"D","text":"Assume a DAX measure showing blank Salary prevents raw data reads in SQL.","why":"A DAX expression is not a SQL access policy."},{"id":"E","text":"Use source-level protection appropriate to the data engine and test other independent access paths.","why":"Correct. Least privilege is applied end-to-end; avoid overprivileged workspace memberships and alternative unprotected copies."}],"correct":["B","E"],"explanation":"Least privilege is applied end-to-end; avoid overprivileged workspace memberships and alternative unprotected copies.","videoSeconds":596,"refs":["vref_e8903e93a0480ba6","vref_3444302757631152","vref_6479b4656ce498ad"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data","provenance":"source-video plus current Microsoft Learn; original question not copied from exam","validation":"documentation-backed; not executed in live Fabric workspace","sourceVideoUrl":"https://www.youtube.com/watch?v=mw2cWlroGOk&t=596s"}]
