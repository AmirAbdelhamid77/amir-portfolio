[{"id":"fb-e01","sourceId":"E01","pack":"eventhouse","topic":"Store selection","title":"Select an operational analytics store","prompt":"A manufacturer receives JSON sensor events continuously. Analysts need time-window aggregation and free-text fault investigation over the arriving stream. They do not need relational multi-table transactions. Which primary store best matches this workload?","type":"single","options":[{"id":"A","text":"A Warehouse that parses JSON into relational tables and serves the investigations through T-SQL.","why":"This adds a relational preparation layer, while the main requirement favors native time-based event and free-text exploration."},{"id":"B","text":"An Eventhouse KQL database with continuous ingestion and KQL queries.","why":"The workload combines event ingestion, time-based exploration, and semistructured and text analysis."},{"id":"C","text":"A Lakehouse with custom Spark streaming preparation and Spark jobs for each interactive fault investigation.","why":"This can process streams, but custom preparation and job-based investigation are a less direct fit than the dedicated event analysis engine."},{"id":"D","text":"A Power BI import model refreshed frequently from a separate ingestion landing store.","why":"This adds a reporting refresh boundary and still needs a primary event store for the requested raw-log investigations."}],"correct":["B"],"explanation":"Choose the engine and ingestion pattern from the latency and analysis requirements. Validate capacity and measured latency rather than assuming a universal events-per-second guarantee.","videoSeconds":64,"refs":["eoverview","estore"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e02","sourceId":"E02","pack":"eventhouse","topic":"Store selection","title":"Separate workloads by their requirements","prompt":"One team investigates telemetry with KQL. Another prepares relational sales facts and dimensions with T-SQL and must commit changes to several tables in one transaction. Which architecture best respects both requirements?","type":"single","options":[{"id":"A","text":"Keep telemetry in Eventhouse and prepare the transactional relational sales model in Warehouse.","why":"Each preparation workload uses an engine aligned with its query and transaction requirements."},{"id":"B","text":"Move both workloads to a KQL database because its SQL compatibility guarantees Warehouse transaction semantics.","why":"SQL query compatibility does not supply the required relational write and transaction surface."},{"id":"C","text":"Prepare both in a Lakehouse SQL analytics endpoint and write its fact and dimension tables with one T-SQL transaction.","why":"The Lakehouse SQL analytics endpoint does not offer the required T-SQL table-write surface."},{"id":"D","text":"Store sales in KQL tables and use separate ingestion commands for each related table without transaction coordination.","why":"Independent ingestion operations do not establish the required atomic relational write boundary."}],"correct":["A"],"explanation":"A Fabric solution can use multiple stores. KQL support for querying data does not make Eventhouse interchangeable with Warehouse for relational preparation.","videoSeconds":246,"refs":["estore","ewarehousesurface"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e03","sourceId":"E03","pack":"eventhouse","topic":"Store selection","title":"Retain event history deliberately","prompt":"A telemetry team needs interactive KQL investigation of five years of events. It has provisioned and tested sufficient capacity. An architect claims Eventhouse cannot retain more than a few weeks, so migration is mandatory. What is the correct next step?","type":"single","options":[{"id":"A","text":"Reduce retention to 30 days and rely on the hot cache to preserve the other years.","why":"A cache policy cannot preserve records after the retained source data is removed."},{"id":"B","text":"Keep 30 days in KQL and archive the rest as files without providing an interactive historical query path.","why":"An archive can preserve data, but this plan does not meet the required five-year interactive KQL investigation."},{"id":"C","text":"Validate a suitable long retention policy, query patterns, and cost; do not infer a fixed short-term limit.","why":"The video's typical short-retention scenario is not a hard restriction on configurable event history."},{"id":"D","text":"Leave retention unspecified and treat historical availability as independent of all future policy changes.","why":"Historical availability still depends on effective retention policies and their later changes."}],"correct":["C"],"explanation":"Short operational retention is a design choice. Specify and verify retention to meet the actual historical requirement.","videoSeconds":269,"refs":["eretention","eoverview"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e04","sourceId":"E04","pack":"eventhouse","topic":"Objects and shortcuts","title":"Share management across databases","prompt":"A workspace needs separate KQL databases for device events and service logs, with unified resource and ingestion monitoring for both. Which arrangement provides the required grouping?","type":"single","options":[{"id":"A","text":"Create one Eventhouse for each database and monitor resource usage separately in each.","why":"This preserves separate databases but omits the requested unified Eventhouse management grouping."},{"id":"B","text":"Create one KQL database with separate event and log tables and monitor that database.","why":"Separate tables do not satisfy the requirement for separate KQL databases."},{"id":"C","text":"Connect queryset tabs to two databases in separate Eventhouses and use the tabs as shared resource monitoring.","why":"Saved analysis tabs do not supply the requested unified Eventhouse resource and ingestion management."},{"id":"D","text":"Create the two KQL databases within an Eventhouse and monitor them at Eventhouse level.","why":"An Eventhouse groups databases and exposes their shared management and resource information."}],"correct":["D"],"explanation":"The grouping has operational value beyond a folder analogy: databases can share capacity and be monitored together.","videoSeconds":813,"refs":["eoverview"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e05","sourceId":"E05","pack":"eventhouse","topic":"Objects and shortcuts","title":"Choose reusable logic versus persisted results","prompt":"An analyst needs a saved parameterized query that accepts PageName and computes results when called. There is no requirement to store or incrementally maintain its output. Which object should hold this logic?","type":"single","options":[{"id":"A","text":"A materialized view with a runtime PageName parameter.","why":"A materialized view maintains a fixed aggregation definition rather than accepting this runtime parameter."},{"id":"B","text":"A stored KQL function with a PageName parameter.","why":"A function encapsulates reusable query logic and accepts the requested argument."},{"id":"C","text":"A queryset with the page value hardcoded separately in each saved query.","why":"Duplicated page-specific text does not supply the requested single parameterized callable definition."},{"id":"D","text":"A materialized daily total without Page, followed by a caller-specific page filter.","why":"Once Page is discarded by the aggregate, the caller cannot recover the requested page-specific counts."}],"correct":["B"],"explanation":"A stored function reuses logic. Saving it does not itself materialize or cache its query output.","videoSeconds":1520,"refs":["estoredfunction"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e06","sourceId":"E06","pack":"eventhouse","topic":"Objects and shortcuts","title":"Reference external dimension data","prompt":"Device telemetry is already ingested into a KQL table. Device metadata is maintained as a Delta table in a Lakehouse. The team wants to reference that metadata from KQL without creating a separately maintained ingested copy. Which plan fits?","type":"single","options":[{"id":"A","text":"Create a OneLake shortcut in the KQL database and query its external table reference.","why":"This exposes the maintained Delta data without requiring a second ingestion pipeline for the metadata."},{"id":"B","text":"Enable OneLake availability on telemetry and assume the Lakehouse metadata is automatically imported.","why":"OneLake availability exposes KQL data outward; it does not automatically import this reference table."},{"id":"C","text":"Create a materialized view directly over external_table('DeviceMetadata') as its fact source.","why":"The external reference is not a supported fact source for that materialized-view definition."},{"id":"D","text":"Copy the metadata into a KQL table nightly and call that copy a shortcut.","why":"A separate ingested copy needs maintenance and does not implement the requested reference approach."}],"correct":["A"],"explanation":"Distinguish referencing another store from exposing Eventhouse data in OneLake. A shortcut does not make the external source into an ordinary writable local table.","videoSeconds":404,"refs":["eshortcut","emvcreate"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e07","sourceId":"E07","pack":"eventhouse","topic":"Objects and shortcuts","title":"Use a database shortcut within its boundaries","prompt":"An analytics team consumes an existing Azure Data Explorer database through a Fabric database shortcut. It needs a different hot-cache window and also proposes to delete unwanted source rows through the shortcut. Select TWO correct conclusions.","type":"multi","options":[{"id":"A","text":"The consumer can set its cache policy for the shortcut.","why":"Caching is one of the settings a database-shortcut consumer can control."},{"id":"B","text":"The consumer can delete source rows because the shortcut is in its own workspace.","why":"Workspace placement does not make the source-owning database writable through this read-only reference."},{"id":"C","text":"The consumer must ingest a complete independent database copy before querying any source rows.","why":"The shortcut reads the shared source storage without requiring that duplicate ingestion."},{"id":"D","text":"Source data changes must be made through an authorized write path to the source, not through this read-only shortcut.","why":"The source owns its stored data; the database shortcut is a read-only consumer."}],"correct":["A","D"],"explanation":"A database shortcut is distinct from a OneLake table shortcut. Its read-only mode permits specific consumer settings but not source-row modification.","videoSeconds":404,"refs":["efollower"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e08","sourceId":"E08","pack":"eventhouse","topic":"Retention and caching","title":"Preserve queryability while reducing hot storage","prompt":"A KQL table must retain 90 days. Almost all interactive queries scan the most recent seven days; older retained events are investigated occasionally, and slower access is acceptable. Which configuration best aligns with those requirements?","type":"single","options":[{"id":"A","text":"Retention 7 days; hot cache 90 days.","why":"A long hot-cache setting cannot compensate for insufficient retained history."},{"id":"B","text":"Retention 90 days; hot cache 90 days because older events cannot be queried without SSD residency.","why":"Retained cold data remains queryable, so keeping everything hot is unnecessary for the stated access pattern."},{"id":"C","text":"Retention 90 days; hot cache 7 days, with full-data scope for older investigations.","why":"The retained window satisfies history while the hot window targets frequent queries."},{"id":"D","text":"Retention 7 days; hot cache 7 days, plus a view that stores no aggregates for older events.","why":"Neither this retained source nor the described view preserves the required older investigation data."}],"correct":["C"],"explanation":"Retention determines retained queryable data. Hot caching targets faster access to a subset and does not itself delete older retained events.","videoSeconds":434,"refs":["ecache","eretention"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e09","sourceId":"E09","pack":"eventhouse","topic":"Retention and caching","title":"Diagnose a missing older result","prompt":"A table retains 60 days and has a hot-cache window of three days. A query using 'T datascope=hotcache' returns no rows for a known event ingested 20 days ago. A normal full-scope query still returns that event. Which conclusion follows?","type":"single","options":[{"id":"A","text":"Treat the hot-cache result as permanent loss and re-ingest the event before trusting the full-scope result.","why":"The full-scope read already demonstrates that the event is retained; re-ingestion can introduce a duplicate."},{"id":"B","text":"The hot-cache scope excludes older retained data; use full scope for that investigation.","why":"The result difference is explained by the deliberately restricted data scope."},{"id":"C","text":"Increase retention from 60 to 90 days to bring the event into the existing three-day hot window.","why":"The event is already retained; extending retention does not change its hot-cache eligibility."},{"id":"D","text":"Enable backfill on every materialized view to restore the missing raw table event.","why":"The raw event is present; this query-scope problem is unrelated to materialized-view history selection."}],"correct":["B"],"explanation":"No rows in a hot-cache-only query does not prove absence from the retained table. Check scope before changing ingestion or retention.","videoSeconds":1001,"refs":["ecache"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e10","sourceId":"E10","pack":"eventhouse","topic":"Retention and caching","title":"Distinguish eligibility from a deletion deadline","prompt":"A compliance requirement says records must be inaccessible exactly 30 days after their business EventTime. An engineer sets SoftDeletePeriod=30d and claims the requirement is satisfied. What must be corrected?","type":"single","options":[{"id":"A","text":"Hot caching should also be 30 days because eviction establishes the exact business-time deletion deadline.","why":"Cache eviction concerns performance and does not establish source-record removal."},{"id":"B","text":"Enable recoverability so the required deadline is enforced by the recovery window.","why":"Recovery settings do not convert retention into an exact event-time deletion schedule."},{"id":"C","text":"Keep the policy unchanged because soft-delete retention deletes each row precisely at its EventTime plus 30 days.","why":"Retention does not provide that exact event-column deadline or immediate deletion guarantee."},{"id":"D","text":"Design and verify an explicit removal process; retention is normally ingestion-age based and deletion timing is imprecise.","why":"The requested event-time cutoff and precise inaccessibility need controls beyond this policy alone."}],"correct":["D"],"explanation":"Retention guarantees availability within its window; exceeding it makes data eligible for removal. It is not a precise business-event deadline.","videoSeconds":434,"refs":["eretention"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e11","sourceId":"E11","pack":"eventhouse","topic":"Materialized views","title":"Preserve the needed aggregate grain","prompt":"A website dashboard needs visit counts by Page and UTC day. Several pages have visits on the same day. Which materialized aggregation preserves exactly the requested breakdown?","type":"single","options":[{"id":"A","text":"Visits | summarize VisitCount=count() by Page, VisitDay=bin(VisitTime, 1d)","why":"Both required grouping keys are retained, with a count at page-day grain."},{"id":"B","text":"Visits | summarize VisitCount=count() by VisitDay=bin(VisitTime, 1d)","why":"Collapsing Page loses the per-page breakdown and it cannot be reconstructed from that count."},{"id":"C","text":"Visits | summarize VisitCount=count() by Page","why":"Collapsing the date key loses the required daily breakdown."},{"id":"D","text":"Visits | summarize VisitCount=count() by VisitId, Page, VisitDay=bin(VisitTime, 1d)","why":"Adding the unique visit identifier preserves individual-visit groups rather than the requested page-day aggregate."}],"correct":["A"],"explanation":"Choose the materialized grain from the downstream query. Aggregation discards detail that is absent from its group keys.","videoSeconds":1334,"refs":["emvcreate"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e12","sourceId":"E12","pack":"eventhouse","topic":"Materialized views","title":"Separate a stored aggregate from display logic","prompt":"The proposed materialized-view query is shown below. The team wants the 20 highest-volume days at query time while retaining the daily aggregate for every day. Which revision is appropriate?","type":"single","options":[{"id":"A","text":"Move top 20 before summarize, so only 20 source visits feed the stored view.","why":"This limits input events, corrupting the daily counts rather than limiting displayed aggregate rows."},{"id":"B","text":"Replace top 20 with take 20 after summarize in the stored definition.","why":"Post-aggregation truncation still loses the required retained daily groups and violates the final-summarize rule."},{"id":"C","text":"End the stored definition at summarize; apply top 20 by VisitCount desc when querying the view.","why":"The view retains the full daily grain, while the consumer applies the requested display selection."},{"id":"D","text":"Keep top 20 in the definition and add docString to make the final operator supported.","why":"Documentation metadata does not change materialized-view query restrictions."}],"correct":["C"],"explanation":"Keep the materialized definition as a supported aggregation. Sorting and selecting the displayed results belong in the consuming query.","videoSeconds":497,"refs":["emvcreate"],"code":"Visits\n| summarize VisitCount=count() by Day=bin(VisitTime, 1d)\n| top 20 by VisitCount desc","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e13","sourceId":"E13","pack":"eventhouse","topic":"Materialized views","title":"Compute a ratio without losing its components","prompt":"A dashboard needs total error count divided by total request count for any selected set of services. The materialized definition must support later regrouping. Which design avoids an invalid composite aggregate and an incorrect average of service rates?","type":"single","options":[{"id":"A","text":"Store average(ErrorCount/RequestCount) by Service and sum the stored rates across services.","why":"Averages of per-record rates and sums of service rates do not produce the combined ratio."},{"id":"B","text":"Store sum(ErrorCount) and sum(RequestCount) by Service, then divide their selected totals at query time.","why":"Separate additive components permit the correct ratio after the selected services are combined."},{"id":"C","text":"Store sum(ErrorCount)/sum(RequestCount) directly inside the materialized summarize and then average it across services.","why":"The composite definition is unsupported and unweighted service-rate averaging also gives the wrong combined rate."},{"id":"D","text":"Store only RequestCount by Service and recover ErrorCount from the requested percentage.","why":"The missing error numerator cannot be recovered from request totals alone."}],"correct":["B"],"explanation":"Retain numerators and denominators separately. Define zero-denominator behavior in the consumer rather than using an unweighted mean of stored rates.","videoSeconds":497,"refs":["emvcreate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e14","sourceId":"E14","pack":"eventhouse","topic":"Materialized views","title":"Evaluate materialization under load","prompt":"An Eventhouse is already CPU-constrained. A proposal creates 50 materialized views, most queried once monthly, to solve dashboard latency. Which action should precede this rollout?","type":"single","options":[{"id":"A","text":"Approve all views based only on reduced per-query dashboard duration, without measuring background maintenance.","why":"A faster individual consumer query can still leave the complete workload more resource constrained."},{"id":"B","text":"Approve all views and reduce raw retention to one day without checking drill-through requirements.","why":"This risks losing needed detail and does not establish that background maintenance fits capacity."},{"id":"C","text":"Deploy all 50 views first, then choose the retained set only from consumer query duration without measuring usage frequency.","why":"This postpones capacity validation and omits maintenance cost and reuse, both central to the proposed constrained rollout."},{"id":"D","text":"Prioritize frequently reused aggregates and test their maintenance and query benefits against available capacity.","why":"Measured reuse and maintenance load determine whether materialization improves the complete workload."}],"correct":["D"],"explanation":"Materialization trades storage and background compute for reused query work. It can worsen a constrained system when deployed indiscriminately.","videoSeconds":497,"refs":["emvoverview"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e15","sourceId":"E15","pack":"eventhouse","topic":"Backfill and readiness","title":"Interpret history selection using ingestion time","prompt":"At June 10, a view is created with backfill=true and effectiveDateTime=datetime(2026-06-01). Client-reported EventTime may be ahead of server time because of clock skew; the stored timestamps must not be silently corrected. All required source input is in hot cache. Before creation the source contains R1: EventTime May 20, ingested June 3; R2: EventTime June 3, ingested May 25; R3: EventTime June 5, ingested June 6. There is no event-time filter in the definition. Which existing rows enter backfill?","type":"single","options":[{"id":"A","text":"R1 and R3.","why":"Their ingestion times are after the cutoff, irrespective of their EventTime values."},{"id":"B","text":"R2 and R3.","why":"This follows the event column, but effectiveDateTime controls ingestion-time selection."},{"id":"C","text":"R3 only.","why":"R1's older business timestamp does not exclude it from this ingestion-time backfill."},{"id":"D","text":"R1, R2, and R3.","why":"R2 was ingested before the specified cutoff and is outside the selected historical input."}],"correct":["A"],"explanation":"effectiveDateTime restricts existing input by ingestion time. This intentionally differs from a filter on a business timestamp.","videoSeconds":549,"refs":["emvcreate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e16","sourceId":"E16","pack":"eventhouse","topic":"Backfill and readiness","title":"Include all retained input but filter business time","prompt":"An existing Visits table contains late uploads and client timestamps that may be ahead of server time. All retained input needed by the backfill is available in hot cache. A new view must include every retained visit whose stored VisitTime is June 1 or later, even if it was ingested before June 1. Which creation plan matches the requirement?","type":"single","options":[{"id":"A","text":"Set effectiveDateTime to June 1 and omit a VisitTime predicate.","why":"That restricts ingestion time and admits older events while potentially excluding required existing rows."},{"id":"B","text":"Omit backfill and use where VisitTime >= datetime(2026-06-01) in the definition.","why":"The predicate cannot make precreation input appear when historical backfill is disabled."},{"id":"C","text":"Use async with backfill=true, omit effectiveDateTime, and filter VisitTime >= datetime(2026-06-01) before summarize.","why":"All retained input is considered for backfill, and the fixed event-time filter expresses the required business boundary."},{"id":"D","text":"Set effectiveDateTime to June 1 and add VisitTime >= June 1, assuming this broadens the selected input.","why":"The additional filter cannot restore rows already excluded by the ingestion-time cutoff."}],"correct":["C"],"explanation":"A fixed event-time condition and a backfill selection solve different problems. Avoid adding an unintended ingestion cutoff.","videoSeconds":1380,"refs":["emvcreate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e17","sourceId":"E17","pack":"eventhouse","topic":"Backfill and readiness","title":"Gate deployment on backfill readiness","prompt":"A deployment creates a new view over a large retained table with backfill=true. Its approved definition is ready. Policy requires historical validation of the completed new view before consumers switch. Arrange the four deployment actions in dependency order.","type":"sequence","options":[{"id":"A","text":"Monitor the returned operation identifier until backfill completes successfully.","why":"Monitoring this creation requires the operation identifier produced by submitting it."},{"id":"B","text":"Route the dashboard to the validated new view.","why":"The policy permits consumer cutover only after the completed view passes validation."},{"id":"C","text":"Submit the async materialized-view creation and capture its operation identifier.","why":"Backfilled creation must be submitted first with async and yields the identifier needed by monitoring."},{"id":"D","text":"Query the completed new view and verify the historical aggregates against the validation baseline.","why":"Backfilled views are not queryable until creation completes; validation must precede dashboard cutover."}],"correct":["C","A","D","B"],"explanation":"Current documentation requires async for backfilled creation and states that querying waits for completed backfill. Submission, successful completion, validation, and cutover have strict dependencies here.","videoSeconds":575,"refs":["emvcreate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e18","sourceId":"E18","pack":"eventhouse","topic":"Backfill and readiness","title":"Account for newly ingested late events","prompt":"A count-per-event-day view was created on June 10 with default backfill=false. The source already contained 100 rows from June 1. On June 11, two more rows are ingested with EventTime June 1. A direct query of the functioning view occurs after this ingestion is visible. What is its June 1 count?","type":"single","options":[{"id":"A","text":"102 because the new rows trigger automatic backfill of every older row for their event day.","why":"A matching group key does not retroactively admit all precreation source rows."},{"id":"B","text":"0 because a no-backfill view rejects any row whose business timestamp predates creation.","why":"No-backfill governs ingestion relative to creation, not the value of the business-time column."},{"id":"C","text":"100 because only the precreation records are used to seed the daily count.","why":"Those historical records are precisely the input omitted by default no-backfill creation."},{"id":"D","text":"2 because only the newly ingested rows contribute to that older event-day group.","why":"Both late events arrive after creation, while the 100 historical source rows remain excluded."}],"correct":["D"],"explanation":"No-backfill is not an event-date cutoff. New late arrivals can create or update old event-time groups without importing the old source history.","videoSeconds":1295,"refs":["emvcreate"],"code":"","origin":"video","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e19","sourceId":"E19","pack":"eventhouse","topic":"Materialized views","title":"Combine the materialized part and delta correctly","prompt":"A healthy count view has a materialized count of 120 for one page-day. Its source delta contains 7 newly ingested visits for that same page-day, all visible to queries and not yet materialized. No other rows or filters exist. A user runs the view name directly. Which result is expected?","type":"single","options":[{"id":"A","text":"127, because the direct view query combines the stored aggregate with the unmaterialized input.","why":"The direct query accounts for the seven visible source visits in addition to the stored count."},{"id":"B","text":"120, because direct queries can only read the stored aggregate.","why":"That describes a materialized-part-only access path rather than direct full-view semantics."},{"id":"C","text":"7, because the direct name bypasses the stored portion and returns only the latest delta.","why":"Direct view queries include both portions, not just newly arrived records."},{"id":"D","text":"134, because the source delta is counted once by the view and again by its stored part.","why":"The seven rows have not been materialized, so they are not already present in the stored count."}],"correct":["A"],"explanation":"For input included in the view, direct-name queries incorporate visible unmaterialized records. Background lag does not itself imply stale direct-query results.","videoSeconds":1490,"refs":["emvoverview"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e20","sourceId":"E20","pack":"eventhouse","topic":"Materialized views","title":"Evaluate max_age as a fallback policy","prompt":"A dashboard calls materialized_view('DailyVisits', 5m). At query time, the last materialization was 12 minutes ago. New source rows are visible but remain in the delta. What does this call do?","type":"single","options":[{"id":"A","text":"Return only rows whose business EventTime is within the last five minutes.","why":"max_age measures materialization freshness, not an event-time row filter."},{"id":"B","text":"Fail because the materialized part is older than five minutes.","why":"The function provides a full-view fallback rather than rejecting the query for this reason."},{"id":"C","text":"Return the full view, combining materialized data and delta because materialization is too old.","why":"An expired freshness threshold switches this call to the same semantics as querying the view name."},{"id":"D","text":"Return only the stale materialized part and suppress the delta to meet the five-minute target.","why":"Omitting the delta when the part is too old contradicts the specified fallback behavior."}],"correct":["C"],"explanation":"max_age trades performance for freshness by selecting the materialized part only when it is recent enough; otherwise the full view is evaluated.","videoSeconds":1490,"refs":["emvfunction"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e21","sourceId":"E21","pack":"eventhouse","topic":"KQL query reasoning","title":"Extract a numeric JSON measure","prompt":"Telemetry.Payload is a string such as {\"metrics\":{\"temperature\":\"21.5\"},\"device\":\"D1\"}. All payloads have this shape and numeric text is valid. You need mean temperature by device as a numeric result. Which query fragment correctly prepares the columns?","type":"single","options":[{"id":"A","text":"extend p=parse_json(Payload) | extend Device=tostring(p.device), Temp=todouble(p.metrics.temperature) | summarize MeanTemp=avg(Temp) by Device","why":"Parsing the bag and casting its selected values gives a string group key and a numeric aggregate input."},{"id":"B","text":"extend p=parse_json(Payload) | extend Device=tostring(p.device), Temp=tostring(p.metrics.temperature) | summarize MeanTemp=avg(Temp) by Device","why":"The temperature remains a string and does not supply the numeric input required for avg."},{"id":"C","text":"extend p=parse_json(Payload) | extend Device=tostring(p.device), Temp=todouble(p.temperature) | summarize MeanTemp=avg(Temp) by Device","why":"The temperature is nested below metrics; accessing the nonexistent top-level property loses the value."},{"id":"D","text":"extend Device=Payload, Temp=todouble(Payload) | summarize MeanTemp=avg(Temp) by Device","why":"The entire JSON document is neither the device key nor a numeric temperature scalar."}],"correct":["A"],"explanation":"JSON extraction and type conversion are separate steps. A property read from a dynamic bag should be cast to the type needed by the next operator.","videoSeconds":90,"refs":["eqjson","eqdynamic","eqsum"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e22","sourceId":"E22","pack":"eventhouse","topic":"KQL query reasoning","title":"Preserve page-filter semantics","prompt":"Visits has Page:string and VisitTime:datetime. A daily function must return counts only for the caller's pageName. You inherit the fragment shown below. Which change meets the requirement without counting other pages?","type":"single","options":[{"id":"A","text":"Keep the query and replace Visits with a materialized view grouped only by VisitDay.","why":"A daily total without Page has already lost the page breakdown, so the requested filter cannot be recovered."},{"id":"B","text":"Move where Page == pageName before summarize, then group by bin(VisitTime,1d).","why":"Filtering source rows first preserves the requested page-specific count."},{"id":"C","text":"Move where Page == pageName after project VisitDay, VisitCount.","why":"The projected result still has no Page column and cannot evaluate the requested filter."},{"id":"D","text":"Replace the predicate with where VisitCount > 0 after summarize.","why":"This retains days with any visits; it does not restrict visits to the caller's page."}],"correct":["B"],"explanation":"An aggregation keeps its group keys and aggregate outputs. A filter on a discarded detail column must occur earlier, or that column must be retained as a group key.","videoSeconds":1540,"refs":["eqsum","eqbest"],"code":"Visits\n| summarize VisitCount=count() by VisitDay=bin(VisitTime,1d)\n| where Page == pageName","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e23","sourceId":"E23","pack":"eventhouse","topic":"KQL query reasoning","title":"Count events rather than deliveries","prompt":"A web collector can deliver VisitId more than once. All copies have the same Page and VisitTime. You need an exact count of distinct visits by Page and UTC day, using only summarize and count, without approximate cardinality. Which fragment is correct?","type":"single","options":[{"id":"A","text":"summarize Visits=count() by Page, Day=bin(VisitTime,1d)","why":"This counts every delivery, including repeated VisitId copies."},{"id":"B","text":"summarize by VisitId | summarize Visits=count() by Page, Day=bin(VisitTime,1d)","why":"The first summarize discards Page and VisitTime, so the second cannot group by them."},{"id":"C","text":"summarize by Page, Day=bin(VisitTime,1d), VisitId | summarize Visits=count() by Page, Day","why":"The first stage produces one row per visit in its page/day group; the second counts those rows exactly."},{"id":"D","text":"summarize by Page, Day=bin(VisitTime,1d) | summarize Visits=count() by Page, Day","why":"This collapses all visits within each page/day to one row, making each nonempty group's count one."}],"correct":["C"],"explanation":"Deduplicate at the business event grain while retaining the required reporting keys, then count. Count of delivery rows and count of distinct business events answer different questions.","videoSeconds":1334,"refs":["eqsum"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e24","sourceId":"E24","pack":"eventhouse","topic":"KQL query reasoning","title":"Place events at UTC boundaries","prompt":"The query shown processes four unique events with VisitTime values 2026-05-01 23:59:59Z, May 2 00:00:00Z, May 2 23:59:59Z, and May 3 00:00:00Z. All four are ingested on May 3. What rows does it return?","type":"single","options":[{"id":"A","text":"May 1: 1; May 2: 2; May 3: 1.","why":"The grouping uses the event timestamp rounded down to each UTC day boundary."},{"id":"B","text":"May 1: 2; May 2: 2; no May 3 row.","why":"This incorrectly treats exact midnight as belonging to the previous day."},{"id":"C","text":"May 3: 4; no May 1 or May 2 rows.","why":"This groups by ingestion day instead of the VisitTime expression in the query."},{"id":"D","text":"Four rows with counts of 1 at the original timestamps.","why":"The explicit one-day bin merges the two May 2 timestamps into one group."}],"correct":["A"],"explanation":"KQL datetime values use UTC. bin(VisitTime,1d) creates day groups from source event time, independently of when the rows arrived.","videoSeconds":1334,"refs":["eqbin","eqtime"],"code":"Visits\n| summarize Visits=count() by Day=bin(VisitTime,1d)\n| order by Day asc","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e25","sourceId":"E25","pack":"eventhouse","topic":"Functions and reuse","title":"Choose reusable parameterized logic","prompt":"A team needs one centrally managed query definition that callers invoke with different page names. Results must be computed from the rows currently visible to each invocation. They do not require stored aggregation output. Select TWO appropriate statements.","type":"multi","options":[{"id":"A","text":"Create a stored tabular function with pageName:string and a query body that filters Page == pageName.","why":"A stored function packages reusable logic and a typed scalar parameter for callers."},{"id":"B","text":"Create a materialized view whose creation takes a different pageName parameter on each query invocation.","why":"A materialized view has a fixed definition; it is not a parameterized stored function."},{"id":"C","text":"Treat the stored function's definition as a persisted result snapshot refreshed only by ingestion.","why":"Storing a query definition does not store the result of every invocation."},{"id":"D","text":"Call the function with the desired page string and apply an explicit order by to its returned table when ordering is required.","why":"Callers can supply the parameter and control presentation order over the function result."}],"correct":["A","D"],"explanation":"A function reuses query logic. A materialized view maintains aggregation state. Neither the stored function nor a table's existence implies an output sort order.","videoSeconds":1520,"refs":["eqfunc","eqsum"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e26","sourceId":"E26","pack":"eventhouse","topic":"KQL query reasoning","title":"Select the latest row, then test it","prompt":"DeviceStatus has D1 at 10:00 with Alarm=true, D1 at 11:00 with Alarm=false, and D2 at 10:30 with Alarm=true. SourceTime is unique within each DeviceId. The requirement is to return devices whose latest status is in alarm. Which query meets it?","type":"single","options":[{"id":"A","text":"DeviceStatus | where Alarm == true | summarize arg_max(SourceTime, *) by DeviceId","why":"This returns the latest alarm row even for D1, whose newer status clears the alarm."},{"id":"B","text":"DeviceStatus | summarize arg_max(SourceTime, *) by DeviceId | where Alarm == true","why":"Selecting the latest status across all rows first correctly leaves only D2 after the alarm filter."},{"id":"C","text":"DeviceStatus | summarize Latest=max(SourceTime), AlarmSeen=countif(Alarm == true) by DeviceId | where AlarmSeen > 0","why":"An alarm at any historical time qualifies D1, contrary to the latest-status requirement."},{"id":"D","text":"DeviceStatus | summarize arg_max(SourceTime, *) by DeviceId, Alarm | where Alarm == true","why":"Grouping by Alarm preserves a separate historical true row for D1 instead of one latest device row."}],"correct":["B"],"explanation":"Operator order changes the meaning. Latest qualifying record differs from latest record that qualifies. Unique source timestamps remove tie ambiguity in this scenario.","videoSeconds":510,"refs":["eqarg","eqsum"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e27","sourceId":"E27","pack":"eventhouse","topic":"Reference-data joins","title":"Predict join fan-out","prompt":"Readings contains two rows for D1 with measures 10 and 20, and one for D2 with measure 5. Registry contains two matching D1 rows and one D2 row. The query uses explicit join kind=inner on DeviceId and then summarizes Total=sum(Measure), Rows=count(). What is returned?","type":"single","options":[{"id":"A","text":"Total=35, Rows=3.","why":"This assumes one registry match per reading even though D1 has two matching registry rows."},{"id":"B","text":"Total=35, Rows=5.","why":"This recognizes five matching pairs but incorrectly sums each original reading only once afterward."},{"id":"C","text":"Total=65, Rows=5.","why":"Each D1 reading matches twice: 10+10+20+20; D2 contributes 5 once."},{"id":"D","text":"Total=70, Rows=6.","why":"This duplicates D2 as well, although its registry has exactly one matching row."}],"correct":["C"],"explanation":"An inner join emits matching pairs. A reference table's grain must match the intended enrichment; multiple matches can inflate later sums.","videoSeconds":410,"refs":["eqjoin"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e28","sourceId":"E28","pack":"eventhouse","topic":"OneLake interoperability","title":"Read a mirrored dynamic payload","prompt":"Payload is dynamic in a KQL table and contains a JSON property bag. A Fabric notebook reads the table's OneLake Delta representation. Which approach aligns with the documented type mapping?","type":"single","options":[{"id":"A","text":"Expect a Spark struct with the identical KQL dynamic schema and directly select Payload.temperature.","why":"The documented mirroring mapping for KQL dynamic is string, not an automatically inferred Spark struct."},{"id":"B","text":"Use spark.read.json directly on the Delta table directory so its storage files infer Payload's nested fields.","why":"The table directory contains Delta metadata and Parquet data, not a JSON dataset to which that reader can directly apply the desired payload schema."},{"id":"C","text":"Treat nested dynamic property names as separate top-level Delta columns and select temperature without parsing Payload.","why":"The source bag is mapped as a string column, so its nested fields do not become independent typed Delta columns automatically."},{"id":"D","text":"Inspect the Delta schema, then parse the mapped string as JSON with the required Spark schema before selecting fields.","why":"Parsing the string representation explicitly produces typed fields suitable for Spark analytics."}],"correct":["D"],"explanation":"Cross-engine table availability does not imply that every source type has identical semantics in the receiving engine. Verify the published type mapping and reader schema.","videoSeconds":660,"refs":["eqmirror","eqjson"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e29","sourceId":"E29","pack":"eventhouse","topic":"OneLake freshness","title":"Meet a strict ingestion-to-report budget","prompt":"A telemetry alert must include rows newly queryable in KQL within 2 minutes. The team proposes a OneLake consumer and asks whether a 5-minute mirroring write-delay target proves compliance. Which conclusion is defensible?","type":"single","options":[{"id":"A","text":"Approve the design because a 5-minute target guarantees that each row appears within 2 minutes.","why":"A five-minute configured target cannot establish the tighter two-minute requirement."},{"id":"B","text":"Use direct KQL querying for this path and measure end-to-end latency; retain OneLake for consumers with looser freshness needs.","why":"This avoids relying on asynchronous Delta mirroring for a tighter requirement and still validates the actual alert path."},{"id":"C","text":"Approve after extending table retention from 30 to 90 days; retention reduces the mirroring interval.","why":"Retention governs how long data is kept, not whether mirroring meets the alert budget."},{"id":"D","text":"Reduce the target to 1 minute using the mirroring policy and treat it as an end-to-end latency SLA.","why":"The documented configurable range begins at five minutes, and a write-delay target is not an end-to-end SLA."}],"correct":["B"],"explanation":"Separate data retention, mirroring write targets, and observed report freshness. Current documentation allows a 5-minute to 3-hour write-delay target; validate requirements rather than inferring a guarantee.","videoSeconds":660,"refs":["eqavail"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e30","sourceId":"E30","pack":"eventhouse","topic":"OneLake operations","title":"Plan a compatible schema change","prompt":"OneLake availability is enabled for Telemetry. The team must add FirmwareVersion:string and migrate Temperature from string to real while preserving existing numeric-text values. Select TWO correct planning statements based on current limitations.","type":"multi","options":[{"id":"A","text":"Adding FirmwareVersion is supported while availability remains enabled.","why":"Current documentation explicitly allows adding or deleting a column, unlike altering a column type."},{"id":"B","text":"Both operations are prohibited because every schema change requires disabling availability.","why":"This repeats the video's broader wording, but the current documented restriction distinguishes column-type changes from add/delete."},{"id":"C","text":"Plan a controlled source migration to a correctly typed table with validated transformed history and a consumer cutover; coordinate availability and validate the rebuilt Delta path.","why":"A type migration must preserve source values and references, while the availability transition must be coordinated with consumers."},{"id":"D","text":"Change only the Delta column type directly in Spark and leave the KQL source unchanged.","why":"The OneLake representation is read-only; it is not the place to independently rewrite the source schema."}],"correct":["A","C"],"explanation":"Adding a column is supported while enabled; direct type alteration is restricted. Direct KQL column-type alteration also loses access to prior values. Preserve required history with a validated transformed-table migration and deliberate cutover, rather than treating disable/alter/re-enable as a data-preserving shortcut.","videoSeconds":734,"refs":["eqavail","eqtypemigrate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":null,"sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e31","sourceId":"E31","pack":"eventhouse","topic":"Case: backfill and event time","title":"Calculate the historical cutoff","prompt":"After row D arrives, what are RecentIngest's daily counts?","type":"single","options":[{"id":"A","text":"May 1: 1; May 3: 1.","why":"This excludes B by its older VisitTime, incorrectly applying effectiveDateTime to the event timestamp."},{"id":"B","text":"May 1: 3; May 3: 1.","why":"This includes A even though its ingestion precedes the backfill cutoff."},{"id":"C","text":"May 1: 2; May 3: 1.","why":"B and C qualify for historical backfill by ingestion time, and newly ingested D is included afterward."},{"id":"D","text":"May 3: 2; May 4: 1.","why":"This groups by ingestion day rather than by the view's VisitTime day key."}],"correct":["C"],"explanation":"The historical cutoff selects B and C by ingestion time. The aggregation still uses event time: B and new row D group on May 1; C groups on May 3. A remains excluded.","videoSeconds":1380,"refs":["eqmvcreate","eqbin"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-contoso-web-operations","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e32","sourceId":"E32","pack":"eventhouse","topic":"Case: backfill and event time","title":"Interpret a late event in NewOnly","prompt":"After row D arrives, what does NewOnly return?","type":"single","options":[{"id":"A","text":"One May 1 row with count 1.","why":"Only D arrived after view creation; its old event timestamp still places it in the May 1 bucket."},{"id":"B","text":"One May 4 row with count 1.","why":"D was ingested May 4, but the grouping expression uses VisitTime rather than ingestion_time."},{"id":"C","text":"No rows, because May 1 predates the view's creation day.","why":"No-backfill restricts already-ingested rows; it does not reject new arrivals with older event timestamps."},{"id":"D","text":"May 1 count 3 and May 3 count 1.","why":"This incorrectly includes the pre-creation rows A, B, and C without backfill."}],"correct":["A"],"explanation":"No-backfill means no historical source ingestion is loaded at creation. Late-arriving events ingested afterward can populate an old event-time bucket.","videoSeconds":1478,"refs":["eqmvcreate","eqbin"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-contoso-web-operations","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e33","sourceId":"E33","pack":"eventhouse","topic":"Case: backfill and event time","title":"Gate the report cutover","prompt":"During RecentIngest's original deployment, a tool must query the specific create operation by its returned identifier, then switch the report only after successful backfill. Place ALL steps in their required dependency order.","type":"sequence","options":[{"id":"A","text":"Use the captured identifier to monitor .show operations until the operation completes successfully.","why":"The identifier must first be returned and captured; successful completion must precede report cutover."},{"id":"B","text":"Switch the report's queries to RecentIngest and validate its results.","why":"The specified cutover is gated on successful backfill, since the view is not queryable during backfill."},{"id":"C","text":"Submit the async materialized-view create command with backfill=true.","why":"Submitting the create operation produces the identifier needed by later steps."},{"id":"D","text":"Capture the operation identifier returned by the create command.","why":"The monitoring tool cannot query this specific operation before it has its identifier."}],"correct":["C","D","A","B"],"explanation":"Async starts and returns control from the create operation. It does not make an incomplete backfilled view queryable. The report must wait for the operation's successful completion.","videoSeconds":575,"refs":["eqmvcreate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-contoso-web-operations","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e34","sourceId":"E34","pack":"eventhouse","topic":"Case: backfill and event time","title":"Query the fresh aggregate","prompt":"After backfill completes, B and C have been materialized. D is queryable in the source but has not been materialized yet. A report requires every row in RecentIngest's defined coverage that is already ingested. Which query path meets this requirement?","type":"single","options":[{"id":"A","text":"Query materialized_view('RecentIngest') without a freshness bound, because it includes D immediately.","why":"This reads only the materialized part and does not necessarily include the unmaterialized D row."},{"id":"B","text":"Query RecentIngest by its view name, allowing the engine to combine its materialized part with the eligible delta.","why":"The full view query incorporates newly ingested qualifying rows that have not yet been materialized."},{"id":"C","text":"Query Visits | summarize count() by bin(VisitTime,1d), because the source query has the same historical coverage.","why":"This source query includes A, which was excluded by the view's ingestion-time backfill cutoff."},{"id":"D","text":"Add the full view's counts to the source's daily counts to ensure the delta is included.","why":"The full view already includes its delta; adding all source counts double counts covered rows and also adds excluded A."}],"correct":["B"],"explanation":"Full-view freshness applies to the view's defined coverage. It does not retroactively include source records deliberately excluded at creation.","videoSeconds":1478,"refs":["eqmvover","eqmvcreate"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-contoso-web-operations","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e35","sourceId":"E35","pack":"eventhouse","topic":"Case: OneLake consumers","title":"Choose the measured serving paths","prompt":"Using the case's measured state at 12:04, select TWO valid decisions.","type":"multi","options":[{"id":"A","text":"Serve the incident monitor through direct KQL and measure whether its complete path meets the two-minute budget.","why":"KQL contains the later rows in this measurement, so it is the appropriate path to validate for the stricter monitor."},{"id":"B","text":"Declare both reports compliant because the same logical table name guarantees an identical latest row in every engine.","why":"The measured KQL and Delta watermarks differ, so a shared table identity does not prove equal freshness."},{"id":"C","text":"Allow the historical report to use Delta in this measurement, since its observed four-minute lag is within fifteen minutes.","why":"The observed lag satisfies this report's stated allowance; continuing to monitor it remains necessary."},{"id":"D","text":"Increase hot-cache duration until the Delta watermark reaches 12:04, because caching controls replication completion.","why":"Caching accelerates KQL access; it does not synchronize the OneLake write watermark."}],"correct":["A","C"],"explanation":"At 12:04 the OneLake path lags by four minutes. This fails the incident monitor's two-minute budget but fits the historical report's fifteen-minute budget at the measured instant.","videoSeconds":660,"refs":["eqavail","eqmirror"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-fabrikam-fleet-analytics","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e36","sourceId":"E36","pack":"eventhouse","topic":"Case: OneLake consumers","title":"Preserve a year of raw history","prompt":"The team adds a requirement to query raw telemetry for one year. Is the current OneLake Delta representation alone a sufficient archive?","type":"single","options":[{"id":"A","text":"Yes; mirroring creates a permanent independent copy unaffected by the source's 30-day retention.","why":"OneLake availability carries the source retention behavior and is not an independent long-term archive."},{"id":"B","text":"Yes; increasing only hot-cache duration to one year retains raw records in both engines.","why":"A cache policy is not a replacement for retention or a separately managed archive."},{"id":"C","text":"No; configure a justified longer retention strategy or preserve raw data in a separately managed archive with its own retention controls.","why":"The new requirement needs a storage lifecycle that actually retains the required history beyond the existing source policy."},{"id":"D","text":"No; periodically disable and re-enable availability to restore records already removed by retention.","why":"Re-enabling can backfill only available source data; it does not recreate history already removed."}],"correct":["C"],"explanation":"Retention changes must match the new historical requirement. Data removed from KQL at retention expiry is also removed from its OneLake representation; an archive needs independent lifecycle design.","videoSeconds":720,"refs":["eqavail","eqretain"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-fabrikam-fleet-analytics","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e37","sourceId":"E37","pack":"eventhouse","topic":"Case: OneLake consumers","title":"Protect every regional access path","prompt":"A proposed release plan says to add KQL table RLS while OneLake availability stays enabled and grant operators direct Delta access, assuming the same KQL predicate will protect every read. Which response is correct?","type":"single","options":[{"id":"A","text":"Release after applying the predicate to KQL; direct Delta readers automatically execute that KQL predicate.","why":"This assumes both a supported live operation and cross-engine predicate enforcement that have not been established."},{"id":"B","text":"Hide Region in a report and release the direct Delta path; users cannot filter a hidden column.","why":"Hiding a report field does not prevent direct access to rows through a granted storage path."},{"id":"C","text":"Turn availability off briefly, add KQL RLS, and re-enable it immediately without reviewing consumer permissions.","why":"A toggle alone does not establish that a supported design protects direct Delta reads after release."},{"id":"D","text":"Hold the access grant, redesign against the current OneLake/RLS compatibility restriction, and validate authorization on every retained access path.","why":"Applying table RLS is restricted while availability is enabled; release also requires verified regional protection for any direct OneLake path."}],"correct":["D"],"explanation":"A security policy must be compatible with the enabled features and cover the paths actually granted. Do not infer direct Delta enforcement from a KQL query policy.","videoSeconds":734,"refs":["eqavail"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-fabrikam-fleet-analytics","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e38","sourceId":"E38","pack":"eventhouse","topic":"Case: corrected telemetry","title":"Resolve corrections at the event grain","prompt":"Before reference enrichment, which query produces the corrected high-temperature events required by the case?","type":"single","options":[{"id":"A","text":"Readings | where Temperature > 70 | summarize arg_max(Version, *) by EventId","why":"Filtering first retains e1's superseded hot revision, producing a false positive."},{"id":"B","text":"Readings | summarize arg_max(Version, *) by DeviceId | where Temperature > 70","why":"This resolves one row per device instead of one corrected row per event and can discard independent events."},{"id":"C","text":"Readings | summarize arg_max(Version, *) by EventId | where Temperature > 70","why":"Each event's latest revision is selected before its corrected temperature is tested; e2 and e3 qualify."},{"id":"D","text":"Readings | summarize Temperature=max(Temperature) by EventId | where Temperature > 70","why":"A maximum historical temperature includes superseded e1=80 rather than applying its correction to 60."}],"correct":["C"],"explanation":"EventId defines the revision grain. DeviceId describes which device emitted each independent event. Resolve versions before applying a threshold to the corrected value.","videoSeconds":510,"refs":["eqarg","eqsum"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-alpine-equipment-monitoring","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e39","sourceId":"E39","pack":"eventhouse","topic":"Case: corrected telemetry","title":"Calculate the inflated intermediate sum","prompt":"An analyst correctly deduplicates Readings by EventId, but then joins all three Registry rows using explicit kind=inner on DeviceId, without resolving RegistryVersion or applying the temperature filter. What is the joined sum of Temperature?","type":"single","options":[{"id":"A","text":"235.","why":"This is the sum of corrected events without registry fan-out: 60+90+85."},{"id":"B","text":"385.","why":"The corrected D1 events 60 and 90 each match two registry rows, while corrected D2=85 matches once."},{"id":"C","text":"620.","why":"This corresponds to joining every raw reading, including superseded revisions, rather than the deduplicated input."},{"id":"D","text":"300.","why":"This counts only the two duplicated D1 event temperatures and omits the matching D2 event."}],"correct":["B"],"explanation":"Resolving event revisions does not resolve dimension history. The joined sum is 2*(60+90)+85=385 until Registry is reduced to its intended one-row-per-device grain.","videoSeconds":410,"refs":["eqjoin","eqarg"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-alpine-equipment-monitoring","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null},{"id":"fb-e40","sourceId":"E40","pack":"eventhouse","topic":"Case: corrected telemetry","title":"Produce current-region counts","prompt":"The corrected events are selected, then filtered for Temperature > 70. DeviceRegistry is independently reduced with arg_max(RegistryVersion, *) by DeviceId before an inner join. The result is summarized as count() by Region. What is returned?","type":"single","options":[{"id":"A","text":"West: 1; East: 1; North: 1.","why":"West survives only if the old D1 registry row remains, contrary to the independent current-version selection."},{"id":"B","text":"East: 2; North: 1.","why":"This counts the superseded hot e1 revision as well as e2, contrary to correction-before-filtering."},{"id":"C","text":"East: 1; North: 2.","why":"This counts both e3 versions instead of the single corrected event."},{"id":"D","text":"East: 1; North: 1.","why":"Corrected e2=90 maps once to current D1/East; corrected e3=85 maps once to current D2/North."}],"correct":["D"],"explanation":"Two independent canonicalization steps are required: one latest revision per event, and one current registry row per device. The final reporting grain is current region, so the two qualifying events contribute once each.","videoSeconds":1540,"refs":["eqarg","eqjoin","eqsum"],"code":"","origin":"extension","difficulty":null,"caseStudyId":"case-study-alpine-equipment-monitoring","sourceObjective":null,"provenance":null,"validation":null,"sourceVideoUrl":null}]
