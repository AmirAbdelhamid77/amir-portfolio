[{"id":"fb-v20-delta-001","sourceId":"V20-DELTA-001","pack":"video20","topic":"Snapshot correctness","title":"Snapshot correctness","prompt":"A retail Delta folder contains 28 Parquet files, but only 12 are active after updates and compaction. A custom export reads every Parquet file directly and doubles some orders. Which correction preserves the committed table state?","type":"single","options":[{"id":"A","text":"Read the largest 12 files","why":"File size does not identify which commits are active."},{"id":"B","text":"Read the table through a Delta-aware reader","why":"The transaction log identifies the active snapshot and avoids superseded rows."},{"id":"C","text":"Delete all small files before export","why":"Small files may be active and deleting them can corrupt the table."},{"id":"D","text":"Filter files only by modification date","why":"Modification time cannot reconstruct transactional membership."}],"correct":["B"],"explanation":"The transaction log identifies the active snapshot and avoids superseded rows.","videoSeconds":19,"refs":["vref_234dce6bb601f9f5"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-002","sourceId":"V20-DELTA-002","pack":"video20","topic":"Logical deletion","title":"Logical deletion","prompt":"A compliance analyst observes that DELETE removed a customer from query results but old files remain. The team needs both a correct current table and governed physical erasure. What should it plan?","type":"single","options":[{"id":"A","text":"Assess obsolete-file retention and supported physical cleanup separately","why":"Separate logical visibility from physical retention; cleanup must respect readers and required recovery."},{"id":"B","text":"Treat DELETE as proof all old bytes vanished","why":"Logical removal does not establish physical historical erasure."},{"id":"C","text":"Rewrite the export query without the customer","why":"An export filter cannot remove underlying historical bytes."},{"id":"D","text":"Remove the entire transaction log","why":"The log is required to interpret the table."}],"correct":["A"],"explanation":"Separate logical visibility from physical retention; cleanup must respect readers and required recovery.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-003","sourceId":"V20-DELTA-003","pack":"video20","topic":"Retention design","title":"Retention design","prompt":"Finance needs 30-day reproducible reports. The operator keeps 30 days of logs but vacuums unreferenced data after seven days. Which TWO controls are necessary?","type":"multi","options":[{"id":"A","text":"Disable current SELECT access","why":"Current access permissions do not extend retention."},{"id":"B","text":"Retain usable transaction history/checkpoints for the target snapshots","why":"Reconstruction also needs the relevant log/checkpoint chain."},{"id":"C","text":"Rely exclusively on DESCRIBE HISTORY","why":"History metadata is not a substitute for missing data."},{"id":"D","text":"Retain required historical data files long enough","why":"Historical snapshots need their referenced data files."}],"correct":["B","D"],"explanation":"Historical snapshots need their referenced data files. Reconstruction also needs the relevant log/checkpoint chain.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-004","sourceId":"V20-DELTA-004","pack":"video20","topic":"Compaction purpose","title":"Compaction purpose","prompt":"A table has thousands of tiny active files. Storage cleanup runs daily, but reads remain slow. Which action directly targets active-file fragmentation?","type":"single","options":[{"id":"A","text":"Run OPTIMIZE and validate file/read metrics","why":"Compaction targets file layout; measure results for the actual workload."},{"id":"B","text":"Increase log retention only","why":"Longer metadata retention does not compact active data."},{"id":"C","text":"Delete random Parquet files","why":"Manual deletion can remove committed data."},{"id":"D","text":"Shorten VACUUM retention","why":"Vacuum does not combine active files."}],"correct":["A"],"explanation":"Compaction targets file layout; measure results for the actual workload.","videoSeconds":19,"refs":["vref_9a2e93e66f4b6ad3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-005","sourceId":"V20-DELTA-005","pack":"video20","topic":"Compaction storage","title":"Compaction storage","prompt":"After OPTIMIZE, current queries read fewer files but total folder bytes temporarily increase. The operator calls this a failed optimization. Which explanation fits?","type":"single","options":[{"id":"A","text":"OPTIMIZE always duplicates logical rows","why":"Logical equality should be tested, not inferred from directory bytes."},{"id":"B","text":"Compression must have been disabled","why":"The observation alone cannot diagnose compression settings."},{"id":"C","text":"Old files remain for retained snapshots until eligible cleanup","why":"Replacements can coexist physically with obsolete retained files."},{"id":"D","text":"The table was automatically converted to CSV","why":"Compaction does not imply CSV conversion."}],"correct":["C"],"explanation":"Replacements can coexist physically with obsolete retained files.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-006","sourceId":"V20-DELTA-006","pack":"video20","topic":"Safe cleanup","title":"Safe cleanup","prompt":"A newly created demo table was updated ten minutes ago. VACUUM with default retention removes no files. What is the best interpretation?","type":"single","options":[{"id":"A","text":"Recent unreferenced files are not yet eligible","why":"Default seven-day retention protects recently obsolete files."},{"id":"B","text":"The transaction log can never track updates","why":"Delta history supports updates."},{"id":"C","text":"The command must be broken","why":"Zero deletions can be correct under retention."},{"id":"D","text":"All files must be active forever","why":"Eligibility changes with state and retention."}],"correct":["A"],"explanation":"Default seven-day retention protects recently obsolete files.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-007","sourceId":"V20-DELTA-007","pack":"video20","topic":"Concurrent readers","title":"Concurrent readers","prompt":"A long-running reader can take nine days. The proposed maintenance uses seven-day retention. Which TWO actions address the risk?","type":"multi","options":[{"id":"A","text":"Extend retention beyond the longest relevant workload and recovery need","why":"Retention must accommodate workloads needing older referenced files."},{"id":"B","text":"Force zero-hour vacuum during the reader","why":"Aggressive cleanup can remove required input."},{"id":"C","text":"Assume ACID preserves files after physical deletion","why":"Transaction consistency cannot recreate deleted bytes."},{"id":"D","text":"Inventory readers and validate cleanup timing","why":"Operational evidence determines an appropriate safety window."}],"correct":["A","D"],"explanation":"Retention must accommodate workloads needing older referenced files. Operational evidence determines an appropriate safety window.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-008","sourceId":"V20-DELTA-008","pack":"video20","topic":"Historical recovery","title":"Historical recovery","prompt":"An audit query for version 8 fails after required files were vacuumed, although version 8 appears in history. What is justified?","type":"single","options":[{"id":"A","text":"Grant more SQL permission to restore bytes","why":"Authorization does not recover deleted files."},{"id":"B","text":"Retry DESCRIBE HISTORY to recreate files","why":"History inspection does not regenerate data."},{"id":"C","text":"Use a separately retained backup if available","why":"Recovery depends on an independent retained source or backup."},{"id":"D","text":"Rename current files to old filenames","why":"Invented filename replacement cannot reconstruct snapshot content."}],"correct":["C"],"explanation":"Recovery depends on an independent retained source or backup.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-009","sourceId":"V20-DELTA-009","pack":"video20","topic":"Write conflict","title":"Write conflict","prompt":"Two jobs update overlapping Delta data concurrently. One receives a concurrent-modification error. What should the engineer conclude?","type":"single","options":[{"id":"A","text":"Both writes necessarily corrupted the table","why":"A rejected conflict is not evidence of corruption."},{"id":"B","text":"ACID guarantees every competing write succeeds","why":"Consistency does not mean conflict-free updates."},{"id":"C","text":"Conflict detection prevented an unsafe commit; inspect overlap and retry policy","why":"Optimistic concurrency can reject conflicting commits while preserving the table."},{"id":"D","text":"Disable transaction logging to avoid conflicts","why":"Removing transaction coordination defeats correctness."}],"correct":["C"],"explanation":"Optimistic concurrency can reject conflicting commits while preserving the table.","videoSeconds":19,"refs":["concurrency"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-010","sourceId":"V20-DELTA-010","pack":"video20","topic":"Schema contract","title":"Schema contract","prompt":"An ingestion change adds a nullable source field. The production contract requires review before new columns appear. Which approach fits?","type":"single","options":[{"id":"A","text":"Append raw Parquet outside the Delta writer","why":"Bypassing Delta commits is not safe table ingestion."},{"id":"B","text":"Globally enable automatic schema merging without review","why":"Uncontrolled global evolution bypasses the requirement."},{"id":"C","text":"Convert all fields to strings permanently","why":"String conversion loses type contracts and does not govern additions."},{"id":"D","text":"Validate incoming schema and explicitly approve evolution","why":"Explicit evolution separates intended additive change from drift."}],"correct":["D"],"explanation":"Explicit evolution separates intended additive change from drift.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-011","sourceId":"V20-DELTA-011","pack":"video20","topic":"Time-travel comparison","title":"Time-travel comparison","prompt":"A fraud investigation compares a prior snapshot with current orders. New and deleted IDs must both be found. Which comparison is appropriate?","type":"single","options":[{"id":"A","text":"Full outer join on stable ID with explicit added/deleted/changed classification","why":"A full comparison retains additions and deletions while matching identities."},{"id":"B","text":"Compare row counts only","why":"Equal counts can hide different records."},{"id":"C","text":"Join on every mutable attribute","why":"Mutable join keys obscure updates."},{"id":"D","text":"Inner join on order ID only","why":"An inner join loses IDs absent on either side."}],"correct":["A"],"explanation":"A full comparison retains additions and deletions while matching identities.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-012","sourceId":"V20-DELTA-012","pack":"video20","topic":"Version reproducibility","title":"Version reproducibility","prompt":"Two analysts run the same query on a changing Delta table hours apart and get different totals. They need a reproducible investigation dataset. What should they record?","type":"single","options":[{"id":"A","text":"Only the current file count","why":"File counts do not identify record content."},{"id":"B","text":"The exact version and adequate retention for it","why":"A version identifies a snapshot, subject to retained supporting data/logs."},{"id":"C","text":"Only the notebook title","why":"Notebook names do not freeze input."},{"id":"D","text":"Only the table display name","why":"The name does not pin data state."}],"correct":["B"],"explanation":"A version identifies a snapshot, subject to retained supporting data/logs.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-013","sourceId":"V20-DELTA-013","pack":"video20","topic":"Partition cardinality","title":"Partition cardinality","prompt":"A two-terabyte sales table is queried by month and region. A developer proposes partitioning by unique transaction ID. Which review finding is strongest?","type":"single","options":[{"id":"A","text":"Unique IDs maximize useful pruning for monthly scans","why":"Monthly filters do not target transaction-ID directories effectively."},{"id":"B","text":"VACUUM will merge the partitions","why":"Vacuum cleans obsolete files; it does not combine partition structure."},{"id":"C","text":"High-cardinality partitioning fragments data without matching the main filters","why":"Choose meaningful partition sizes and actual predicate patterns."},{"id":"D","text":"Partitioning changes all transaction IDs","why":"Partitioning organizes storage rather than changing values."}],"correct":["C"],"explanation":"Choose meaningful partition sizes and actual predicate patterns.","videoSeconds":453,"refs":["vref_b0f2ee954a790751"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=453s"},{"id":"fb-v20-delta-014","sourceId":"V20-DELTA-014","pack":"video20","topic":"Small table tradeoff","title":"Small table tradeoff","prompt":"A 20 MB dimension has a few thousand rows. The proposed partition key creates 600 directories. What is the best starting recommendation?","type":"single","options":[{"id":"A","text":"Run zero-hour vacuum to reduce active directory count","why":"Vacuum does not remove active partitions."},{"id":"B","text":"Partition every dimension by default","why":"A universal partition rule ignores overhead."},{"id":"C","text":"Create one directory per row","why":"Per-row partitioning increases fragmentation."},{"id":"D","text":"Start without that partitioning and benchmark the actual queries","why":"Small tables often gain little from excessive directory fragmentation."}],"correct":["D"],"explanation":"Small tables often gain little from excessive directory fragmentation.","videoSeconds":453,"refs":["vref_b0f2ee954a790751"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=453s"},{"id":"fb-v20-delta-015","sourceId":"V20-DELTA-015","pack":"video20","topic":"Pruning verification","title":"Pruning verification","prompt":"A date-partitioned table has slow full-year aggregates and fast single-month queries. Which TWO pieces of evidence should guide further tuning?","type":"multi","options":[{"id":"A","text":"End-to-end runtime and resource usage across the workload","why":"Workload measurements expose tradeoffs rather than a single favorable query."},{"id":"B","text":"Only the instructor demo file count","why":"A tiny demonstration is not a production benchmark."},{"id":"C","text":"The existence of directories alone","why":"A physical layout alone does not prove effective pruning."},{"id":"D","text":"Actual partition/file scan metrics for representative predicates","why":"Scan evidence tests whether pruning is occurring."}],"correct":["A","D"],"explanation":"Scan evidence tests whether pruning is occurring. Workload measurements expose tradeoffs rather than a single favorable query.","videoSeconds":453,"refs":["vref_b0f2ee954a790751"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=453s"},{"id":"fb-v20-delta-016","sourceId":"V20-DELTA-016","pack":"video20","topic":"V-Order decision","title":"V-Order decision","prompt":"A streaming-heavy bronze layer is written once and rarely read. Gold is read frequently by BI users. Where should V-Order evaluation start?","type":"single","options":[{"id":"A","text":"Partition every column to imitate V-Order","why":"Partitioning is not V-Order."},{"id":"B","text":"Enable everywhere because every write benefits equally","why":"Write overhead and read benefits differ by workload."},{"id":"C","text":"Disable all compaction","why":"Compaction and V-Order solve related but different layout concerns."},{"id":"D","text":"Benchmark it first on read-heavy outputs while measuring write cost","why":"Read/write tradeoffs support targeted evaluation."}],"correct":["D"],"explanation":"Read/write tradeoffs support targeted evaluation.","videoSeconds":19,"refs":["vorder"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-017","sourceId":"V20-DELTA-017","pack":"video20","topic":"Default assumptions","title":"Default assumptions","prompt":"A new workspace has ingestion throughput above expectations but BI scans are slower than a tuned older workspace. The reviewer assumes V-Order must be on by default. What should be checked?","type":"single","options":[{"id":"A","text":"Recreate every table immediately","why":"Recreation without diagnosis is unjustified."},{"id":"B","text":"Only check workspace name","why":"A label cannot establish runtime configuration."},{"id":"C","text":"Assume all Parquet files are V-Ordered","why":"Parquet compliance does not imply this optimization."},{"id":"D","text":"Inspect effective session/table/write settings rather than assuming a historical default","why":"Current defaults and overrides must be inspected in context."}],"correct":["D"],"explanation":"Current defaults and overrides must be inspected in context.","videoSeconds":19,"refs":["vorder"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-018","sourceId":"V20-DELTA-018","pack":"video20","topic":"Performance claims","title":"Performance claims","prompt":"A project budget assumes exactly 15% extra write time and exactly 50% smaller storage after V-Order. What should the engineer change?","type":"single","options":[{"id":"A","text":"Assume zero overhead because Parquet is open","why":"Open format compatibility does not eliminate compute work."},{"id":"B","text":"Use them as illustrative figures and benchmark representative data","why":"Measure the actual distribution, runtime and consumption path."},{"id":"C","text":"Treat the percentages as guaranteed service limits","why":"Published average or potential gains are not per-workload guarantees."},{"id":"D","text":"Apply the figures only to file counts","why":"File count does not directly express compression ratio or latency."}],"correct":["B"],"explanation":"Measure the actual distribution, runtime and consumption path.","videoSeconds":19,"refs":["vorder"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-019","sourceId":"V20-DELTA-019","pack":"video20","topic":"Open compatibility","title":"Open compatibility","prompt":"A partner reads Delta data using a compatible external engine. The team worries V-Order requires conversion to a proprietary file extension. What is correct?","type":"single","options":[{"id":"A","text":"Every consumer must query the SQL endpoint","why":"Compatible readers can use supported storage paths."},{"id":"B","text":"V-Order removes Delta metadata","why":"Layout optimization does not eliminate the transaction log."},{"id":"C","text":"V-Order output remains Parquet compliant","why":"File layout optimization retains Parquet compatibility, while readers must still support relevant Delta features."},{"id":"D","text":"V-Order converts Parquet to a semantic model","why":"A storage optimization does not create a semantic model."}],"correct":["C"],"explanation":"File layout optimization retains Parquet compatibility, while readers must still support relevant Delta features.","videoSeconds":19,"refs":["vorder"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-020","sourceId":"V20-DELTA-020","pack":"video20","topic":"Scope of commands","title":"Scope of commands","prompt":"A DBA runs Spark VACUUM syntax in the Lakehouse SQL analytics endpoint. It fails. Which correction fits?","type":"single","options":[{"id":"A","text":"Run the maintenance through a supported Spark or Lakehouse maintenance path","why":"Use the command in its supported execution engine."},{"id":"B","text":"Wrap it in a SQL stored procedure","why":"A wrapper does not change syntax support."},{"id":"C","text":"Grant workspace Admin and rerun unchanged","why":"Privileges do not add unsupported engine commands."},{"id":"D","text":"Change only the SQL endpoint display name","why":"Names do not change engine capabilities."}],"correct":["A"],"explanation":"Use the command in its supported execution engine.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-021","sourceId":"V20-DELTA-021","pack":"video20","topic":"Dry-run governance","title":"Dry-run governance","prompt":"An operator must list candidate cleanup files before approval of a retention change. Which command best supports review without deletion?","type":"single","options":[{"id":"A","text":"DROP TABLE","why":"Dropping a table does not provide the requested review."},{"id":"B","text":"VACUUM table DRY RUN","why":"DRY RUN previews eligible files without executing cleanup."},{"id":"C","text":"DELETE all rows","why":"Deleting rows changes logical content."},{"id":"D","text":"OPTIMIZE followed by physical directory deletion","why":"Manual directory deletion is not the supported review path."}],"correct":["B"],"explanation":"DRY RUN previews eligible files without executing cleanup.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-022","sourceId":"V20-DELTA-022","pack":"video20","topic":"Logs versus data","title":"Logs versus data","prompt":"An engineer wants to reduce a large _delta_log folder by running VACUUM repeatedly. Which correction is needed?","type":"single","options":[{"id":"A","text":"VACUUM cleans obsolete data; log cleanup has separate retention/checkpoint behavior","why":"Different retention mechanisms govern data and log history."},{"id":"B","text":"Rename the log directory after each load","why":"Renaming the required log breaks table interpretation."},{"id":"C","text":"Delete all checkpoints manually","why":"Manual checkpoint deletion can break reconstruction."},{"id":"D","text":"Vacuum always deletes every JSON commit","why":"The command does not perform that blanket log deletion."}],"correct":["A"],"explanation":"Different retention mechanisms govern data and log history.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-023","sourceId":"V20-DELTA-023","pack":"video20","topic":"Deletion vectors","title":"Deletion vectors","prompt":"A supported runtime uses deletion vectors. A delete does not rewrite every affected Parquet file. Does this contradict Delta semantics?","type":"single","options":[{"id":"A","text":"No; logical deletion can use supported metadata mechanisms","why":"The snapshot incorporates supported deletion metadata; consumers must be compatible."},{"id":"B","text":"No; all old files may now be deleted manually","why":"Files may remain referenced and must not be removed arbitrarily."},{"id":"C","text":"Yes; every delete must create exactly one replacement file","why":"Rewrite behavior is feature-dependent rather than universal."},{"id":"D","text":"Yes; Delta has become a CSV table","why":"Deletion vectors do not imply a different serialization format."}],"correct":["A"],"explanation":"The snapshot incorporates supported deletion metadata; consumers must be compatible.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-024","sourceId":"V20-DELTA-024","pack":"video20","topic":"Active-file protection","title":"Active-file protection","prompt":"A physically old Parquet file is still referenced by the current snapshot. Why should a correctly executed VACUUM preserve it?","type":"single","options":[{"id":"A","text":"Active references make it ineligible even if physically old","why":"Current-state data must remain available."},{"id":"B","text":"Only SQL permissions determine eligibility","why":"Cleanup eligibility follows Delta state and retention."},{"id":"C","text":"Every old file is corrupt","why":"Age is not evidence of corruption."},{"id":"D","text":"Age alone is sufficient for deletion","why":"Eligibility is not based solely on file creation age."}],"correct":["A"],"explanation":"Current-state data must remain available.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-025","sourceId":"V20-DELTA-025","pack":"video20","topic":"Maintenance acceptance","title":"Maintenance acceptance","prompt":"A maintenance run reports success. Which TWO checks establish useful completion beyond a green status?","type":"multi","options":[{"id":"A","text":"Check relevant active file/scan measures and runtime","why":"Metrics establish whether the intended optimization occurred."},{"id":"B","text":"Assume every historical version remains queryable after vacuum","why":"Historical availability depends on retention and cleanup."},{"id":"C","text":"Reconcile business totals before/after compaction","why":"Compaction must preserve logical data."},{"id":"D","text":"Assume all source duplicates were removed","why":"Maintenance is not business-key deduplication."}],"correct":["A","C"],"explanation":"Compaction must preserve logical data. Metrics establish whether the intended optimization occurred.","videoSeconds":19,"refs":["vref_9a2e93e66f4b6ad3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-026","sourceId":"V20-DELTA-026","pack":"video20","topic":"Deduplication boundary","title":"Deduplication boundary","prompt":"Duplicate order IDs remain after OPTIMIZE. The analyst expected physical compaction to deduplicate business records. What is the correct fix?","type":"single","options":[{"id":"A","text":"Vacuum active files","why":"Deleting active files corrupts data rather than applying a rule."},{"id":"B","text":"Repeat OPTIMIZE until rows disappear","why":"Compaction preserves logical rows."},{"id":"C","text":"Rename duplicate IDs in the file browser","why":"Manual file editing bypasses table transactions."},{"id":"D","text":"Define a deterministic business deduplication rule in transformation logic","why":"Record semantics require explicit key and precedence logic."}],"correct":["D"],"explanation":"Record semantics require explicit key and precedence logic.","videoSeconds":19,"refs":["vref_9a2e93e66f4b6ad3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-027","sourceId":"V20-DELTA-027","pack":"video20","topic":"Schema evolution versus schemas","title":"Schema evolution versus schemas","prompt":"A new column is required in sales.orders. A developer proposes creating an hr schema to enable schema evolution. What distinction matters?","type":"single","options":[{"id":"A","text":"Partition folders are namespaces for column types","why":"Partition values are not type-contract namespaces."},{"id":"B","text":"Every namespace creates all missing columns","why":"Namespace creation does not alter a table definition."},{"id":"C","text":"Evolution requires one Lakehouse per field","why":"Column changes do not require separate Lakehouses."},{"id":"D","text":"Namespace schemas organize tables; schema evolution changes a table column contract","why":"These uses of schema describe different layers."}],"correct":["D"],"explanation":"These uses of schema describe different layers.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-028","sourceId":"V20-DELTA-028","pack":"video20","topic":"Streaming maintenance","title":"Streaming maintenance","prompt":"A stream can be stopped for ten days and then resume from older table files. The team uses seven-day cleanup. Which planning change is justified?","type":"single","options":[{"id":"A","text":"Erase streaming checkpoints during vacuum","why":"Deleting checkpoints destroys useful recovery state."},{"id":"B","text":"Align retention with stream recovery requirements and validate supported restart behavior","why":"A stream restart may require data beyond the current cleanup window."},{"id":"C","text":"Assume checkpoints retain all source bytes","why":"A checkpoint records progress, not an independent copy of all input."},{"id":"D","text":"Use SQL aliases to preserve obsolete files","why":"Aliases do not preserve source storage."}],"correct":["B"],"explanation":"A stream restart may require data beyond the current cleanup window.","videoSeconds":333,"refs":["vacuum"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=333s"},{"id":"fb-v20-delta-029","sourceId":"V20-DELTA-029","pack":"video20","topic":"History interpretation","title":"History interpretation","prompt":"DESCRIBE HISTORY shows WRITE, UPDATE and OPTIMIZE commits. An auditor assumes every commit changed business values. What is the best interpretation?","type":"single","options":[{"id":"A","text":"Every OPTIMIZE necessarily adds sales","why":"Layout maintenance is intended to preserve records."},{"id":"B","text":"History is an immutable backup of every file","why":"History metadata alone is not a backup."},{"id":"C","text":"Separate data-changing operations from layout maintenance and reconcile effects","why":"Commit history includes maintenance as well as business changes."},{"id":"D","text":"Ignore all commits after the first","why":"Later commits can contain important updates."}],"correct":["C"],"explanation":"Commit history includes maintenance as well as business changes.","videoSeconds":19,"refs":["vref_234dce6bb601f9f5"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-030","sourceId":"V20-DELTA-030","pack":"video20","topic":"Partition value visibility","title":"Partition value visibility","prompt":"A Delta-aware query returns category although a directly opened partition Parquet file omits that field. Which explanation fits?","type":"single","options":[{"id":"A","text":"The query fabricated a random category","why":"Partition interpretation is deterministic, not random."},{"id":"B","text":"VACUUM deleted only the column","why":"Vacuum operates on eligible obsolete files, not arbitrary current columns."},{"id":"C","text":"The partition value is represented in the table partition metadata/path","why":"The table reader reconstructs partition values as part of the logical table."},{"id":"D","text":"All columns must exist in every file identically","why":"Physical representation can differ from the logical row schema."}],"correct":["C"],"explanation":"The table reader reconstructs partition values as part of the logical table.","videoSeconds":453,"refs":["vref_b0f2ee954a790751"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=453s"},{"id":"fb-v20-delta-031","sourceId":"V20-DELTA-031","pack":"video20","topic":"Multi-column fragmentation","title":"Multi-column fragmentation","prompt":"A table has 24 months, 80 regions and 1000 product values. A proposal partitions by all three. What must be assessed before adoption?","type":"single","options":[{"id":"A","text":"Only whether all names are lowercase","why":"Naming style does not control fragmentation."},{"id":"B","text":"Only total row count","why":"Total rows do not establish useful partition size."},{"id":"C","text":"Only whether a demo used two partition columns","why":"Demonstrations do not establish workload fit."},{"id":"D","text":"The combination cardinality and resulting per-partition size against query predicates","why":"Compound keys can create many small partitions despite a large overall table."}],"correct":["D"],"explanation":"Compound keys can create many small partitions despite a large overall table.","videoSeconds":453,"refs":["vref_b0f2ee954a790751"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=453s"},{"id":"fb-v20-delta-032","sourceId":"V20-DELTA-032","pack":"video20","topic":"Source log authority","title":"Source log authority","prompt":"An ingestion tool copies a few new Parquet files into a Delta directory without committing a corresponding transaction. What is the correct review finding?","type":"single","options":[{"id":"A","text":"Use a supported Delta writer and validate table state","why":"The write must participate in the table transaction protocol."},{"id":"B","text":"The files automatically become committed rows","why":"Directory presence alone does not establish committed membership."},{"id":"C","text":"Grant SELECT on each filename","why":"SQL grants cannot create Delta commits."},{"id":"D","text":"Delete the old log so discovery sees all files","why":"Removing the log loses table semantics."}],"correct":["A"],"explanation":"The write must participate in the table transaction protocol.","videoSeconds":19,"refs":["vref_234dce6bb601f9f5"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-033","sourceId":"V20-DELTA-033","pack":"video20","topic":"Single-table atomicity","title":"Single-table atomicity","prompt":"An application writes Orders and Payments in two separate Spark transactions and assumes Delta ACID makes them one atomic business operation. What should be concluded?","type":"single","options":[{"id":"A","text":"Every Delta commit automatically covers the workspace","why":"Workspace membership does not create a transaction boundary."},{"id":"B","text":"The assumption requires a supported multi-table transaction mechanism; two independent commits are insufficient","why":"The scope of a transaction matters; individual table guarantees do not combine automatically."},{"id":"C","text":"VACUUM provides distributed rollback","why":"Cleanup is not distributed rollback."},{"id":"D","text":"V-Order groups the two commits atomically","why":"File layout does not orchestrate business atomicity."}],"correct":["B"],"explanation":"The scope of a transaction matters; individual table guarantees do not combine automatically.","videoSeconds":19,"refs":["concurrency"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-034","sourceId":"V20-DELTA-034","pack":"video20","topic":"Reproducible benchmarks","title":"Reproducible benchmarks","prompt":"A test compares a cold scan before OPTIMIZE with a warm cached scan afterward and attributes all gains to compaction. Which TWO improvements make the claim defensible?","type":"multi","options":[{"id":"A","text":"Compare representative repeated runs with resource metrics","why":"Repeated measurements expose variability and cost."},{"id":"B","text":"Use only the fastest observed run","why":"Selecting a best outlier overstates typical improvement."},{"id":"C","text":"Change data volume between runs","why":"Different inputs undermine the comparison."},{"id":"D","text":"Control cache state and input snapshot","why":"Control confounding factors before attributing causality."}],"correct":["A","D"],"explanation":"Control confounding factors before attributing causality. Repeated measurements expose variability and cost.","videoSeconds":453,"refs":["vref_b0f2ee954a790751"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=453s"},{"id":"fb-v20-delta-035","sourceId":"V20-DELTA-035","pack":"video20","topic":"Retention scope","title":"Retention scope","prompt":"Legal requires deleted rows retained for 90 days in a separate restricted archive, while operational current tables have shorter history. Which design best meets the requirement?","type":"single","options":[{"id":"A","text":"Assume every Delta table always retains 90 days","why":"Defaults do not prove the required retention."},{"id":"B","text":"Disable DELETE for BI readers only","why":"Reader permissions do not retain data."},{"id":"C","text":"Rename operational files as archive","why":"Renaming is not a complete archive design."},{"id":"D","text":"Keep an independently governed archive with its own access and retention controls","why":"Retention obligations need an explicit controlled storage lifecycle."}],"correct":["D"],"explanation":"Retention obligations need an explicit controlled storage lifecycle.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-036","sourceId":"V20-DELTA-036","pack":"video20","topic":"Write amplification","title":"Write amplification","prompt":"Frequent tiny appends create many files between nightly maintenance runs. Which TWO interventions should be evaluated?","type":"multi","options":[{"id":"A","text":"Manually combine bytes from unrelated Parquet files","why":"Parquet and Delta require structured supported rewrites."},{"id":"B","text":"Tune ingestion batch/file sizing using supported write options","why":"Preventing tiny-file creation can reduce downstream maintenance."},{"id":"C","text":"Force one enormous global file for every workload","why":"One universal file size is not justified by all workloads."},{"id":"D","text":"Evaluate a maintenance cadence against arrival pattern and capacity","why":"Maintenance frequency is a workload/cost tradeoff."}],"correct":["B","D"],"explanation":"Preventing tiny-file creation can reduce downstream maintenance. Maintenance frequency is a workload/cost tradeoff.","videoSeconds":19,"refs":["vref_9a2e93e66f4b6ad3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-037","sourceId":"V20-DELTA-037","pack":"video20","topic":"Engine interoperability","title":"Engine interoperability","prompt":"A Delta table readable by Spark fails in another engine after enabling a table feature. What is the best diagnostic approach?","type":"single","options":[{"id":"A","text":"Delete unsupported metadata","why":"Metadata removal can corrupt interpretation."},{"id":"B","text":"Check that engine support covers the table protocol/features, not just Parquet","why":"Format compatibility includes protocol and feature support."},{"id":"C","text":"Assume every Parquet reader supports every Delta feature","why":"Parquet support alone is not full Delta support."},{"id":"D","text":"Copy only the newest-looking data file","why":"Recency cannot establish a complete snapshot."}],"correct":["B"],"explanation":"Format compatibility includes protocol and feature support.","videoSeconds":19,"refs":["vref_234dce6bb601f9f5"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-038","sourceId":"V20-DELTA-038","pack":"video20","topic":"Maintenance scheduling","title":"Maintenance scheduling","prompt":"A large optimization overlaps a critical morning dashboard refresh and capacity contention rises. Which response is strongest?","type":"single","options":[{"id":"A","text":"Disable all quality checks permanently","why":"Quality removal does not target the observed resource competition."},{"id":"B","text":"Run vacuum every minute instead","why":"Cleanup cadence does not substitute for compaction scheduling."},{"id":"C","text":"Schedule measured maintenance to meet freshness needs without unnecessary peak contention","why":"Maintenance consumes resources and should be coordinated with consumers."},{"id":"D","text":"Change the table name to prioritize compute","why":"Names do not allocate compute."}],"correct":["C"],"explanation":"Maintenance consumes resources and should be coordinated with consumers.","videoSeconds":19,"refs":["vref_9a2e93e66f4b6ad3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=19s"},{"id":"fb-v20-delta-039","sourceId":"V20-DELTA-039","pack":"video20","topic":"Historical query scope","title":"Historical query scope","prompt":"A notebook uses VERSION AS OF successfully, but the author sends identical Spark syntax to another SQL surface. What should be verified first?","type":"single","options":[{"id":"A","text":"Whether current row count is even","why":"Row parity is unrelated to syntax compatibility."},{"id":"B","text":"Whether table names contain digits","why":"Digits do not explain command capability."},{"id":"C","text":"Engine-specific time-travel syntax and supported object type","why":"Shared storage does not guarantee identical SQL syntax across engines."},{"id":"D","text":"Only the user display language","why":"Locale does not establish feature support."}],"correct":["C"],"explanation":"Shared storage does not guarantee identical SQL syntax across engines.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"performance-review","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"},{"id":"fb-v20-delta-040","sourceId":"V20-DELTA-040","pack":"video20","topic":"Recovery drill","title":"Recovery drill","prompt":"The team documents retention but has never restored a required historical snapshot. Which TWO acceptance actions provide evidence?","type":"multi","options":[{"id":"A","text":"Declare recovery proven from a green ingestion job","why":"Ingestion success is not recovery evidence."},{"id":"B","text":"Infer retention from the oldest visible filename","why":"A filename cannot prove a coherent historical snapshot."},{"id":"C","text":"Verify backup recovery independently where backup is part of the plan","why":"Backup reliability requires its own recovery validation."},{"id":"D","text":"Run representative historical reads within the intended retained window","why":"Direct tests establish recoverability of required snapshots."}],"correct":["C","D"],"explanation":"Direct tests establish recoverability of required snapshots. Backup reliability requires its own recovery validation.","videoSeconds":1004,"refs":["batch"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"maintenance-council","sourceObjective":"Maintain a data analytics solution > Implement security and governance; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=8-u26TcA4LM&t=1004s"}]
