[{"id":"fb-v12-mon-001","sourceId":"V12-MON-001","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"A BI operator has access to the Sales workspace but not Payroll. Both contain scheduled semantic model refresh jobs. Management asks for a tenant-wide list of every job without granting additional permissions. Which outcome is consistent with the Monitor hub security model?","type":"single","options":[{"id":"A","text":"The operator cannot open Monitor without capacity-admin membership.","why":"Incorrect: Capacity admin is not mandatory to open the job-run view."},{"id":"B","text":"The operator sees all job names but with errors redacted.","why":"Incorrect: There is no universal name-only bypass described."},{"id":"C","text":"The operator sees all tenant jobs because the hub is tenant-wide.","why":"Incorrect: Tenant-wide interface does not override item permissions."},{"id":"D","text":"The operator sees only activities for items the operator may view.","why":"Correct: Job visibility is permission-scoped."}],"correct":["D"],"explanation":"The hub centralizes navigation, not authorization: visibility is bounded by item access. Grant legitimate access or ask an appropriately authorized reviewer for other workspaces.","videoSeconds":100,"refs":["vref_873a12301549dc9b","vref_8ecb8fd3ad5c6932"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=100s"},{"id":"fb-v12-mon-002","sourceId":"V12-MON-002","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"An orchestration runs every 10 minutes. An auditor finds fewer executions in the main Monitoring hub list than expected and assumes all earlier jobs were deleted. What is the safest first action?","type":"single","options":[{"id":"A","text":"Run every old job again to rebuild its history.","why":"Incorrect: Rerunning modifies operations rather than retrieving historical evidence."},{"id":"B","text":"Resize the capacity because missing UI rows always mean throttling.","why":"Incorrect: Capacity pressure is not established from display limits."},{"id":"C","text":"Enable Git integration to preserve job history.","why":"Incorrect: Git manages artifacts, not retroactive execution rows."},{"id":"D","text":"Use Historical runs for the relevant item and review the available retention window.","why":"Correct: Correct: inspect the item-specific history; do not equate truncation with deletion."}],"correct":["D"],"explanation":"The main activities view is limited, while per-item Historical runs provides the 30-day history; absent rows in the main listing do not prove the underlying executions never happened.","videoSeconds":121,"refs":["vref_873a12301549dc9b"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=121s"},{"id":"fb-v12-mon-003","sourceId":"V12-MON-003","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"A team sees refresh jobs marked Succeeded but interactive reports are intermittently slow. They suspect CU throttling rather than job failure. Which evidence should they prioritize?","type":"single","options":[{"id":"A","text":"A new tenant-wide audit report about domain labels.","why":"Incorrect: Governance labeling does not measure compute saturation."},{"id":"B","text":"Monitoring hub job statuses alone.","why":"Incorrect: Succeeded status does not establish adequate capacity responsiveness."},{"id":"C","text":"Capacity monitoring/Capacity Metrics CU and throttling evidence correlated with the job times.","why":"Correct: Correct: capacity evidence addresses utilization, throttling, and item load."},{"id":"D","text":"Only the Power BI report refresh history.","why":"Incorrect: Refresh history alone cannot quantify CU pressure."}],"correct":["C"],"explanation":"Job execution health and capacity pressure are distinct observability dimensions; correlate capacity utilization and throttling with timestamps.","videoSeconds":163,"refs":["vref_e468c481337ea4ed","vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=163s"},{"id":"fb-v12-mon-004","sourceId":"V12-MON-004","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"Eventstream throughput declines while a scheduled Notebook and a Data Pipeline fail in the same workspace. The incident lead wants streaming-specific metrics, failed job details, and capacity utilization. Which THREE are appropriate? (Select THREE.)","type":"multi","options":[{"id":"A","text":"The semantic model relationships view as the primary event latency monitor.","why":"Incorrect: Model relationships do not diagnose stream processing lag."},{"id":"B","text":"A Git branch comparison as the primary live operations dashboard.","why":"Incorrect: Source control is not live telemetry."},{"id":"C","text":"Eventstream runtime/workspace monitoring for event flow and errors.","why":"Correct: Streaming-specific metrics identify flow, backlog and errors."},{"id":"D","text":"Capacity Metrics for CU and throttling context.","why":"Correct: Capacity monitoring identifies shared resource pressure."},{"id":"E","text":"Monitor hub job-run details for Notebook and Pipeline failures.","why":"Correct: Job-run details identify failures and activity context."}],"correct":["C","D","E"],"explanation":"Investigate each layer through its native evidence: streaming metrics, run diagnostics, and capacity. Multiple tools are complementary.","videoSeconds":139,"refs":["vref_c3f851c8822446b3","vref_dad9bc01b395e634","vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=139s"},{"id":"fb-v12-mon-005","sourceId":"V12-MON-005","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"A refresh job fails at 02:00 while the same refresh succeeds at 03:00. A service desk analyst wants to filter failures in a permitted workspace and inspect the failed execution. What is the shortest defensible workflow?","type":"single","options":[{"id":"A","text":"Open Capacity Metrics and treat all CU peaks as the root cause.","why":"Incorrect: A correlation can guide investigation but does not prove root cause."},{"id":"B","text":"Inspect the Warehouse sys.dm_exec_connections view.","why":"Incorrect: Connection DMV is specific to active SQL connections."},{"id":"C","text":"Open Monitor, filter workspace/item/status and inspect the failed run details.","why":"Correct: Correct first-layer job investigation."},{"id":"D","text":"Open admin monitoring Inventory and delete the report.","why":"Incorrect: Tenant Inventory does not expose a particular refresh failure stack."}],"correct":["C"],"explanation":"Filter job runs to the relevant item and failure then inspect error and activity details; escalate to capacity diagnostics only if evidence justifies it.","videoSeconds":85,"refs":["vref_873a12301549dc9b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=85s"},{"id":"fb-v12-mon-006","sourceId":"V12-MON-006","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"A Viewer with access to one permitted pipeline cannot see runs originating in an unrelated workspace. Their colleague can. Which explanation requires the fewest unsupported assumptions?","type":"single","options":[{"id":"A","text":"The colleague has different item/workspace access.","why":"Correct: Correct: permission boundaries are the leading explanation."},{"id":"B","text":"The Viewer must become a Fabric tenant admin to use filters.","why":"Incorrect: No tenant-admin requirement for ordinary job view."},{"id":"C","text":"The hub has a random per-user bug.","why":"Incorrect: Not evidenced."},{"id":"D","text":"The pipeline has to be copied to both workspaces.","why":"Incorrect: Duplicating artifacts does not solve authorization."}],"correct":["A"],"explanation":"Access scope, not which user opened the same centralized hub, determines visible activity; verify authorization before treating this as an outage.","videoSeconds":130,"refs":["vref_873a12301549dc9b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=130s"},{"id":"fb-v12-mon-007","sourceId":"V12-MON-007","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"Your operations design calls for cross-workspace job health, alerts and capacity management. Which TWO statements remain correct in current Fabric documentation? (Select TWO.)","type":"multi","options":[{"id":"A","text":"Monitoring hub activity permissions are ignored because it is centralized.","why":"Incorrect: Hub job view respects item access."},{"id":"B","text":"The Monitor hub now covers multiple observability areas beyond historical job runs.","why":"Correct: Correct modern scope."},{"id":"C","text":"Any Fabric user can inspect capacity management details and resize every capacity.","why":"Incorrect: Capacity privileges are required to inspect/manage capacities."},{"id":"D","text":"Capacity management in the Monitor hub has administrator prerequisites and preview caveats.","why":"Correct: Correct: distinct admin prerequisites apply."},{"id":"E","text":"The Capacity Metrics app is the only available capacity-monitoring surface.","why":"Incorrect: Current Monitor hub also offers a capacity view."}],"correct":["B","D"],"explanation":"The current Monitor hub is broader than the video-era description, while capacity administration remains privileged and some functionality preview.","videoSeconds":64,"refs":["vref_873a12301549dc9b","vref_e468c481337ea4ed"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=64s"},{"id":"fb-v12-mon-008","sourceId":"V12-MON-008","pack":"video12","topic":"Monitor hub / cross-workspace job observability","title":"Monitor hub","prompt":"A failed data pipeline run includes an automated investigation suggestion in the new Monitor hub. Production governance forbids autonomous modifications. Which option respects the documented functionality?","type":"single","options":[{"id":"A","text":"Do not use any monitoring because AI always modifies the pipeline.","why":"Incorrect: Incorrect blanket assumption."},{"id":"B","text":"Grant tenant admin rights to every pipeline owner so the agent can resolve failures.","why":"Incorrect: Excessive privilege unrelated to diagnosis."},{"id":"C","text":"Let the agent delete and recreate the pipeline because that is required for diagnosis.","why":"Incorrect: Unnecessary and unsupported destructive step."},{"id":"D","text":"Run the preview Operations agent investigation to get read-only likely root cause; review recommendations before making changes.","why":"Correct: Correct: read-only investigation, human-reviewed remediation."}],"correct":["D"],"explanation":"The failed-run investigation entry point is described as read-only; it may assist diagnosis, not justify uncontrolled action.","videoSeconds":81,"refs":["vref_873a12301549dc9b","vref_df75f7b08597c96b"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=81s"},{"id":"fb-v12-mon-009","sourceId":"V12-MON-009","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"A Fabric pipeline writes Lakehouse rows into Warehouse staging, then calls a stored procedure. The final table is short 5% of rows despite a Succeeded pipeline. The engineer must pinpoint which activity lost rows. What should be inspected first?","type":"single","options":[{"id":"A","text":"Admin monitoring domain endorsement report.","why":"Incorrect: Governance report is irrelevant to missing rows."},{"id":"B","text":"The Warehouse sys.dm_exec_connections encryption protocol.","why":"Incorrect: Connection encryption does not explain aggregation or filtering losses."},{"id":"C","text":"Deployment pipeline Git history.","why":"Incorrect: Version control cannot validate activity row counts."},{"id":"D","text":"Copy activity output rows-read/rows-written and the stored procedure result/affected rows.","why":"Correct: Correct: compare transfer counts and downstream DML outcome."}],"correct":["D"],"explanation":"Activity input/output and row counts localize the discrepancy between ingestion and transformation; success means completion, not semantic reconciliation.","videoSeconds":1141,"refs":["vref_1e961b75b5385b70","vref_dad9bc01b395e634"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1141s"},{"id":"fb-v12-mon-010","sourceId":"V12-MON-010","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"Notebook A fetches JSON from an API, Notebook B converts it to Delta, Copy Activity loads staging. Notebook B finishes successfully but outputs the wrong schema. What evidence is most directly linked to Notebook B’s actual execution?","type":"single","options":[{"id":"A","text":"Query Insights long-running query aggregation only.","why":"Incorrect: Warehouse aggregated queries are a different processing layer."},{"id":"B","text":"Notebook activity run details and its execution snapshot/log.","why":"Correct: Correct evidence from this execution."},{"id":"C","text":"The workspace Deployment rules tab.","why":"Incorrect: Deployment rules concern release-time configuration."},{"id":"D","text":"Fabric Capacity Metrics total tenant storage alone.","why":"Incorrect: Storage total does not capture schema processing."}],"correct":["B"],"explanation":"The activity detail can lead to notebook execution output, parameters and prints, helping reconstruct the run that produced the schema.","videoSeconds":1127,"refs":["vref_1e961b75b5385b70"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1127s"},{"id":"fb-v12-mon-011","sourceId":"V12-MON-011","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"A daily pipeline takes 3 hours instead of 45 minutes. No individual activity failed. The operator wants to identify waiting and overlapping activities visually, before editing code. Which view provides the best first clue?","type":"single","options":[{"id":"A","text":"Admin monitoring sensitivity label report.","why":"Incorrect: Unrelated to schedule bottlenecks."},{"id":"B","text":"A pipeline Gantt/run-duration view, followed by activity performance details.","why":"Correct: Correct execution-timing diagnostic."},{"id":"C","text":"Warehouse sys.dm_exec_connections only.","why":"Incorrect: SQL connections omit non-SQL pipeline timeline."},{"id":"D","text":"A semantic model relationship diagram.","why":"Incorrect: Shows relationships rather than runtime."}],"correct":["B"],"explanation":"Gantt activity visualization highlights elapsed durations and temporal overlaps; inspection can then narrow to a slow notebook/copy/stored procedure.","videoSeconds":1181,"refs":["vref_1e961b75b5385b70","vref_dad9bc01b395e634"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1181s"},{"id":"fb-v12-mon-012","sourceId":"V12-MON-012","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"A pipeline failed at a transient API ingestion activity after the initial successful setup step. The credential fault has been corrected. Which TWO controls are documented rerun approaches? (Select TWO.)","type":"multi","options":[{"id":"A","text":"Restore a previous Git commit as the sole way to retry.","why":"Incorrect: Git rollback addresses source code, not needed for a corrected transient fault."},{"id":"B","text":"Rerun the complete pipeline.","why":"Correct: Supported rerun mode; verify duplicate side effects first."},{"id":"C","text":"Start rerun from the failed activity.","why":"Correct: Supported rerun mode after root cause addressed."},{"id":"D","text":"Manually edit Query Insights history to change status.","why":"Incorrect: Historical query telemetry is not mutable replay control."},{"id":"E","text":"Rewrite the Monitoring hub retention policy to replay the run.","why":"Incorrect: Retention setting is not a rerun method."}],"correct":["B","C"],"explanation":"Both a full rerun and a rerun from failure are available; choose based on idempotency and dependency safety.","videoSeconds":1225,"refs":["vref_dad9bc01b395e634","vref_1e961b75b5385b70"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1225s"},{"id":"fb-v12-mon-013","sourceId":"V12-MON-013","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"An engineer reruns a pipeline from an arbitrary midstream activity after its upstream files have changed. The target Warehouse now has duplicate transactions. What design weakness should be addressed?","type":"single","options":[{"id":"A","text":"Make every execution dependent on an unstable notebook owner.","why":"Incorrect: Ownership does not prevent double writes."},{"id":"B","text":"Disable all activity output logging.","why":"Incorrect: Logs are needed for investigation."},{"id":"C","text":"Implement idempotent loads/checkpoint-aware dependencies before rerunning selected steps.","why":"Correct: Correct: deterministic reprocessing, MERGE/keys and dependency checks."},{"id":"D","text":"Replace the Warehouse with the Monitoring hub.","why":"Incorrect: A monitoring interface is not a data store."}],"correct":["C"],"explanation":"Rerunning part of an orchestration without guaranteeing consistent upstream inputs and idempotent writes can duplicate data.","videoSeconds":1250,"refs":["vref_dad9bc01b395e634"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1250s"},{"id":"fb-v12-mon-014","sourceId":"V12-MON-014","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"Finance requires notification whenever a production pipeline fails, without a human opening Monitor every hour. What is the best documented approach?","type":"single","options":[{"id":"A","text":"Schedule Fabric admin monitoring workspace installation once a day.","why":"Incorrect: Workspace installation does not deliver incident alert conditions."},{"id":"B","text":"Configure pipeline run alerts (or a suitable monitored event/notification workflow) and verify recipients and conditions.","why":"Correct: Correct intentional alerting solution."},{"id":"C","text":"Assume the pipeline detail page sends email automatically to all users.","why":"Incorrect: Not guaranteed by opening a page."},{"id":"D","text":"Create a Warehouse SQL view called Alert.","why":"Incorrect: A static view is not a notification process."}],"correct":["B"],"explanation":"Proactive monitoring requires explicit alert configuration; viewing run history is a reactive step.","videoSeconds":1080,"refs":["vref_320f8cb7f91e878c","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1080s"},{"id":"fb-v12-mon-015","sourceId":"V12-MON-015","pack":"video12","topic":"Pipeline activity diagnostics / reruns","title":"Pipeline investigation","prompt":"A new multi-pipeline workflow chains a parent pipeline to child pipelines in separate workspaces. A late report occurs. Which TWO diagnostics are appropriate? (Select TWO.)","type":"multi","options":[{"id":"A","text":"Infer that each scheduled run must have succeeded because its item exists.","why":"Incorrect: Existence of an artifact conveys no execution result."},{"id":"B","text":"Use execution relationships in the new Monitoring hub to inspect upstream/downstream runs.","why":"Correct: Correct modern execution linkage."},{"id":"C","text":"Inspect the relevant child pipeline’s run activities and durations.","why":"Correct: Correct detailed activity evidence."},{"id":"D","text":"Check Warehouse query hash only and ignore child pipelines.","why":"Incorrect: SQL patterns may be relevant only after localizing a SQL bottleneck."},{"id":"E","text":"Use deployment rules as a live run trace.","why":"Incorrect: Deployment rules are not runtime tracing."}],"correct":["B","C"],"explanation":"Trace orchestration dependencies first, then inspect the slow/failing child activities for evidence.","videoSeconds":1099,"refs":["vref_dad9bc01b395e634"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=1099s"},{"id":"fb-v12-mon-016","sourceId":"V12-MON-016","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"Interactive SQL queries are delayed at peak load while multiple background notebook jobs continue running. The capacity admin wants to determine whether CU pressure and throttling coincide. What is the correct data surface?","type":"single","options":[{"id":"A","text":"Monitoring hub job names alone without CU metrics.","why":"Incorrect: Missing CU pressure context."},{"id":"B","text":"The Git commit graph.","why":"Incorrect: Git is artifact history."},{"id":"C","text":"Capacity Metrics Health/Compute or Monitor hub capacity details, correlated with workload timestamps.","why":"Correct: Correct capacity-specific evidence."},{"id":"D","text":"The semantic model diagram in Desktop.","why":"Incorrect: Model shape is not capacity telemetry."}],"correct":["C"],"explanation":"Capacity utilization, interactive/background load and throttling provide an operational explanation; item-run statuses alone do not.","videoSeconds":215,"refs":["vref_efe82a7410b49fc3","vref_e468c481337ea4ed"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=215s"},{"id":"fb-v12-mon-017","sourceId":"V12-MON-017","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"At 14:05 a heavy workload consumes CUs, and a new workspace is created. At 14:20 the app shows the activity but not the new workspace dimension. Which explanation best matches the current Metrics documentation?","type":"single","options":[{"id":"A","text":"All app dimensions are refreshed in exactly the same five-minute interval.","why":"Incorrect: Different data categories have different update paths."},{"id":"B","text":"Usage refreshes only once per month.","why":"Incorrect: Not the documented time scale."},{"id":"C","text":"Data remains unavailable until Git synchronization.","why":"Incorrect: Git sync is unrelated."},{"id":"D","text":"Usage data commonly appears after about 10–15 minutes, while workspace/item metadata can depend on midnight model refresh.","why":"Correct: Correct refresh distinction."}],"correct":["D"],"explanation":"Distinguish usage processing latency from scheduled dimensional refresh. Manual semantic model refresh can help newly created items appear sooner.","videoSeconds":218,"refs":["vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=218s"},{"id":"fb-v12-mon-018","sourceId":"V12-MON-018","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"A tenant has multiple Fabric capacities. The operations lead is a capacity admin for only two. Which TWO actions are consistent with least privilege? (Select TWO.)","type":"multi","options":[{"id":"A","text":"Expect all capacity-admin-only management controls to be available to report viewers.","why":"Incorrect: A shared report does not elevate management rights."},{"id":"B","text":"Declare the colleague an Azure subscription Owner as a precondition for viewing a shared report.","why":"Incorrect: Viewing a shared report does not mandate Azure subscription ownership."},{"id":"C","text":"Assume every workspace viewer can install the app.","why":"Incorrect: Viewer workspace rights do not replace install authorization."},{"id":"D","text":"Share the Metrics report with an authorized colleague who is not a capacity admin.","why":"Correct: Report sharing to authorized users is supported."},{"id":"E","text":"Install or configure the Capacity Metrics app using an eligible capacity-admin account.","why":"Correct: Installation requires capacity-admin privileges plus licensing prerequisites."}],"correct":["D","E"],"explanation":"A capacity administrator installs the app and may share the report; access to view a report does not confer full capacity management authority.","videoSeconds":290,"refs":["vref_fb3c591214a49a11","vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=290s"},{"id":"fb-v12-mon-019","sourceId":"V12-MON-019","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"Two warehouse reports have equal average duration, but one is run 2,000 times daily and appears as a high CU consumer. What is the best optimization priority?","type":"single","options":[{"id":"A","text":"Ignore the workload because it succeeded.","why":"Incorrect: Success does not imply low cost."},{"id":"B","text":"Disable all workspace monitoring.","why":"Incorrect: Disabling monitoring hides evidence without fixing load."},{"id":"C","text":"Prioritize based solely on the longest single run.","why":"Incorrect: A single longest run is not necessarily largest aggregate CU."},{"id":"D","text":"Investigate high aggregate consumption using item-level Compute/operations data and query frequency.","why":"Correct: Correct triage via total resource impact."}],"correct":["D"],"explanation":"Frequency multiplied by per-run resource cost can dominate aggregate capacity consumption; use item-level CU plus query statistics.","videoSeconds":254,"refs":["vref_efe82a7410b49fc3","vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=254s"},{"id":"fb-v12-mon-020","sourceId":"V12-MON-020","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"An admin enables an independent Spark autoscale compute configuration. The team wants to attribute spend to this pool rather than treat it as standard Fabric CU usage. Which evidence should be consulted?","type":"single","options":[{"id":"A","text":"Admin Inventory report’s “inactive” flag.","why":"Incorrect: Inventory inactivity is not a spend meter."},{"id":"B","text":"Fabric workspace endorsement labels only.","why":"Incorrect: Governance labels are not compute billing."},{"id":"C","text":"Autoscale for Spark monitoring in the Capacity Metrics app, together with the corresponding pool billing model.","why":"Correct: Correct monitoring dimension."},{"id":"D","text":"Warehouse connection encryption status.","why":"Incorrect: Connection detail is irrelevant."}],"correct":["C"],"explanation":"Autoscale for Spark has monitoring distinct from general capacity usage; cost conclusions require its documented billing mode.","videoSeconds":256,"refs":["vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=256s"},{"id":"fb-v12-mon-021","sourceId":"V12-MON-021","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"A CFO asks to configure an email alert directly inside the Capacity Metrics app whenever CU consumption spikes. Which answer is technically defensible in current documentation?","type":"single","options":[{"id":"A","text":"Rename the workspace “Alert” so monitoring notifies users.","why":"Incorrect: Workspace name is not an alert configuration."},{"id":"B","text":"The app does not itself support alerts; use supported Fabric capacity event/alert facilities for notifications.","why":"Correct: Correct; separate reporting from notification capabilities."},{"id":"C","text":"The app natively supports arbitrary thresholds and alerts on each chart.","why":"Incorrect: Not supported by app documentation."},{"id":"D","text":"Use sys.dm_exec_requests to set a tenant-level alert threshold.","why":"Incorrect: SQL DMVs are diagnostic views, not a subscription engine."}],"correct":["B"],"explanation":"The Capacity Metrics app is an analysis surface, not its own notification engine; Fabric capacity events provide alert paths.","videoSeconds":198,"refs":["vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=198s"},{"id":"fb-v12-mon-022","sourceId":"V12-MON-022","pack":"video12","topic":"Capacity CU, throttling and freshness","title":"Capacity metrics","prompt":"An engineer proposes creating a new custom Power BI report directly against the internal semantic model created by the installed Capacity Metrics app. The team needs a supported implementation. What should the reviewer advise?","type":"single","options":[{"id":"A","text":"Delete the app so its dataset becomes unrestricted.","why":"Incorrect: Deleting app is not a support workaround."},{"id":"B","text":"Microsoft states that consuming, using or modifying the app semantic model outside the reports provided with the app is unsupported; use supported outputs or an independently maintained monitoring model.","why":"Correct: Correct current documented limitation."},{"id":"C","text":"Treat the installed semantic model as read-only supported reusable enterprise dataset.","why":"Incorrect: The support boundary is stricter than this claim."},{"id":"D","text":"Any model re-use is explicitly supported without qualification.","why":"Incorrect: Direct custom model usage is not universally supported."}],"correct":["B"],"explanation":"Current Metrics limitations explicitly disallow unsupported usage/modification of its provided semantic model, correcting the video-era suggestion.","videoSeconds":175,"refs":["vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=175s"},{"id":"fb-v12-mon-023","sourceId":"V12-MON-023","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"An organization enables workspace monitoring on Friday and discovers no KQL telemetry for Wednesday failures. The new Monitoring item appears healthy. What is the best diagnosis?","type":"single","options":[{"id":"A","text":"The absence proves the Eventhouse is full.","why":"Incorrect: No capacity evidence supports an Eventhouse full condition."},{"id":"B","text":"The missing rows prove Wednesday had no incidents.","why":"Incorrect: The lack of historic telemetry is expected and not proof of zero incidents."},{"id":"C","text":"Workspace monitoring does not backfill prior activity; logs begin after data collection is enabled for supported items.","why":"Correct: Correct documented collection boundary."},{"id":"D","text":"Monitoring automatically imports all pre-existing query history when installed.","why":"Incorrect: No retroactive import promised."}],"correct":["C"],"explanation":"The current Monitoring item architecture begins collecting after explicit enablement and has no automatic historic backfill.","videoSeconds":336,"refs":["vref_8ea741ad8e9b2d71"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=336s"},{"id":"fb-v12-mon-024","sourceId":"V12-MON-024","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"Three same-region workspaces each need long-term analysis in a central KQL observability environment. Architects also want to minimize isolated Eventhouse costs. Which solution best follows current documented architecture?","type":"single","options":[{"id":"A","text":"Enable monitoring in a different Azure region with no constraints.","why":"Incorrect: Cross-region routing is constrained."},{"id":"B","text":"Create several independent Monitoring items in every workspace for each workload.","why":"Incorrect: One collection item per workspace limit forbids parallel collectors for same workspace."},{"id":"C","text":"Use Git to merge live run logs across tenants.","why":"Incorrect: Git does not aggregate runtime telemetry."},{"id":"D","text":"Configure one Monitoring item per workspace and send telemetry to a shared Monitoring item’s Eventhouse where supported.","why":"Correct: Correct centralization approach within region constraints."}],"correct":["D"],"explanation":"Current workspace monitoring supports routing monitoring telemetry to another Monitoring item in the same region; one monitoring item collects telemetry for each workspace at a time.","videoSeconds":347,"refs":["vref_8ea741ad8e9b2d71"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=347s"},{"id":"fb-v12-mon-025","sourceId":"V12-MON-025","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"The team wants a historical, queryable log of pipeline activity across an entire workspace for a bespoke SLA dashboard. They need KQL rather than clicking through individual job runs. What should be designed?","type":"single","options":[{"id":"A","text":"Enable supported workspace monitoring telemetry and query its Monitoring database with KQL.","why":"Correct: Correct logs-plus-KQL pattern."},{"id":"B","text":"Open every pipeline manually and export screen captures.","why":"Incorrect: Manual screenshots cannot provide a robust queryable log."},{"id":"C","text":"Query sys.dm_exec_connections for notebook activities.","why":"Incorrect: SQL DMV does not represent pipeline activity-level logs."},{"id":"D","text":"Read the Capacity Metrics app semantic model as a supported custom source.","why":"Incorrect: App model reuse carries support limits and wrong granularity."}],"correct":["A"],"explanation":"Workspace monitoring stores supported activity logs in the monitoring database for KQL analysis, dashboards and alerts.","videoSeconds":362,"refs":["vref_8ea741ad8e9b2d71","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=362s"},{"id":"fb-v12-mon-026","sourceId":"V12-MON-026","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"A telemetry Eventstream continues to receive data but its downstream transformation is falling behind. The engineer wants measurable lag and error counts from time-series logs. Which TWO signals are appropriate? (Select TWO.)","type":"multi","options":[{"id":"A","text":"Watermark delay and backlogged input events from EventStreamMetrics.","why":"Correct: Correct streaming lag signals."},{"id":"B","text":"The Warehouse sys.dm_exec_connections encryption setting.","why":"Incorrect: Connection encryption does not quantify stream lag."},{"id":"C","text":"Endorsement count in Admin Inventory.","why":"Incorrect: Governance metric unrelated."},{"id":"D","text":"Power BI dataset relationship cardinality.","why":"Incorrect: Model cardinality unrelated."},{"id":"E","text":"Runtime error counts/details from EventStreamErrorMetrics and diagnostics.","why":"Correct: Correct stream failure evidence."}],"correct":["A","E"],"explanation":"Eventstream-specific metrics provide lag/backlog; error metrics and diagnostics isolate event processing failures.","videoSeconds":357,"refs":["vref_c3f851c8822446b3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=357s"},{"id":"fb-v12-mon-027","sourceId":"V12-MON-027","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"A Workspace Contributor and a Workspace Viewer ask to query the Monitoring KQL database directly. Which statement is aligned with current workspace monitoring guidance?","type":"single","options":[{"id":"A","text":"Contributor can query workspace monitoring data; a Viewer should not be assumed to have that role-based entitlement.","why":"Correct: Correct minimum documented workspace role for monitoring queries."},{"id":"B","text":"Monitoring query access is identical to Warehouse KILL permission.","why":"Incorrect: KQL read privilege differs from SQL session termination."},{"id":"C","text":"Both automatically have equal query access.","why":"Incorrect: Not supported equivalence."},{"id":"D","text":"Neither can query any logs; only tenant admins may.","why":"Incorrect: Contributor access is explicitly documented."}],"correct":["A"],"explanation":"Current general workspace monitoring documentation names Contributor or higher for direct monitoring database queries.","videoSeconds":388,"refs":["vref_8ea741ad8e9b2d71"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=388s"},{"id":"fb-v12-mon-028","sourceId":"V12-MON-028","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"An administrator proposes enabling workspace monitoring on every heavily loaded F2 capacity without budgeting compute or retention. What is the highest-value architecture review?","type":"single","options":[{"id":"A","text":"Turn off all query diagnostics to avoid alerts.","why":"Incorrect: Loss of needed evidence is not a cost plan."},{"id":"B","text":"Monitoring data never produces KQL query load.","why":"Incorrect: KQL analytical queries themselves consume resources."},{"id":"C","text":"Monitoring logs can consume capacity and storage; estimate expected volume, retention and centralized collection options.","why":"Correct: Correct capacity-conscious observability design."},{"id":"D","text":"Monitoring is free and storage-less so no review is required.","why":"Incorrect: Telemetry has compute/storage implications."}],"correct":["C"],"explanation":"Monitoring infrastructure writes, retains and queries telemetry; its economics and capacity implications should be considered before rollout.","videoSeconds":392,"refs":["vref_8ea741ad8e9b2d71","vref_efe82a7410b49fc3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=392s"},{"id":"fb-v12-mon-029","sourceId":"V12-MON-029","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"A cross-warehouse latency dashboard uses `WarehouseExecutions` and identifies a single suspicious `OperationId`. Engineers now require the precise query text and per-execution CPU metrics. Where should they go next?","type":"single","options":[{"id":"A","text":"Query EventStreamNodeStatus because it contains Warehouse SQL text.","why":"Incorrect: Eventstream status is not Warehouse SQL request history."},{"id":"B","text":"Read current sys.dm_exec_connections and assume the original query is still running.","why":"Incorrect: Active connection DMV cannot reconstruct past request text in general."},{"id":"C","text":"Search Admin Inventory by sensitivity label only.","why":"Incorrect: Governance tags omit query telemetry."},{"id":"D","text":"Join this OperationId to `queryinsights.exec_requests_history.distributed_statement_id` in the associated Warehouse.","why":"Correct: Correct documented cross-scope drill-down."}],"correct":["D"],"explanation":"Workspace monitoring captures the broad execution signal; Query Insights preserves detailed request history linked by operation/statement identifiers.","videoSeconds":547,"refs":["vref_e5f6c82cfe8cc1c9","vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=547s"},{"id":"fb-v12-mon-030","sourceId":"V12-MON-030","pack":"video12","topic":"Monitoring items and cross-workload telemetry","title":"Workspace monitoring","prompt":"An outdated slide says workspace monitoring supports only semantic models, mirrored databases and Eventhouse. A new roll-out also needs Pipeline activity logs and Warehouse query logs. What is the correct action?","type":"single","options":[{"id":"A","text":"Consult current supported telemetry table and enable collection for supported item types; account for feature-specific prerequisites.","why":"Correct: Correct current feature verification."},{"id":"B","text":"Treat old slide as complete and reject the requirements.","why":"Incorrect: Outdated static scope list."},{"id":"C","text":"Force all pipeline telemetry into sys.dm_exec_requests.","why":"Incorrect: SQL requests DMV is not pipeline log ingestion."},{"id":"D","text":"Assume every unlisted service is always supported without checking.","why":"Incorrect: Support is explicit rather than universal."}],"correct":["A"],"explanation":"Current documentation lists additional workload logs including Pipeline activities and Warehouse queries. Scope changes over time; verify current settings per service.","videoSeconds":356,"refs":["vref_8ea741ad8e9b2d71","vref_e5f6c82cfe8cc1c9"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=356s"},{"id":"fb-v12-mon-031","sourceId":"V12-MON-031","pack":"video12","topic":"Tenant-wide usage, adoption and governance","title":"Admin monitoring","prompt":"The security team opens Admin monitoring for the first time and sees blank reports. The administrator has the Fabric admin role and no refresh failures are reported. What is the appropriate next step?","type":"single","options":[{"id":"A","text":"Wait for the initial installation refresh to populate the read-only workspace, then validate reports.","why":"Correct: Correct first-use behavior."},{"id":"B","text":"Give every analyst Azure subscription Owner.","why":"Incorrect: Privileges unrelated."},{"id":"C","text":"Immediately delete the monitoring workspace as corrupt.","why":"Incorrect: Unnecessary destructive action."},{"id":"D","text":"Run Warehouse `KILL` commands to populate it.","why":"Incorrect: SQL session termination does not create tenant adoption data."}],"correct":["A"],"explanation":"The admin monitoring workspace is initialized upon first admin access, and the initial model refresh starts shortly afterward.","videoSeconds":441,"refs":["vref_ce2895726543b0cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=441s"},{"id":"fb-v12-mon-032","sourceId":"V12-MON-032","pack":"video12","topic":"Tenant-wide usage, adoption and governance","title":"Admin monitoring","prompt":"The COO wants to identify unused Fabric items across workspaces before consolidation. Which analytics view and caveat fit?","type":"single","options":[{"id":"A","text":"Monitoring hub’s current active jobs list supplies all historical item-adoption evidence.","why":"Incorrect: Current jobs are not a comprehensive tenant inventory."},{"id":"B","text":"Only sys.dm_exec_requests for one Warehouse and infer zero tenant usage.","why":"Incorrect: One active warehouse DMV is too narrow."},{"id":"C","text":"Capacity CU metrics alone prove all content is unused.","why":"Incorrect: CU usage does not capture every aspect of adoption."},{"id":"D","text":"Admin monitoring Feature usage/Inventory, noting “inactive” is based on absence of tracked audit activity in the considered period.","why":"Correct: Correct tenant governance/adoption evidence."}],"correct":["D"],"explanation":"Tenant-level Inventory and Feature usage support estate-wide activity decisions; audit activity is a signal, not an unqualified proof of no business value.","videoSeconds":466,"refs":["vref_ce2895726543b0cd","vref_74a0dd9599410a57"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=466s"},{"id":"fb-v12-mon-033","sourceId":"V12-MON-033","pack":"video12","topic":"Tenant-wide usage, adoption and governance","title":"Admin monitoring","prompt":"An admin wants to edit a prebuilt Admin monitoring semantic model directly to add departmental columns. Which statement best matches the current documented limitations?","type":"single","options":[{"id":"A","text":"Editing the underlying system model is required to change tenant settings.","why":"Incorrect: Tenant settings are not managed by arbitrary model edits."},{"id":"B","text":"Admin monitoring is a specialized read-only workspace; build external analysis rather than modify its protected included items.","why":"Correct: Correct protection boundary."},{"id":"C","text":"Giving Build permission always makes the included semantic model editable.","why":"Incorrect: Build/Read do not override read-only item restrictions."},{"id":"D","text":"All Admin monitoring artifacts are fully editable by anyone with workspace Admin.","why":"Incorrect: Contradicts documented read-only restrictions."}],"correct":["B"],"explanation":"Admin monitoring is not a normal writable workspace. Separate custom reporting from packaged read-only service-managed assets.","videoSeconds":498,"refs":["vref_ce2895726543b0cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=498s"},{"id":"fb-v12-mon-034","sourceId":"V12-MON-034","pack":"video12","topic":"Tenant-wide usage, adoption and governance","title":"Admin monitoring","prompt":"A non-admin analyst needs selected usage reports but must not gain the Fabric tenant admin role. Which TWO controls/constraints matter? (Select TWO.)","type":"multi","options":[{"id":"A","text":"Treat the workspace like an unrestricted writable development area.","why":"Incorrect: Read-only service-managed resource."},{"id":"B","text":"Require the analyst to become the installer to receive any read permission.","why":"Incorrect: Installer does not need to be every reader."},{"id":"C","text":"Assume every reader can modify packaged semantic models.","why":"Incorrect: Readers cannot edit managed models."},{"id":"D","text":"Have a Fabric administrator initialize the Admin monitoring workspace.","why":"Correct: Correct bootstrap privilege."},{"id":"E","text":"Grant suitable workspace/item access to the analyst after initialization.","why":"Correct: Correct least-privilege access delegation."}],"correct":["D","E"],"explanation":"The Fabric administrator initializes the workspace, and authorized non-admins can receive access through workspace/item sharing while respecting read-only behavior.","videoSeconds":530,"refs":["vref_ce2895726543b0cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=530s"},{"id":"fb-v12-mon-035","sourceId":"V12-MON-035","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"A finance Warehouse has a report hanging now. The admin wants to identify active SQL statements and elapsed time, not last month’s performance trends. Which starting view is appropriate?","type":"single","options":[{"id":"A","text":"sys.dm_exec_requests","why":"Correct: Correct live-request DMV."},{"id":"B","text":"queryinsights.exec_sessions_history","why":"Incorrect: Historical sessions, not active command details."},{"id":"C","text":"queryinsights.frequently_run_queries","why":"Incorrect: Aggregated historical queries, not active request ledger."},{"id":"D","text":"Admin monitoring Inventory","why":"Incorrect: Tenant item inventory, not live SQL."}],"correct":["A"],"explanation":"`sys.dm_exec_requests` provides live requests and elapsed time; historical Query Insights is not the first response for a running SQL session.","videoSeconds":642,"refs":["vref_ee5d78793d52d9a3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=642s"},{"id":"fb-v12-mon-036","sourceId":"V12-MON-036","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"The warehouse administrator knows a suspicious session ID but must identify the authenticated user before taking any action. Which DMV supplies the login name?","type":"single","options":[{"id":"A","text":"Fabric workspace capacity metadata","why":"Incorrect: Capacity metadata is not login/session data."},{"id":"B","text":"sys.dm_exec_sessions","why":"Correct: Correct authenticated session identity."},{"id":"C","text":"queryinsights.long_running_queries only","why":"Incorrect: Aggregations do not directly identify a live session by ID."},{"id":"D","text":"sys.dm_exec_connections only","why":"Incorrect: Connection protocol is not the best source of user login."}],"correct":["B"],"explanation":"Sessions represent authenticated users, including login_name; connections represent connection attributes.","videoSeconds":618,"refs":["vref_ee5d78793d52d9a3"],"code":"","origin":"extension","difficulty":4,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=618s"},{"id":"fb-v12-mon-037","sourceId":"V12-MON-037","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"A security audit needs client connection protocol and connection IP for current Warehouse sessions, including users other than the investigator. Who should retrieve the data and from where?","type":"single","options":[{"id":"A","text":"A workspace Contributor via semantic model refresh history.","why":"Incorrect: Refresh jobs do not reveal current SQL connections."},{"id":"B","text":"Anyone with report Read via queryinsights.frequently_run_queries.","why":"Incorrect: Aggregated history is not connection protocol."},{"id":"C","text":"A Workspace Admin via sys.dm_exec_connections, optionally joined to sys.dm_exec_sessions.","why":"Correct: Correct role and source."},{"id":"D","text":"A Workspace Viewer via sys.dm_exec_connections for all users.","why":"Incorrect: Viewers cannot execute connections DMV."}],"correct":["C"],"explanation":"Current docs reserve sys.dm_exec_connections for workspace Admins; the view includes connection-level details and can be joined to sessions.","videoSeconds":597,"refs":["vref_ee5d78793d52d9a3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=597s"},{"id":"fb-v12-mon-038","sourceId":"V12-MON-038","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"A Workspace Contributor executes `sys.dm_exec_requests` while an Admin sees several additional concurrent requests. The Contributor knows those queries are real. What best explains the difference?","type":"single","options":[{"id":"A","text":"The Admin has disabled Query Insights and that changes live DMV visibility.","why":"Incorrect: Query Insights setting is not the reason for live role scoping."},{"id":"B","text":"All Members automatically see all requests in every workspace.","why":"Incorrect: Non-admin visibility is scoped, not tenant-wide."},{"id":"C","text":"Contributor requests are scoped to the user’s own sessions/requests.","why":"Correct: Correct scoped visibility."},{"id":"D","text":"The DMV holds only historic requests.","why":"Incorrect: Requests DMV is live."}],"correct":["C"],"explanation":"Current DMV access limits Members/Contributors/Viewers to their own live sessions and requests, while Admins see all.","videoSeconds":698,"refs":["vref_ee5d78793d52d9a3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=698s"},{"id":"fb-v12-mon-039","sourceId":"V12-MON-039","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"A verified runaway session is consuming capacity. The team wants to terminate it. What is the permitted and correctly targeted method?","type":"single","options":[{"id":"A","text":"Change the capacity SKU to zero until the query disappears.","why":"Incorrect: Resizing is an overbroad production impact and not the targeted operation."},{"id":"B","text":"Delete rows from queryinsights.exec_requests_history.","why":"Incorrect: Query telemetry history is not a control plane."},{"id":"C","text":"Issue KILL with the query hash as a Viewer.","why":"Incorrect: KILL targets session ID and requires Admin."},{"id":"D","text":"Use `KILL <session_id>` while connected as a Warehouse workspace Admin, after verifying the session.","why":"Correct: Correct authorized session termination."}],"correct":["D"],"explanation":"Workspace Admins can terminate a live session using the numeric session ID. Because it affects active work, first verify ownership and rollback impact.","videoSeconds":699,"refs":["vref_ee5d78793d52d9a3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=699s"},{"id":"fb-v12-mon-040","sourceId":"V12-MON-040","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"A run completed yesterday and is no longer active. A new incident occurs now. Which TWO evidence sources map directly to yesterday’s completed query and the currently running statement? (Select TWO.)","type":"multi","options":[{"id":"A","text":"sys.dm_exec_requests for the currently running statement.","why":"Correct: Correct live request source."},{"id":"B","text":"queryinsights.exec_sessions_history for real-time request text.","why":"Incorrect: Sessions history is not real-time request text."},{"id":"C","text":"sys.dm_exec_connections for every completed statement text last month.","why":"Incorrect: Connections DMV is live and not query-history text."},{"id":"D","text":"Admin monitoring Inventory to obtain current SQL text.","why":"Incorrect: Inventory is governance scope."},{"id":"E","text":"queryinsights.exec_requests_history for yesterday.","why":"Correct: Correct historical request source."}],"correct":["A","E"],"explanation":"Query Insights retains completed request history while `sys.dm_exec_requests` inspects live activity.","videoSeconds":763,"refs":["vref_ee5d78793d52d9a3","vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=763s"},{"id":"fb-v12-mon-041","sourceId":"V12-MON-041","pack":"video12","topic":"SQL DMV lifecycle and privileges","title":"Live SQL DMVs","prompt":"A Workspace Admin must map the live command text and remote connection properties to a named user. Which join path is most relevant?","type":"single","options":[{"id":"A","text":"Monitoring hub failed jobs → semantic model measure table.","why":"Incorrect: No SQL lifecycle link."},{"id":"B","text":"sys.dm_exec_connections → sys.dm_exec_sessions → sys.dm_exec_requests via session linkage.","why":"Correct: Correct lifecycle relationship."},{"id":"C","text":"Only sys.dm_exec_connections, which includes all request text and user-session metadata by itself.","why":"Incorrect: Connection view alone omits complete authenticated session/request details."},{"id":"D","text":"queryinsights.long_running_queries → Admin inventory → workspace endorsements.","why":"Incorrect: Governance dimension unrelated to active command."}],"correct":["B"],"explanation":"The connection, authenticated session and active request views describe different stages of the lifecycle; join by session identifiers to build a full operational picture.","videoSeconds":625,"refs":["vref_ee5d78793d52d9a3"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=625s"},{"id":"fb-v12-mon-042","sourceId":"V12-MON-042","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"The analyst executes a new expensive statement and immediately searches Query Insights, but the query is absent. The statement completed normally. What should they do?","type":"single","options":[{"id":"A","text":"Delete the Warehouse to rebuild monitoring.","why":"Incorrect: Destructive and irrelevant."},{"id":"B","text":"Use live DMV only, which permanently stores completed requests.","why":"Incorrect: Live DMVs are transient."},{"id":"C","text":"Allow for Query Insights ingestion latency (up to about 15 minutes under load), then inspect request history.","why":"Correct: Correct documented delay."},{"id":"D","text":"Treat absence as evidence that SQL never ran.","why":"Incorrect: Not logically established."}],"correct":["C"],"explanation":"Query Insights is historical telemetry with nonzero ingestion latency; completed executions need time to materialize.","videoSeconds":788,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=788s"},{"id":"fb-v12-mon-043","sourceId":"V12-MON-043","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"A compliance team wants a complete 90-day record of every historical SQL request solely from native Query Insights views. What is the correct limitation to raise?","type":"single","options":[{"id":"A","text":"Its native historical retention is 30 days; plan an approved external retention/export strategy for longer evidence.","why":"Correct: Correct retention limit and solution implication."},{"id":"B","text":"The Monitoring hub guarantees all SQL query text forever.","why":"Incorrect: Hub is not indefinite warehouse query audit storage."},{"id":"C","text":"Query Insights inherently stores three full years.","why":"Incorrect: Not documented."},{"id":"D","text":"sys.dm_exec_requests retains 90 days.","why":"Incorrect: Live DMV does not store long-term query history."}],"correct":["A"],"explanation":"Native Query Insights retains historical SQL execution data for 30 days. Long-term compliance evidence needs separate approved design.","videoSeconds":755,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=755s"},{"id":"fb-v12-mon-044","sourceId":"V12-MON-044","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"Performance engineering needs minimum, maximum, average run duration and failure counts for repeated query shapes. Which system view directly supports these statistics?","type":"single","options":[{"id":"A","text":"queryinsights.frequently_run_queries","why":"Correct: Correct complete query-pattern aggregate."},{"id":"B","text":"sys.dm_exec_sessions","why":"Incorrect: Live authentication/session metadata."},{"id":"C","text":"sys.dm_exec_connections","why":"Incorrect: Connection metadata is not query performance history."},{"id":"D","text":"queryinsights.long_running_queries","why":"Incorrect: Focuses on median and last duration, fewer statistics."}],"correct":["A"],"explanation":"Frequently-run query aggregation includes min/max/average and counts of success/failure/cancel for repeated query shapes.","videoSeconds":808,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=808s"},{"id":"fb-v12-mon-045","sourceId":"V12-MON-045","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"A regression appears in a parameterized SQL report. Two statements differ only in their date filter values. Which approach groups logically equivalent shapes while preserving drill-down?","type":"single","options":[{"id":"A","text":"Use Query Insights query_hash and examine similar executions.","why":"Correct: Correct documented shape-based grouping."},{"id":"B","text":"Group only by report name from Admin monitoring.","why":"Incorrect: Report title does not identify execution plan shape."},{"id":"C","text":"Join to sys.dm_exec_connections by host IP.","why":"Incorrect: IP does not identify query patterns."},{"id":"D","text":"Group solely by exact SQL text and reject parameterization.","why":"Incorrect: Exact literal text can split equivalent shapes."}],"correct":["A"],"explanation":"Query Insights normalizes query shapes and exposes a query hash for similar statements, even if predicates vary.","videoSeconds":823,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=823s"},{"id":"fb-v12-mon-046","sourceId":"V12-MON-046","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"One cross-database SQL query reads WH_SALES but is executed with WH_FINANCE as its connection context. Where should the Query Insights request history entry appear?","type":"single","options":[{"id":"A","text":"Only in the Warehouse containing the largest table.","why":"Incorrect: Storage-size ranking does not govern audit placement."},{"id":"B","text":"In the connected execution-context Warehouse (WH_FINANCE).","why":"Correct: Correct context-scoping rule."},{"id":"C","text":"No Query Insights entry is recorded for cross-database queries.","why":"Incorrect: Cross-database execution is not excluded as a class."},{"id":"D","text":"Every referenced Warehouse equally.","why":"Incorrect: Context attribution is not fan-out duplication."}],"correct":["B"],"explanation":"Completed query history is recorded for the Warehouse/endpoint context where the SQL was executed, not automatically for every referenced object.","videoSeconds":804,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=804s"},{"id":"fb-v12-mon-047","sourceId":"V12-MON-047","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"A Warehouse experiences intermittent resource pressure even though no single user query is consistently slow. The team wants pool-level pressure and configuration-change trends. Which view is a better first fit than a query-only aggregate?","type":"single","options":[{"id":"A","text":"queryinsights.sql_pool_insights","why":"Correct: Correct documented newer Query Insights view."},{"id":"B","text":"queryinsights.exec_sessions_history","why":"Incorrect: Past session metadata lacks pool pressure analysis."},{"id":"C","text":"Admin monitoring sensitivity labels","why":"Incorrect: Governance labels are unrelated."},{"id":"D","text":"sys.dm_exec_connections","why":"Incorrect: Current connection metadata, not pool pressure history."}],"correct":["A"],"explanation":"The sql_pool_insights view monitors SQL pool capacity/resource pressure and configuration signals, enabling comparison with query-level histories.","videoSeconds":794,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=794s"},{"id":"fb-v12-mon-048","sourceId":"V12-MON-048","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"A workspace-level KQL incident record includes the Warehouse execution OperationId but no full statement text. Which combination is the best precise forensic drill-down?","type":"single","options":[{"id":"A","text":"Correlate the Workspace ID with sys.dm_exec_connections.session_id without querying history.","why":"Incorrect: Workspace IDs and session IDs have different meaning."},{"id":"B","text":"Match the item display name to the Capacity Metrics app storage legend.","why":"Incorrect: Labels are not execution identity."},{"id":"C","text":"Use only Query Insights frequent aggregates without per-execution identifiers.","why":"Incorrect: Aggregations may omit the specific incident execution."},{"id":"D","text":"Correlate WarehouseExecutions.OperationId with queryinsights.exec_requests_history.distributed_statement_id.","why":"Correct: Correct cross-system correlation."}],"correct":["D"],"explanation":"OperationId and distributed_statement_id form the documented bridge between cross-workspace monitoring and per-query request history.","videoSeconds":788,"refs":["vref_e5f6c82cfe8cc1c9","vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=788s"},{"id":"fb-v12-mon-049","sourceId":"V12-MON-049","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"A data engineer with Workspace Contributor permission and SQL query access can query some historical statistics, but the graphical Warehouse Monitor is unavailable. Which TWO conclusions match the documented permissions? (Select TWO.)","type":"multi","options":[{"id":"A","text":"The graphical Warehouse Monitor requires Workspace Admin permission.","why":"Correct: Correct: graphical Monitor is workspace Admin-only."},{"id":"B","text":"Neither graphic view nor Query Insights is accessible below Fabric tenant admin.","why":"Incorrect: False: Contributor can use Query Insights under stated prerequisites."},{"id":"C","text":"Every Contributor has full graphical Monitor access by default.","why":"Incorrect: False: the UI is not automatically open to Contributors."},{"id":"D","text":"A Contributor meeting the Query Insights prerequisites can query the supported SQL history views.","why":"Correct: Correct: SQL-based history views have a less restrictive role requirement."},{"id":"E","text":"Only SQL Server Management Studio supports Query Insights.","why":"Incorrect: False: query insights can be queried through supported SQL tools."}],"correct":["A","D"],"explanation":"The graphical Warehouse Monitor and T-SQL Query Insights views have distinct role requirements: the UI requires Workspace Admin, whereas SQL history views can support Contributor or higher.","videoSeconds":893,"refs":["vref_7ee3ab405d54586c","vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=893s"},{"id":"fb-v12-mon-050","sourceId":"V12-MON-050","pack":"video12","topic":"Historical warehouse query analysis","title":"Query Insights","prompt":"A team uses Fabric SQL AI functions and wants diagnostics at the external API function-call level, plus aggregate warehouse query performance. Which TWO Query Insights views map to those demands? (Select TWO.)","type":"multi","options":[{"id":"A","text":"queryinsights.frequently_run_queries for query-pattern timing and result statistics.","why":"Correct: Correct repeated query aggregate."},{"id":"B","text":"queryinsights.exec_sessions_history for the exact external API breakdown.","why":"Incorrect: Sessions history tracks sessions rather than external function-level diagnostic fields."},{"id":"C","text":"queryinsights.external_api_call_stats for external function diagnostics.","why":"Correct: Correct specific external function diagnostic view."},{"id":"D","text":"Admin monitoring Inventory for per-call token/latency breakdown.","why":"Incorrect: Inventory adoption data does not replace execution-level function statistics."},{"id":"E","text":"sys.dm_exec_connections for historical AI response codes.","why":"Incorrect: Connection lifecycle view lacks historical external API call diagnostics."}],"correct":["A","C"],"explanation":"The latest Query Insights list adds an external API call statistics view, while frequently_run_queries remains appropriate for broad query-pattern analysis.","videoSeconds":828,"refs":["vref_04e9ffd542e82ed7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"DP-700 primary; DP-600 supporting / adjacent","provenance":"Original scenario inspired by timestamped educational video, with 2026-10-23 Microsoft Learn verification. Not a copied certification question.","validation":"Current Microsoft Learn concept checked; not execution-tested in a Fabric tenant. Timestamp represents corresponding discussion rather than exact independent screenshot inspection.","sourceVideoUrl":"https://www.youtube.com/watch?v=0HVN53x87yg&t=828s"}]
