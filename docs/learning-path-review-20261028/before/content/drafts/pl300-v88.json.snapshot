      "exam_objective": "Model the data",
      "exam_subobjective": "Distinguish one-to-one cardinality from complete matching-key coverage",
      "prompt": "Two imported dimension tables each have unique CustomerID values. DimCustomer contains 10,000 customers and DimLoyalty contains 8,200, with some missing customers. What does a valid one-to-one relationship guarantee?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Each related column contains unique values, but some customers in DimCustomer may have no matching loyalty row."
        },
        {
          "id": "B",
          "text": "Both tables must have identical row counts and a matching row for every customer."
        },
        {
          "id": "C",
          "text": "Every loyalty attribute must be nonblank for each DimCustomer row in every report visual."
        },
        {
          "id": "D",
          "text": "One-to-one relationships require exactly one fact-table row per customer."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB24-V20-004",
      "sourceId": "PL300-RB24-V20-004",
      "legacy_id": "PBI-V20-ONETOONE-004",
      "video_id": "V20",
      "video_title": "One-to-one dimension cardinality, merges and object-level security",
