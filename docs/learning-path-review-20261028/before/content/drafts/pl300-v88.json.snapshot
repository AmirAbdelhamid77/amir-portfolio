        {
          "id": "B",
          "text": "Join each budget row to every daily Sales row on Department, then sum budget."
        },
        {
          "id": "C",
          "text": "Use conformed dimensions, separate facts and grain-aware measures."
        },
        {
          "id": "D",
          "text": "Assign monthly Budget to the first transaction date and let daily breakdowns imply allocations."
        }
      ],
      "gradingEnabled": false
