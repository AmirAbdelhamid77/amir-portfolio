      "topic": "Privacy boundary",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Get or connect to data",
      "prompt": "A Power Query merge takes account identifiers from a Private Excel file and matches them to an Organizational SQL source. The privacy firewall blocks a combination that might transmit the private values. What is the safest response?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Import the source ID as a hash and assume all privacy constraints disappear."
        },
        {
          "id": "B",
          "text": "Set privacy to Organizational for both sources because the report is internal."
        },
        {
          "id": "C",
          "text": "Set privacy to Public for SQL and Private for Excel, then disable checks."
        },
        {
          "id": "D",
          "text": "Review the privacy classification and approved data flow before combining."
        }
      ],
      "gradingEnabled": false
