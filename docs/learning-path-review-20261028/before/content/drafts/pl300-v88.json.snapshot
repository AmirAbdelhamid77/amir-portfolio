      "topic": "Reduce columns",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A 20-column sales extract is imported into a Power BI semantic model. One column holds 200 KB of XML trace text per order, and no report, relationship, or measure uses it. The analyst plans to hide that column in Model view. Which alternative directly prevents importing the trace payload?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Add the trace column to a tooltip, and hide that tooltip on the report page."
        },
        {
          "id": "B",
          "text": "Set the trace column to Do not summarize so its values use less storage."
        },
        {
          "id": "C",
          "text": "Hide the trace from the Data pane while preserving the loaded table."
        },
        {
          "id": "D",
          "text": "Remove the trace column in Power Query before loading the semantic model."
        }
      ],
      "gradingEnabled": false
    },
    {
