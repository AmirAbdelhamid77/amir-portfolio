          "text": "Set a refresh interval on the Power BI mobile app for every report reader."
        },
        {
          "id": "D",
          "text": "Republish the PBIX daily with unchanged data; the service will infer the corrected CSV values."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-011",
      "sourceId": "PL300-RB12-V02-011",
      "legacy_id": "PBI-V02-CRASH-011",
      "video_id": "V02",
      "video_title": "Power BI end-to-end crash course",
