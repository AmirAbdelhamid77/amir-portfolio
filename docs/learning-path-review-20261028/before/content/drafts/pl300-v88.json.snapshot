        {
          "id": "B",
          "text": "AVERAGE(InvoiceLines[Units] * InvoiceLines[UnitPrice])"
        },
        {
          "id": "C",
          "text": "COUNTROWS(InvoiceLines) * MAX(InvoiceLines[UnitPrice])"
        },
        {
          "id": "D",
          "text": "SUM(InvoiceLines[Units]) * SUM(InvoiceLines[UnitPrice])"
        }
      ],
      "gradingEnabled": false
    },
