      "topic": "Date cleanup edge cases",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean the data",
      "prompt": "An upstream system prefixes valid ISO-style shipping dates with D. A parser encounters D2026-03-18, D2026-99-18 and D2026-03-19. Business policy forbids inventing invalid dates. Which transformation preserves data quality and source traceability?",
      "type": "single",
      "difficulty": 4,
      "code": "RowID | RawShipDate\nS1    | D2026-03-18\nS2    | D2026-99-18\nS3    | D2026-03-19\nValid month must be 01–12.",
      "options": [
        {
          "id": "A",
          "text": "Remove D and replace every parse failure with 2026-12-18 so aggregation remains complete."
        },
        {
          "id": "B",
          "text": "Keep raw values, remove verified D prefix, use try-to-date conversion and flag the invalid source row."
        },
        {
          "id": "C",
          "text": "Remove all alphabetic characters, cast as Date, and drop source text because the errors are temporary."
        },
        {
          "id": "D",
          "text": "Parse using a US date locale and coerce the invalid month to the nearest valid month before loading."
        }
      ],
      "gradingEnabled": false
