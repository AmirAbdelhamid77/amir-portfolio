      "prompt": "Sales records include promotions and Product keys. Budget is defined only at Product-Month grain, with no promotion allocation. Both facts share a conforming Product dimension. Which requested visual is defensible without inventing allocation?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Allocate monthly Budget to individual Sales invoice lines by using ProductKey alone."
        },
        {
          "id": "B",
          "text": "Show Sales and Budget by Product category, respecting both fact grains and valid dimension paths."
        },
        {
          "id": "C",
          "text": "Show monthly Budget by the Sales-only promotion field, allocating it in proportion to observed promotion sales even though no business-approved allocation rule exists."
        },
        {
          "id": "D",
          "text": "Show Returns by an unconnected Promotion dimension and assume its filter reaches Return amounts."
        }
      ],
      "gradingEnabled": false
