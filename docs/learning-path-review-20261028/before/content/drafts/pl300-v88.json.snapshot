      "exam_objective": "Model the data",
      "exam_subobjective": "TOPN ties",
      "prompt": "A report must return precisely five products ranked by sales even when products tie on sales. TOPN(5, Products, [Sales], DESC) sometimes returns six. What is the correct explanation and remediation?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
