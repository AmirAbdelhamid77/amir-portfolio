      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Field hygiene — Don't summarize",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "OrderID is a whole-number identifier, not an additive business metric. Report authors regularly drag it into a table visual and accidentally get Sum of OrderID. What modeling property addresses the default aggregation mistake?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Change the Order-to-Customer relationship to Both."
        },
        {
          "id": "B",
          "text": "Set OrderID default summarization to Don’t summarize."
        },
        {
          "id": "C",
          "text": "Replace OrderID with SUM(OrderID) as a certified measure."
        },
        {
          "id": "D",
          "text": "Use AVERAGE(OrderID) to generate a smaller identifier value."
        }
      ],
      "gradingEnabled": false
    },
    {
