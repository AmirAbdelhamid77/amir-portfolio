      "topic": "Power Query build",
      "exam_objective": "Model the data",
      "exam_subobjective": "Choose append versus merge transformations",
      "prompt": "Two source systems provide employee rows with identical field names, and the developer needs to stack them into one staging table before deduplication. Which Power Query action is appropriate?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Merge, because matching field names are automatically used to join rows on all columns."
        },
        {
          "id": "B",
          "text": "Group By, because it concatenates rows from several unrelated tables."
        },
        {
          "id": "C",
          "text": "Append, because it combines rows by matching column names; Merge is for joining columns on keys."
        },
        {
          "id": "D",
          "text": "Sort, because ordering two queries causes them to be combined when loaded."
        }
      ],
      "gradingEnabled": false
    },
