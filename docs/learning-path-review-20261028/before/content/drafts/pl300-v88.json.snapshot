      "exam_objective": "Prepare the data",
      "exam_subobjective": "Get or connect to data",
      "prompt": "Five Power Query queries read the same environment-specific SQL database, currently Sales_Dev. UAT and Production should reuse identical shaping but point to Sales_Test and Sales_Prod respectively. What design centralizes this environment switch?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Parameterize database name and reference it in the relevant source functions."
        },
        {
          "id": "B",
          "text": "Duplicate all five queries for each environment and hide inactive copies."
        },
        {
          "id": "C",
          "text": "Use a separate Power Query group per environment and edit every Source step."
        },
        {
          "id": "D",
          "text": "Store both names in an Excel dimension and select the environment via a slicer."
        }
      ],
      "gradingEnabled": false
