      "legacy_id": "PBI-V25-RLS-039",
      "topic": "Refresh failures credentials",
      "exam_objective": "Manage and secure Power BI",
      "exam_subobjective": "Refresh failures credentials",
      "prompt": "A semantic model scheduled refresh has worked for months; it now fails with invalid OAuth credentials after an account password change. Reports still display last refreshed data. What is the first operational action?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
