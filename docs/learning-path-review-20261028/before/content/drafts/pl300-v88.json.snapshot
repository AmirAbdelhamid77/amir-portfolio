          "id": "B",
          "text": "SUMX(Date, USERELATIONSHIP(Sales[DeliveryDate], Date[Date]))"
        },
        {
          "id": "C",
          "text": "RELATED(Date[Date]) without a row context or relationship override."
        },
        {
          "id": "D",
          "text": "Rename Sales[OrderDate] to DeliveryDate in the visual."
        }
      ],
      "gradingEnabled": false
    },
    {
