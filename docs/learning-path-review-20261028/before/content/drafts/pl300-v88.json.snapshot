      "draftId": "draft-pl300-v88-PL300-RB01-V10-001",
      "sourceId": "PL300-RB01-V10-001",
      "legacy_id": "PBI-V10-PQ-001",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 265,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=265s",
      "scope": "Microsoft Learn extension to video concept",
      "topic": "ETL ownership",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "An enterprise warehouse already validates and shapes 12 million order lines nightly for multiple downstream teams. A Power BI analyst needs only region and revenue measures, and a governed source view exists. Which design best avoids duplicating centralized ETL while preparing a lean Import model?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Import every source column and apply calculated columns to cleanse each attribute."
        },
        {
          "id": "B",
          "text": "Reuse governed SQL shaping; apply only report-specific steps in Power Query."
        },
        {
          "id": "C",
          "text": "Move the warehouse shaping into separate copies of the report’s Power Query queries."
        },
        {
          "id": "D",
          "text": "Load raw SQL into Power Query, then implement all governed cleansing again."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-002",
      "sourceId": "PL300-RB01-V10-002",
      "legacy_id": "PBI-V10-PQ-002",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 155,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=155s",
      "scope": "Video-grounded scenario rewrite",
      "topic": "Stage ordering",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A Power Query pipeline contains `Removed Columns`, `Changed Type`, and `Filtered Rows`. The filter is on `[OrderDate]`, but that column is dropped by `Removed Columns`. What should you change?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Filter on OrderDate before removing it, or retain it through filtering."
        },
        {
          "id": "B",
          "text": "Filter after removing OrderDate with the same field name."
        },
        {
          "id": "C",
          "text": "Reorder Changed Type after Removed Columns so the filter sees converted values."
        },
        {
          "id": "D",
          "text": "Use a column rename immediately after Removed Columns to restore OrderDate."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-003",
      "sourceId": "PL300-RB01-V10-003",
      "legacy_id": "PBI-V10-PQ-003",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 1000,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=1000s",
      "scope": "Video-grounded scenario rewrite",
      "topic": "Efficient source filtering",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A SQL Server fact table holds 140 million orders. The report needs only the past two years and six columns. Select TWO independent changes that can improve refresh performance.",
      "type": "multi",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Import all rows, then apply a page-level relative-date report filter."
        },
        {
          "id": "B",
          "text": "Change OrderDate to text to minimize date-based computation at source."
        },
        {
          "id": "C",
          "text": "Filter the required date range early and inspect whether the predicate folds."
        },
        {
          "id": "D",
          "text": "Sort all 140 million rows locally before any date filtering."
        },
        {
          "id": "E",
          "text": "Keep only the six required fields in the query, checking projection pushdown."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-004",
      "sourceId": "PL300-RB01-V10-004",
      "legacy_id": "PBI-V10-PQ-004",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 1000,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=1000s",
      "scope": "Microsoft Learn extension to video concept",
      "topic": "Pushdown limitations",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A SQL Server query folds through `Filtered Rows`, but an added custom operation cannot translate to SQL. What can be concluded?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Expect partial folding: SQL filters; custom work may run locally."
        },
        {
          "id": "B",
          "text": "Assume the custom step forces the engine to re-import every source column."
        },
        {
          "id": "C",
          "text": "Expect folding to stop for the entire query, including every earlier predicate."
        },
        {
          "id": "D",
          "text": "Rename the custom step to force SQL execution."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-005",
      "sourceId": "PL300-RB01-V10-005",
      "legacy_id": "PBI-V10-PQ-005",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 915,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=915s",
      "scope": "Video-grounded scenario rewrite",
      "topic": "Applied steps inspection",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A CustomerID column is valid after a Source step but becomes incorrect somewhere among six Power Query Applied Steps. A text split is suspected. What is the least destructive way to identify the FIRST step that corrupts the IDs?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Open the Advanced Editor and delete all steps after Source, then rebuild them."
        },
        {
          "id": "B",
          "text": "Use the query Dependencies view to identify which report visual references IDs."
        },
        {
          "id": "C",
          "text": "Compare only the final row count to the source."
        },
        {
          "id": "D",
          "text": "Inspect before-and-after previews of consecutive Applied Steps."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-006",
      "sourceId": "PL300-RB01-V10-006",
      "legacy_id": "PBI-V10-PQ-006",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 605,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=605s",
