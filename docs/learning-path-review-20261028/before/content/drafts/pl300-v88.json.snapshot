          "text": "Display median or percentiles alongside mean and a clear outlier indicator."
        },
        {
          "id": "C",
          "text": "Delete the 60-day shipment without investigating."
        },
        {
          "id": "D",
          "text": "Clip every delay above 2 days silently."
        }
      ],
      "gradingEnabled": false
    },
