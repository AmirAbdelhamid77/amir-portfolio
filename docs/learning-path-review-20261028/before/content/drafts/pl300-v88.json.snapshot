          "id": "B",
          "text": "SUM(Sales[ShipDate])"
        },
        {
          "id": "C",
          "text": "CALCULATE([Sales Amount], CROSSFILTER(Sales[ShipDate], 'Date'[Date], None))"
        },
        {
          "id": "D",
          "text": "RELATED('Date'[Date])"
        }
      ],
      "gradingEnabled": false
    },
