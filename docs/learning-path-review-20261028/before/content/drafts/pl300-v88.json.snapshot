      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Cross-filter direction",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "Invoice[InvoiceKey] and Invoice[CustomerKey] are distinct business identifiers, both stored as integers. A model relationship accidentally joins Invoice[InvoiceKey] to Customer[CustomerKey] and is accepted. What should the auditor conclude?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "A relationship accepted by Desktop proves that the matching integer codes describe the same business entity."
        },
        {
          "id": "B",
          "text": "Matching integers may identify different entities, yielding incorrect customer-level sales totals."
        },
        {
          "id": "C",
          "text": "Use Both cross-filtering so the mismatched business identifiers become valid."
        },
        {
          "id": "D",
          "text": "Assign the same display names to both key columns to establish referential integrity."
        }
      ],
      "gradingEnabled": false
    },
    {
