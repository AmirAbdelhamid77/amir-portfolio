      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "The product-dimension repair",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "A Product name matrix has a blank row, but a report author removes (Blank) and sees total revenue drop from 100 to 30. Which specific data-quality explanation and remediation should be tested?",
      "type": "single",
      "difficulty": 4,
      "code": "Product: (ProductID=1,Name=Widget), (ProductID=2,Name=Tool).\nSales: (ProductID=1,Amount=30), (ProductID=3,Amount=70).\nRelationship: regular ProductID (1)→Sales (*) active.",
      "options": [
        {
          "id": "A",
          "text": "The unknown product 3 maps to a virtual blank lookup member; investigate unmatched fact keys before hiding rows."
        },
        {
          "id": "B",
          "text": "Product 2 has no corresponding sale, so deleting Product 2 restores the omitted 70 in the matrix."
        },
        {
          "id": "C",
          "text": "The SUM measure is non-additive over Product; replacing SUM with MAX returns the complete 100."
        },
        {
          "id": "D",
          "text": "A one-to-many regular relationship cannot represent unmatched fact keys; convert it to many-to-many with Both-direction filters to recover all records."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB09-V18-038",
