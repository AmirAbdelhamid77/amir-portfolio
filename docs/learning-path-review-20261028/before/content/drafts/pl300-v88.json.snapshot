      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "The analyst changes `#\"Changed Type\"` to `#\"Changed Currency Type\"` in one M query step, but downstream steps still reference the old name. What is the likely result?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Convert every subsequent `#\"...\"` reference into a column-name string."
        },
        {
          "id": "B",
          "text": "Use the original SQL alias instead of the renamed step."
        },
        {
          "id": "C",
          "text": "Update subsequent references to match the renamed M step identifier."
        },
        {
          "id": "D",
          "text": "Change only the Applied Steps display caption while keeping old M references."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-007",
      "sourceId": "PL300-RB01-V10-007",
      "legacy_id": "PBI-V10-PQ-007",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 605,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=605s",
      "scope": "Video-grounded scenario rewrite",
      "topic": "M script structure",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A valid Power Query M `let` expression defines `Source`, `#\"Changed Type\"`, and finally `#\"Cleaned Rows\"`. You want the final query to return the table bound to the last step rather than its step NAME as text. Which `in` expression is correct?",
      "type": "single",
      "difficulty": 4,
      "code": "let\n    Source = #table({\"Amount\"}, {{10}, {-5}}),\n    #\"Changed Type\" = Table.TransformColumnTypes(Source, {{\"Amount\", type number}}),\n    #\"Cleaned Rows\" = Table.SelectRows(#\"Changed Type\", each [Amount] > 0)\n// Select the correct final `in` expression.",
      "options": [
        {
          "id": "A",
          "text": "in \"Cleaned Rows\""
        },
        {
          "id": "B",
          "text": "in #\"Cleaned Rows\""
        },
        {
          "id": "C",
          "text": "in #\"Changed Type\""
        },
        {
          "id": "D",
          "text": "in [Cleaned Rows]"
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-008",
