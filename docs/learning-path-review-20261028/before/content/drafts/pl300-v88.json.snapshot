      "legacy_id": "PBI-V04-DQ-017",
      "topic": "Accessible color encoding",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Accessible color encoding",
      "prompt": "A line chart compares shipping performance for three carriers. The author distinguishes lines only by red/green color and the legend is difficult for color-vision-deficient users. Which change best improves usability?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Use two subtly different reds instead of red and green."
        },
        {
          "id": "B",
          "text": "Remove the chart title and legend to save pixels."
        },
        {
          "id": "C",
          "text": "Use distinct line styles or markers plus accessible labels and sufficient contrast, not hue alone."
        },
        {
          "id": "D",
          "text": "Use tiny pastel labels that appear only on hover."
        }
      ],
      "gradingEnabled": false
    },
