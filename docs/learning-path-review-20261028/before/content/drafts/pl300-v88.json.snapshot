          "id": "B",
          "text": "Change the model storage mode to Direct Lake."
        },
        {
          "id": "C",
          "text": "Enable report subscriptions on the chart."
        },
        {
          "id": "D",
          "text": "Use drill down on selected hierarchy branch rather than expand all down one level."
        }
      ],
      "gradingEnabled": false
    },
