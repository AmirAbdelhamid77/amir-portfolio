      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean the data",
      "prompt": "A 9-million-row customer dimension has an optional SecondaryContact column, missing on many rows and unused by all current measures. A designer proposes replacing missing contacts with a long textual sentence. Select TWO concerns to evaluate before loading.",
      "type": "multi",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Power Query fails to load any text column containing null unless all rows are replaced."
