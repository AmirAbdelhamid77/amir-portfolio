      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "FactOrders has 1,000 rows with one CustomerID=9 line for 100 USD. DimCustomer mistakenly contains three matching CustomerID=9 records. A left outer Power Query merge is expanded to CustomerName, and the developer sums OrderAmount. What is the expected defect?",
      "type": "single",
      "difficulty": 4,
      "code": "Original rows=1,000; one matching order with amount 100 has 3 lookup matches. If all others have exactly one match, expanded rows=1,002 and that order contributes 300 instead of 100.",
      "options": [
        {
          "id": "A",
          "text": "The output remains exactly 1,000 rows because a left outer merge never expands the fact grain."
        },
        {
          "id": "B",
          "text": "The 100 USD order repeats three times, inflating totals by 200."
        },
        {
          "id": "C",
          "text": "Power Query turns unrelated model relationships inactive to avoid the duplicate expansion."
        },
        {
          "id": "D",
          "text": "The duplicated dimension has no effect until a DAX measure explicitly asks for CustomerName."
        }
      ],
      "gradingEnabled": false
    },
    {
