      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Pivot mechanics",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Pivot, unpivot and transpose data",
      "prompt": "Three rows share (Department=East, Month=Jan, Metric=Revenue) with Values 40, 60, and 60. The last 60 may be either a repeated import or a real second transaction. What must the analyst determine before pivoting?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Choose Dont Aggregate and accept the first value for each Department-Month-Metric cell, because the other repeated entries do not need reconciliation."
        },
        {
          "id": "B",
          "text": "Remove duplicates by Department, leaving a single January revenue row."
        },
        {
          "id": "C",
          "text": "Discard Metric and pivot Month; this ensures a correct total regardless of duplicates."
        },
        {
          "id": "D",
          "text": "Confirm event identity and target grain first; reconcile, then aggregate Sum only when repeated facts are legitimate."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB04-V13-022",
