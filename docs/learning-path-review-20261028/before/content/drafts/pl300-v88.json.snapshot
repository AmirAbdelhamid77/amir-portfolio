      "options": [
        {
          "id": "A",
          "text": "Configure and test appropriate object-level security or equivalent enforced permission boundaries for the sensitive table or columns."
        },
        {
          "id": "B",
          "text": "Only hide the table in the field list, because a hidden table cannot be queried or exposed by any user."
        },
        {
          "id": "C",
          "text": "Set the relationship to one-to-one, because cardinality automatically excludes unauthorized users."
        },
        {
          "id": "D",
          "text": "Remove the customer display name field, because report titles alone provide sufficient security for confidential notes."
        }
      ],
      "gradingEnabled": false
    },
    {
