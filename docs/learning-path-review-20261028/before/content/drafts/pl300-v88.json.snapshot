      "topic": "Reduce rows without loss",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A service ticket table spans 2012–2026. The business needs only incidents from 2024 onward; a filter hard-codes 2024 as a minimum. What happens when the model refreshes in 2027?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "The filter still includes 2024 onward until its cutoff expression changes."
        },
        {
          "id": "B",
          "text": "It changes to 2025 because relative date filters self-adjust during refresh."
        },
        {
          "id": "C",
          "text": "It keeps only 2026–2027 after refresh because older rows are archived."
        },
        {
          "id": "D",
          "text": "It fails because a historical year cannot be referenced by a Power Query filter."
        }
      ],
      "gradingEnabled": false
    },
    {
