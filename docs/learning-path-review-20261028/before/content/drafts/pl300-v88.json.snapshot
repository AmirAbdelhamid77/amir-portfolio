        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-013",
      "sourceId": "PL300-RB12-V02-013",
      "legacy_id": "PBI-V02-CRASH-013",
      "video_id": "V02",
      "video_title": "Power BI end-to-end crash course",
      "video_timestamp_seconds": 525,
      "video_url": "https://www.youtube.com/watch?v=WdCltDhmRLo&t=525s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Model view basics",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a semantic model — relationship cardinality and cross-filter direction",
      "prompt": "Customers contains one row per CustomerID. Orders contains many rows per customer. The model must let a Country filter on Customers reduce Sales totals in Orders, without unnecessarily propagating fact filters back to Customers. Which relationship configuration fits?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Customers[CustomerID] 1 to Orders[CustomerID] *; active, single cross-filter direction from Customers to Orders."
        },
        {
          "id": "B",
          "text": "Customers[CustomerID] * to Orders[CustomerID] *; bidirectional filtering is always faster."
        },
        {
          "id": "C",
          "text": "Customers[CustomerID] 1 to Orders[CustomerID] 1; filters must move from Orders to Customers."
        },
        {
          "id": "D",
          "text": "Leave the tables unrelated; selecting Customers[Country] automatically filters Orders[Sales]."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-014",
      "sourceId": "PL300-RB12-V02-014",
      "legacy_id": "PBI-V02-CRASH-014",
      "video_id": "V02",
      "video_title": "Power BI end-to-end crash course",
      "video_timestamp_seconds": 555,
      "video_url": "https://www.youtube.com/watch?v=WdCltDhmRLo&t=555s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Model view basics",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a semantic model — configure and verify relationships",
      "prompt": "The model has Customers[CustomerID] with unique, non-null values and Orders[CustomerID] with repeated matches. The existing relationship was accidentally deleted. Which option reestablishes the intended filter path with explicit control?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Merge Customers and Orders into one Power Query table and discard the dimension; relationships cannot be recreated."
        },
        {
          "id": "B",
          "text": "In Model view or Manage relationships, create an active 1:* relationship on CustomerID and inspect its Single cross-filter direction."
        },
        {
          "id": "C",
          "text": "Set the Sales field to Summarize by Sum; Power BI automatically restores missing relationships."
        },
        {
          "id": "D",
          "text": "Use a DAX calculated column with the same name in both tables; matching names alone create the relationship."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-015",
      "sourceId": "PL300-RB12-V02-015",
      "legacy_id": "PBI-V02-CRASH-015",
      "video_id": "V02",
      "video_title": "Power BI end-to-end crash course",
      "video_timestamp_seconds": 630,
      "video_url": "https://www.youtube.com/watch?v=WdCltDhmRLo&t=630s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Model view basics",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a semantic model — troubleshoot relationships and filtering",
      "prompt": "A report unexpectedly shows identical total sales for every customer segment. Model view contains several tables, and both Customers and Orders have a field named CustomerID. What should the analyst verify before rewriting DAX?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Locate both CustomerID fields in the model and inspect whether an active relationship on matching keys provides the intended filter path."
        },
        {
          "id": "B",
          "text": "Apply a different color palette to the visual because colors control relationship activity."
        },
        {
          "id": "C",
          "text": "Convert the CustomerID identifiers into SUM measures so the visual can aggregate them."
        },
        {
          "id": "D",
          "text": "Remove the Customers table and use only fields from Orders; separate dimension tables always corrupt totals."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-016",
      "sourceId": "PL300-RB12-V02-016",
