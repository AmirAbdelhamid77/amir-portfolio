      "topic": "Getting data",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Get or connect to data — choose storage and refresh for a data source",
      "prompt": "A report uses Import mode with a local CSV. An analyst corrects a source row after the PBIX has already loaded the table. The report still shows the previous value. What is the least disruptive next step when working in Desktop?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Change the report display units to Auto to invalidate the data cache."
