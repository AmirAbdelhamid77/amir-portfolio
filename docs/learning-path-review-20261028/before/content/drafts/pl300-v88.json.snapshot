      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "DimProduct uses TEXT ProductCode keys \"0007\" and \"0012\". An upstream Sales import turns those source codes into WHOLE NUMBERS 7 and 12. Sales category totals show unmatched products. Which repair is defensible?",
      "type": "single",
      "difficulty": 5,
      "code": "DimProduct ProductCode TEXT: \"0007\",\"0012\". Sales ProductCode INTEGER: 7,12; amounts 30,40. Required Product category total 70.",
      "options": [
