        {
          "id": "B",
          "text": "Add a page navigation button with no filter-related configuration."
        },
        {
          "id": "C",
          "text": "Add CustomerID as a drillthrough field on the target page and enable keeping all relevant source filters."
        },
        {
          "id": "D",
          "text": "Replace CustomerID with CustomerName in the fact table."
        }
      ],
      "gradingEnabled": false
    },
