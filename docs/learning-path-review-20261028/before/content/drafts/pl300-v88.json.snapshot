      "video_title": "Data Modeling and Schema Designs",
      "video_timestamp_seconds": 799,
      "video_url": "https://www.youtube.com/watch?v=TtxfKIe0HuQ&t=799s",
      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Galaxy schema",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "OrderLines has three products per OrderID; ShipmentLines has two fulfillment records per OrderID. A report merges the two detailed facts on OrderID and sums OrderAmount. Why can the resulting measure overstate revenue?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "A 3×2 detail join can produce six joined rows per order even though there are only three order lines; use conformed dimensions/compatible grains."
        },
        {
          "id": "B",
          "text": "A direct join automatically allocates each shipment amount to every order item without repeating transaction amounts or requiring an explicit business allocation rule."
        },
        {
          "id": "C",
          "text": "The relationship automatically makes ShipmentLines a unique one-side OrderID lookup table."
        },
        {
          "id": "D",
          "text": "All fact-to-fact joins return blank unless the tables are first appended together."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB07-V16-035",
