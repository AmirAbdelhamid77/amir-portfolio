      "video_url": "https://www.youtube.com/watch?v=FTYeKznXBpo&t=198s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_DOC_REVIEW",
      "topic": "Choosing the join",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Predict row loss from an inner join when a supplemental dimension has missing keys",
      "prompt": "A customer master has 1,000 unique customers. A loyalty table has records for 940 of them, with one record per known customer. An analyst merges loyalty into the master with an Inner join on CustomerID. How many distinct master customer rows survive?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "940 master rows survive, because the inner join keeps only keys found in both inputs."
        },
        {
          "id": "B",
          "text": "1,000 master rows survive, because inner join always preserves the entire left table."
        },
        {
          "id": "C",
          "text": "1,940 master rows survive, because inner join appends the two table row counts."
        },
        {
          "id": "D",
          "text": "60 master rows survive, because inner join returns only keys absent from the second table."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB24-V20-012",
      "sourceId": "PL300-RB24-V20-012",
