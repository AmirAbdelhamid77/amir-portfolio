      "video_url": "https://www.youtube.com/watch?v=XZoj-VCc3fM&t=279s",
      "scope": "Microsoft Learn extension to lesson theme",
      "topic": "Swapping the model default",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "Sales[ShipDate] and Date[Date] are not related. An author writes CALCULATE([Revenue], USERELATIONSHIP(Sales[ShipDate], Date[Date])) to use ShipDate. Which issue must be resolved?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "An actual relationship between those endpoints must be created in the semantic model first."
        },
        {
          "id": "B",
          "text": "USERELATIONSHIP can infer the missing relationship from matching data types at evaluation time."
        },
        {
          "id": "C",
          "text": "USERELATIONSHIP creates and stores a permanent relationship after the first successful query."
        },
        {
          "id": "D",
          "text": "The Date table must be imported again as a calculated table each time the measure runs."
        }
      ],
      "gradingEnabled": false
    },
    {
