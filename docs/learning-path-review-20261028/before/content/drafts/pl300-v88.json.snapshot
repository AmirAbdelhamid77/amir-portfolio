      "video_url": "https://www.youtube.com/watch?v=FTYeKznXBpo&t=74s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_DOC_REVIEW",
      "topic": "The two options",
      "exam_objective": "Model the data",
      "exam_subobjective": "Evaluate when to consolidate versus retain one-to-one related dimension tables",
      "prompt": "DimCustomer and DimLoyalty share unique CustomerID values and describe the same business entity. Which TWO recommendations are defensible?",
      "type": "multi",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "If both are in the same source group and ordinary attribute tables, consider consolidating them into a single dimension after checking unmatched rows."
        },
        {
          "id": "B",
          "text": "All one-to-one dimension relationships automatically corrupt numeric measures and must be replaced with many-to-many."
        },
        {
          "id": "C",
          "text": "When the tables are across different source groups, examine limited-relationship behavior and missing-key implications before deciding on source-side integration."
        },
        {
          "id": "D",
          "text": "Merge tables without checking keys, because the uniqueness of both ID columns guarantees the same set of keys exists."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB24-V20-007",
      "sourceId": "PL300-RB24-V20-007",
