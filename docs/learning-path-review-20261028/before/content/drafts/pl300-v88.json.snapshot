      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 536,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=536s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Groups — organising the Queries pane",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "A REST API costs per request. Two loaded queries reference a nonloaded staging query that performs an expensive API pull. Maintenance must remain centralized and billing must be predictable. Which design-and-verification approach is defensible?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Duplicate the API query into each loaded branch; duplication forces a single paid API request."
        },
        {
          "id": "B",
          "text": "Add more Reference children; Power Query caches every base query globally and thus bills exactly once."
        },
        {
          "id": "C",
          "text": "Rename the staging query with prefix 00; editor order determines outbound API request count."
        },
        {
          "id": "D",
          "text": "Reference shared logic; measure API requests and consider persisted staging when costly."
        }
      ],
      "gradingEnabled": false
    },
    {
