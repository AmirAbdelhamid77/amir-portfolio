      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Duplicate — legitimate use",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "A report team maintains a base Power Query staging query and three downstream reporting branches. All branches must inherit future column-removal changes in the base, although branches have different final calculations. Which design avoids maintaining four independent cleaning pipelines?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Paste the current base M steps into each of the three branches."
        },
        {
          "id": "B",
          "text": "Create references to the shared staging query and add branch-specific steps."
        },
        {
          "id": "C",
          "text": "Duplicate the base query and edit the duplicates independently from then on."
        },
        {
          "id": "D",
          "text": "Disable loading and refreshing of every branch while editing the base query."
        }
      ],
      "gradingEnabled": false
    },
    {
