      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Getting data",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean data — identify type errors and apply correct data types",
      "prompt": "An imported CSV contains CustomerCode values 0007 and 0031, but Power Query has assigned Whole number and shows 7 and 31. Analysts must preserve leading zeros for exact customer matching. What should they change before loading the model?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Apply a thousands separator so whole numbers display four digits."
        },
        {
          "id": "B",
          "text": "Remove or edit the autogenerated Changed Type step that discarded zeros, then set CustomerCode to Text before loading; verify original CSV values."
        },
        {
          "id": "C",
          "text": "Change CustomerCode to Date and select a four-digit display format."
        },
        {
          "id": "D",
          "text": "Create a measure that sums CustomerCode and formats the result with four digits."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-008",
      "sourceId": "PL300-RB12-V02-008",
