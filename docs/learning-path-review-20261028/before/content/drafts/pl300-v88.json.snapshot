        {
          "id": "B",
          "text": "Restore the gateway connection and valid source credentials, then initiate/verify a semantic model refresh in the service."
        },
        {
          "id": "C",
          "text": "Republish the unchanged Desktop PBIX; that will repair the gateway service."
        },
        {
          "id": "D",
          "text": "Ask report viewers to reopen their mobile app to reload the on-premises CSV directly."
        }
      ],
      "gradingEnabled": false
