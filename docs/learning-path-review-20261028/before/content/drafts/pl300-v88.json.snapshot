      "legacy_id": "PBI-V09-PBIP-032",
      "topic": "Role-playing date dimensions",
      "exam_objective": "Model the data",
      "exam_subobjective": "Role-playing date dimensions",
      "prompt": "An order fact has OrderDateKey and ShipDateKey. Users must slice orders by order month and shipment month simultaneously on the same page, independently. Which semantic-model design most directly supports this?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Use one date slicer and rename its label to both dates."
