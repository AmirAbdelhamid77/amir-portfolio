      "topic": "Cross-filter direction",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "Product[ProductKey] has an inactive relationship to Returns[ProductKey], and a regular SUM(Returns[Amount]) measure ignores a Product slicer. There is no competing active path. Which change makes ordinary Returns measures respond to Product by default?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Use USERELATIONSHIP within only the specialized Returns measure that requires this slicer."
        },
        {
          "id": "B",
          "text": "Activate the Product-to-Returns relationship."
        },
        {
          "id": "C",
          "text": "Change the Returns Amount column to Do not summarize for default slicer propagation."
        },
        {
          "id": "D",
          "text": "Enable Both direction on the unrelated Product-to-Sales relationship."
        }
      ],
      "gradingEnabled": false
