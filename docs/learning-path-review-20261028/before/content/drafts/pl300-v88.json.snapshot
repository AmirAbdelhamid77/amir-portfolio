      "video_url": "https://www.youtube.com/watch?v=WdCltDhmRLo&t=448s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Getting data",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean data — identify type errors and unexpected values",
      "prompt": "An unstructured CSV begins with 200 rows containing only integer-like entries in a field, but later rows contain alphanumeric product codes. Automatic type detection is enabled in Power Query. Which TWO statements describe a sound response? Select two.",
      "type": "multi",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Auto type detection for unstructured sources can inspect the first 200 rows, potentially missing later text codes."
        },
        {
          "id": "B",
          "text": "If the first 200 rows are numeric, all later values are guaranteed to be numeric."
        },
        {
          "id": "C",
          "text": "The automatically inserted Changed Type step is immutable after loading."
        },
        {
          "id": "D",
          "text": "Review the detected type and explicitly set the product-code field to Text, then profile rows beyond the sample."
        }
      ],
      "gradingEnabled": false
    },
    {
