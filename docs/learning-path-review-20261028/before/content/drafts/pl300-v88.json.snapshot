        {
          "id": "B",
          "text": "Reorder the source month columns so the new month is physically adjacent to Jan."
        },
        {
          "id": "C",
          "text": "Keep AccountID and other governed descriptors fixed and use Unpivot Other Columns, validating future schema additions."
        },
