      "topic": "Source path reliability",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Get or connect to data",
      "prompt": "A shared CSV moved from C:\\Imports\\ to D:\\DailyFeeds\\. Power Query fails at the Source step with File not found; the downstream schema is unchanged. Which correction preserves existing transformations?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Recreate all transform steps because moving the CSV invalidates the M code."
        },
        {
          "id": "B",
          "text": "Update the source file path or the parameter referenced by Source."
        },
        {
          "id": "C",
          "text": "Restore the old path inside a calculated table after Close & Apply."
        },
        {
          "id": "D",
          "text": "Modify Changed Type to use the new folder path for type detection."
        }
      ],
      "gradingEnabled": false
    },
    {
