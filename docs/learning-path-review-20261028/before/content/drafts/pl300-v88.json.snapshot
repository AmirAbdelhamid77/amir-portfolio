      "topic": "Header promotion",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A CSV preview has generic columns Column1 and Column2. Its first data row is \"OrderID,OrderDate\"; subsequent rows are actual orders. What should the analyst do so OrderID/OrderDate become field names rather than a data record?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Filter out the first row but leave Column1 and Column2 as the column names."
        },
        {
          "id": "B",
          "text": "Transpose the two fields so the row of labels becomes a column."
        },
        {
          "id": "C",
          "text": "Promote the first data row to headers, then review field types."
        },
        {
          "id": "D",
          "text": "Rename Column1 and Column2 in the model after the CSV is loaded."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-012",
      "sourceId": "PL300-RB01-V10-012",
