      "topic": "SUMMARIZECOLUMNS — mixing tables",
      "exam_objective": "Model the data",
      "exam_subobjective": "Avoid false universal SUMMARIZE vs SUMMARIZECOLUMNS rules",
      "prompt": "A colleague claims SUMMARIZE can never group by a column in a related dimension table, and therefore SUMMARIZECOLUMNS is mandatory whenever fields come from multiple tables. What is correct?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "True: SUMMARIZE only accepts columns physically on its first table."
        },
        {
          "id": "B",
          "text": "False: SUMMARIZE groupBy columns can be in its table or a related table; SUMMARIZECOLUMNS has different syntax and semantics."
        },
        {
          "id": "C",
          "text": "Both functions always return identical rows under all filter contexts."
        },
        {
          "id": "D",
          "text": "SUMMARIZECOLUMNS accepts its starting fact table as the mandatory first argument."
        }
      ],
      "gradingEnabled": false
