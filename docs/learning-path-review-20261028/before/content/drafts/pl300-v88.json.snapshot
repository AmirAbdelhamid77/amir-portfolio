    {
      "draftId": "draft-pl300-v88-PL300-RB08-V17-030",
      "sourceId": "PL300-RB08-V17-030",
      "legacy_id": "PBI-V17-REL-030",
      "video_id": "V17",
      "video_title": "Power BI Data Modeling Technical Foundations",
      "video_timestamp_seconds": 618,
      "video_url": "https://www.youtube.com/watch?v=-0GctLQhcjY&t=618s",
      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Cross-filter direction",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "Customer (1) and Product (1) each filter Sales (*) in a star schema. An analyst enables bidirectional filtering so the two dimension slicers restrict one another through Sales. What design consequence warrants review?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Both automatically causes the fact table to contain additional duplicate rows at refresh."
        },
        {
          "id": "B",
          "text": "Reverse paths can introduce ambiguity, query costs, and changing slicer choices."
        },
        {
          "id": "C",
          "text": "Both guarantees faster cross-dimension slicing, regardless of model size or complexity."
        },
        {
          "id": "D",
          "text": "Both removes the need to maintain unique one-side keys for lookup tables."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB08-V17-031",
      "sourceId": "PL300-RB08-V17-031",
