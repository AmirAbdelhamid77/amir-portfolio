      "video_id": "V17",
      "video_title": "Power BI Data Modeling Technical Foundations",
      "video_timestamp_seconds": 585,
      "video_url": "https://www.youtube.com/watch?v=-0GctLQhcjY&t=585s",
      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Cross-filter direction",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "An Import model has an existing active Product[ProductID] 1:* Sales[ProductID] single-direction relationship. One diagnostic MEASURE must temporarily propagate a Sales-side filter back to Product. No RLS change is intended. Which calculation-specific approach fits?",
      "type": "single",
      "difficulty": 5,
      "code": "Model: Product[ProductID] 1 --> * Sales[ProductID], active and single-direction. Sales-side filter Sales[Channel]=\"Web\". Desired calculation tests which Product members are represented.",
      "options": [
        {
          "id": "A",
          "text": "Change every model relationship to Both permanently."
        },
        {
          "id": "B",
          "text": "Duplicate the Sales table and sever its Product relationship."
        },
        {
          "id": "C",
          "text": "Use CALCULATE(..., CROSSFILTER(Sales[ProductID], Product[ProductID], BOTH))."
        },
        {
          "id": "D",
          "text": "Replace Product[ProductID] with a measure and use it as the relationship key."
        }
      ],
      "gradingEnabled": false
    },
