      "video_id": "V13",
      "video_title": "Pivot and Unpivot",
      "video_timestamp_seconds": 565,
      "video_url": "https://www.youtube.com/watch?v=xWan9LY0mYQ&t=565s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "The measure trade-off",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Pivot, unpivot and transpose data",
      "prompt": "A revenue pivot yields one row per Customer-Month but a source contains USD and EUR entries for the same Customer-Month. The totals are arithmetically larger than either currency subtotal. No FX conversion was authorized. What should be fixed first?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Retain CurrencyCode in the pivot grouping identifiers (or explicitly convert amounts under an approved FX policy)."
        },
        {
          "id": "B",
          "text": "Change Month values from date to text so both currencies are kept as separate measures."
        },
        {
          "id": "C",
          "text": "Use Average rather than Sum; this avoids mixing currencies without changing the grouping grain."
        },
        {
          "id": "D",
          "text": "Change Amount to Decimal Number; the extra precision separates USD and EUR records automatically."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB04-V13-020",
