      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=405s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Reference — propagation proof",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "A rate-limited WebAPI is referenced by FactCalls and DimCustomers (both loaded). A team proposes Table.Buffer in the shared `BaseAPI` query to enforce exactly one API download per refresh. Select TWO sound conclusions.",
      "type": "multi",
      "difficulty": 5,
      "code": "BaseAPI (Enable Load Off) -> FactCalls + DimCustomers (Enable Load On). API quota: 1 request per minute.",
      "options": [
        {
          "id": "A",
          "text": "Independently evaluated references can execute the BaseAPI steps more than once."
        },
        {
          "id": "B",
          "text": "Table.Buffer in BaseAPI guarantees a global cache reused by every child query."
        },
        {
          "id": "C",
          "text": "A persistently materialized and properly governed staging layer can reduce repeated live API calls."
        },
        {
          "id": "D",
          "text": "Disabling Enable Load for BaseAPI also disables source requests from the two children."
        },
        {
          "id": "E",
          "text": "Query Dependencies reports the exact number of HTTP fetches for the next scheduled refresh."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-011",
      "sourceId": "PL300-RB05-V14-011",
      "legacy_id": "PBI-V14-REFDUP-011",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
