      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Getting data",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Get or connect to data — identify and connect to data sources; transform data",
      "prompt": "A finance analyst receives a semicolon-delimited CSV whose Revenue field is intended to be decimal. Before loading rows into an imported semantic model, which workflow lets the analyst validate the delimiter and set appropriate column types?",
      "type": "single",
      "difficulty": 4,
