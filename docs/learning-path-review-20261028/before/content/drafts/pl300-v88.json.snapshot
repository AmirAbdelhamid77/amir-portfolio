      "scope": "MICROSOFT_LEARN_EXTENSION",
      "topic": "Running totals",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Create reports — Create visual calculations by using DAX",
      "prompt": "A matrix places January, February and March 2026 **across COLUMNS** (not down rows), with `[Sales]` values 10, 20, and 30 and no row subtotals. Which expression correctly accumulates left to right along the month axis?",
      "type": "single",
      "difficulty": 5,
      "code": "Across = RUNNINGSUM([Sales], COLUMNS)",
      "options": [
        {
          "id": "A",
          "text": "`SUMX(Sales, Sales[Amount])` entered as a visual calculation to scan the source fact table."
        },
        {
          "id": "B",
          "text": "`RUNNINGSUM([Sales], ROWS)`; ROWS always means visual columns."
        },
        {
          "id": "C",
          "text": "`RUNNINGSUM([Sales], COLUMNS)`; COLUMNS traverses the monthly column axis."
        },
        {
          "id": "D",
          "text": "`RUNNINGSUM([Sales], ROWPAGES)`; ROWPAGES is the horizontal month axis."
        }
      ],
      "gradingEnabled": false
