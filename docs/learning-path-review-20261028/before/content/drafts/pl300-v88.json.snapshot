          "id": "D",
          "text": "Remove all date relationships and sort by the fact table OrderID."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-032",
      "sourceId": "PL300-SUPP-V81-032",
      "legacy_id": "PBI-V09-PBIP-033",
      "topic": "USERELATIONSHIP measure",
      "exam_objective": "Model the data",
      "exam_subobjective": "USERELATIONSHIP measure",
      "prompt": "A Sales fact has an active relationship to Date on OrderDate and an inactive relationship on DeliveryDate. A measure must calculate delivered value by Date slicer, without changing other measures. Which pattern is correct?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
