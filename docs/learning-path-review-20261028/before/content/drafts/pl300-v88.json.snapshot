    {
      "draftId": "draft-pl300-v88-PL300-RB09-V18-030",
      "sourceId": "PL300-RB09-V18-030",
      "legacy_id": "PBI-V18-STAR-030",
      "video_id": "V18",
      "video_title": "Power BI Model View and Relationships Hands-on",
