      "video_timestamp_seconds": 455,
      "video_url": "https://www.youtube.com/watch?v=TtxfKIe0HuQ&t=455s",
      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Star schema",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "An analyst has a valid Product and Date dimension and separate Sales and Return facts. Monthly net revenue must be sliced by historic Product category; Sales records the SCD2 ProductSK, but Returns contains only current ProductID. Which design fix is required before claiming historically correct Product-category net revenue?",
      "type": "single",
      "difficulty": 5,
      "code": "DimProduct: (SK501,ProductID14,Basic,Jan–Jun); (SK502,ProductID14,Premium,Jul–Dec).\nSales: (Jun,SK501,100),(Aug,SK502,60).\nReturns: (Aug,ProductID14,20), referencing a Jun sale.\nRequirement: attribute any return to the category of its original sale and calculate net by category.",
      "options": [
        {
          "id": "A",
          "text": "Relate both facts directly on ProductID and set Both cross-filter so historic categories become available across all transaction dates and return events."
        },
        {
          "id": "B",
          "text": "Map each return to its original sale/version ProductSK and use conformed product/date roles at a defined event grain."
        },
        {
          "id": "C",
          "text": "Relate Returns to the latest version ProductSK because return processing occurs in August, regardless of original purchase."
        },
        {
          "id": "D",
          "text": "Append Sales and Returns at ProductID level, then use MAX of Category to keep one valid dimension value."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB07-V16-017",
