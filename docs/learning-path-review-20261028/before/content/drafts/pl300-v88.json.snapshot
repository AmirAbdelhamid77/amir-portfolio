      "topic": "Security and inactive relationships",
      "exam_objective": "Model the data",
      "exam_subobjective": "Security and inactive relationships",
      "prompt": "A model has RLS applied to the Territory dimension. A proposed measure uses USERELATIONSHIP on an inactive Territory-to-fact path to extend secure filtering. Why is a dedicated design review necessary?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Report bookmarks establish new RLS membership."
