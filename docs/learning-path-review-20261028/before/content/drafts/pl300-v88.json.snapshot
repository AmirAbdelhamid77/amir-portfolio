      "scope": "SOURCE_MAPPED_MICROSOFT_LEARN_CROSS_CHECK",
      "topic": "Grain design guidance (Microsoft Learn enrichment)",
      "exam_objective": "Model the data",
      "exam_subobjective": "Balance lowest possible transaction grain with performance and detail requirements",
      "prompt": "A data team is choosing between a line-level transaction fact and a monthly sales summary for a model that must drill into individual SKUs. What guidance best fits?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Always use monthly summaries; large detail tables are never justified."
        },
        {
          "id": "B",
          "text": "Detailed facts must have fewer rows than aggregated facts."
        },
        {
          "id": "C",
          "text": "Use the lowest grain needed for analytical questions when feasible; aggregated facts can supplement performance but do not recreate missing detail."
        },
        {
          "id": "D",
          "text": "The lowest grain guarantees that every numeric column can be summed across all dimensions."
        }
      ],
      "gradingEnabled": false
    },
