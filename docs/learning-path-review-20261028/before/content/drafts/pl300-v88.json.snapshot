      "video_id": "V18",
      "video_title": "Power BI Model View and Relationships Hands-on",
      "video_timestamp_seconds": 858,
      "video_url": "https://www.youtube.com/watch?v=Eazu28FSKEU&t=858s",
      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "The product-dimension repair",
