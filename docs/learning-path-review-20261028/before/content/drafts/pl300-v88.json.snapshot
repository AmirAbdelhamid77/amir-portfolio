      "video_id": "V18",
      "video_title": "Power BI Model View and Relationships Hands-on",
      "video_timestamp_seconds": 596,
      "video_url": "https://www.youtube.com/watch?v=Eazu28FSKEU&t=596s",
      "scope": "Course concept deepened with applied Microsoft Learn scenario",
      "topic": "Testing behaviour in Report view",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "A 50-table Power BI model needs Product slicers to filter Sales. Product already has an active Single 1:* path to Sales. Why is setting Both on every relationship an unjustified default?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Setting Both is necessary before a Product lookup column can filter its related Sales fact."
        },
        {
          "id": "B",
          "text": "It always disables filters from Product to Sales."
        },
        {
          "id": "C",
          "text": "Both adds potentially ambiguous reverse paths without aiding the existing Product slicer."
        },
        {
          "id": "D",
          "text": "It is mandatory for all one-to-many star schema relationships."
        }
      ],
      "gradingEnabled": false
    },
