      "topic": "Enrichment (Microsoft documentation)",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Pivot, unpivot and transpose data",
      "prompt": "A quality extract has four rows for one inspection group: Measurement 9, null, 11, and null. It will be Pivoted using Count (all) versus Count (not blank) over Measurement. Which result is consistent with the two definitions?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Count (all)=4 and Count (not blank)=2, so a valid-record KPI must specify the null policy."
        },
        {
          "id": "B",
          "text": "Both return four because Count (not blank) is assumed to treat null measurements as equivalent to measured zero values."
        },
        {
          "id": "C",
          "text": "Count (all)=20 because it sums numeric measurements instead of counting rows."
        },
        {
          "id": "D",
          "text": "Count (not blank)=99 because it multiplies the two nonnull values."
        }
      ],
      "gradingEnabled": false
    },
    {
