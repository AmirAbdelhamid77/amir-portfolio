      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "For Customer C1 there are two order lines (100 and 80) and three support tickets. A detailed join of both fact tables by CustomerID creates six rows and repeats order revenue. Reports need Orders, Tickets and Sales by Segment. Which model design avoids this?",
      "type": "single",
      "difficulty": 5,
      "code": "DimCustomer: A Segment Retail. Orders: (A,O1,100),(A,O2,60). Tickets: (A,T1),(A,T2),(A,T3). Expected A: Order Revenue=160; Ticket Count=3.",
      "options": [
        {
          "id": "A",
          "text": "Join the facts on CustomerID and divide every amount by a hardcoded count of tickets."
        },
        {
          "id": "B",
          "text": "Use one unique DimCustomer filtering each fact separately, and define grain-specific measures."
        },
        {
          "id": "C",
          "text": "Enable bidirectional many-to-many filtering directly between ticket and order details."
        },
        {
          "id": "D",
          "text": "Append every ticket record to the order-line fact and sum Amount without an event discriminator."
        }
      ],
      "gradingEnabled": false
