      "topic": "Reference refresh behavior",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A non-loaded Clean_Base query feeds loaded Sales and Returns through Reference. A refresh hits the SQL source more than once. Which explanation correctly guides optimization work?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "With Enable Load off, every downstream reference is guaranteed to read from one persisted cache."
        },
        {
          "id": "B",
          "text": "Reference prevents independent source evaluation because the upstream steps have one display name, so refresh diagnostics need not distinguish dependent branches."
        },
        {
          "id": "C",
          "text": "Duplicate is guaranteed to reduce the number of SQL requests without changing transformations."
        },
        {
          "id": "D",
          "text": "Power Query can evaluate the shared upstream steps separately in downstream queries; inspect requests and consider upstream persistence if material."
        }
      ],
      "gradingEnabled": false
