      "legacy_id": "PBI-V09-PBIP-037",
      "topic": "Drillthrough filter context",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Drillthrough filter context",
      "prompt": "A report lists customers on a summary page. Right-clicking customer C123 should open a details page already filtered to C123, while preserving Region slicer context. How should navigation be configured?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Use a bookmark that has CustomerID C123 permanently selected."
