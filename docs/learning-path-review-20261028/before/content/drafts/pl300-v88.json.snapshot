      "options": [
        {
          "id": "A",
          "text": "26 is closing stock because snapshot balances are additive through time."
        },
        {
          "id": "B",
          "text": "Use 8.67 because average stock always equals the ending balance."
        },
        {
          "id": "C",
          "text": "Use the minimum value, regardless of which date it occurred."
        },
        {
          "id": "D",
          "text": "Use the latest observed balance: Wednesday, 7 units."
        }
      ],
      "gradingEnabled": false
