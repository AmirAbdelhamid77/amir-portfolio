      "topic": "Replace scope",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean the data",
      "prompt": "An OrderDate text field is guaranteed to contain either a leading `D` followed by an ISO date (e.g. `D2026-08-04`) or an ISO date without the prefix. Other text fields can contain meaningful letter D. Which cleanup is safest?",
      "type": "single",
