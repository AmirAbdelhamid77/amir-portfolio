        {
          "id": "B",
          "text": "Remove all target filters to make the report load faster."
        },
        {
          "id": "C",
          "text": "Create a static bookmark in the source that always filters a fixed customer."
        },
        {
          "id": "D",
          "text": "Configure supported cross-report drillthrough with appropriately matched field definitions and target drillthrough filters, then test report navigation."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-081",
      "sourceId": "PL300-SUPP-V81-081",
      "legacy_id": "PBI-V26-CAPSTONE-057",
      "topic": "Narrative truthfulness",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Narrative truthfulness",
      "prompt": "A quarterly sales chart shows an 80% increase after a one-off accounting reclassification. Copilot drafts a narrative saying customer demand surged 80%. What should the analyst do?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Replace the trend with a pie chart so no explanation is needed."
        },
        {
          "id": "B",
          "text": "Publish the generated wording unreviewed because it came from the model."
        },
        {
          "id": "C",
          "text": "Review the AI narrative against source definitions and annotate the reclassification before publication."
        },
        {
          "id": "D",
          "text": "Delete the accounting adjustment from the data to preserve a simple story."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-082",
      "sourceId": "PL300-SUPP-V81-082",
      "legacy_id": "PBI-V26-CAPSTONE-058",
      "topic": "Visual calculation moving average",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Visual calculation moving average",
      "prompt": "A report author needs a three-period moving average of daily tickets within a specific visual. The visual calculation shows unexpected values when sorted by ticket volume. What must be checked?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Add a new report-level filter that excludes every third day."
        },
        {
          "id": "B",
          "text": "Turn off all model date relationships."
        },
        {
          "id": "C",
          "text": "Switch all ticket counts to text strings."
        },
        {
          "id": "D",
          "text": "Confirm the intended axis traversal and sort order, because visual calculations operate on the displayed visual structure."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-083",
      "sourceId": "PL300-SUPP-V81-083",
      "legacy_id": "PBI-V26-CAPSTONE-060",
      "topic": "Error bars",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Error bars",
      "prompt": "Researchers show monthly average delivery duration along with 95% confidence intervals. A proposed visual uses a single unqualified trend line. Which presentation better conveys estimate uncertainty?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Use supported error bars or interval bounds clearly labeled with their calculation methodology."
        },
        {
          "id": "B",
          "text": "Round each average to zero decimals and remove the interval."
        },
        {
          "id": "C",
          "text": "Show only the maximum duration as proof of average confidence."
        },
        {
          "id": "D",
          "text": "Sort error intervals alphabetically and present them as categories."
        }
      ],
      "gradingEnabled": false
    },
