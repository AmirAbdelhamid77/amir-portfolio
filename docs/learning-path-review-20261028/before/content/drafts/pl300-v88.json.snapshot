      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "In a standard Import star, DimProduct → FactSales and DimDate → FactSales are active, regular 1:* single-direction relationships. A slicer filters Product=P2 and a date slicer has no selection. What propagation should be expected before any special measure or visual-level filter?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "The Product selection physically creates a new Sales table for P2."
        },
        {
          "id": "B",
          "text": "Date slicer choices automatically reduce to dates on which P2 sold, through reverse propagation."
        },
        {
          "id": "C",
          "text": "Sales measures restrict to P2 rows, while the Date dimension itself is not reverse-filtered by Product."
        },
        {
          "id": "D",
          "text": "The Product rows other than P2 are permanently removed from the dimension."
        }
      ],
      "gradingEnabled": false
