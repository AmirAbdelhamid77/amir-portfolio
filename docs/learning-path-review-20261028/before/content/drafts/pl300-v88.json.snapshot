      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 865,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=865s",
      "scope": "Video-grounded scenario rewrite",
      "topic": "Header detection risk",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data",
      "prompt": "A CSV feed contains zero, one, or two leading disclaimer rows before the true OrderID,OrderDate,Amount header. The existing Promote Headers step sometimes converts a disclaimer into column names. Which repair is safest for a repeatable refresh?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Apply Change Type to the first two rows before promoting the header."
        },
        {
          "id": "B",
          "text": "Rename the incorrect headers after loading, ignoring the extra disclaimer rows."
        },
        {
          "id": "C",
          "text": "Set a later Reordered Columns step to move disclaimer text out of the model."
        },
        {
          "id": "D",
          "text": "Locate the actual header row, remove the preamble, then promote headers."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-013",
      "sourceId": "PL300-RB01-V10-013",
      "legacy_id": "PBI-V10-PQ-013",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 1440,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=1440s",
      "scope": "Microsoft Learn extension to video concept",
      "topic": "Data-quality profiling",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean the data",
      "prompt": "Power Query Column Quality on a 1,000,000-row CSV shows zero errors, but a Service refresh later fails converting row 482,001 to Date. The Desktop preview was profiled using its default scope. Which TWO steps provide relevant quality evidence without discarding the failure row?",
      "type": "multi",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Switch Date to type Any and declare the source validated without examining the problematic value."
        },
        {
          "id": "B",
          "text": "Create a query branch using Keep Errors on the date conversion to capture the offending record and its source key."
        },
        {
          "id": "C",
          "text": "Change Column Profile from top 1,000 rows to entire data set where feasible, then compare with refresh outcomes."
        },
        {
          "id": "D",
          "text": "Remove every row missing an optional Notes field, even though Notes is unrelated to the Date error."
        },
        {
          "id": "E",
          "text": "Certify the full data set because the 1,000-row preview previously reported zero errors."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-014",
      "sourceId": "PL300-RB01-V10-014",
      "legacy_id": "PBI-V10-PQ-014",
      "video_id": "V10",
      "video_title": "Power Query Tutorial for Beginners (Step-by-Step)",
      "video_timestamp_seconds": 2415,
      "video_url": "https://www.youtube.com/watch?v=T0D6fSdfkO8&t=2415s",
      "scope": "Microsoft Learn extension to video concept",
      "topic": "Error quarantine",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean the data",
      "prompt": "A Power Query Date conversion reports 12 errors among 750,000 transactions. Accounting must reconcile source row counts and preserve the raw rejected values for investigation, while the report needs trusted Date values. What preparation strategy is most defensible?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Retain source identifiers/raw dates and create an error-only audit branch; load or quarantine under an agreed correction policy."
        },
        {
          "id": "B",
          "text": "Use Remove Errors, take the resulting 749,988 rows as certified, and reconcile totals without retaining a separate exception ledger."
        },
        {
          "id": "C",
          "text": "Change Date to Any indefinitely; mixed data types guarantee valid monthly grouping in the model."
        },
        {
          "id": "D",
          "text": "Replace all 12 failed dates with the current refresh date and discard their original text values."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB01-V10-015",
      "sourceId": "PL300-RB01-V10-015",
