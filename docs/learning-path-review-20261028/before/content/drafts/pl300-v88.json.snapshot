      "exam_subobjective": "Profile and clean the data",
      "prompt": "A monthly customer extract has ContactEmail values of null, \"\", and \"  \" (two spaces). A rule must flag all three as missing while preserving genuine email addresses. Which strategy is safest?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Replace only the visible null labels with the literal string \"null\" before loading the table as the only valid missing state."
        },
        {
          "id": "B",
          "text": "Filter out any row where ContactEmail has a length below three characters."
        },
        {
          "id": "C",
          "text": "Trim text values, then normalize zero-length text and null to one missing marker; preserve nonempty emails."
        },
        {
          "id": "D",
          "text": "Change the column type to Whole Number so invalid emails turn into conversion errors."
        }
      ],
      "gradingEnabled": false
