      "exam_objective": "Prepare the data",
      "exam_subobjective": "Profile and clean the data",
      "prompt": "An exported code contains an embedded carriage return, represented in a Power Query M text literal as \"AB#(cr)12\". Leading spaces in other codes carry meaning. Which Power Query M function targets control characters while leaving trim-policy decisions separate?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Use Text.Clean to remove embedded control characters; assess boundary spaces separately."
        },
        {
          "id": "B",
          "text": "Run Fill Down so the previous product code replaces the contaminated code."
        },
        {
          "id": "C",
          "text": "Use Replace Errors because carriage returns are always Power Query errors."
        },
        {
          "id": "D",
          "text": "Use Text.Trim alone because it removes embedded control characters anywhere in the string."
        }
      ],
      "gradingEnabled": false
