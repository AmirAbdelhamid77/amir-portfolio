      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-030",
      "sourceId": "PL300-SUPP-V80-030",
      "legacy_id": "PBI-V24-M2M-020",
      "topic": "Many-to-many enrollment with zero membership",
      "exam_objective": "Model the data",
      "exam_subobjective": "Many-to-many enrollment with zero membership",
      "prompt": "A training catalog contains Class C1 and C2, while Enrollment contains only (Student S1, Class C1). A report must list all classes including C2 with zero enrollments. The developer uses an inner join of Class to Enrollment and C2 disappears. Which semantic approach preserves the catalog?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Inner join again after changing the Class ID case; the absent class will now acquire an enrollment automatically."
        },
        {
          "id": "B",
          "text": "Retain the full Class dimension, and use measures to show classes with no enrollments."
        },
        {
          "id": "C",
          "text": "Delete C2 from the Class source because courses with no students should not exist in the catalog."
        },
        {
          "id": "D",
          "text": "Duplicate C1 enrollment onto C2 to force a nonblank row even though no student enrolled in C2."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-031",
      "sourceId": "PL300-SUPP-V80-031",
      "legacy_id": "PBI-V32-CALCTBL-007",
      "topic": "TREATAS missing values behavior",
      "exam_objective": "Model the data",
      "exam_subobjective": "TREATAS missing values behavior",
      "prompt": "A disconnected Campaign table selects codes {A, B, Z}, while Product[CampaignCode] contains {A, B, C}. The KPI measure uses `CALCULATE([Sales], TREATAS(VALUES(Campaign[Code]), Product[CampaignCode]))`. Finance wonders whether nonexistent Z causes an error or filters out all products. What behavior should be expected?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Every Product row is removed because one campaign value is not in Product."
        },
        {
          "id": "B",
          "text": "The expression creates a permanent relationship and inserts Product row Z during refresh."
        },
        {
          "id": "C",
          "text": "TREATAS filters matching Product codes A and B; unmatched Z is ignored."
        },
        {
          "id": "D",
          "text": "The model silently converts Z to C by sorting both code lists alphabetically."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-032",
      "sourceId": "PL300-SUPP-V80-032",
      "legacy_id": "PBI-V32-CALCTBL-008",
      "topic": "CALCULATETABLE qualifying high-margin items",
      "exam_objective": "Model the data",
      "exam_subobjective": "CALCULATETABLE qualifying high-margin items",
      "prompt": "A retailer must count transactions associated with Products where Product[MarginPct] exceeds 0.30, respecting the current Region and Period slicers. A developer filters the Sales fact with a disconnected copy of Product and gets all transactions. Which approach should be considered?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Use `CALCULATETABLE(Sales, ALL(Product))` because removing every product filter isolates high-margin SKUs."
        },
        {
          "id": "B",
          "text": "Filter an unrelated Product copy by MarginPct and assume it automatically propagates to Sales."
        },
        {
          "id": "C",
          "text": "Count every row in Sales before evaluating Product so unrelated products do not affect the answer."
        },
        {
          "id": "D",
          "text": "Filter Sales through a related qualifying Product set, or a validated virtual filter."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-033",
      "sourceId": "PL300-SUPP-V80-033",
      "legacy_id": "PBI-V32-CALCTBL-010",
      "topic": "SUMMARIZECOLUMNS and filter context",
      "exam_objective": "Model the data",
      "exam_subobjective": "SUMMARIZECOLUMNS and filter context",
      "prompt": "A modeler needs a summarized table of sales by existing Region and Year under a selected Category, and plans to construct a giant Cartesian product of all keys before joining. The intended result must omit combinations with no nonblank measure result. Which design deserves consideration?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Group existing Region–Year columns with `SUMMARIZECOLUMNS` and a measure."
        },
        {
          "id": "B",
          "text": "Use CROSSJOIN of every model table regardless of filters, then count each resulting row as one sale."
        },
        {
          "id": "C",
          "text": "Convert all Region names to measures so they cannot participate in grouping."
        },
        {
          "id": "D",
          "text": "Disable all Category filters while claiming the summary still respects the selected category."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-034",
      "sourceId": "PL300-SUPP-V80-034",
      "legacy_id": "PBI-V29-AGG-008",
      "topic": "Aggregate cache misses by geography",
      "exam_objective": "Model the data",
      "exam_subobjective": "Aggregate cache misses by geography",
      "prompt": "A DirectQuery fact stores individual invoice lines; an imported aggregation table stores Revenue by Date and Store but not Product. A query groups Revenue by Date and Store and uses the same aggregation mapping. Another query adds Product[SKU] to the axis. Which behavior should be anticipated?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Both queries always hit the same Date–Store aggregation even if SKU distribution is unknown."
        },
        {
          "id": "B",
          "text": "The Date–Store query may hit the aggregation; SKU breakdown may require the detailed fact because SKU grain is absent."
        },
        {
          "id": "C",
          "text": "Adding a SKU axis inserts SKU values into the aggregation automatically without refresh."
        },
        {
          "id": "D",
          "text": "Neither query can use any aggregation because the detailed fact uses DirectQuery storage."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-035",
      "sourceId": "PL300-SUPP-V80-035",
      "legacy_id": "PBI-V29-AGG-011",
      "topic": "Distinct customers in aggregate table",
      "exam_objective": "Model the data",
      "exam_subobjective": "Distinct customers in aggregate table",
      "prompt": "A sales model groups daily invoices by Store and precomputes distinct customers per Store. Customer C1 purchased in Store A and Store B. Management wants distinct customers across *all stores*. Why is summing each store’s distinct-customer aggregate unsafe?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Summing group distinct counts is always equivalent to the all-store distinct count when Store is filtered."
        },
        {
          "id": "B",
          "text": "Replace CustomerID with invoice amount because uniqueness follows revenue."
        },
        {
          "id": "C",
          "text": "Count distinct customers across all selected stores, not summed store counts."
        },
        {
          "id": "D",
          "text": "Average the two store distinct counts and round up to infer a guaranteed global count."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-036",
      "sourceId": "PL300-SUPP-V80-036",
      "legacy_id": "PBI-V29-AGG-013",
      "topic": "Choose aggregation grain for report KPI",
      "exam_objective": "Model the data",
      "exam_subobjective": "Choose aggregation grain for report KPI",
      "prompt": "Operations repeatedly query Revenue by FiscalMonth and Category, and 95% of interactions use that grain. The DirectQuery detail fact has 150 million rows; source freshness allows a 15-minute aggregation refresh. Which candidate aggregation table should the team measure first?",
