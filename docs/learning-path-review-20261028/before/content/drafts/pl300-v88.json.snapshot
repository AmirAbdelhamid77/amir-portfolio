    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-037",
      "sourceId": "PL300-SUPP-V81-037",
      "legacy_id": "PBI-V22-ROLEPLAY-025",
      "topic": "Ratio of totals",
      "exam_objective": "Model the data",
      "exam_subobjective": "Ratio of totals",
      "prompt": "A sales model has 5 transactions; analysts want overall discount rate defined as total discount amount divided by total gross sales. Which formula is correct for slicer-aware aggregate reporting?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
