    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-001",
      "sourceId": "PL300-RB05-V14-001",
      "legacy_id": "PBI-V14-REFDUP-001",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 22,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=22s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Why query organisation matters",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "CleanSales is a nonloaded Power Query staging query. Two loaded outputs, FactSales and DimCustomer, must inherit a future correction to CleanSales[NormalizedCustomerID]. Finance also wants to know whether refresh issues one source request or two. Which design and assertion are correct?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Create two Duplicates; edits to CleanSales automatically rewrite duplicated M, and requests are shared once."
        },
        {
          "id": "B",
          "text": "Export CleanSales into two unrelated files, one per report, for guaranteed upstream lineage."
        },
        {
          "id": "C",
          "text": "Create calculated tables in the report; they change upstream Power Query transformation code by reference."
        },
        {
          "id": "D",
          "text": "Reference the staging query for both outputs; measure source requests separately."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-002",
      "sourceId": "PL300-RB05-V14-002",
      "legacy_id": "PBI-V14-REFDUP-002",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 67,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=67s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Duplicate — what it creates",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "BaseOrders initially has Source → TypeFix. An analyst chooses Duplicate, naming the result AuditOrders. Next day a TrimCustomer step is appended only to BaseOrders. AuditOrders still reads the same file. What is true of AuditOrders after refresh?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "It inherits TrimCustomer because its file source is shared."
        },
        {
          "id": "B",
          "text": "It is removed from the model because the original query gained an extra step."
        },
        {
          "id": "C",
          "text": "Its copied definition still lacks TrimCustomer, unless that step is independently added."
        },
        {
          "id": "D",
          "text": "Power Query converts Duplicate into Reference once both queries access the same file."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-003",
      "sourceId": "PL300-RB05-V14-003",
      "legacy_id": "PBI-V14-REFDUP-003",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 91,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=91s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Duplicate — isolation",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "BaseSales cleans invoice currency, then three branches Reference BaseSales to build FactSales, RegionAudit and ReturnsAudit. A currency rule changes in BaseSales. How should you reason about the branches?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Each child uses a disconnected snapshot, so none can receive the corrected rule."
        },
        {
          "id": "B",
          "text": "The parent is automatically materialized once, guaranteeing one source request for all children."
        },
        {
          "id": "C",
          "text": "Only loaded FactSales inherits the change; audit branches are evaluated once at authoring time even if they refresh later."
        },
        {
          "id": "D",
          "text": "Each child depends on the updated base definition; refresh may still reevaluate the source separately."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-004",
      "sourceId": "PL300-RB05-V14-004",
      "legacy_id": "PBI-V14-REFDUP-004",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 307,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=307s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Duplicate — how to create one",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "Three loaded tables reference BaseSales, which calls a slow external API. BaseSales has Enable Load disabled. During refresh the administrator sees multiple API calls. Which statement is correct?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Load BaseSales into the model first and rely on its loaded table to guarantee cached values are shared by all three downstream queries."
        },
        {
          "id": "B",
          "text": "Disable Load removes BaseSales transformation steps and makes all children independent."
        },
        {
          "id": "C",
          "text": "Each child can evaluate BaseSales steps; Disable Load does not guarantee a single shared API response."
        },
        {
          "id": "D",
          "text": "Disabling load automatically converts BaseSales into a reusable cached DAX measure."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-005",
      "sourceId": "PL300-RB05-V14-005",
      "legacy_id": "PBI-V14-REFDUP-005",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 108,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=108s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Duplicate — maintenance cost",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "CleanSales is a common staging query referenced by FactSales and DimCustomer. The reporting model must load those two outputs but not a third intermediate CleanSales table. Which setting fits?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Hide CleanSales in Model view but leave Enable Load on, assuming hidden model columns no longer consume model storage."
        },
        {
          "id": "B",
          "text": "Turn off Enable Load for both FactSales and DimCustomer."
        },
        {
          "id": "C",
          "text": "Delete CleanSales after references exist so dependencies inline automatically."
        },
        {
          "id": "D",
          "text": "Disable Enable Load on CleanSales, retaining its definition for the loaded branches."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-006",
      "sourceId": "PL300-RB05-V14-006",
      "legacy_id": "PBI-V14-REFDUP-006",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 121,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=121s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "The base-query pattern",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "Three loaded Power Query branches reference nonloaded BaseAPI. Refresh traffic rises, but the developer expects exactly one API call per refresh. Which conclusion best matches Microsoft guidance?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Each branch independently evaluates the referenced steps; caching may reduce requests but a single fetch is not guaranteed."
        },
        {
          "id": "B",
          "text": "Disabling load for BaseAPI prevents its source steps from executing while loaded branches refresh."
        },
        {
          "id": "C",
          "text": "One parent reference is automatically materialized before any branch evaluates downstream steps."
        },
        {
          "id": "D",
          "text": "Desktop, Service and all connectors share one global HTTP cache that guarantees source deduplication."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-007",
      "sourceId": "PL300-RB05-V14-007",
      "legacy_id": "PBI-V14-REFDUP-007",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 146,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=146s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Reference — branching",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "Three loaded queries reference a nonloaded BaseSQL staging query. Diagnostics show multiple SELECT statements during refresh. Which design conclusion is best supported?",
      "type": "single",
      "difficulty": 5,
      "code": "BaseSQL (load off) -> DimA, DimB, FactC (all load on). SQL diagnostics show 3 SELECT executions during refresh.",
      "options": [
        {
          "id": "A",
          "text": "References may reevaluate; verify source reads and persist staging if needed."
        },
        {
          "id": "B",
          "text": "Enable Load off prevents all upstream evaluations of BaseSQL."
        },
        {
          "id": "C",
          "text": "A shared BaseSQL query definition guarantees one SQL fetch per refresh."
        },
        {
          "id": "D",
          "text": "Table.Buffer in the parent guarantees a global cache shared across all children."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-008",
      "sourceId": "PL300-RB05-V14-008",
      "legacy_id": "PBI-V14-REFDUP-008",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 157,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=157s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Reference — change propagation",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "A teammate adds Table.Buffer in a nonloaded base query to force all referencing branches to reuse one fetch. Why is this risky?",
      "type": "single",
      "difficulty": 5,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Buffering converts Import mode into Live Connection"
        },
        {
          "id": "B",
          "text": "Buffering is scoped to an evaluation and does not guarantee cross-branch reuse"
        },
        {
          "id": "C",
          "text": "Buffering forces all SQL transformations to fold"
        },
        {
          "id": "D",
          "text": "Buffer the nonloaded base query and assume its in-memory result persists across every independent loaded query evaluation"
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB05-V14-009",
      "sourceId": "PL300-RB05-V14-009",
      "legacy_id": "PBI-V14-REFDUP-009",
      "video_id": "V14",
      "video_title": "Reference vs Duplicate and Query Organization",
      "video_timestamp_seconds": 366,
      "video_url": "https://www.youtube.com/watch?v=jova3i1u3xo&t=366s",
      "scope": "curriculum-aligned independently authored exam-style scenario, extended with Microsoft Learn",
      "topic": "Reference — empty step list",
      "exam_objective": "Prepare the data",
      "exam_subobjective": "Transform and load the data — Reference versus duplicate queries",
      "prompt": "Six loaded report queries reference a nonloaded staging query that fetches a rate-limited API and applies the same cleansing steps. Keeping logic centralized is important, but multiple upstream evaluations remain expensive. Which architecture should be tested?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Refresh a centrally persisted staging table/dataflow, then have the six queries read that materialized output."
        },
        {
          "id": "B",
          "text": "Duplicate the staging M code into each loaded branch to remove its dependency on the shared query."
        },
        {
          "id": "C",
          "text": "Wrap the staging table in Table.Buffer and assume it becomes a persistent cross-branch cache."
        },
        {
          "id": "D",
          "text": "Replace the six references with six direct Web.Contents calls and allow concurrent refresh of them."
        }
      ],
      "gradingEnabled": false
    },
    {
