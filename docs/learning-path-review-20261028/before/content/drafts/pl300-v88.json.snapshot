    {
      "draftId": "draft-pl300-v88-PL300-RB10-V19-020",
      "sourceId": "PL300-RB10-V19-020",
      "legacy_id": "PBI-V19-ACTIVE-020",
      "video_id": "V19",
      "video_title": "Active and Inactive Relationships",
      "video_timestamp_seconds": 73,
      "video_url": "https://www.youtube.com/watch?v=XZoj-VCc3fM&t=73s",
      "scope": "Microsoft Learn extension to lesson theme",
      "topic": "Properties of an inactive relationship",
      "exam_objective": "Model the data",
      "exam_subobjective": "Design and implement a data model",
      "prompt": "A regulated Sales model uses role-playing OrderDate and ShipDate reporting. An engineer sees USERELATIONSHIP failures only for RLS-protected identities, but has not identified where the measure resides. What is the appropriate diagnostic and deployment decision?",
      "type": "single",
      "difficulty": 4,
      "code": "Calendar→Sales[OrderDate] active; Calendar→Sales[ShipDate] inactive.\nProposed measure: CALCULATE([Sales Amount], USERELATIONSHIP(Sales[ShipDate], Calendar[Date])).\nRLS exists in the model; measure-home table and exact enforcement topology are currently unknown.",
      "options": [
        {
          "id": "A",
          "text": "Set every relationship cross-filter to Both; this bypasses USERELATIONSHIP errors for all RLS members regardless of the table where each measure is stored."
        },
        {
          "id": "B",
          "text": "Inspect the measure-home table and RLS topology; use supported active role-playing date dimensions as needed and validate affected identities."
        },
        {
          "id": "C",
          "text": "Grant the restricted group workspace Contributor because that will enforce RLS on every measure."
        },
        {
          "id": "D",
          "text": "Remove the restricted identities from the RLS role while keeping their report permission unchanged."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB10-V19-021",
      "sourceId": "PL300-RB10-V19-021",
      "legacy_id": "PBI-V19-ACTIVE-021",
      "video_id": "V19",
      "video_title": "Active and Inactive Relationships",
