      "legacy_id": "PBI-V06-LIVE-019",
      "topic": "Dynamic RLS identity",
      "exam_objective": "Manage and secure Power BI",
      "exam_subobjective": "Dynamic RLS identity",
      "prompt": "A model has SecurityAccess[UPN] and SecurityAccess[TerritoryKey]. Users should see multiple authorized territories according to their sign-in, and access changes frequently. What is a robust pattern?",
