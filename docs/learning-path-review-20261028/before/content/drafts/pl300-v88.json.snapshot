      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Use one shared Date table with two slicers on the same Date[Month] field and expect different date-role filters."
        },
        {
          "id": "B",
          "text": "Delete ShipDate from the fact and infer it from the chart title after filters are applied."
        },
        {
          "id": "C",
          "text": "Use independent active OrderDate and ShipDate dimensions with separately tested slicers."
        },
        {
          "id": "D",
          "text": "Make the OrderDate and ShipDate relationships active in parallel between the same two tables without path checks."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-044",
      "sourceId": "PL300-SUPP-V80-044",
      "legacy_id": "PBI-V22-ROLEPLAY-017",
      "topic": "RLS inactive relationship misconception",
      "exam_objective": "Model the data",
      "exam_subobjective": "RLS inactive relationship misconception",
      "prompt": "A reporting model enforces region-based RLS on a DateRole dimension. A developer activates an inactive relationship inside a measure using `USERELATIONSHIP` and claims the RLS restriction therefore propagates securely through that inactive relationship. Why must this design be challenged?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "USERELATIONSHIP creates a permanent active security relationship for all queries in the model."
        },
        {
          "id": "B",
          "text": "RLS applies only to chart legends, so DateRole security never affects the actual fact rows."
        },
        {
          "id": "C",
          "text": "Turning on a bidirectional visual interaction makes every inactive relationship enforce RLS automatically."
        },
        {
          "id": "D",
          "text": "RLS needs active security paths; `USERELATIONSHIP` does not secure an inactive path."
        }
      ],
      "gradingEnabled": false
    },
    {
