    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-038",
      "sourceId": "PL300-SUPP-V81-038",
      "legacy_id": "PBI-V22-ROLEPLAY-027",
      "topic": "CALCULATE and existing filters",
      "exam_objective": "Model the data",
      "exam_subobjective": "CALCULATE and existing filters",
      "prompt": "A report is filtered to Product[Color] = Blue. A measure must apply Color = Red as an additional condition so the result stays blank when Blue is selected, not override Blue. Which modifier is needed?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "CALCULATE([Sales], Product[Color] = \"Red\") without KEEPFILTERS."
        },
        {
          "id": "B",
          "text": "CALCULATE([Sales], REMOVEFILTERS(Product[Color]))"
        },
        {
          "id": "C",
          "text": "CALCULATE([Sales], KEEPFILTERS(Product[Color] = \"Red\"))"
        },
        {
          "id": "D",
