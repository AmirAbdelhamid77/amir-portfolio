      "video_url": "https://www.youtube.com/watch?v=WdCltDhmRLo&t=465s",
      "scope": "VIDEO_GROUNDED_WITH_MICROSOFT_LEARN_VERIFICATION",
      "topic": "Getting data",
      "exam_objective": "Manage and secure Power BI",
      "exam_subobjective": "Create and manage workspaces and assets — troubleshoot data refresh",
      "prompt": "Operations changed an order price in a CSV on an on-premises shared folder. The report and semantic model were published last week. The semantic model refresh history now reports a gateway-offline error. What should the owner do first to bring report figures current without republishing the Desktop file?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Change visual interactions on the report canvas to Cross-filter."
