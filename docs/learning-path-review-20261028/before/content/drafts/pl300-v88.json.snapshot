        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-039",
      "sourceId": "PL300-SUPP-V81-039",
      "legacy_id": "PBI-V22-ROLEPLAY-032",
      "topic": "Context transition",
      "exam_objective": "Model the data",
      "exam_subobjective": "Context transition",
      "prompt": "A calculated column in Customer uses CALCULATE(SUM(Sales[Amount])) to derive lifetime sales from a related Sales fact. Why can CALCULATE change the result compared with naked SUM inside this row context?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_PROVISIONAL",
      "options": [
        {
          "id": "A",
          "text": "Calculated columns are evaluated once per visual interaction."
        },
        {
          "id": "B",
          "text": "CALCULATE always removes every active relationship automatically."
        },
        {
          "id": "C",
          "text": "SUM implicitly imports the whole table from SQL again for each row."
        },
        {
          "id": "D",
          "text": "CALCULATE performs context transition, converting the current customer row context into a filter context."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V81-040",
      "sourceId": "PL300-SUPP-V81-040",
      "legacy_id": "PBI-V22-ROLEPLAY-034",
