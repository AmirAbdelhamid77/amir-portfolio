        {
          "id": "D",
          "text": "Use a FiscalMonth–Category Revenue aggregation and test query hits."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-SUPP-V80-037",
      "sourceId": "PL300-SUPP-V80-037",
      "legacy_id": "PBI-V09-PBIP-021",
      "topic": "Merge PBIP report definitions safely",
      "exam_objective": "Manage and secure Power BI",
      "exam_subobjective": "Merge PBIP report definitions safely",
      "prompt": "Two analysts change the same PBIP page definition on separate branches: one adds a new filter, and the other replaces an obsolete visual. The Git merge reports a conflict. The team wants both deliberate changes and a reproducible deployment. What should they do?",
      "type": "single",
      "difficulty": "APPLIED_SCENARIO_AUTHOR_DRAFT_NOT_CALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Resolve the PBIP definition conflict and test both retained edits in Power BI Desktop."
        },
        {
          "id": "B",
          "text": "Accept the larger JSON file without reading either change because size predicts business correctness."
        },
        {
          "id": "C",
          "text": "Delete the full report folder and push the semantic model only, claiming both page edits survived."
