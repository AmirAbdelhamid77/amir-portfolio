        {
          "id": "C",
          "text": "Refresh the semantic model in Desktop from its source, confirming the file path is accessible."
        },
        {
          "id": "D",
          "text": "Wait until the next mobile app startup to synchronize the file contents."
        }
      ],
      "gradingEnabled": false
    },
    {
      "draftId": "draft-pl300-v88-PL300-RB12-V02-010",
