      "exam_objective": "Prepare the data",
      "exam_subobjective": "Preserve all primary dimension members during enrichment from incomplete secondary attributes",
      "prompt": "DimCustomer includes all 5,000 unique CustomerIDs, while DimLoyalty contains exactly one row for 4,700 of those customers. You need one consolidated customer dimension without losing customers. Which merge is correct?",
      "type": "single",
      "difficulty": 4,
      "code": "",
      "options": [
        {
          "id": "A",
          "text": "Merge DimCustomer as the left table with a Left outer join to DimLoyalty, then expand needed attributes while preserving blanks for unmatched customers."
        },
        {
          "id": "B",
          "text": "Merge DimLoyalty as the left table with a Left outer join, because it always preserves the larger master dimension regardless of ordering."
        },
        {
          "id": "C",
          "text": "Use Inner join, because unique ID values force both tables to contain all the same customer keys."
        },
        {
          "id": "D",
          "text": "Use Left anti join from DimCustomer, because it keeps the customers that have valid loyalty records."
        }
      ],
      "gradingEnabled": false
    },
    {
