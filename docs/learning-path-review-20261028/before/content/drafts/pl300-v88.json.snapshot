      "topic": "Outlier impact on mean",
      "exam_objective": "Visualize and analyze the data",
      "exam_subobjective": "Outlier impact on mean",
      "prompt": "One shipment takes 60 days while 99 take 2 days. Management wants typical transit time and the exceptional tail. What summary avoids masking both?",
      "type": "single",
      "difficulty": "APPLIED_AUTHORIAL_DRAFT_UNCALIBRATED",
      "options": [
        {
          "id": "A",
          "text": "Present only the mean and call it the median."
