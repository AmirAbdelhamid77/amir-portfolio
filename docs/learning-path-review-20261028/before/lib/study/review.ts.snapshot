import dp from '@/content/drafts/dp600-r18.json';import pl from '@/content/drafts/pl300-v88.json';import notion from '@/content/intake/notion-lessons.json';import assessments from '@/content/intake/notion-assessments.json';import rti from '@/content/intake/rti-labs.json';import {classify,type StudyRecord,type SubjectId} from './taxonomy';
// Explicit metadata allowlist: never project options, keys or answer rationales.
export function reviewRecords():StudyRecord[]{const out:StudyRecord[]=[];
 function question(q:Record<string,unknown>,bank:string,subject:SubjectId,status:string){const text=String(q.prompt??q.stem??q.question??q.title??q.sourceId),id=String(q.draftId??q.id??q.sourceId),sourceId=String(q.sourceId??q.id);out.push({id,title:text.slice(0,170),href:`/practice/drafts/?bank=${bank}&q=${encodeURIComponent(sourceId)}`,subject,...classify(subject,String(q.exam_subobjective??q.topic??'')+' '+text),kind:'question',context:'REVIEW ONLY — '+status,source:bank+' / '+sourceId,status,language:'en'});}
 for(const q of dp.questions)question(q,'dp600-r18','fabric',dp.status);for(const q of pl.questions)question(q,'pl300-v88','power-bi',pl.status);for(const q of assessments.questions)question(q,'notion-28','visualization',assessments.status);
 for(const l of notion.lessons)out.push({id:l.id,title:l.title,href:`/learn/drafts/?tab=lessons&q=${encodeURIComponent(l.title)}`,subject:'visualization',...classify('visualization',l.title),kind:'read',context:'REVIEW ONLY — '+l.explanation,source:'Creative-patterns intake / '+l.id,status:notion.status,language:'en'});
 for(const l of rti.labs)out.push({id:l.lab_id,title:l.title,href:`/learn/drafts/?tab=labs&q=${encodeURIComponent(l.title)}`,subject:'fabric',...classify('fabric',l.title),kind:'experiment',context:'REVIEW ONLY — '+l.task,source:'RTI source lab / '+l.lab_id,status:rti.status+' · '+rti.runtimeStatus,language:'en'});return out;}
