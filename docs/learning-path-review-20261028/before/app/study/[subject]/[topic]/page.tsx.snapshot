import {TOPIC_GOALS} from '@/lib/study/briefs';
import Link from 'next/link';import {SUBJECTS,subjectById,topicHref} from '@/lib/study/taxonomy';import {studyRecords} from '@/lib/study/server';import {TopicBrowser} from '@/components/study/topic-browser';import '@/components/study/study.css';
export const dynamicParams=false;export function generateStaticParams(){return SUBJECTS.flatMap(s=>s.topics.map(([topic])=>({subject:s.id,topic})));}
export async function generateMetadata({params}:{params:Promise<{subject:string;topic:string}>}){const p=await params,s=subjectById(p.subject);return {title:`${s?.topics.find(t=>t[0]===p.topic)?.[1]} — ${s?.title}`,alternates:{canonical:topicHref(p.subject,p.topic)}};}
export default async function Page({params}:{params:Promise<{subject:string;topic:string}>}){const {subject,topic}=await params,s=subjectById(subject)!,index=s.topics.findIndex(t=>t[0]===topic),title=s.topics[index][1],items=studyRecords().filter(r=>r.subject===subject&&r.topic===topic);return <div className="study-shell"><header className="study-heading"><nav aria-label="Breadcrumb"><Link href="/study/">Subjects</Link><Link href={`/study/${subject}/`}>{s.title}</Link><span aria-current="page">{title}</span></nav><p className="study-eyebrow">{s.title} / TOPIC DESK</p><h1>{title}</h1><p>{TOPIC_GOALS[`${subject}.${topic}`]??s.goal}</p></header><TopicBrowser items={items}/><details className="study-topic-guide"><summary className="min-h-11 cursor-pointer py-3">Study order, prerequisites & source context</summary><p>Use this desk to understand the topic, try an experiment and practise its decisions. Source order and exam pack labels are kept in the source details.</p><p>There is no mandatory unlock or claimed prerequisite chain here. Topic grouping is organizational; each original lesson retains its actual prerequisites and each question retains its review status.</p>{index>0&&<p>Suggested earlier reading in this subject: <Link className="underline" href={topicHref(subject,s.topics[index-1][0])}>{s.topics[index-1][1]}</Link>. This is a reading sequence, not a scientific dependency.</p>}</details><nav className="study-source-shelf" aria-label="Continue through subject"><Link href={`/study/${subject}/`}>All topics in {s.title}</Link>{index<s.topics.length-1&&<Link href={topicHref(subject,s.topics[index+1][0])}>Suggested next topic: {s.topics[index+1][1]} ↗</Link>}</nav></div>;}
