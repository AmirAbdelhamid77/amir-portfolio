import type { Metadata } from "next";
import Link from "next/link";
import { Container } from "@/components/ui";
import { HubHeader, Panel, Callout } from "@/components/fabric/ui";
import { IngestionLab } from "@/components/academy/ingestion-lab";
import { PatternComparison } from "@/components/academy/pattern-comparison";
import { AtlasPeek } from "@/components/atlas/peek";
import { getAtlas } from "@/lib/atlas/server";
import { LESSON, REFERENCES } from "@/lib/academy/ingestion";
export const metadata: Metadata = { title: "Ingestion Decision Lab — DP-600 Academy", description: LESSON.objective, alternates: { canonical: LESSON.href } };
export default function IngestionLesson() {
    return <>
 <HubHeader eyebrow="DP-600 Academy · Prepare data for analytics" title={LESSON.title} description="The key question is what must happen to the data: reference it, replicate it, or retain a transformed result."><Link className="mt-4 inline-block min-h-11 py-3 text-sm underline underline-offset-4" href="/learn/dp-600/">Back to the academy</Link></HubHeader>
 <Container className="space-y-8 py-8 md:py-12">
  <nav aria-label="Lesson sections" className="flex flex-wrap gap-x-5 gap-y-2 text-sm">{[["understand", "Understand"], ["experiment", "Predict & explore"], ["sources", "Evidence"], ["continue", "Continue"]].map(([id, label]) => <a key={id} href={`#${id}`} className="min-h-11 py-3 underline underline-offset-4">{label}</a>)}</nav>
  <Panel title="Your learning goal"><p className="text-sm leading-7">{LESSON.objective}</p><p className="mt-2 text-sm leading-7 text-muted-foreground">Before starting: {LESSON.prerequisites.join("; ")}. This is an untimed conceptual lab. It does not connect to a Fabric tenant.</p></Panel>
  <section id="understand" className="scroll-mt-24"><h2 className="text-2xl font-medium">1. Follow the data, then choose the pattern</h2><p className="mt-3 max-w-3xl text-sm leading-7 text-muted-foreground">Start with the required outcome. A reference makes a target accessible through another path. A database replica is another analytical representation maintained by replication. A retained batch result needs a deliberate load and history policy. Freshness alone does not decide between them.</p>
   <PatternComparison />
   <div className="mt-5"><Callout title="Two distinctions that prevent wrong answers"><p>“Mirroring” here means database replication. Metadata mirroring can use shortcuts instead. A shortcut avoids a separately maintained ingestion replica, but reads can still transfer bytes and eligible external shortcuts can cache files. Never infer universal zero movement, immediate report freshness or automatic access.</p></Callout></div>
   <details className="mt-5 rounded-2xl border border-border-strong p-4"><summary className="min-h-11 cursor-pointer py-2 text-sm font-medium">Worked decision: two workspaces, one Gold table</summary><ol className="list-decimal space-y-2 pl-5 text-sm leading-7"><li>Existing Delta table is a supported OneLake target; both paths have authorized access.</li><li>The consumer needs reuse, not a separate analytical replica or retained snapshot.</li><li>No transformation is required. Create a shortcut, then validate consumer behavior and permissions.</li><li>If the requirement changes to retaining yesterday’s transformed output, the reference alone is no longer sufficient.</li></ol></details>
  </section>
  <AtlasPeek atlas={getAtlas()} />
  <section id="experiment" className="scroll-mt-24" aria-label="Interactive ingestion practice"><noscript><p className="mb-4 rounded-xl border border-border-strong p-4 text-sm leading-7">Interactive practice requires JavaScript. The explanation, comparison, worked decision and source references remain available above and below.</p></noscript><IngestionLab /></section>
  <section id="sources" className="scroll-mt-24 rounded-3xl border border-border p-5"><h2 className="text-xl font-medium">Evidence and scope</h2><p className="mt-3 text-sm leading-7 text-muted-foreground">Original Hansa explanations and exercises, documentation-reviewed on 25 October 2026; no live Fabric execution. Inspired by study-guide pages {LESSON.sourcePages.join(", ")}. The original guide remains an internal editorial source; full text and preview images are not published here. This pilot does not establish complete DP-600 syllabus coverage.</p><ul className="mt-3 space-y-1">{REFERENCES.map(r => <li key={r.id}><a className="inline-block min-h-11 py-2 text-sm underline underline-offset-4" href={r.url}>{r.title} — Microsoft Learn</a></li>)}</ul><p className="mt-2 text-xs leading-6 text-muted-foreground">Source support, security modes and features change. Validate the relevant connector, identity and capacity before applying this design in a real workspace. {LESSON.origin}.</p><a className="mt-3 inline-block min-h-11 py-2 text-sm underline underline-offset-4" href="/contact/">Report a lesson issue via Contact</a></section>
  <section id="continue" className="scroll-mt-24"><h2 className="text-xl font-medium">5. Reflect and continue</h2><p className="mt-3 text-sm leading-7">Explain the requirement that would make you change your first choice. Could a source-support or permission issue invalidate it? A correct pattern without those assumptions is an incomplete design.</p><div className="mt-4 flex flex-wrap gap-4"><Link className="min-h-11 rounded-full border border-border-strong px-5 py-3 text-sm" href="/lab/dp-600/explore/?subject=ingestion">Explore related existing questions</Link><Link className="min-h-11 rounded-full border border-border-strong px-5 py-3 text-sm" href="/lab/dp-600/resources/">Existing labs & source notes</Link><a className="min-h-11 rounded-full border border-border-strong px-5 py-3 text-sm" href="https://learn.microsoft.com/training/modules/discover-data-onelake/">Try Microsoft’s OneLake learning module</a></div><p className="mt-3 text-xs leading-6 text-muted-foreground">Related questions belong to the existing Fabric bank and keep their own progress. This lesson’s three transfer cases are tracked separately.</p></section>
 </Container>
 </>;
}
