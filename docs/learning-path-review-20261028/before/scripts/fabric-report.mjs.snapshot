// Generates the Fabric import and coverage reports from the generated content
// layer, so every number in the docs is reproducible rather than transcribed.
//
//   npm run report:fabric
//
// Writes:
//   docs/fabric/02-import-report.md
//   docs/fabric/03-coverage-report.md
//   docs/fabric/coverage-matrix.csv
//   docs/fabric/coverage-matrix.json
//   docs/fabric/classification-confidence.json
//   docs/fabric/dp700-adjacency.json

import { mkdir, readFile, readdir, writeFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { DOMAINS, OBJECTIVES, SUBJECTS } from "../lib/fabric/taxonomy.ts";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const CONTENT = path.join(ROOT, "content/fabric");
const OUT = path.join(ROOT, "docs/fabric");

const readJson = async (name) => JSON.parse(await readFile(path.join(CONTENT, name), "utf8"));

const [packs, index, cases, sources, meta] = await Promise.all([
  readJson("packs.json"),
  readJson("index.json"),
  readJson("cases.json"),
  readJson("sources.json"),
  readJson("meta.json"),
]);

const questionFiles = (await readdir(path.join(CONTENT, "questions"))).filter((file) => file.endsWith(".json"));
const questions = [];
for (const file of questionFiles) {
  questions.push(...JSON.parse(await readFile(path.join(CONTENT, "questions", file), "utf8")));
}
const questionById = new Map(questions.map((question) => [question.id, question]));

await mkdir(OUT, { recursive: true });

const pct = (value, total) => (total === 0 ? "0.0" : ((value / total) * 100).toFixed(1));
const table = (head, rows) => {
  const lines = [`| ${head.join(" | ")} |`, `| ${head.map(() => "---").join(" | ")} |`];
  for (const row of rows) lines.push(`| ${row.join(" | ")} |`);
  return lines.join("\n");
};

// ---------------------------------------------------------------------------
// 1. Import report
// ---------------------------------------------------------------------------

const packRows = packs.map((pack) => {
  const stats = meta.coverage.byPack.find((row) => row.pack === pack.key);
  return [
    pack.key,
    pack.title.replace(/\|/g, "/"),
    pack.questionCount,
    stats?.core ?? 0,
    pack.chapterCount,
    pack.video?.title.replace(/\|/g, "/") ?? "—",
  ];
});

const importReport = `# Question import report

Generated by \`npm run report:fabric\` on ${new Date().toISOString()}.
Every figure below is read from \`content/fabric/*.json\`, which
\`scripts/import-fabric-bank.mjs\` writes from the supplied package.

## Totals

${table(
  ["Figure", "Value", "Source of truth"],
  [
    ["Questions imported", questions.length, "sum of the 18 pack files"],
    ["Source packs", packs.length, "`LAB_PACKS.merged.json` keys"],
    ["Source videos", new Set(packs.map((pack) => pack.video?.id)).size, "pack video metadata"],
    ["Reference registry entries", sources.length, "`SOURCES.merged.json`"],
    ["Case studies", cases.length, "grouped by identical title+text"],
    ["Questions with case context", meta.counts.withCaseStudy, "`caseStudyId` present"],
  ],
)}

## Question types

${table(
  ["Type", "Count", "Grading rule"],
  [
    ["Single answer", meta.counts.singleSelect, "exactly one option id"],
    ["Multi-select", meta.counts.multiSelect, "exact set — a partial answer is wrong"],
    ["Ordered sequence", meta.counts.sequence, "exact order of every option id"],
  ],
)}

Other structural figures: **${meta.counts.fiveOption}** questions have five options (the rest have four);
**${meta.counts.withCode}** carry a code snippet; **${meta.counts.withCaseStudy}** carry case-study context.

## Packs

${table(["Pack key", "Title", "Questions", "DP-600 focused", "Chapters", "Source video"], packRows)}

## Alignment scope

Scope comes from each question's own \`importMetadata.exam_objective\`, never from a guess.

${table(
  ["Scope", "Questions", "Share"],
  meta.coverage.byScope.map((row) => [row.scope, row.total, `${pct(row.total, questions.length)}%`]),
)}

- **core** — the source names a DP-600 domain with no adjacent qualifier.
- **support** — DP-600 supporting/enrichment, or a topic-derived mapping with no declared objective.
- **adjacent** — the source declares DP-700 as primary.
- **review** — no defensible mapping; kept, labelled, and excluded from focused sessions.

## Duplicates and quarantine

- **Exact normalised prompt duplicates:** ${meta.packageQa.exactDuplicatePromptGroups} groups.
- **Lexical similarity candidates:** ${meta.packageQa.similarityCandidates} (V16-SQL-010 / V16-SQL-033,
  reviewed by the package author as distinct scenarios and retained).
- **Quarantined records:** 0. No record was deleted, rewritten or normalised to satisfy a test.
- **Documented adaptations:** ${meta.packageQa.adaptations.length} — \`${meta.packageQa.adaptations[0]?.id}\`:
  ${meta.packageQa.adaptations[0]?.change}

## Integrity checks

The importer ran **${meta.integrity.checksRun.toLocaleString()}** assertions and recorded
**0 failures**. Categories: unique internal ids, pack references, option ids, answer keys,
answer cardinality per type, explanation presence, option-level rationales, case-study shape,
reference resolution, type compatibility, import metadata, difficulty metadata, flat-bank
agreement and declared-count agreement.

Recorded warnings (documented, not fatal): **${meta.integrity.warnings.length}**, all of one kind —
the eight foundation questions have \`time: null\` because they are synthesis questions with no
single video anchor.

## Provenance

${table(["Origin", "Questions"], meta.origins.map((row) => [row.label, row.count]))}

Validation wording preserved verbatim from the source package:

${table(["Author's validation note", "Questions"], meta.validationNotes.map((row) => [row.label.replace(/\|/g, "/"), row.count]))}

The remaining ${meta.counts.questions - meta.validationNotes.reduce((sum, row) => sum + row.count, 0)}
questions (the five original topic packs plus the foundation set) carry no validation note; the
package predates that metadata. Nothing was invented to fill the gap.

## Reference verification

- All ${sources.length} registry entries have an \`https\` URL and a title.
- Every reference cited by a question resolves to a registry entry: **0 broken references**.
- ${sources.length - new Set(questions.flatMap((question) => question.refs)).size} registry entries are
  currently cited by no question. They are kept because the registry is the package's own
  canonical list and a future question may cite them.

## How to reproduce

\`\`\`bash
node --experimental-strip-types scripts/import-fabric-bank.mjs \\
  --source "../Amirs_Fabric_Lab_Merged_834_Deployment_Package"
npm run test:fabric
npm run report:fabric
\`\`\`
`;

await writeFile(path.join(OUT, "02-import-report.md"), importReport, "utf8");

// ---------------------------------------------------------------------------
// 2. Coverage report
// ---------------------------------------------------------------------------

const domainRows = meta.coverage.domainShares.map((domain) => {
  const band = domain.officialWeight.split("–").map((value) => Number(value.replace("%", "")));
  const midpoint = (band[0] + band[1]) / 2;
  const gap = (domain.coreShare - midpoint).toFixed(1);
  return [
    domain.domain,
    domain.label,
    domain.officialWeight,
    domain.coreQuestions,
    `${domain.coreShare}%`,
    `${gap > 0 ? "+" : ""}${gap} pts`,
  ];
});

const objectiveDetail = OBJECTIVES.map((objective) => {
  const row = meta.coverage.byObjective.find((item) => item.key === objective.id);
  return [
    objective.id,
    objective.label,
    row?.total ?? 0,
    row?.core ?? 0,
    row?.support ?? 0,
    row?.adjacent ?? 0,
    row?.review ?? 0,
  ];
});

const weakest = [...meta.coverage.byObjective]
  .filter((row) => /^\d\.\d$/.test(row.key))
  .sort((a, b) => a.total - b.total)
  .slice(0, 3)
  .map((row) => `${row.key} ${row.label.replace(/^DP-600 [\d.]+ · /, "")} (${row.total})`);

const coverageReport = `# DP-600 coverage report

Generated by \`npm run report:fabric\` on ${new Date().toISOString()}.
The exam blueprint is Microsoft's study guide, *skills measured as of 19 October 2026*
(https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/dp-600).

## Official weights versus this bank

${table(
  ["Domain", "Official title", "Official weight", "Focused questions", "Share of focused", "Difference"],
  domainRows,
)}

A focused question is one whose own source metadata names a DP-600 objective with no
adjacent qualifier. The "difference" column compares the bank's share against the midpoint
of Microsoft's published band.

**Reading:** the bank is heavily weighted toward *Maintain a data analytics solution*
(${meta.coverage.domainShares[0].coreShare}%) and badly under-weighted on *Implement and manage
semantic models* (${meta.coverage.domainShares[2].coreShare}%, ${meta.coverage.domainShares[2].coreQuestions} questions).
Those are facts about the supplied content, not a defect introduced here.

## Sub-objective coverage

${table(["Objective", "Name", "Total", "Focused", "Supporting", "DP-700", "Review"], objectiveDetail)}

Thinnest sub-objectives by volume: ${weakest.join("; ")}.

## What the gap means for practice design

1. **No blueprint-weighted mock is offered.** Reproducing 25–30% semantic models from 13
   questions would require either repetition that pretends to be a sample, or invented
   questions. Both would misrepresent the bank.
2. **Timed sessions are labelled "custom practice simulation"** in the UI, the session
   label, and the results screen. No percentage is described as a predicted exam score.
3. **Semantic-model study is flagged as thin** on the hub, the mock set-up and here, so a
   reader does not infer coverage from a large total.
4. **DP-700-adjacent material is kept and labelled.** ${meta.counts.adjacent} questions declare
   DP-700 as primary; they are excluded from "DP-600 focused" sessions but remain available
   in Fabric Extended scope, because the engineering depth is genuinely useful — it is just
   not what DP-600 measures.

## Domain-level questions the bank cannot answer

- **Calculation groups, field parameters, .pbip projects, XMLA endpoint, incremental refresh,
  Direct Lake fallback configuration** are named in the official bullets but have very few or
  no questions here.
- **KQL query authoring** is represented (${meta.coverage.bySubject.find((row) => row.key === "eventhouse")?.total ?? 0}
  Eventhouse/KQL questions), but mostly as Eventhouse operations rather than as the DP-600
  "Query and analyze data" sub-objective.
- **Visual query editor** appears in the study guide and in none of the questions.

These are content gaps in the source material, recorded so future packs can target them.

## Subject coverage (Fabric technology view)

${table(
  ["Subject", "Questions", "Focused"],
  SUBJECTS.map((subject) => {
    const row = meta.coverage.bySubject.find((item) => item.key === subject.id);
    return [subject.label, row?.total ?? 0, row?.core ?? 0];
  }),
)}

Subjects are derived from each question's own wording, topic and references, so one question
can be found under a technology area even when its source pack is organised by video.

## Limitations of the practice simulation

- Question mix is not weighted to the blueprint, and says so.
- Microsoft lists **100 minutes** for DP-600; presets use that as context only. The default
  pace suggestion (${Math.round(1.5 * 10) / 10} minutes per question) comes from the source package's
  own suggested timing, not from a calibrated study.
- Scores measure this session, not exam readiness.
`;

await writeFile(path.join(OUT, "03-coverage-report.md"), coverageReport, "utf8");

// ---------------------------------------------------------------------------
// 3. Machine-readable artifacts
// ---------------------------------------------------------------------------

const matrix = index.map((entry) => {
  const question = questionById.get(entry.id);
  return {
    internalId: entry.id,
    sourceId: entry.sourceId,
    pack: entry.pack,
    sourcePackTitle: packs.find((pack) => pack.key === entry.pack)?.title ?? entry.pack,
    title: entry.title,
    type: entry.type,
    subject: entry.subject,
    subjects: entry.subjects,
    domain: entry.domain,
    objectiveId: entry.objectiveId,
    scope: entry.scope,
    confidence: entry.confidence,
    sourceObjective: question?.sourceObjective ?? null,
    sourceVideoId: packs.find((pack) => pack.key === entry.pack)?.video?.id ?? null,
    videoSeconds: entry.videoSeconds,
    difficulty: entry.difficulty,
    optionCount: entry.optionCount,
    answerCount: entry.answerCount,
    caseStudyId: entry.caseStudyId,
    references: entry.refs,
  };
});

await writeFile(
  path.join(OUT, "coverage-matrix.json"),
  `${JSON.stringify({ generatedAt: new Date().toISOString(), totals: meta.counts, rows: matrix }, null, 2)}\n`,
  "utf8",
);

const csvHead = [
  "internal_id",
  "source_id",
  "pack",
  "type",
  "subject",
  "domain",
  "objective_id",
  "scope",
  "confidence",
  "source_objective",
  "video_seconds",
  "difficulty",
  "option_count",
  "answer_count",
  "case_study_id",
];
const escape = (value) => {
  const text = value === null || value === undefined ? "" : String(value);
  return /[",\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
};
const csv = [
  csvHead.join(","),
  ...matrix.map((row) =>
    [
      row.internalId,
      row.sourceId,
      row.pack,
      row.type,
      row.subject,
      row.domain,
      row.objectiveId,
      row.scope,
      row.confidence,
      row.sourceObjective,
      row.videoSeconds,
      row.difficulty,
      row.optionCount,
      row.answerCount,
      row.caseStudyId,
    ]
      .map(escape)
      .join(","),
  ),
].join("\n");
await writeFile(path.join(OUT, "coverage-matrix.csv"), `${csv}\n`, "utf8");

const confidence = {
  generatedAt: new Date().toISOString(),
  byConfidence: ["high", "medium", "low"].map((level) => ({
    level,
    count: index.filter((entry) => entry.confidence === level).length,
  })),
  byScope: meta.coverage.byScope,
  needsReview: index
    .filter((entry) => entry.scope === "review")
    .map((entry) => ({
      internalId: entry.id,
      sourceId: entry.sourceId,
      pack: entry.pack,
      title: entry.title,
      reason: "No declared objective and the topic rules scored two subjects equally.",
    })),
  method:
    "Objectives resolve from importMetadata.exam_objective first (first domain named wins). Without it, the subject rule decides and confidence drops to low/medium. Subjects are scored from topic, title, prompt, references and a pack prior; a margin under 2 marks the question as needing review.",
};
await writeFile(path.join(OUT, "classification-confidence.json"), `${JSON.stringify(confidence, null, 2)}\n`, "utf8");

const adjacency = {
  generatedAt: new Date().toISOString(),
  adjacent: index
    .filter((entry) => entry.scope === "adjacent")
    .map((entry) => ({
      internalId: entry.id,
      sourceId: entry.sourceId,
      pack: entry.pack,
      title: entry.title,
      sourceObjective: questionById.get(entry.id)?.sourceObjective ?? null,
    })),
  note:
    "These questions declare DP-700 as primary in their own source metadata. They are excluded from DP-600 Focused sessions and remain available in Fabric Extended scope. None is presented as directly assessed DP-600 content.",
};
await writeFile(path.join(OUT, "dp700-adjacency.json"), `${JSON.stringify(adjacency, null, 2)}\n`, "utf8");

console.log(`Wrote reports for ${matrix.length} questions to docs/fabric/.`);
console.log(`  focused ${meta.counts.core} · supporting ${meta.counts.support} · adjacent ${meta.counts.adjacent} · review ${meta.counts.review}`);
for (const domain of DOMAINS) {
  const row = meta.coverage.domainShares.find((item) => item.domain === domain.id);
  console.log(`  domain ${domain.id}: ${row.coreShare}% of focused (official ${domain.officialWeight})`);
}
