import {chromium} from 'playwright-core';import {writeFile} from 'node:fs/promises';
const browser=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true}),checks=[];const check=(id,pass)=>{checks.push({id,status:pass?'PASS':'FAIL'});console.log(`${pass?'PASS':'FAIL'} ${id}`);};
try{const p=await browser.newPage({viewport:{width:1280,height:900}});await p.goto('http://127.0.0.1:4321/Hansa_Final_Review/',{waitUntil:'networkidle'});for(const width of ['320','390','768','1280','1440'])for(const theme of ['light','dark']){await p.locator('#width').selectOption(width);await p.locator('#theme').selectOption(theme);await p.waitForFunction(()=>[...document.querySelectorAll('#before,#after')].every(i=>i.complete&&i.naturalWidth>0));check(`HOME-GALLERY-${width}-${theme}`,true);}for(const theme of ['light','dark']){await p.locator('#atlas-theme').selectOption(theme);await p.waitForFunction(()=>[...document.querySelectorAll('#atlas-public,#atlas-review,#atlas-phone,#atlas-map-phone')].every(i=>i.complete&&i.naturalWidth>0));check(`ATLAS-GALLERY-${theme}`,true);}
const videos=await p.locator('video').evaluateAll(async videos=>{return await Promise.all(videos.map(v=>new Promise(resolve=>{v.preload='auto';const end=()=>resolve({src:v.getAttribute('src'),duration:v.duration,valid:Number.isFinite(v.duration)&&v.duration>4,width:v.videoWidth,height:v.videoHeight,error:v.error?.message});if(v.readyState>=1)end();else{v.addEventListener('loadedmetadata',end,{once:true});v.addEventListener('error',end,{once:true});setTimeout(end,15000);v.load();}})));});for(const v of videos)check('VIDEO:'+v.src,v.valid&&v.width>0);const links=await p.locator('a[href$=".md"],a[href$=".json"],a[href$=".patch"],a[href$=".zip"]').evaluateAll(a=>a.map(e=>e.href));for(const url of new Set(links))check('DELIVERABLE-LINK:'+new URL(url).pathname,(await fetch(url,{method:'HEAD'})).status===200);await p.evaluate(()=>scrollTo(0,0));await p.screenshot({path:'docs/final-review-20261028/evidence/gallery-1280.png'});await writeFile('docs/final-review-20261028/checks/video-metadata.json',JSON.stringify(videos,null,2));}
finally{await browser.close();await writeFile('docs/final-review-20261028/checks/delivery-gallery.json',JSON.stringify({checks},null,2));}if(checks.some(c=>c.status==='FAIL'))process.exitCode=1;
