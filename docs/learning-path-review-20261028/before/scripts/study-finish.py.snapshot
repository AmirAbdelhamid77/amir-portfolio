from pathlib import Path
r=Path(__file__).resolve().parents[1];p=r/'app/study/[subject]/[topic]/page.tsx';s=p.read_text(encoding='utf8');s="import {TOPIC_GOALS} from '@/lib/study/briefs';\n"+s;s=s.replace('<p>{s.goal}</p>','<p>{TOPIC_GOALS[`${subject}.${topic}`]??s.goal}</p>');a=s.index('<div className="study-topic-guide">');z=s.index('</div><TopicBrowser items={items}/>',a);guide=s[a:z+6].replace('<div className="study-topic-guide">','<details className="study-topic-guide"><summary className="min-h-11 cursor-pointer py-3">Study order, prerequisites & source context</summary>').replace('</div>','</details>');s=s[:a]+'<TopicBrowser items={items}/>'+guide+s[z+len('</div><TopicBrowser items={items}/>'):];p.write_text(s,encoding='utf8')
