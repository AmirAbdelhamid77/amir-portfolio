import {chromium} from 'playwright-core';import {writeFile} from 'node:fs/promises';const b=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true}),checks=[];try{for(const width of [390,1440]){const c=await b.newContext({viewport:{width,height:900},isMobile:width<500,hasTouch:width<500}),p=await c.newPage();await p.goto('http://127.0.0.1:4318/practice/catalogue/',{waitUntil:'networkidle'});await p.locator('.study-open').first().click();await p.waitForURL('**/study/fabric/?mode=question');const link=p.getByRole('link',{name:/Data ingestion & orchestration/});await link.waitFor();await p.waitForFunction(()=>document.querySelector('a[href*="/study/fabric/ingestion/"]')?.getAttribute('href')?.includes('mode=question'));await link.click();await p.getByLabel('Learning activity',{exact:true}).waitFor();await p.waitForFunction(()=>document.querySelector('select[aria-label="Learning activity"]')?.value==='question');checks.push({id:'PRACTICE-INTENT-'+width,status:'PASS'});await c.close();}}finally{await b.close();await writeFile('docs/learning-architecture-20261028/evidence/intent-results.json',JSON.stringify({checks},null,2));}console.log('PASS practice intent retained through subject and topic on mobile and desktop');
