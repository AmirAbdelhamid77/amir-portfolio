import {chromium} from 'playwright-core';import {readFile,writeFile} from 'node:fs/promises';
const dir='docs/final-review-20261028/evidence/atlas',checks=[];
const check=(id,pass)=>{checks.push({id,status:pass?'PASS':'FAIL'});console.log(`${pass?'PASS':'FAIL'} ${id}`);};
const data=JSON.parse(await readFile('content/atlas/dp600-continuation.json','utf8'));const distant=data.semanticEdges.find(e=>!e.from.includes('shortcut')&&!e.to.includes('shortcut'));
const browser=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true});
try{for(const width of [390,1440])for(const dark of [false,true]){const ctx=await browser.newContext({viewport:{width,height:950},hasTouch:width<500,isMobile:width<500});await ctx.addInitScript(d=>localStorage.setItem('amir-theme',d?'dark':'light'),dark);const p=await ctx.newPage();
await p.goto('http://127.0.0.1:4320/learn/dp-600/atlas/?edge='+encodeURIComponent(distant.id),{waitUntil:'networkidle'});check(`OUTSIDE-FOCUS-${width}-${dark}`,await p.getByText('The requested connection is outside this focus. Choose a visible connection or reset the view.').isVisible()&&!(await p.getByTestId('atlas-inspector').innerText()).includes('Relationship inspector'));
await p.getByRole('button',{name:'Reset view',exact:true}).click();if(width<1280)await p.getByRole('button',{name:'Open the optional map'}).click();await p.locator('.atlas-circle-edge').first().focus();await p.keyboard.press('Enter');await p.waitForTimeout(300);await p.getByTestId('atlas-map').screenshot({path:`${dir}/selected-map-${width}-${dark?'dark':'light'}.png`});await p.getByTestId('atlas-inspector').screenshot({path:`${dir}/selected-evidence-${width}-${dark?'dark':'light'}.png`});check(`SELECTED-ENDPOINTS-${width}-${dark}`,await p.locator('[data-edge-focus="endpoint"]').count()===2);await ctx.close();}}
finally{await browser.close();await writeFile(`${dir}/focused-results.json`,JSON.stringify({checks},null,2));}if(checks.some(c=>c.status==='FAIL'))process.exitCode=1;
