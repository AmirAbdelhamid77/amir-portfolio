import {register} from 'node:module';register('./study-loader.mjs',import.meta.url);
import {readFileSync,writeFileSync,readdirSync,mkdirSync} from 'node:fs';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const {studyRecords}=await import('../lib/study/server.ts'),{SUBJECTS}=await import('../lib/study/taxonomy.ts');const records=studyRecords(),dir='docs/learning-architecture-20261028';mkdirSync(dir,{recursive:true});
const {reviewRecords}=await import('../lib/study/review.ts');const review=reviewRecords();assert.equal(review.length,1572);assert.equal(new Set(review.map(r=>r.id)).size,review.length);writeFileSync(dir+'/REVIEW_RECORDS.json',JSON.stringify(review,null,2));
assert.equal(new Set(records.map(r=>r.id)).size,records.length,'Duplicate identities in learning registry');
assert.equal(records.filter(r=>r.kind==='question').length,1441,'834 original + 532 additions + 60 analyst + 12 scenarios + 3 authored transfer cases; R11 is a revision overlay');
assert.equal(records.filter(r=>r.source.includes('current R11 revision')).length,222,'Every current R11 revised stem must replace its older index text');
for(const r of records){assert.ok(SUBJECTS.find(s=>s.id===r.subject)?.topics.some(t=>t[0]===r.topic));assert.ok(r.title&&r.href.startsWith('/'));assert.ok(!/^draft-|^r18-|^v88-/i.test(r.id),'Unapproved draft escaped isolation: '+r.id);assert.ok(!('answer'in r)&&!('options'in r));}
const walk=d=>readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):[d+'/'+e.name]);
const baseline=JSON.parse(readFileSync(dir+'/BASELINE.json','utf8')).files;const changedContent=[];for(const [p,hash]of Object.entries(baseline))if(p.startsWith('content/')){if(createHash('sha256').update(readFileSync(p)).digest('hex')!==hash)changedContent.push(p);}assert.deepEqual(changedContent,[],'Original content changed');
const inventory=walk('content').filter(p=>p.endsWith('.json')).map(p=>{const data=JSON.parse(readFileSync(p));return {path:p,sha256:createHash('sha256').update(readFileSync(p)).digest('hex'),arrays:Array.isArray(data)?{records:data.length}:Object.fromEntries(Object.entries(data).filter(([,v])=>Array.isArray(v)).map(([k,v])=>[k,v.length])),role:/drafts|intake/.test(p)?'isolated-review':/r11/.test(p)?'revision-overlay-not-extra-questions':'canonical-source-or-derived-view'};});
const imports=walk('app').concat(walk('components'),walk('lib')).filter(p=>/\.tsx?$/.test(p)).flatMap(p=>[...readFileSync(p,'utf8').matchAll(/(?:from\s+|import\s*)["']([^"']+)["']/g)].map(m=>({from:p,to:m[1]})));
const lessons=JSON.parse(readFileSync('content/intake/notion-lessons.json')).lessons;const deps=lessons.flatMap(l=>[...(l.prerequisite_lesson_ids??[]),...(l.prerequisite_slugs??[])].map(target=>({from:l.id,to:target,status:'existing-review-only-prerequisite'})));const ids=new Set(lessons.flatMap(l=>[l.id,l.slug]));const dangling=deps.filter(e=>!ids.has(e.to));
writeFileSync(dir+'/RECORDS.json',JSON.stringify(records,null,2));writeFileSync(dir+'/SOURCE_INVENTORY.json',JSON.stringify(inventory,null,2));writeFileSync(dir+'/IMPORT_DEPENDENCIES.json',JSON.stringify(imports,null,2));writeFileSync(dir+'/REVIEW_DEPENDENCIES.json',JSON.stringify({dependencies:deps,dangling,notice:'Existing review-only declarations retained. Topic order does not create semantic dependencies.'},null,2));
const summary={records:records.length,uniqueIDs:records.length,subjects:SUBJECTS.map(s=>({id:s.id,records:records.filter(r=>r.subject===s.id).length,topics:s.topics.map(([id])=>({id,records:records.filter(r=>r.subject===s.id&&r.topic===id).length}))})),questionRecords:records.filter(r=>r.kind==='question').length,broadPlacement:records.filter(r=>r.basis.startsWith('Broad')).length,contentFilesPreserved:inventory.length,importEdges:imports.length,reviewDependencies:deps.length,danglingReviewDependencies:dangling};writeFileSync(dir+'/AUDIT.json',JSON.stringify(summary,null,2));console.log(JSON.stringify(summary,null,2));
