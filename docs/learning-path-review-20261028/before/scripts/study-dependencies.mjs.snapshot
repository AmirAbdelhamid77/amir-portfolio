import {readFileSync,writeFileSync} from 'node:fs';import assert from 'node:assert/strict';import {register} from 'node:module';register('./study-loader.mjs',import.meta.url);const {SUBJECTS}=await import('../lib/study/taxonomy.ts');
const file='docs/learning-architecture-20261028/REVIEW_DEPENDENCIES.json',data=JSON.parse(readFileSync(file)),lessons=JSON.parse(readFileSync('content/intake/notion-lessons.json')).lessons,map=new Map(lessons.flatMap(l=>[[l.id,l.id],[l.slug,l.id]]));const edges=[...new Map(data.dependencies.map(e=>{const v={...e,from:map.get(e.from),to:map.get(e.to)};return [v.from+'|'+v.to,v];})).values()],cycles=[];function walk(id,path){if(path.includes(id)){cycles.push([...path,id]);return;}for(const e of edges.filter(e=>e.from===id))walk(e.to,[...path,id]);}for(const l of lessons)walk(l.id,[]);
assert.equal(data.dangling.length,0);assert.doesNotMatch(readFileSync('lib/study/server.ts','utf8'),/lib\/search\/documents/,'Learning registry must not depend on search delivery');
writeFileSync('docs/learning-architecture-20261028/DEPENDENCY_MODEL.json',JSON.stringify({existingReviewDeclarations:data.dependencies.length,normalizedReviewEdges:edges,cycles,suggestedReadingOrder:SUBJECTS.flatMap(s=>s.topics.slice(1).map(([topic],i)=>({from:`${s.id}.${s.topics[i][0]}`,to:`${s.id}.${topic}`,relation:'suggested-reading-order',scientificPrerequisite:false}))),publishedAtlasEdges:0,notice:'Intake prerequisites remain review-only. Reading order is not a semantic graph. No new scientific edge is approved.'},null,2));console.log('PASS dependency references; cycles:',cycles.length,'; published semantic edges remain 0');
