import {chromium} from 'playwright-core';import {writeFile} from 'node:fs/promises';
const b=await chromium.launch({executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe',headless:true}),p=await b.newPage({viewport:{width:390,height:900}}),checks=[];const check=(id,pass)=>{checks.push({id,status:pass?'PASS':'FAIL'});console.log(`${pass?'PASS':'FAIL'} ${id}`);};
try{await p.addInitScript(()=>localStorage.setItem('amir-lab-v1',JSON.stringify({sql:{best:80,attempts:2,lastAt:'2026-10-27T00:00:00Z'}})));await p.goto('http://127.0.0.1:4318/lab/sql/?question=sql-07&learningContext=sql.overview',{waitUntil:'networkidle'});await p.getByRole('button',{name:'Start practice',exact:true}).click();await p.getByText('Which expression numbers employees 1, 2, 3… within each department by descending salary?',{exact:true}).waitFor();check('EXACT-QUESTION',true);check('SINGLE-QUESTION',await p.locator('main').innerText().then(t=>/Question\s+1\s+of\s+1\b/.test(t)));await p.getByRole('button',{name:'Finish now',exact:true}).click();await p.getByRole('button',{name:'Finish',exact:true}).click();check('DRILL-DOES-NOT-SCORE',await p.evaluate(()=>{const s=JSON.parse(localStorage.getItem('amir-lab-v1'));return s.sql.best===80&&s.sql.attempts===2;}));await p.goto('http://127.0.0.1:4318/lab/sql/?question=sql-07',{waitUntil:'networkidle'});await p.getByRole('radio',{name:/Mock/}).click();await p.getByRole('button',{name:'Start mock exam',exact:true}).click();check('MOCK-REMAINS-FULL',await p.locator('main').innerText().then(t=>/Question\s+1\s+of\s+10\b/.test(t)));}
finally{await b.close();await writeFile('docs/learning-architecture-20261028/evidence/drill-results.json',JSON.stringify({checks},null,2));}if(checks.some(c=>c.status==='FAIL'))process.exitCode=1;
