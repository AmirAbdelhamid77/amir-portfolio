.study-shell{max-width:1120px;margin:auto;padding:100px 24px 60px}.study-heading{max-width:880px;margin-bottom:38px}.study-eyebrow{font:11px/1.7 monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--muted-foreground)}.study-heading h1{font-size:clamp(34px,5vw,64px);font-weight:400;letter-spacing:-.045em;line-height:1.1;margin:16px 0 24px}.study-heading>p{max-width:65ch;line-height:1.9;color:var(--muted-foreground)}.study-heading nav{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:24px}.study-shell a{text-underline-offset:5px}.study-heading nav a,.study-source-shelf a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;font-size:13px}.study-principle{border-block:1px solid var(--border-strong);padding:22px 0;display:flex;gap:16px 35px;flex-wrap:wrap;font-size:13px;color:var(--primary)}.study-principle p{width:100%;font-size:12px;line-height:1.8;color:var(--muted-foreground);max-width:85ch}.study-subject{display:grid;grid-template-columns:1fr 1.5fr;gap:56px;padding:46px 0;border-bottom:1px solid var(--border-strong)}.study-number{font:46px/1 monospace;color:var(--primary);opacity:.8}.study-subject h2{font-size:27px;letter-spacing:-.025em;margin:18px 0 12px}.study-subject-intro p{color:var(--muted-foreground);font-size:14px;line-height:1.8;max-width:34ch}.study-subject small{display:block;font-size:11px;line-height:1.8;color:var(--muted-foreground);margin-top:10px}.study-topic-list a{display:grid;grid-template-columns:1fr 24px;min-height:68px;align-items:center;padding:14px 12px;border-bottom:1px solid var(--border);border-inline-start:2px solid transparent;transition:background-color .15s,border-color .15s}.study-topic-list a:hover{border-inline-start-color:var(--primary);background:var(--card)}.study-topic-list small{grid-column:1;margin:4px 0 0}.study-topic-list a>span:last-child{grid-column:2;grid-row:1/3;color:var(--primary)}.study-source-shelf{margin-top:40px;padding:22px;border:1px solid var(--border-strong)}.study-source-shelf summary{min-height:44px;cursor:pointer;line-height:1.8}.study-source-shelf p{color:var(--muted-foreground);font-size:13px;line-height:1.8}.study-source-shelf>div{display:flex;gap:12px 30px;flex-wrap:wrap}.study-controls{display:flex;gap:18px;align-items:end;flex-wrap:wrap;padding:24px 0;border-block:1px solid var(--border-strong)}.study-controls label{display:flex;flex-direction:column;gap:10px;font-size:13px;flex:1;min-width:180px}.study-controls input,.study-controls select,.study-controls button,.study-more{min-height:44px;background:var(--background);border:1px solid var(--border-strong);padding:10px;font-size:14px}.study-controls button,.study-more{cursor:pointer}.study-result-count{font-size:12px;color:var(--muted-foreground);padding:16px 0}.study-records>li{display:grid;grid-template-columns:1fr auto;gap:24px;padding:25px 0;border-bottom:1px solid var(--border)}.study-records h2{font-size:21px;line-height:1.5;letter-spacing:-.02em;margin:8px 0}.study-records h2 a:hover{text-decoration:underline}.study-records p{max-width:80ch;font-size:13px;line-height:1.9;color:var(--muted-foreground);overflow-wrap:anywhere}.study-records details{font-size:11px;margin-top:15px}.study-records summary{cursor:pointer;min-height:44px;padding:12px 0;color:var(--muted-foreground)}.study-open{min-height:44px;align-self:start;padding:12px;color:var(--primary);font-size:13px}.study-more{margin-top:24px}.study-empty{padding:30px 0;line-height:1.9}.study-shell :is(a,button,input,select,summary):focus-visible{outline:2px solid var(--primary);outline-offset:4px}.study-topic-guide{margin:20px 0 32px;padding-inline-start:18px;border-inline-start:2px solid var(--primary);font-size:13px;line-height:1.9;max-width:80ch;color:var(--muted-foreground)}@media(max-width:767px){.study-shell{padding:90px 20px 45px}.study-subject{grid-template-columns:1fr;gap:22px;padding:32px 0}.study-number{font-size:32px}.study-subject h2{margin-top:10px}.study-subject-intro p{max-width:60ch}.study-records>li{grid-template-columns:1fr;gap:4px}.study-open{justify-self:start;padding-inline:0}.study-controls{display:grid;grid-template-columns:1fr}.study-controls label{min-width:0}}@media(prefers-reduced-motion:reduce){.study-shell *{transition:none!important}}
