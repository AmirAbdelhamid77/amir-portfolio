'use client';
import Link from 'next/link';import {usePathname} from 'next/navigation';import {useEffect,useState} from 'react';import {SUBJECTS,topicHref} from '@/lib/study/taxonomy';
// Route orientation only. Does not invent question-level prerequisite edges.
export function StudyOrientation(){const path=usePathname();const [context,setContext]=useState('');useEffect(()=>{const restore=()=>setContext(new URL(location.href).searchParams.get('learningContext')??'');queueMicrotask(restore);addEventListener('popstate',restore);return()=>removeEventListener('popstate',restore);},[path]);if(!/^\/(learn|lab|practice|explore)(\/|$)/.test(path)||path.includes('/catalogue'))return null;
 const [contextSubject,contextTopic]=context.split('.');const selected=SUBJECTS.find(s=>s.id===contextSubject);const topic=selected?.topics.find(t=>t[0]===contextTopic);
 const subject=path.includes('dp-600')?'fabric':path.includes('statistics')?'statistics':path.includes('/lab/power-bi')?'power-bi':path.includes('/lab/sql')?'sql':path.includes('/lab/python')?'python':path.includes('/lab/excel')?'excel':path==='/lab'||path==='/lab/'?'analysis':'visualization';
 const label=subject==='fabric'?'Microsoft Fabric':subject==='statistics'?'Statistics':subject==='visualization'?'Data visualization':subject==='power-bi'?'Power BI':subject==='analysis'?'Analytical foundations':subject.toUpperCase();
 return <nav aria-label="Learning context" className="relative z-10 mx-auto mt-20 mb-[-48px] flex w-full max-w-6xl flex-wrap gap-x-5 gap-y-2 px-5 text-xs leading-6 text-muted-foreground"><Link className="min-h-11 py-2 underline underline-offset-4" href="/study/">Learning library</Link>{!path.includes('drafts')&&<Link className="min-h-11 py-2 underline underline-offset-4" href={`/study/${subject}/`}>{label} topics</Link>}{selected&&topic&&<Link className="min-h-11 py-2 underline underline-offset-4" href={path.includes('drafts')?'/study/review/':topicHref(selected.id,topic[0])}>Return to {topic[1]}</Link>}<span className="min-h-11 py-2">{path.includes('drafts')?'Review workspace · not approved':path.startsWith('/lab')||path.startsWith('/practice')?'Practice & review':'Learning & experiments'}</span></nav>;
}
