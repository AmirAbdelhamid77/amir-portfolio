"use client";
import Link from "next/link";
import { useEffect, useRef, useState } from "react";
import { emptyJourney, parseJourney, JOURNEY_KEY, defaultView, viewHref, type JourneyState } from "@/lib/atlas/model";
const stages = ["Learn", "Explore", "Practice", "Reflect"];
const button = "min-h-11 rounded-xl border border-border-strong px-4 py-3 text-sm disabled:opacity-50";
export function AtlasJourney() {
  const [state, setState] = useState<JourneyState>(emptyJourney), [ready,setReady]=useState(false), [message,setMessage]=useState("Loading this browser’s journey…");
  const writable=useRef(false);
  useEffect(() => { Promise.resolve().then(() => { try { const parsed=parseJourney(localStorage.getItem(JOURNEY_KEY)); if(parsed) { setState(parsed); writable.current=true; setMessage("Journey notes stay in this browser. Visited steps are not a mastery score."); } else setMessage("Existing journey data is unreadable and has been preserved. You can use this visit without saving; Reset journey replaces only this journey’s data."); } catch { setMessage("Storage is unavailable. This journey works for this visit without saving."); } setReady(true); }); },[]);
  function save(next: JourneyState) { setState(next); if(writable.current)try { localStorage.setItem(JOURNEY_KEY,JSON.stringify(next)); } catch { writable.current=false; setMessage("Could not save. Copy your reflection before leaving; other progress is unchanged."); } }
  const atlasHref=viewHref({...defaultView(),edge:"edge:fabric:reference-replica",incoming:true});
  return <section className="rounded-3xl border border-border-strong p-5 sm:p-8" data-testid="atlas-journey"><nav aria-label="Guided journey stages"><ol className="grid gap-2 sm:grid-cols-4">{stages.map((label,index)=><li key={label}><button className={`${button} w-full text-start ${state.step===index?"border-primary bg-primary/5 font-medium":""}`} disabled={!ready} aria-current={state.step===index?"step":undefined} onClick={()=>save({...state,step:index})}>{index+1}. {label}{state.visited.includes(index)?" · visited":""}</button></li>)}</ol></nav>
    <p role="status" className="mt-4 text-sm leading-7 text-muted-foreground">{message}</p><p className="mt-2 text-xs text-muted-foreground">{state.visited.length} of 4 steps marked visited. No quiz answer, exam timer or mastery estimate is changed.</p>
    <div className="mt-7 min-h-64" aria-live="polite">
      {state.step===0&&<><h2 className="text-2xl font-medium">Learn the decision boundary</h2><p className="mt-4 max-w-3xl text-sm leading-8">A shortcut references a supported target; Database Mirroring maintains a replica. “Mirroring” can also mean metadata mirroring, which uses references. First identify which mechanism and which outcome the scenario actually describes.</p><Link href={`/learn/dp-600/ingestion/?atlasReturn=${encodeURIComponent(atlasHref)}#understand`} className="mt-5 inline-block min-h-11 py-3 text-primary underline">Read the existing worked lesson →</Link></>}
      {state.step===1&&<><h2 className="text-2xl font-medium">Explore the connection, then its evidence</h2><p className="mt-4 text-sm leading-8">Open the shortcut-versus-replica relation. Read its conditions and compare the two official references. Try the incoming-connections control to see why direction matters.</p><Link href={atlasHref} className="mt-5 inline-block min-h-11 py-3 text-primary underline">Explore this exact relationship →</Link></>}
      {state.step===2&&<><h2 className="text-2xl font-medium">Apply it to a new case</h2><p className="mt-4 text-sm leading-8">A second workspace must read a supported, accessible OneLake Gold table. No separate ingestion replica is permitted. Which pattern fits that requirement?</p><fieldset disabled={!ready} className="mt-4 space-y-3"><legend className="text-sm font-medium">Original conceptual self-check, not an exam-bank question</legend>{[["shortcut","Shortcut"],["mirroring","Database Mirroring"]].map(([value,label])=><label className="flex min-h-11 items-center gap-3 rounded-xl border border-border-strong p-3" key={value}><input type="radio" name="atlas-practice" value={value} checked={state.answer===value} onChange={()=>save({...state,answer:value})}/>{label}</label>)}</fieldset>{state.answer&&<p className="mt-4 rounded-xl bg-primary/5 p-4 text-sm leading-7">{state.answer==="shortcut"?"A shortcut fits the stated reference-only requirement. Access, caching and consumer behavior still need validation.":"Database Mirroring creates a replica. Revisit the no-separate-ingestion-replica requirement; freshness alone does not decide the architecture."}</p>}<Link href={`/learn/dp-600/ingestion/?atlasReturn=${encodeURIComponent(atlasHref)}#experiment`} className="mt-4 inline-block min-h-11 py-3 text-primary underline">Try the full existing constraint lab →</Link></>}
      {state.step===3&&<><h2 className="text-2xl font-medium">Reflect on what could change your choice</h2><label className="mt-4 block text-sm leading-7">Name one changed requirement that would invalidate a shortcut-only design.<textarea className="mt-3 block w-full rounded-xl border border-border-strong bg-background p-4" rows={5} maxLength={1500} disabled={!ready} value={state.reflection} onChange={event=>save({...state,reflection:event.target.value})}/></label><p className="mt-3 text-sm leading-7 text-muted-foreground">For example, a retained transformed daily result needs more than a reference. Your note is private browser-local writing; it is not automatically graded or sent anywhere.</p></>}
    </div>
    <div className="mt-7 flex flex-wrap gap-3"><button disabled={!ready||state.step===0} className={button} onClick={()=>save({...state,step:state.step-1})}>Previous step</button><button disabled={!ready} className={button} onClick={()=>save({...state,visited:[...new Set([...state.visited,state.step])],step:Math.min(3,state.step+1)})}>Mark visited{state.step<3?" & continue":""}</button><button disabled={!ready} className={button} onClick={()=>{ const next=emptyJourney();try {localStorage.setItem(JOURNEY_KEY,JSON.stringify(next));writable.current=true;setMessage("Only this Atlas journey was reset. Existing lesson and quiz progress is preserved.");}catch{setMessage("Journey reset for this visit. Storage is unavailable.");}setState(next);}}>Reset this journey</button></div>
  </section>;
}
