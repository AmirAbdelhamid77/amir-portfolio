+import pathlib,json,subprocess,imageio_ffmpeg,sys
+root=pathlib.Path(__file__).resolve().parents[1]
+raw=pathlib.Path(sys.argv[1]) if len(sys.argv)>1 else root/'.scratch/final-review-video'
