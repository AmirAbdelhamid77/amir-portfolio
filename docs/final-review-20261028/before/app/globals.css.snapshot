@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

/* ---------------------------------------------------------------------------
   BeUI design tokens — light
   Surfaces stay neutral; the brand ramp is the only saturated colour on the
   page. Values mirror beui.dev's `:root` block exactly so components and
   colour presets behave the same way here.
--------------------------------------------------------------------------- */
:root {
    --background: oklch(99% 0 0);
    --foreground: oklch(15% 0 0);
    --card: oklch(97% 0 0);
    --muted-foreground: oklch(50% 0 0);
    --border: oklch(15% 0 0 / 0.06);
    --border-strong: oklch(15% 0 0 / 0.12);
    --accent-fg: oklch(15% 0 0);
    --neon: oklch(80% 0.22 145);
    --violet: oklch(68% 0.22 295);
    --danger: oklch(62% 0.22 25);
    --success: oklch(70% 0.18 155);
    --warning: oklch(78% 0.18 75);
    /* Qualitative data palette (Okabe–Ito subset). Deliberately independent of
       the brand ramp so a theme change never alters the meaning of a series. */
    --chart-1: #0072b2;
    --chart-2: #009e73;
    --chart-3: #e69f00;
    --chart-4: #cc79a7;
    --chart-5: #d55e00;
    --glass-bg: oklch(99% 0 0 / 0.55);
    --glass-border: oklch(15% 0 0 / 0.08);
    --glass-strong-bg: rgb(255 255 255 / 0.7);
    --glass-thin-bg: rgb(255 255 255 / 0.45);
    --gradient-bg: linear-gradient(
        135deg,
        oklch(99% 0 0) 0%,
        oklch(96% 0.008 210) 100%
    );
    --gradient-accent: linear-gradient(
        to right,
        oklch(72% 0.18 195) 0%,
        oklch(68% 0.22 295) 100%
    );
    --card-foreground: var(--foreground);
    --popover: var(--card);
    --popover-foreground: var(--foreground);
    /* `#0285f7` against white is 3.68:1 — below the 4.5:1 AA threshold for the
       small text that sits on these buttons, chips and `text-primary` labels.
       The brand ramp stays blue; it is simply deep enough to be readable. */
    --primary: #0b62b5;
    --primary-foreground: #ffffff;
    --secondary: var(--card);
    --secondary-foreground: var(--foreground);
    --muted: var(--card);
    --accent: oklch(72% 0.18 195);
    --accent-foreground: var(--accent-fg);
    --destructive: var(--danger);
    --input: var(--border);
    /* A 12%-alpha border is not a visible focus indicator (WCAG 2.4.7 / 1.4.11).
       The ring uses the brand colour at full strength instead. */
    --ring: var(--primary);
}

/* BeUI design tokens — dark */
.dark {
    --background: #151515;
    --foreground: oklch(96% 0 0);
    --card: #1c1c1c;
    /* 62% landed at 4.48:1 on the tinted dark card surfaces — a hair under AA.
       66% clears it with margin while staying visually secondary. */
    --muted-foreground: oklch(66% 0 0);
    --border: rgb(255 255 255 / 0.05);
    --border-strong: rgb(255 255 255 / 0.1);
    /* Light brand ramp on a dark surface, with dark text on the solid fills —
       the same inversion the colour presets already use. */
    --primary: oklch(74% 0.12 250);
    --primary-foreground: oklch(15% 0 0);
    --ring: var(--primary);
    /* Same qualitative families, lifted for a dark surface. */
    --chart-1: #56b4e9;
    --chart-2: #34d399;
    --chart-3: #fbbf24;
    --chart-4: #f0a6ca;
    --chart-5: #fb923c;
    --accent: oklch(80% 0.18 195);
    --accent-fg: #151515;
    --glass-bg: rgb(28 28 28 / 0.55);
    --glass-border: rgb(255 255 255 / 0.08);
    --glass-strong-bg: rgb(28 28 28 / 0.6);
    --glass-thin-bg: rgb(21 21 21 / 0.45);
    --gradient-bg: linear-gradient(
        135deg,
        oklch(19% 0 0) 0%,
        oklch(22% 0.008 210) 100%
    );
    --gradient-accent: linear-gradient(
        to right,
        oklch(80% 0.18 195) 0%,
        oklch(72% 0.18 295) 100%
    );
}

/* Colour presets lifted from BeUI's lib/themes.ts. Neutral surfaces are kept;
   only the brand ramp moves. */
[data-theme="violet"] {
    --primary: oklch(55% 0.2 290);
    --primary-foreground: oklch(99% 0 0);
    --accent: oklch(55% 0.2 290);
    --accent-foreground: oklch(99% 0 0);
    --ring: oklch(55% 0.2 290 / 0.5);
}
.dark[data-theme="violet"] {
    --primary: oklch(72% 0.16 290);
    --primary-foreground: oklch(15% 0 0);
    --accent: oklch(72% 0.16 290);
    --accent-foreground: oklch(15% 0 0);
    --ring: oklch(72% 0.16 290 / 0.55);
}
[data-theme="blue"] {
    --primary: oklch(55% 0.18 255);
    --primary-foreground: oklch(99% 0 0);
    --accent: oklch(55% 0.18 255);
    --accent-foreground: oklch(99% 0 0);
    --ring: oklch(55% 0.18 255 / 0.5);
}
.dark[data-theme="blue"] {
    --primary: oklch(70% 0.15 255);
    --primary-foreground: oklch(15% 0 0);
    --accent: oklch(70% 0.15 255);
    --accent-foreground: oklch(15% 0 0);
    --ring: oklch(70% 0.15 255 / 0.55);
}
[data-theme="teal"] {
    --primary: oklch(55% 0.12 185);
    --primary-foreground: oklch(99% 0 0);
    --accent: oklch(55% 0.12 185);
    --accent-foreground: oklch(99% 0 0);
    --ring: oklch(55% 0.12 185 / 0.5);
}
.dark[data-theme="teal"] {
    --primary: oklch(72% 0.13 185);
    --primary-foreground: oklch(15% 0 0);
    --accent: oklch(72% 0.13 185);
    --accent-foreground: oklch(15% 0 0);
    --ring: oklch(72% 0.13 185 / 0.55);
}
[data-theme="green"] {
    --primary: oklch(56% 0.14 150);
    --primary-foreground: oklch(99% 0 0);
    --accent: oklch(56% 0.14 150);
    --accent-foreground: oklch(99% 0 0);
    --ring: oklch(56% 0.14 150 / 0.5);
}
.dark[data-theme="green"] {
    --primary: oklch(72% 0.15 150);
    --primary-foreground: oklch(15% 0 0);
    --accent: oklch(72% 0.15 150);
    --accent-foreground: oklch(15% 0 0);
    --ring: oklch(72% 0.15 150 / 0.55);
}
[data-theme="rose"] {
    --primary: oklch(58% 0.2 12);
    --primary-foreground: oklch(99% 0 0);
    --accent: oklch(58% 0.2 12);
    --accent-foreground: oklch(99% 0 0);
    --ring: oklch(58% 0.2 12 / 0.5);
}
.dark[data-theme="rose"] {
    --primary: oklch(70% 0.17 12);
    --primary-foreground: oklch(15% 0 0);
    --accent: oklch(70% 0.17 12);
    --accent-foreground: oklch(15% 0 0);
    --ring: oklch(70% 0.17 12 / 0.55);
}
[data-theme="amber"] {
    --primary: oklch(74% 0.15 70);
    --primary-foreground: oklch(20% 0.02 70);
    --accent: oklch(74% 0.15 70);
    --accent-foreground: oklch(20% 0.02 70);
    --ring: oklch(74% 0.15 70 / 0.5);
}
.dark[data-theme="amber"] {
    --primary: oklch(80% 0.15 75);
    --primary-foreground: oklch(18% 0.02 75);
    --accent: oklch(80% 0.15 75);
    --accent-foreground: oklch(18% 0.02 75);
    --ring: oklch(80% 0.15 75 / 0.55);
}

@theme inline {
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);

    --color-border: var(--border);
    --color-border-strong: var(--border-strong);
    --color-neon: var(--neon);
    --color-violet: var(--violet);
    --color-success: var(--success);
    --color-warning: var(--warning);
    --color-background: var(--background);
    --color-foreground: var(--foreground);
    --color-card: var(--card);
    --color-card-foreground: var(--card-foreground);
    --color-popover: var(--popover);
    --color-popover-foreground: var(--popover-foreground);
    --color-primary: var(--primary);
    --color-primary-foreground: var(--primary-foreground);
    --color-secondary: var(--secondary);
    --color-secondary-foreground: var(--secondary-foreground);
    --color-muted: var(--muted);
    --color-muted-foreground: var(--muted-foreground);
    --color-accent: var(--accent);
    --color-accent-foreground: var(--accent-foreground);
    --color-destructive: var(--destructive);
    --color-input: var(--input);
    --color-ring: var(--ring);

    --font-sans: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
    --font-mono: var(--font-geist-mono), ui-monospace, monospace;
    --font-display: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
}

@theme {
    --background-image-brand-bg: var(--gradient-bg);
    --background-image-brand-accent: var(--gradient-accent);
    --animate-mark-sweep: mark-sweep 900ms cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
    --animate-rise: rise 700ms var(--ease-out) both;
    --animate-shimmer: shimmer 2.5s linear infinite;

    @keyframes mark-sweep {
        from {
            background-size: 0% var(--mark-h, 72%);
        }
        to {
            background-size: 100% var(--mark-h, 72%);
        }
    }
    @keyframes rise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes shimmer {
        from {
            background-position: 200% 0;
        }
        to {
            background-position: -200% 0;
        }
    }
}

@layer base {
    button:not(:disabled),
    [role="button"]:not(:disabled),
    a {
        cursor: pointer;
    }
    html {
        color-scheme: light dark;
        overflow-x: clip;
        scroll-behavior: smooth;
        scroll-padding-top: 5.5rem;
    }
    body {
        background: var(--background);
        color: var(--foreground);
        font-family: var(--font-sans);
        overflow-x: clip;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }
    ::selection {
        background: color-mix(in oklch, var(--accent) 30%, transparent);
        color: var(--foreground);
    }
    :focus-visible {
        outline: 2px solid var(--ring);
        outline-offset: 3px;
        border-radius: 2px;
    }
    h1,
    h2,
    h3,
    h4 {
        text-wrap: balance;
    }
    p {
        text-wrap: pretty;
    }
}

@layer utilities {
    .text-balance {
        text-wrap: balance;
    }
    .text-pretty {
        text-wrap: pretty;
    }

    .grid-noise {
        background-image:
            linear-gradient(
                to right,
                color-mix(in oklch, var(--foreground) 6%, transparent) 1px,
                transparent 1px
            ),
            linear-gradient(
                to bottom,
                color-mix(in oklch, var(--foreground) 6%, transparent) 1px,
                transparent 1px
            );
        background-size: 32px 32px;
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        scrollbar-width: none;
    }

    .mask-radial-fade {
        mask-image: radial-gradient(
            ellipse at center,
            black 40%,
            transparent 75%
        );
    }
    .mask-b-fade {
        mask-image: linear-gradient(to bottom, black 60%, transparent);
    }

    .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(20px) saturate(160%);
        border: 1px solid var(--glass-border);
        box-shadow:
            0 1px 0 0 rgb(255 255 255 / 0.06) inset,
            0 24px 60px -24px rgb(0 0 0 / 0.45);
    }
    .glass-strong {
        background: var(--glass-strong-bg);
        backdrop-filter: blur(16px);
    }
    .glass-thin {
        background: var(--glass-thin-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
    }

    .press {
        transition:
            transform 120ms var(--ease-out),
            background-color 150ms,
            border-color 150ms,
            color 150ms;
    }
    .press:active {
        transform: scale(0.97);
    }

    .gradient-text {
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .hairline {
        border-color: var(--border);
    }

    /* BeUI's highlighter stroke behind a word in the hero. */
    .mark {
        --mark-h: 72%;
        padding: 0 0.12em;
        margin: 0 -0.02em;
        border-radius: 0.14em;
        white-space: nowrap;
        color: var(--mark-fg, #0d3a50);
        /* The UA stylesheet paints <mark> yellow; without this, the 28% of the
           box outside the sweep gradient shows as a yellow band. */
        background-color: transparent;
        background-image: linear-gradient(
            var(--mark-bg, #d4eaf4),
            var(--mark-bg, #d4eaf4)
        );
        background-repeat: no-repeat;
        background-position: 0 50%;
        background-size: 100% var(--mark-h);
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
        animation: var(--animate-mark-sweep);
    }

    .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition:
            opacity 650ms var(--ease-out),
            transform 650ms var(--ease-out);
    }
    .reveal[data-visible="true"] {
        opacity: 1;
        transform: none;
    }

    .mark-hero {
        --mark-bg: #d4eaf4;
        --mark-fg: #0d3a50;
    }
    .dark .mark-hero {
        --mark-bg: rgb(126 192 222 / 0.2);
        --mark-fg: #cdebf7;
    }

    /* The selected accent lives on <html>, set before paint by the inline
       theme script, so the checkmark can be driven by CSS rather than state. */
    .accent-check {
        display: none;
    }
    :root:not([data-theme]) .accent-check[data-accent-check="default"],
    [data-theme="violet"] .accent-check[data-accent-check="violet"],
    [data-theme="blue"] .accent-check[data-accent-check="blue"],
    [data-theme="teal"] .accent-check[data-accent-check="teal"],
    [data-theme="green"] .accent-check[data-accent-check="green"],
    [data-theme="rose"] .accent-check[data-accent-check="rose"],
    [data-theme="amber"] .accent-check[data-accent-check="amber"] {
        display: inline-flex;
        color: var(--primary);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
    .reveal {
        opacity: 1;
        transform: none;
    }
}

/* KaTeX is rendered at build time; keep its math in the page's ink colour and
   let long display formulas scroll rather than break the layout. */
.katex {
    color: var(--foreground);
    font-size: 1.03em;
}
.katex-display {
    margin: 0.25rem 0;
    padding: 0.1rem 0;
}
.katex-display > .katex {
    white-space: normal;
}

/* BeUI treemap: the tile name is full-opacity ink, but the value under it is
   dimmed to 80%. White-on-teal at 10–12px then falls to ~4.1:1, under the 4.5:1
   WCAG AA floor (axe reports `color-contrast` on the largest tile). The registry
   file must stay byte-identical, so this is a site-level override of the
   embedded chart rather than a fork of the component. */
[data-treemap-tile] .opacity-80 {
    opacity: 1;
}

/* Print-friendly exam review */
@media print {
    .no-print,
    body > header,
    body > footer {
        display: none !important;
    }
    body {
        background: #fff;
        color: #000;
    }
    .print-sheet {
        color: #000;
        background: #fff;
    }
    .print-sheet a,
    .print-sheet .katex {
        color: #000;
        text-decoration: none;
    }
    @page {
        margin: 12mm;
    }
}

/* ---------------------------------------------------------------------------
   Prototype C — knowledge stage
   Local stage aliases over the semantic tokens. Nothing here replaces a global
   token: the rest of the site keeps its own palette. Depth comes from layered
   planes, occlusion and a directional shadow, not from blur on reading text.
--------------------------------------------------------------------------- */
.hansa-stage {
    --stage-wash: color-mix(in oklch, var(--primary) 10%, transparent);
    --stage-wash-warm: color-mix(in oklch, var(--accent) 14%, transparent);
    --stage-dot: color-mix(in oklch, var(--foreground) 14%, transparent);
    --stage-floor: color-mix(in oklch, var(--foreground) 9%, transparent);
    background:
        radial-gradient(
            120% 70% at 62% -8%,
            var(--stage-wash-warm) 0%,
            transparent 58%
        ),
        radial-gradient(
            90% 60% at 18% 4%,
            var(--stage-wash) 0%,
            transparent 62%
        ),
        var(--background);
}
.dark .hansa-stage {
    --stage-wash: color-mix(in oklch, var(--primary) 16%, transparent);
    --stage-wash-warm: color-mix(in oklch, var(--accent) 10%, transparent);
    --stage-dot: color-mix(in oklch, var(--foreground) 16%, transparent);
    --stage-floor: color-mix(in oklch, var(--foreground) 12%, transparent);
}

.hansa-wash {
    background:
        radial-gradient(
            58% 52% at 66% 22%,
            color-mix(in oklch, var(--primary) 9%, transparent),
            transparent 70%
        ),
        radial-gradient(
            46% 44% at 26% 12%,
            color-mix(in oklch, var(--accent) 8%, transparent),
            transparent 72%
        );
}

.hansa-dots {
    background-image: radial-gradient(var(--stage-dot) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.5;
    mask-image: radial-gradient(
        80% 70% at 50% 10%,
        black 0%,
        transparent 72%
    );
}

.hansa-floor {
    background-image:
        linear-gradient(to right, var(--stage-floor) 1px, transparent 1px),
        linear-gradient(to bottom, var(--stage-floor) 1px, transparent 1px);
    background-size: 64px 40px;
    opacity: 0.35;
    transform: perspective(560px) rotateX(62deg) scale(1.5);
    transform-origin: bottom center;
    mask-image: linear-gradient(to top, black, transparent 78%);
}

/* Phones keep the depth cues but spend less fill rate on them. */
@media (max-width: 480px) {
    .hansa-dots {
        opacity: 0.35;
    }
    .hansa-floor {
        opacity: 0.22;
    }
}
