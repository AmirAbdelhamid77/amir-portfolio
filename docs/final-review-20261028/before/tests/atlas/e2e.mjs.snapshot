import assert from "node:assert/strict";
import { chromium } from "playwright-core";
import { mkdirSync, writeFileSync } from "node:fs";
const base=process.env.ATLAS_PREVIEW_URL || "http://127.0.0.1:4192";
const folder="docs/knowledge-atlas/implementation/qa"; mkdirSync(folder,{recursive:true});
const browser=await chromium.launch({executablePath:"C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",headless:true});
const checks=[], errors=[];
const pass=name=>checks.push({name,status:"PASS"});
const legacy={"amir-lab-v1":"keep-general-history","amir-fabric-v1":"keep-fabric-attempt","hansa-academy-ingestion-v1":JSON.stringify({version:1,revision:1,answers:{},checked:[],confidence:"medium",journal:[]})};
try {
 for(const [width,theme,motion] of [[1440,"light","no-preference"],[320,"dark","reduce"],[390,"light","reduce"]]) {
  const context=await browser.newContext({viewport:{width,height:1000},colorScheme:theme,reducedMotion:motion,hasTouch:width<500});
  await context.addInitScript(values=>{for(const [key,value] of Object.entries(values))localStorage.setItem(key,value);},legacy);
  const page=await context.newPage(); page.on("pageerror",error=>errors.push(error.message));
  await page.goto(base+"/",{waitUntil:"networkidle"});
  assert.equal(await page.locator('a[href^="/work"],a[href^="/experience"],a[href^="/services"],a[href^="/about"]').count(),0);
  assert.doesNotMatch(await page.locator("main").innerText(),/HSE|Selected work|Sohag|I started in electronics|freelance|Experience & skills/i);
  await page.screenshot({path:`${folder}/home-${width}-${theme}.png`,fullPage:false});
  pass(`${width}: landing contains learning/Atlas routes and no experience/project sections or links`);
  await page.getByRole("link",{name:"Explore the Knowledge Atlas",exact:true}).click();
  await page.getByTestId("review-notice").waitFor();
  await page.screenshot({path:`${folder}/initial-${width}-${theme}.png`,fullPage:true});
  assert.equal(await page.getByRole("button",{name:"OneLake shortcuts",exact:true}).count(),1);
  await page.getByRole("button",{name:/A shortcut references a target; Database Mirroring maintains a replica/}).click();
  const inspector=page.getByTestId("atlas-inspector");
  await inspector.getByRole("heading",{name:"Under which conditions?"}).waitFor();
  assert.equal(await inspector.locator('a[href^="https://learn.microsoft.com"]').count(),2);
  const source=page.getByLabel("Evidence lens",{exact:true}); await source.selectOption("security");
  await page.getByText("No reviewed relationships match this focus",{exact:false}).waitFor();
  await page.getByLabel("Include incoming directed connections",{exact:true}).check();
  await page.getByRole("button",{name:/Authorized identities and permissions govern shortcut access/}).waitFor();
  await page.getByRole("button",{name:"Reset view",exact:true}).click();
  await page.getByLabel("Find a concept",{exact:true}).fill("اختصار");
  await page.getByText("1 of 8 concepts",{exact:false}).waitFor();
  await page.getByRole("button",{name:"OneLake shortcuts",exact:true}).click();
  await page.getByLabel("Find a concept",{exact:true}).fill("");
  if(width<500) { assert.equal(await page.getByTestId("atlas-map").isVisible(),false); await page.getByRole("button",{name:"Open the optional map",exact:true}).click(); }
  const mapNode=page.getByRole("button",{name:"Select Database Mirroring",exact:true});
  await mapNode.focus(); await page.keyboard.press("Enter"); assert.ok(page.url().includes("database-mirroring"));
  await page.getByRole("button",{name:"OneLake shortcuts",exact:true}).click();
  await page.getByTestId("atlas-map").screenshot({path:`${folder}/map-${width}-${theme}.png`});
  await page.getByRole("button",{name:"Zoom in",exact:true}).click();
  await page.getByRole("button",{name:"Pan right",exact:true}).click();
  const beforeReturn=page.url();
  await page.getByRole("link",{name:/Shortcut, Mirroring or Copy/}).click();
  await page.getByTestId("atlas-peek").waitFor();
  await page.getByRole("link",{name:"Return to your Atlas view",exact:true}).click();
  await page.waitForURL(beforeReturn);
  assert.ok(page.url().includes("zoom=1.2")&&page.url().includes("x=70"));
  await page.getByRole("button",{name:"Reset view",exact:true}).click();
  await page.getByRole("button",{name:"Focus +",exact:true}).click();
  assert.ok(page.url().includes("hops=2")); await page.goBack(); await page.getByText("1-hop focus",{exact:true}).waitFor();
  await page.addScriptTag({path:"node_modules/axe-core/axe.min.js"});
  const violations=await page.evaluate(async()=> (await window.axe.run('[data-testid="atlas-explorer"]',{runOnly:{type:"tag",values:["wcag2a","wcag2aa","wcag21aa","wcag22aa"]}})).violations);
  assert.deepEqual(violations,[],"Atlas scoped accessibility scan");
  assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);
  await page.screenshot({path:`${folder}/explorer-${width}-${theme}.png`,fullPage:true});
  pass(`${width}: evidence inspector, incoming direction, Arabic alias, URL camera/return/back, scoped axe and reflow`);
  await page.goto(base+"/learn/dp-600/atlas/journey/",{waitUntil:"networkidle"});
  await page.getByRole("button",{name:"Mark visited & continue",exact:true}).click();
  await page.getByRole("button",{name:"Mark visited & continue",exact:true}).click();
  await page.getByRole("radio",{name:"Shortcut",exact:true}).check();
  await page.getByText("A shortcut fits the stated reference-only requirement",{exact:false}).waitFor();
  await page.getByRole("button",{name:"Mark visited & continue",exact:true}).click();
  await page.getByRole("textbox").fill("A retained transformed daily result needs a materialized history policy.");
  await page.reload({waitUntil:"networkidle"});
  assert.equal(await page.getByRole("textbox").inputValue(),"A retained transformed daily result needs a materialized history policy.");
  const preserved=await page.evaluate(keys=>Object.fromEntries(keys.map(key=>[key,localStorage.getItem(key)])),Object.keys(legacy)); assert.deepEqual(preserved,legacy);
  await page.getByRole("button",{name:"Reset this journey",exact:true}).click();
  const afterReset=await page.evaluate(keys=>Object.fromEntries(keys.map(key=>[key,localStorage.getItem(key)])),Object.keys(legacy)); assert.deepEqual(afterReset,legacy);
  pass(`${width}: guided journey answer/reflection resumes after reload; reset never touches existing three progress stores`);
  await context.close();
 }
 const corrupt=await browser.newContext(); await corrupt.addInitScript(()=>localStorage.setItem("hansa-atlas-journey-v1","not-json")); const page=await corrupt.newPage();
 await page.goto(base+"/learn/dp-600/atlas/journey/",{waitUntil:"networkidle"}); await page.getByText("Existing journey data is unreadable",{exact:false}).waitFor();
 await page.getByRole("button",{name:"Mark visited & continue",exact:true}).click(); assert.equal(await page.evaluate(()=>localStorage.getItem("hansa-atlas-journey-v1")),"not-json"); await corrupt.close(); pass("Corrupt Atlas progress is preserved without silent replacement");
 const blocked=await browser.newContext(); await blocked.addInitScript(()=>{const get=Storage.prototype.getItem,set=Storage.prototype.setItem;Storage.prototype.getItem=function(key){if(key==="hansa-atlas-journey-v1")throw new DOMException("denied","SecurityError");return get.call(this,key);};Storage.prototype.setItem=function(key,value){if(key==="hansa-atlas-journey-v1")throw new DOMException("denied","SecurityError");return set.call(this,key,value);};});
 const denied=await blocked.newPage();await denied.goto(base+"/learn/dp-600/atlas/journey/",{waitUntil:"networkidle"});await denied.getByText("Storage is unavailable.",{exact:false}).waitFor();await denied.getByRole("button",{name:"Mark visited & continue",exact:true}).click();await denied.getByRole("heading",{name:"Explore the connection, then its evidence",exact:true}).waitFor();await blocked.close();pass("Denied Atlas storage still permits the guided journey without pretending to save");
 const nojs=await browser.newContext({javaScriptEnabled:false}); const reading=await nojs.newPage(); await reading.goto(base+"/learn/dp-600/atlas/"); assert.ok((await reading.locator("main").innerText()).includes("Connections you can explain")); await nojs.close(); pass("No-JS semantic connection list remains in exported HTML");
 for(const route of ["/experience/","/work/hse-analytics/"]) assert.equal((await fetch(base+route)).status,200); pass("Legacy professional routes remain available outside the landing page");
 assert.deepEqual(errors,[]); pass("No browser runtime errors");
 writeFileSync(`${folder}/BROWSER_RESULTS.json`,JSON.stringify({checks,notRun:["Human screen reader","Physical device/touch","CWV field measurements","Deployment"]},null,2)); console.log(JSON.stringify(checks,null,2));
} finally {await browser.close();}
