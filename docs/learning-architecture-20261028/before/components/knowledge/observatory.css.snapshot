/* Canonical landing only. Plane-based 2.5D; no global token replacement. */
.observatory {
  --obs-panel: color-mix(in oklch, var(--background) 94%, var(--accent));
  --obs-slab: color-mix(in oklch, var(--card) 85%, var(--primary));
  --obs-slab-light: color-mix(in oklch, var(--background) 95%, var(--primary));
  --obs-edge: color-mix(in oklch, var(--foreground) 24%, var(--background));
  background: var(--background);
}
.observatory .hansa-dots { opacity: .13; background-size: 36px 36px; }
.observatory .hansa-wash { opacity: .45; }
.observatory .hansa-floor { bottom: 12%; opacity: .25; }
.observatory-light { position:absolute; z-index:-1; inset:0 0 auto; height:850px; pointer-events:none; background: radial-gradient(ellipse at 75% 32%, color-mix(in oklch,var(--primary) 12%,transparent),transparent 48%); }
.observatory-vault { position:absolute; width:1100px; height:1100px; top:-235px; left:calc(71% - 550px); transform:rotate(-22deg); opacity:.15; }
.observatory-vault span { position:absolute; inset:0; border:1px solid var(--obs-edge); border-radius:50%; }
.observatory-vault span:nth-child(2) { inset:34px; }
.observatory-vault span:nth-child(3) { inset:130px; border-style:dashed; }
.observatory-hero { display:grid; grid-template-columns:1.05fr 1fr; gap:36px; align-items:center; min-height:540px; padding:28px 0 8px; }
.observatory-editorial { position:relative; z-index:2; padding:15px 0 25px; }
.observatory-headline { margin-top:20px; font-size:clamp(54px,6.2vw,88px); line-height:.98; letter-spacing:-.065em; font-weight:500; }
.observatory-headline > span { display:block; }
.observatory-title-rest { margin-top:9px; color:var(--primary); font-weight:400; }
.observatory-editorial > p:last-of-type { max-width:38ch; font-size:14px; line-height:1.8; }
.observatory-current { display:flex; align-items:center; gap:16px; max-width:460px; margin-top:24px; padding:16px 0; border-block:1px solid var(--obs-edge); }
.observatory-current .observatory-index { font-size:40px; line-height:1; font-weight:300; letter-spacing:-.06em; color:var(--primary); }
.observatory-current time { display:block; font:10px/1.6 var(--font-geist-mono),monospace; letter-spacing:.12em; }
.observatory-current strong { display:block; font-size:13px; line-height:1.6; font-weight:500; }
.observatory-current svg { margin-left:auto; }
.observatory-current:hover strong { text-decoration:underline; text-underline-offset:4px; }
.observatory-mechanism { min-width:0; position:relative; max-width:500px; width:100%; margin-inline:auto; }
.observatory-instrument { position:relative; width:100%; }
.instrument-coordinate { display:flex; justify-content:space-between; font:9px monospace; letter-spacing:.18em; color:var(--muted-foreground); padding:0 8%; }
.instrument-svg { width:100%; height:auto; display:block; overflow:visible; filter:drop-shadow(10px 22px 16px rgb(0 0 0 / .10)); }
.instrument-assembly { margin-top:-12px; }
.instrument-readout { position:relative; margin-top:-35px; text-align:center; }
.instrument-state { font:12px/1.7 monospace; letter-spacing:.025em; min-height:22px; }
.instrument-switch { display:inline-flex; min-height:44px; align-items:center; justify-content:center; gap:10px; padding:8px 18px; margin-top:10px; border:1px solid var(--obs-edge); border-radius:30px; background:var(--obs-panel); font-size:12px; box-shadow:0 3px 0 var(--obs-slab),0 12px 24px rgb(0 0 0 / .08); cursor:pointer; }
.switch-dot { width:7px; height:7px; border-radius:50%; background:var(--primary); box-shadow:0 0 0 4px color-mix(in oklch,var(--primary) 15%,transparent); }
.instrument-switch[aria-pressed=true] .switch-dot { background:var(--warning); }
.instrument-reset { display:block; margin:8px auto 0; min-height:36px; padding:4px 12px; font-size:11px; color:var(--muted-foreground); text-decoration:underline; text-underline-offset:4px; }
.observatory-caption { text-align:center; font-size:10px; line-height:1.8; color:var(--muted-foreground); margin:0 auto; max-width:38ch; }
.observatory-time { position:relative; padding:16px 0 0; margin:0 -5px 36px; }
.observatory-time::before { content:""; position:absolute; left:5%; right:5%; height:94px; top:65px; border:1px solid var(--obs-edge); border-radius:50%; transform:perspective(800px) rotateX(65deg) rotateZ(-3deg); background:linear-gradient(180deg,transparent,color-mix(in oklch,var(--primary) 7%,var(--background))); box-shadow:0 15px 18px -14px color-mix(in oklch,var(--foreground) 25%,transparent); pointer-events:none; }
.observatory .insight-rail-viewport { perspective:1100px; }
.observatory .rail-edition { transform-style:preserve-3d; }
.observatory .rail-date-face { border-radius:3px 18px 3px 18px; padding:14px 18px; border-color:var(--obs-edge); background:var(--obs-panel); box-shadow:0 4px 0 var(--obs-slab),0 5px 0 var(--obs-edge),0 22px 20px -14px rgb(0 0 0 / .3); }
.observatory .rail-edition[data-active=true] .rail-date-face { border-top:2px solid var(--primary); }
.observatory-study { padding:24px 0 26px; border-top:1px solid var(--obs-edge); }
.observatory .insight-reading { padding:16px 0 0; border:0; border-radius:0; background:transparent; box-shadow:none; overflow:visible; }
.observatory .insight-backing { display:none; }
.observatory .insight-reading h2 { font-size:clamp(28px,3vw,42px); max-width:21ch; letter-spacing:-.04em; }
.observatory .insight-reading > div:first-child { border-bottom:1px solid var(--border-strong); padding-bottom:18px; }
.observatory .insight-experiment { position:relative; border-radius:3px 24px 3px 24px; background:var(--obs-panel); border-color:var(--obs-edge); box-shadow:7px 7px 0 var(--obs-slab),8px 8px 0 var(--obs-edge),0 25px 30px -25px rgb(0 0 0 / .3); }
.observatory .insight-experiment svg { overflow:visible; }
.observatory-workbench { position:relative; padding:24px; margin-top:16px; border-block:1px solid var(--obs-edge); background:color-mix(in oklch,var(--card) 55%,transparent); isolation:isolate; }
.observatory-workbench::before { content:""; position:absolute; inset:18px -12px -14px 14px; z-index:-1; border:1px solid var(--obs-edge); transform:skewY(-2deg); background:var(--obs-panel); box-shadow:0 24px 35px -25px rgb(0 0 0 / .35); }
.observatory .dealer-tray { perspective:1100px; }
.observatory .dealer-tray::before { content:""; position:absolute; width:92%; height:55%; bottom:5%; left:4%; border:1px solid var(--obs-edge); border-radius:50%; background:radial-gradient(ellipse,color-mix(in oklch,var(--primary) 9%,transparent),transparent 70%); transform:rotateX(65deg); box-shadow:0 8px 0 color-mix(in oklch,var(--foreground) 4%,var(--card)),0 9px 0 var(--obs-edge); }
.observatory .dealer-card-frame { filter:drop-shadow(8px 15px 7px rgb(0 0 0 / .16)); }
.observatory .dealer-card-back { border-radius:12px; background:var(--obs-slab); border:1px solid var(--obs-edge); padding:14px; box-shadow:inset 0 0 0 5px var(--obs-panel),inset 0 0 0 6px var(--obs-edge); }
.observatory .dealer-card-back::after { content:""; position:absolute; width:86px; height:86px; left:50%; top:50%; border:1px solid var(--primary); border-radius:50%; transform:translate(-50%,-50%) rotateX(50deg) rotateZ(-35deg); box-shadow:0 8px 0 -1px var(--obs-slab),0 9px 0 var(--primary); opacity:.5; }
.observatory .dealer-reader { border-radius:3px 22px 3px 22px; background:var(--obs-panel); border-color:var(--obs-edge); box-shadow:6px 7px 0 var(--obs-slab); }
.observatory .atlas-pending { display:grid; grid-template-columns:220px 1fr; align-items:center; margin-top:24px; border-block:1px solid var(--obs-edge); padding:28px 0; gap:32px; }
.atlas-seal { aspect-ratio:1; border:1px solid var(--obs-edge); border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; padding:28px; text-align:center; }
.atlas-seal::before { content:""; position:absolute; inset:12px; border:1px dashed var(--obs-edge); border-radius:50%; }
.atlas-seal::after { content:""; position:absolute; bottom:13%; left:-7%; width:114%; height:30%; border:1px solid var(--obs-edge); border-radius:50%; transform:rotate(-20deg); }
.atlas-seal > span { font:10px/1.8 monospace; letter-spacing:.13em; color:var(--muted-foreground); }
.atlas-seal > strong { font-size:19px; font-weight:500; line-height:1.3; margin:8px 0; }
.observatory .atlas-pending-copy { padding:0; border:0; border-radius:0; background:transparent; }
.observatory .atlas-pending-backing { display:none; }
.observatory button:focus-visible,.observatory a:focus-visible { outline:2px solid var(--primary); outline-offset:4px; }
.observatory .model-table { width:100%; margin-top:12px; font-size:11px; text-align:start; }
.observatory .model-table th,.observatory .model-table td { padding:7px 4px; border-bottom:1px solid var(--border-strong); text-align:start; vertical-align:top; }
.observatory .model-table th { font-weight:400; color:var(--muted-foreground); }
.dark .observatory { --obs-slab:color-mix(in oklch,var(--card) 90%,var(--primary)); --obs-slab-light:color-mix(in oklch,var(--card) 83%,var(--primary)); --obs-panel:color-mix(in oklch,var(--background) 94%,var(--primary)); --obs-edge:color-mix(in oklch,var(--foreground) 27%,var(--background)); }
@media (max-width:1023px) { .observatory-hero { min-height:490px; gap:16px; } .observatory-headline { font-size:clamp(46px,6.5vw,70px); } .observatory-workbench { max-width:600px; width:100%; margin-inline:auto; } }
@media (max-width:767px) {
  .observatory-content { padding-top:90px; }
  .observatory-hero { grid-template-columns:1fr; gap:12px; padding-top:14px; }
  .observatory-editorial { padding:6px 0 0; }
  .observatory-headline { font-size:clamp(44px,9.5vw,68px); letter-spacing:-.055em; margin-top:13px; }
  .observatory-title-rest { max-width:13ch; }
  .observatory-editorial > p:last-of-type { font-size:13px; margin-top:14px; }
  .observatory-current { margin-top:16px; padding:12px 0; }
  .observatory-current .observatory-index { font-size:32px; }
  .observatory-current strong { font-size:12px; }
  .observatory-mechanism { width:min(100%,450px); margin-inline:auto; }
  .instrument-coordinate { margin-top:12px; }
  .instrument-assembly { margin:-18px auto -20px; width:88%; }
  .instrument-readout { margin-top:-20px; }
  .instrument-state { font-size:10px; }
  .instrument-reset { display:inline-block; margin-left:6px; }
  .observatory-caption { font-size:10px; }
  .observatory-time { margin-top:26px; margin-bottom:18px; }
  .observatory-time::before { left:-15%; right:-15%; }
  .observatory-vault { opacity:.1; }
  .observatory-study { gap:28px; padding-top:12px; }
  .observatory .rail-date-face { padding:12px; }
  .observatory .insight-reading { padding-top:12px; }
  .observatory .insight-reading h2 { font-size:30px; }
  .observatory-workbench { padding:20px 12px; }
  .observatory-workbench::before { inset:12px -5px -12px 7px; }
  .observatory .dealer-reader { padding:20px 16px; border-top:3px solid var(--primary); }
  .observatory .atlas-pending { grid-template-columns:1fr; gap:24px; padding:24px 0; }
  .atlas-seal { width:168px; margin-inline:auto; }
  .atlas-seal > strong { font-size:16px; }
}
@media (prefers-reduced-motion:reduce) { .observatory *, .observatory *::before,.observatory *::after { scroll-behavior:auto!important; transition-duration:0s!important; animation:none!important; } }
@media (forced-colors:active) { .instrument-svg { forced-color-adjust:auto; } .observatory .rail-date-face,.atlas-seal,.instrument-switch { border:1px solid CanvasText; } }
