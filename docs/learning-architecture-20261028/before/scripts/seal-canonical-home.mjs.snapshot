// Seals the canonical-home migration into the preservation receipt chain.
//
//   node scripts/seal-canonical-home.mjs            # inspect only, writes nothing
//   node scripts/seal-canonical-home.mjs --write    # capture rollback bytes + manifest
//
// What it does:
//   1. Walks the existing chain (layer 1 prototype-c → layer 2 R11) to learn the
//      exact hash every touched path was expected to have before this migration.
//   2. Recovers the pre-migration bytes of each touched file from git HEAD,
//      normalising line endings until the hash matches that expectation, so the
//      rollback copy is provably the audited predecessor rather than a best guess.
//   3. Writes docs/canonical-home/before/<path>.snapshot, START_BASELINE.json and
//      INTEGRATION_MANIFEST.json for the canonical-home receipt layer.
//
// It never rewrites an earlier layer and never invents a hash: a path whose
// predecessor bytes cannot be reproduced is reported and left unsealed.
import { execFileSync } from "node:child_process";
import { createHash } from "node:crypto";
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

const root = process.cwd();
const WRITE = process.argv.includes("--write");
const DIR = "docs/canonical-home";
const LAYER_1 = "docs/prototype-c/INTEGRATION_MANIFEST.json";
const LAYER_2 = "docs/dp600-r11-integration/INTEGRATION_MANIFEST.json";

const sha = (bytes) => createHash("sha256").update(bytes).digest("hex");
const hashFile = (p) => sha(readFileSync(path.join(root, p)));
const head = () => {
  try {
    return execFileSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" }).trim();
  } catch {
    return "unavailable";
  }
};

// Every path this migration rewrote, and the two it retired.
const REWRITTEN = [
  "app/page.tsx",
  "components/site-header.tsx",
  "components/site-footer.tsx",
  "app/prototype-c/page.tsx",
  "content/knowledge/insights.json",
  "lib/search/documents.ts",
  "scripts/r11-question-receipt.mjs",
  "scripts/prototype-c-receipt.mjs",
  "scripts/verify-prototype-c.mjs",
  "scripts/prototype-c-preservation.mjs",
  "scripts/verify-preservation-history.mjs",
];
const RETIRED = [
  "components/knowledge/prototype-c.tsx",
  "components/knowledge/knowledge-stage.tsx",
];
// Paths no earlier layer recorded by name, but which the prototype-c
// preservation baseline captured. Their predecessor hash comes from that sealed
// baseline instead of from a layer entry.
const PRESERVATION_BASELINE = "docs/prototype-c/preservation/baseline.json";
const CAPTURED = ["lib/site.ts", "tsconfig.json"];
// The TypeScript build cache is regenerated by any typecheck/build, so it is
// sealed as a generated artifact: reproducible by rebuilding, not by bytes.
const GENERATED = ["tsconfig.tsbuildinfo"];

// ------------------------------------------------------- walk the existing chain
const layer1 = JSON.parse(readFileSync(path.join(root, LAYER_1), "utf8"));
const layer2 = JSON.parse(readFileSync(path.join(root, LAYER_2), "utf8"));

function chainExpectation(target) {
  const inLayer1 = layer1.files.find((entry) => entry.path === target);
  const generated1 = (layer1.generatedArtifacts ?? []).find((entry) => entry.path === target);
  const inLayer2 = layer2.files.find((entry) => entry.path === target);

  // Layer 1 asserts `expected(path, its own hash)`; layer 2 may supersede it.
  let expected = inLayer1?.sha256 ?? generated1?.sha256 ?? null;
  if (inLayer2 && inLayer2.beforeSha256 !== null && inLayer2.beforeSha256 === expected) {
    return inLayer2.sha256;
  }
  // A path only the newer layer records is asserted by that layer at its own
  // after-hash, because layer 1 never knew the file existed.
  if (inLayer2 && !inLayer1 && !generated1) return inLayer2.sha256;
  return expected;
}

function headBytes(target) {
  try {
    return execFileSync("git", ["show", `HEAD:${target}`], { maxBuffer: 40e6 });
  } catch {
    return null;
  }
}

/** HEAD bytes in whichever line-ending form reproduces the audited hash. */
function recoverPredecessor(target, expected) {
  const raw = headBytes(target);
  if (!raw) return { bytes: null, actual: null, reason: "not present in HEAD" };
  const actual = sha(raw);
  if (actual === expected) return { bytes: raw, actual };
  const crlf = Buffer.from(raw.toString("utf8").replace(/\r?\n/g, "\r\n"), "utf8");
  if (sha(crlf) === expected) return { bytes: crlf, actual: sha(crlf), normalised: "CRLF" };
  return { bytes: null, actual, reason: "HEAD bytes do not reproduce the audited hash" };
}

const files = [];
const problems = [];

for (const target of REWRITTEN) {
  const expected = chainExpectation(target);
  if (!expected) {
    problems.push(`${target}: no layer records this path`);
    continue;
  }
  const recovery = recoverPredecessor(target, expected);
  if (!recovery.bytes) {
    problems.push(`${target}: ${recovery.reason} (HEAD ${String(recovery.actual).slice(0, 12)})`);
    continue;
  }
  const current = hashFile(target);
  if (current === expected) {
    problems.push(`${target}: unchanged — nothing to seal`);
    continue;
  }
  files.push({
    path: target,
    basis: `${DIR}/START_BASELINE.json`,
    beforeSha256: expected,
    sha256: current,
    rollbackPath: `${DIR}/before/${target}.snapshot`,
    bytes: recovery.bytes,
    normalised: recovery.normalised ?? null,
  });
}

const preservationBaseline = JSON.parse(readFileSync(path.join(root, PRESERVATION_BASELINE), "utf8"));
for (const target of CAPTURED) {
  const expected = preservationBaseline.files[target] ?? null;
  if (!expected) {
    problems.push(`${target}: not captured by the preservation baseline`);
    continue;
  }
  const recovery = recoverPredecessor(target, expected);
  if (!recovery.bytes) {
    problems.push(`${target}: ${recovery.reason} (HEAD ${String(recovery.actual).slice(0, 12)})`);
    continue;
  }
  const current = hashFile(target);
  if (current === expected) {
    problems.push(`${target}: unchanged — nothing to seal`);
    continue;
  }
  files.push({
    path: target,
    basis: PRESERVATION_BASELINE,
    beforeSha256: expected,
    sha256: current,
    rollbackPath: `${DIR}/before/${target}.snapshot`,
    bytes: recovery.bytes,
    normalised: recovery.normalised ?? null,
  });
}

for (const target of GENERATED) {
  const expected = chainExpectation(target);
  const current = hashFile(target);
  files.push({
    path: target,
    basis: `${DIR}/START_BASELINE.json`,
    beforeSha256: expected,
    sha256: current,
    generated: true,
  });
}

const removed = RETIRED.map((target) => {
  const expected = chainExpectation(target);
  const raw = headBytes(target);
  const actual = raw ? sha(raw) : null;
  return {
    path: target,
    expectedSha256: expected,
    committedSha256: actual,
    existedBeforeRemoval: existsSync(path.join(root, target)),
    reason:
      target === "components/knowledge/knowledge-stage.tsx"
        ? "Superseded: this was the previous root landing implementation, replaced by components/knowledge/hansa-landing.tsx."
        : "Superseded: its loader moved into components/knowledge/hansa-landing.tsx so the landing has exactly one owner.",
    note:
      expected && actual && expected !== actual
        ? "The layer-1 expectation was already stale at HEAD (drift recorded before this migration); the committed bytes are the available predecessor."
        : "The committed bytes match the layer-1 expectation.",
  };
});

console.log(`layer 3 targets: ${files.length} file(s), ${removed.length} retired path(s)`);
for (const entry of files) {
  console.log(
    `  ${entry.generated ? "GEN " : "EDIT"} ${entry.path}\n      before ${String(entry.beforeSha256).slice(0, 12)} → after ${entry.sha256.slice(0, 12)}${entry.normalised ? ` (rollback normalised to ${entry.normalised})` : ""}`,
  );
}
for (const entry of removed) {
  console.log(
    `  RETIRE ${entry.path}\n      layer-1 expected ${String(entry.expectedSha256).slice(0, 12)} · committed ${String(entry.committedSha256).slice(0, 12)} · ${entry.note}`,
  );
}
for (const problem of problems) console.log(`  UNSEALED ${problem}`);

if (!WRITE) {
  console.log("\nDry run. Re-run with --write to capture rollback bytes and write the manifest.");
  process.exit(0);
}

for (const entry of files) {
  if (!entry.bytes) continue;
  const destination = path.join(root, entry.rollbackPath);
  mkdirSync(path.dirname(destination), { recursive: true });
  writeFileSync(destination, entry.bytes);
}

const baseline = {
  capturedAt: new Date().toISOString(),
  reason:
    "Pre-migration state of every path the canonical-home migration touched, recovered from git HEAD and verified against the audited hash recorded by the layer below.",
  head: head(),
  files: Object.fromEntries(files.map((entry) => [entry.path, entry.beforeSha256])),
};
writeFileSync(
  path.join(root, DIR, "START_BASELINE.json"),
  `${JSON.stringify(baseline, null, 2)}\n`,
);

const manifest = {
  scope: "hansa-canonical-home-2026-10-28",
  previousManifest: LAYER_2,
  previousManifestSha256: hashFile(LAYER_2),
  baselines: [
    {
      path: `${DIR}/START_BASELINE.json`,
      sha256: hashFile(`${DIR}/START_BASELINE.json`),
    },
    {
      // The prototype-c layer's own immutable capture, reused for the paths no
      // layer recorded by name (lib/site.ts, tsconfig.json).
      path: PRESERVATION_BASELINE,
      sha256: hashFile(PRESERVATION_BASELINE),
    },
  ],
  noDeployment: true,
  files: files.map(({ path: filePath, basis, beforeSha256, sha256: after, rollbackPath, generated }) =>
    generated
      ? { path: filePath, basis, beforeSha256, sha256: after, generated: true }
      : { path: filePath, basis, beforeSha256, sha256: after, rollbackPath },
  ),
  removed: removed.map(({ path: filePath, expectedSha256, committedSha256, reason, note }) => ({
    path: filePath,
    expectedSha256,
    committedSha256,
    reason,
    note,
  })),
};
writeFileSync(
  path.join(root, DIR, "INTEGRATION_MANIFEST.json"),
  `${JSON.stringify(manifest, null, 2)}\n`,
);
console.log(`\nWrote ${DIR}/START_BASELINE.json and ${DIR}/INTEGRATION_MANIFEST.json`);
