        "answer": "Tables/productline1"
      }
    ],
    "mode": "controls",
    "answers": [],
    "explanationHtml": "<p>- &quot;delta&quot;</p>\n<p>- &quot;Tables/productline1&quot;</p>\n<p>Requirements: Use managed tables.</p>\n<p>If you use saveAsTable() you don&#x27;t need to specify the path &quot;Table/&quot;</p>\n<p>If you you save() you specify the full path</p>",
    "images": [],
