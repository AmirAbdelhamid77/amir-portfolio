        "id": "B",
        "text": "PARQUET"
      },
      {
        "id": "C",
        "text": "DELTA"
      }
    ],
    "controls": [],
    "mode": "single",
    "answers": [
      "C"
    ],
    "explanationHtml": "<p>To create a Delta table you write the DataFrame in Delta format; writing CSV or plain Parquet would not create a Delta table with its transaction log.</p>Key verified against the documentation.",
    "images": [],
    "refs": [],
    "blockers": [],
    "sourceRecords": [
      "mixed:34"
    ],
    "review": "Source-supplied answer; not independently validated",
