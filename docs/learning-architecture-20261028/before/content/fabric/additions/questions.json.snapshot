      {
        "id": "C",
        "text": "SQL"
      },
      {
        "id": "D",
        "text": "XML"
      }
    ],
    "controls": [],
    "mode": "single",
    "answers": [
      "B"
    ],
    "explanationHtml": "<p>When ingesting data by using Dataflow Gen2, you get the same surface area as in Microsoft Power Query. This assumes that you will use the M language for data manipulation, no matter which data source you are connecting to.</p>",
