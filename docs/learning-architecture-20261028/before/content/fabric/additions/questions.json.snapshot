  {
    "id": "new-mixed-43",
    "sourceId": "mixed:43",
    "exam": "DP-600",
    "stemHtml": "<p>Which of the following statements is true about the difference between promotion and certification in Fabric?</p>",
    "contextHtml": "",
    "options": [
      {
        "id": "A",
        "text": "Promotion and certification both allow any workspace member to endorse content."
      },
      {
        "id": "B",
        "text": "Promotion requires a higher level of permissions than certification."
      },
      {
        "id": "C",
        "text": "Certification must be enabled in the tenant by the admin, while promotion can be done by a workspace member."
      }
    ],
    "controls": [],
    "mode": "single",
    "answers": [
      "C"
    ],
    "explanationHtml": "<p>Promotion is a lightweight endorsement any workspace member can apply, while certification is a stronger endorsement that must be enabled in the tenant settings by an admin and is granted by authorised reviewers.</p>Key verified against the documentation.",
    "images": [],
    "refs": [],
    "blockers": [],
    "sourceRecords": [
      "mixed:43"
    ],
    "review": "Source-supplied answer; not independently validated",
