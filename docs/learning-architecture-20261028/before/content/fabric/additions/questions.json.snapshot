        "id": "0",
        "label": "CREATE ______ [dbo].[ProductsWithPricingGroup]",
        "options": [
          "FUNCTION",
          "PROCEDURE",
          "TABLE",
          "VIEW"
        ],
        "answer": "VIEW"
      },
      {
        "id": "1",
        "label": "______  (before the WHEN clauses)",
        "options": [
          "CASE",
          "COALESCE",
          "IIF",
          "SET"
        ],
        "answer": "CASE"
      },
      {
        "id": "2",
        "label": "______ (between  WHEN ListPrice <= 50 THEN 'low'  and  WHEN ListPrice > 1000 THEN 'high')",
        "options": [
          "WHEN(ListPrice > 50 AND ListPrice < 1000) THEN 'medium'",
          "WHEN(ListPrice >= 50 AND ListPrice < 1000) THEN 'medium'",
          "WHEN ListPrice BETWEEN 50 AND 1000) THEN 'medium'"
        ],
        "answer": "WHEN ListPrice BETWEEN 50 AND 1000) THEN 'medium'"
      }
