  {
    "id": "new-mixed-37",
    "sourceId": "mixed:37",
    "exam": "DP-600",
    "stemHtml": "<p>Which tool is best suited for data transformation in Fabric when dealing with large-scale data that will continue to grow?</p>",
    "contextHtml": "",
    "options": [
      {
        "id": "A",
        "text": "Dataflows (Gen2)"
