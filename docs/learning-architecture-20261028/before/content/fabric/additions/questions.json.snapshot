      "p253_i2.png",
      "p253_i3.png"
    ],
    "missingAnswerImages": [
      "p253_i4.png"
    ]
  },
  {
    "id": "new-json-t1q98",
    "sourceId": "json:T1Q98",
    "exam": "DP-600",
    "stemHtml": "<pre>You have a Fabric notebook that has the Python code and output shown in the following exhibit.\n\nWhich type of analytics are you performing?</pre>",
    "contextHtml": "",
    "options": [
      {
        "id": "A",
        "text": "descriptive"
      },
      {
        "id": "B",
        "text": "diagnostic"
      },
      {
        "id": "C",
        "text": "prescriptive"
      },
      {
        "id": "D",
        "text": "predictive"
      }
    ],
    "controls": [],
    "mode": "single",
    "answers": [
      "A"
    ],
    "explanationHtml": "<pre>**Descriptive.** The four analytics types answer four different questions:\n\n| Type | Question it answers |\n| --- | --- |\n| **Descriptive** | **What happened?** |\n| Diagnostic | Why did it happen? |\n| Predictive | What will happen? |\n| Prescriptive | What should we do about it? |\n\nThe notebook loads data and renders a chart of it. It summarises and presents *what the data shows* — no root-cause investigation, no model, no recommendation. That is **descriptive** analytics.</pre>",
    "images": [],
    "refs": [
      {
        "title": "Data analysis and analytics types",
        "url": "https://learn.microsoft.com/training/modules/get-started-data-analytics/?wt.mc_id=studentamb_657938"
      }
    ],
    "blockers": [
      "Original question exhibit files not supplied: p255_i1.png"
