  {
    "id": "new-hub-dp600-66-r66",
    "sourceId": "study-hub:dp600:66",
    "exam": "DP-600",
    "stemHtml": "<p>What should you use to implement calculation groups for the Research division semantic models?</p>",
    "contextHtml": "",
    "options": [
      {
        "id": "A",
        "text": "Microsoft Power BI Desktop"
      },
      {
        "id": "B",
        "text": "the Power BI service"
