      },
      {
        "id": "C",
        "text": "Notebooks"
      }
    ],
    "controls": [],
    "mode": "single",
    "answers": [
      "C"
    ],
    "explanationHtml": "<p>Notebooks run Apache Spark, which distributes the work across a cluster and scales with the data, making them the best fit for large and growing datasets. Dataflows Gen2 are low-code but less suited to very large-scale transformation, and pipelines orchestrate rather than transform.</p>Key verified against the documentation.",
    "images": [],
    "refs": [],
    "blockers": [],
    "sourceRecords": [
      "mixed:37"
    ],
    "review": "Source-supplied answer; not independently validated",
