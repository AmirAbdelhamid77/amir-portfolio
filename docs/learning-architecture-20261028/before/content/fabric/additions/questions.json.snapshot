  {
    "id": "new-mixed-40",
    "sourceId": "mixed:40",
    "exam": "DP-600",
    "stemHtml": "<p>What is the purpose of V-Order and Optimize Write in Delta tables?</p>",
    "contextHtml": "",
    "options": [
      {
        "id": "A",
        "text": "V-Order and Optimize Write sorts the Delta table when queried with PySpark in a Fabric Notebook."
