[{"id":"fb-v7-ddm-001","sourceId":"V7-DDM-001","pack":"video07","topic":"Inference despite masking","title":"Inference despite masking","prompt":"Warehouse hr.Payroll contains (10,Alice,95000), (20,Ben,120000), (30,Cara,75000). Salary has default() masking. A contractor has SELECT but no UNMASK and executes: SELECT EmployeeID, Salary FROM hr.Payroll WHERE Salary BETWEEN 90000 AND 100000. What should the security review conclude?","type":"single","options":[{"id":"A","text":"One row can be returned with Salary displayed as 95000 because WHERE implicitly UNMASKs it.","why":"Filtering does not grant UNMASK to the caller."},{"id":"B","text":"One row (EmployeeID 10) can be returned with Salary displayed as 0, leaking a salary range.","why":"WHERE can evaluate the real underlying Salary while the returned value is masked."},{"id":"C","text":"No rows can be returned because WHERE evaluates the masked value 0.","why":"Masking happens in returned projection; predicates can still probe the underlying values."},{"id":"D","text":"The table stores Salary as 0 after the masking rule was added.","why":"DDM does not overwrite storage."}],"correct":["B"],"explanation":"The matching ID leaks information even though the projection shows zero; never rely on DDM as protection against deliberate inference.","videoSeconds":1077,"refs":["masking","vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-002","sourceId":"V7-DDM-002","pack":"video07","topic":"Multiple controls","title":"Multiple controls","prompt":"Compliance permits payroll analysts to view their own region only; outsourced dashboard maintainers may see employee IDs and departments but must not access Salary at all. Which controls should be part of a least-privilege Warehouse solution? Select THREE.","type":"multi","options":[{"id":"A","text":"Use Warehouse SQL RLS or an equivalent approved row-filter mechanism for region restrictions.","why":"RLS limits rows independently of presentation masking."},{"id":"B","text":"Grant only required item Read and granular database rights; avoid Contributor privileges.","why":"Contributor is elevated and exposes too much."},{"id":"C","text":"Apply default() to Salary as the sole control; the results cannot be inferred.","why":"Masking alone is not a strong boundary."},{"id":"D","text":"Restrict Salary with column-level SELECT permissions; avoid granting table-wide SELECT.","why":"CLS prevents authorized queries from reading the sensitive field."},{"id":"E","text":"Grant UNMASK to dashboard maintainers so they can verify masked values.","why":"UNMASK undermines the sensitive-data restriction."}],"correct":["A","B","D"],"explanation":"Complement RLS with CLS and least-privilege Fabric/SQL access. DDM may be an additional display safeguard, but cannot replace these controls.","videoSeconds":691,"refs":["masking","vref_6b11ae50991bee99","vref_152bbcc4378090d1","vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=691s"},{"id":"fb-v7-ddm-003","sourceId":"V7-DDM-003","pack":"video07","topic":"Nonprivileged NULL behavior","title":"Nonprivileged NULL behavior","prompt":"A payroll export query returns Salary for two employees: one source Salary is NULL and one is 120000. Salary has default() and the analyst has SELECT without UNMASK. Which interpretation is supported?","type":"single","options":[{"id":"A","text":"Both values are omitted from the result set.","why":"Masking does not filter rows."},{"id":"B","text":"NULL becomes 1900-01-01 and 120000 becomes zero.","why":"The date sentinel applies to a date/time typed value, not NULL or numeric."},{"id":"C","text":"Both records display zero because default() converts NULL into zero.","why":"NULL values are not changed by the masking function."},{"id":"D","text":"The NULL remains NULL; the non-NULL numeric salary is displayed as zero.","why":"NULL is not masked; numeric default shows zero."}],"correct":["D"],"explanation":"The video explicitly distinguishes missing values from non-null numeric values. Avoid confusing masking, type conversion, and row filtering.","videoSeconds":421,"refs":["masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=421s"},{"id":"fb-v7-ddm-004","sourceId":"V7-DDM-004","pack":"video07","topic":"Audit inference incidents","title":"Audit inference incidents","prompt":"An incident analyst discovers a nonprivileged user submitted 50 narrowly bounded Salary predicates, observed which employee IDs appeared, and reconstructed approximate salaries. Data returned still showed 0 for Salary. What is the defensible root-cause assessment?","type":"single","options":[{"id":"A","text":"Evidence that the salary mask must have been removed during those queries.","why":"The salary can remain masked in projection throughout probing."},{"id":"B","text":"Expected DDM inference weakness combined with excessive query access.","why":"DDM does not prevent inference from WHERE predicates."},{"id":"C","text":"Confirmed proof that the masked source values were decrypted.","why":"No decryption is needed to exploit query-result inference."},{"id":"D","text":"Evidence that SQL RLS is always disabled when DDM is present.","why":"DDM does not automatically disable RLS."}],"correct":["B"],"explanation":"The attack relies on permissible SQL predicates, not bypassing display masking; tighten access with object/column/row controls.","videoSeconds":1077,"refs":["masking","vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-005","sourceId":"V7-DDM-005","pack":"video07","topic":"Masking versus aggregation","title":"Masking versus aggregation","prompt":"An analytics lead wants to publish department total compensation to a group that is forbidden to infer any individual salary. Which design decision is safest?","type":"single","options":[{"id":"A","text":"Set all employee names to email() so records are anonymized.","why":"Formatting name strings as email-like masks does not stop linkage or salary inference."},{"id":"B","text":"Expose hr.Payroll with default() on Salary and allow unrestricted WHERE clauses.","why":"Probing and aggregations may still disclose information."},{"id":"C","text":"Build an explicitly authorized aggregated dataset or carefully controlled interface, and deny direct access to row-level salaries.","why":"A governed aggregate boundary prevents ad-hoc row-level probing."},{"id":"D","text":"Use random(1,100000) on each salary and let users calculate SUM from the raw table.","why":"A random display mask is not a robust disclosure or analytics governance boundary."}],"correct":["C"],"explanation":"Protect the query surface and data access; a DDM function is not an anonymization or release policy.","videoSeconds":720,"refs":["masking","vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=720s"},{"id":"fb-v7-ddm-006","sourceId":"V7-DDM-006","pack":"video07","topic":"Mask behavior and real business data","title":"Mask behavior and real business data","prompt":"HR applies MASKED WITH (FUNCTION='default()') to Salary and says that downstream calculations can now use the masked zeros as their secure source of truth. Which corrections are necessary? Select TWO.","type":"multi","options":[{"id":"A","text":"A mask is a display restriction, not proof that unauthorized users cannot infer confidential salaries.","why":"Query predicates can leak information."},{"id":"B","text":"Every Spark notebook reads the newly masked salary values.","why":"This SQL-layer behavior does not equate to OneLake/Spark enforcement."},{"id":"C","text":"The operation physically writes 0 to all Salary parquet files.","why":"No stored values are replaced."},{"id":"D","text":"The underlying stored salary values remain unchanged.","why":"DDM changes visible query results only."},{"id":"E","text":"Null salary values are rewritten to zero.","why":"NULL remains NULL in the video examples."}],"correct":["A","D"],"explanation":"Do not confuse presentation-layer effects, destructive redaction, and cross-engine policy enforcement.","videoSeconds":180,"refs":["masking","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=180s"},{"id":"fb-v7-ddm-007","sourceId":"V7-DDM-007","pack":"video07","topic":"Workspace role bypass","title":"Workspace role bypass","prompt":"A warehouse employee table has default() on Salary. Uma has item Read and SQL SELECT; Leo is a workspace Contributor. Neither has an explicit UNMASK grant. A test returns the actual Salary to Leo but zero to Uma. What best explains this?","type":"single","options":[{"id":"A","text":"Leo implicitly owns the table because he issued SELECT.","why":"Ownership is not assigned by running a read query."},{"id":"B","text":"Contributor receives elevated database privileges including access to unmasked data.","why":"Admin, Member, Contributor/CONTROL users are privileged."},{"id":"C","text":"DDM masks only when the query is executed from SSMS, not the Fabric portal.","why":"The key distinction is permission, not client."},{"id":"D","text":"Item Read overrides the masking rule and produces the raw value.","why":"Read alone is insufficient for UNMASK."}],"correct":["B"],"explanation":"Elevated workspace access is a common hidden bypass. Evaluate effective privileges, not only explicit SQL GRANT statements.","videoSeconds":630,"refs":["masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=630s"},{"id":"fb-v7-ddm-008","sourceId":"V7-DDM-008","pack":"video07","topic":"Minimal unmask grant","title":"Minimal unmask grant","prompt":"A finance quality reviewer already has item Read and SELECT on fin.Payroll. They must temporarily see unmasked PayGrade for validation without additional write or workspace permissions. Which operation best meets the requirement?","type":"single","options":[{"id":"A","text":"Promote the reviewer to workspace Member.","why":"Gives broad privileges beyond the requirement."},{"id":"B","text":"Drop the mask on PayGrade for every user.","why":"This removes protection for unrelated users."},{"id":"C","text":"Grant appropriately scoped UNMASK on PayGrade (or its protected table) to the reviewer/role.","why":"UNMASK authorizes seeing original values independently of SELECT."},{"id":"D","text":"Grant CONTROL on the entire database.","why":"CONTROL includes many unnecessary rights."}],"correct":["C"],"explanation":"Keep SELECT/read access as needed and grant only scoped UNMASK; remove that exception when work ends.","videoSeconds":1033,"refs":["masking","vref_680730490d013633"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1033s"},{"id":"fb-v7-ddm-009","sourceId":"V7-DDM-009","pack":"video07","topic":"UNMASK is not SELECT","title":"UNMASK is not SELECT","prompt":"A new service principal has no Fabric item Read and no table SELECT. A DBA issues a SQL UNMASK grant on dbo.Customers to the principal. What should happen when the principal tries to connect and query the warehouse?","type":"single","options":[{"id":"A","text":"It can connect but every masked column becomes 0 regardless of UNMASK.","why":"No item Read means connection is rejected in the documented model."},{"id":"B","text":"It still lacks the required item connectivity and SELECT; UNMASK alone cannot supply either.","why":"UNMASK only changes presentation for users that can read data."},{"id":"C","text":"The service principal automatically becomes workspace Contributor.","why":"A SQL permission does not alter workspace roles."},{"id":"D","text":"UNMASK automatically supplies all missing Read and SELECT permissions.","why":"UNMASK is not a data-selection or control-plane access grant."}],"correct":["B"],"explanation":"Check three separate gates: Fabric Read, SQL data SELECT, and UNMASK privilege.","videoSeconds":641,"refs":["masking","vref_1c5d797a849bbf18","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=641s"},{"id":"fb-v7-ddm-010","sourceId":"V7-DDM-010","pack":"video07","topic":"Mask administration privilege","title":"Mask administration privilege","prompt":"A security operator has table ALTER but not ALTER ANY MASK. They attempt ALTER TABLE dbo.Staff ALTER COLUMN Phone ADD MASKED WITH (FUNCTION='partial(0,\"***\",4)'). What is the most specific missing permission in this scenario?","type":"single","options":[{"id":"A","text":"ALTER ANY MASK.","why":"Adding, replacing or removing a mask requires ALTER ANY MASK as well as ALTER on table."},{"id":"B","text":"SELECT.","why":"SELECT is for querying data, not changing mask metadata."},{"id":"C","text":"VIEW DEFINITION alone.","why":"Metadata visibility does not enable schema alteration."},{"id":"D","text":"UNMASK.","why":"UNMASK governs reading originals, not editing masks."}],"correct":["A"],"explanation":"Mask lifecycle changes require the documented mask-admin permission plus table ALTER.","videoSeconds":586,"refs":["masking","vref_680730490d013633"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=586s"},{"id":"fb-v7-ddm-011","sourceId":"V7-DDM-011","pack":"video07","topic":"Revoke exception","title":"Revoke exception","prompt":"A scoped UNMASK grant on sec.Employees was issued to auditors and now must be removed while preserving their approved SELECT. Which change best implements the revocation?","type":"single","options":[{"id":"A","text":"REVOKE UNMASK ON sec.Employees FROM the auditor principal/role, leaving SELECT intact.","why":"This removes the bypass without modifying the data-selection grant."},{"id":"B","text":"Grant a different random masking function to the role.","why":"DDM functions attach to columns, not per-user role grants."},{"id":"C","text":"DROP MASKED on the EmployeeID column.","why":"Dropping a mask makes the column fully visible to every reader."},{"id":"D","text":"REVOKE SELECT on the entire database.","why":"It removes the ability to perform approved analysis as well."}],"correct":["A"],"explanation":"Remove only the special UNMASK permission, re-test as an affected identity, and ensure no other privileged path exists.","videoSeconds":1058,"refs":["vref_680730490d013633","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1058s"},{"id":"fb-v7-ddm-012","sourceId":"V7-DDM-012","pack":"video07","topic":"Effective privileges inventory","title":"Effective privileges inventory","prompt":"Audit logs show a user's explicit SQL permissions contain SELECT but no UNMASK; yet the user sees real SSNs. Which possible explanations should the team check first? Select THREE.","type":"multi","options":[{"id":"A","text":"The use of item Read automatically suspends masking for every selected column.","why":"Item Read is a connectivity permission, not a DDM bypass."},{"id":"B","text":"The user has only item Read.","why":"Read by itself does not confer unmasked visibility."},{"id":"C","text":"The user inherits a scoped UNMASK grant through a database role.","why":"Role grants can confer UNMASK."},{"id":"D","text":"The user holds CONTROL on the database or similarly elevated Warehouse privileges.","why":"CONTROL includes UNMASK."},{"id":"E","text":"The user is Admin, Member, or Contributor in the workspace.","why":"Those roles are privileged for Warehouse unmasking."}],"correct":["C","D","E"],"explanation":"Review inherited roles, workspace access, and database CONTROL as distinct privileged paths; explicit permissions alone can be misleading.","videoSeconds":646,"refs":["masking","vref_1c5d797a849bbf18"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=646s"},{"id":"fb-v7-ddm-013","sourceId":"V7-DDM-013","pack":"video07","topic":"DDM user identity limitation","title":"DDM user identity limitation","prompt":"An organization is migrating a lakehouse SQL analytics endpoint from delegated identity to user identity mode to use centrally managed OneLake security roles. The existing SQL endpoint has DDM on PatientEmail. Security requests that the exact SQL mask remain enforced through the new mode. What is the key conflict?","type":"single","options":[{"id":"A","text":"Switching modes converts the underlying Delta files to encrypted parquet.","why":"The identity mode does not rewrite stored data like this."},{"id":"B","text":"DDM is supported in user identity mode if the user has only Read.","why":"The restriction is a mode capability, not simply a permission issue."},{"id":"C","text":"OneLake user identity mode does not support SQL DDM; the team must redesign the control or retain delegated mode.","why":"OneLake security has no equivalent SQL DDM facility in user-identity mode."},{"id":"D","text":"DDM is automatically translated into OneLake RLS.","why":"RLS filters rows and is not a masking-function translation."}],"correct":["C"],"explanation":"This is an authoritative mode limitation, not a missing grant.","videoSeconds":646,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=646s"},{"id":"fb-v7-ddm-014","sourceId":"V7-DDM-014","pack":"video07","topic":"Choose governance approach","title":"Choose governance approach","prompt":"A lakehouse must enforce identical table/row restrictions for Spark notebooks and its SQL endpoint under the same user identity. Masking for UI convenience is secondary. Which strategy most closely matches the target architecture?","type":"single","options":[{"id":"A","text":"Grant only SQL UNMASK then rely on that permission to secure Spark.","why":"UNMASK neither restricts rows nor governs Spark OneLake access."},{"id":"B","text":"Use OneLake user identity mode with OneLake roles and supported row/column restrictions.","why":"Pass-through user identity aligns the table access across engines."},{"id":"C","text":"Use delegated identity mode and assume SQL DDM is inherited by Spark.","why":"SQL DDM remains a SQL query-time behavior."},{"id":"D","text":"Implement SQL DDM alone and remove the OneLake roles.","why":"DDM does not protect data across data planes."}],"correct":["B"],"explanation":"Choose the enforcement plane based on all consumers, rather than attempting to make SQL masking act as OneLake policy.","videoSeconds":775,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=775s"},{"id":"fb-v7-ddm-015","sourceId":"V7-DDM-015","pack":"video07","topic":"Mode permission matrix","title":"Mode permission matrix","prompt":"A lakehouse SQL analytics endpoint is in user identity mode. A principal already has item Read. Which statements describe its table-data authorization? Select TWO.","type":"multi","options":[{"id":"A","text":"Changing a SQL view grant automatically changes the underlying OneLake table permissions.","why":"View permissions and base-table OneLake policies are different security targets."},{"id":"B","text":"A SQL table-level UNMASK grant permits raw masked output, even though DDM is unsupported.","why":"DDM is not part of this mode."},{"id":"C","text":"OneLake security roles govern read access to base tables.","why":"The endpoint passes the signed-in identity through for table authorization."},{"id":"D","text":"SQL table GRANT/REVOKE does not replace the OneLake policies.","why":"Table grants are not the mechanism in user identity mode."},{"id":"E","text":"The delegated workspace owner identity is used to evaluate every table query.","why":"That is delegated identity mode."}],"correct":["C","D"],"explanation":"Differentiate object scopes: OneLake for table reads, SQL permissions for nondata objects such as views/functions.","videoSeconds":708,"refs":["vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=708s"},{"id":"fb-v7-ddm-016","sourceId":"V7-DDM-016","pack":"video07","topic":"Two independent gates","title":"Two independent gates","prompt":"A consumer was added to a narrowly scoped OneLake security role for a Delta table, but SQL connections to the Lakehouse endpoint fail before a SELECT runs. Which missing action should be checked FIRST?","type":"single","options":[{"id":"A","text":"Grant the consumer ALTER ANY MASK.","why":"Mask administration cannot fix missing item access."},{"id":"B","text":"Switch the endpoint to delegated mode and grant UNMASK.","why":"This abandons the intended OneLake user-identity security architecture."},{"id":"C","text":"Assign Contributor to bypass the error.","why":"Broad role escalation is not a least-privilege fix."},{"id":"D","text":"Grant the consumer Fabric Read permission on the Lakehouse item.","why":"Control-plane Read is required even if a matching OneLake data role exists."}],"correct":["D"],"explanation":"OneLake table role membership alone cannot establish control-plane connectivity.","videoSeconds":707,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=707s"},{"id":"fb-v7-ddm-017","sourceId":"V7-DDM-017","pack":"video07","topic":"Migration rollout hazards","title":"Migration rollout hazards","prompt":"Before switching a production SQL analytics endpoint from delegated identity to user identity, a deployment engineer prepares a change window. Which actions are justified by current Fabric documentation? Select THREE.","type":"multi","options":[{"id":"A","text":"Assume all data in underlying lakehouse tables must be recreated from scratch.","why":"The documented mode change does not erase OneLake table data."},{"id":"B","text":"Plan a policy replacement for SQL DDM rather than assuming it persists in the new mode.","why":"DDM is unavailable in OneLake security."},{"id":"C","text":"Assume the mode change is purely cosmetic and requires no regression testing.","why":"Effective security and workload availability change."},{"id":"D","text":"Inventory and script SQL roles and inline metadata objects before changing modes.","why":"Mode switching can remove SQL roles and functions."},{"id":"E","text":"Schedule the change carefully because SQL endpoints across the workspace can become temporarily unavailable.","why":"The mode switch cancels queued/running queries at workspace endpoints."}],"correct":["B","D","E"],"explanation":"The migration impacts governance, metadata and availability; back up definitions and test alternate policy design.","videoSeconds":775,"refs":["vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=775s"},{"id":"fb-v7-ddm-018","sourceId":"V7-DDM-018","pack":"video07","topic":"SQL read-only vs metadata DDL","title":"SQL read-only vs metadata DDL","prompt":"An engineer claims that because the Lakehouse SQL endpoint is read-only, the team cannot attach or remove DDM metadata in delegated mode. What is the best correction?","type":"single","options":[{"id":"A","text":"DDM requires Spark to physically rewrite all column values.","why":"DDM uses SQL query-time metadata."},{"id":"B","text":"The endpoint is read-only for table data operations, but supports certain SQL metadata/security changes such as ALTER COLUMN masking.","why":"Data DML limitations do not prohibit documented security metadata operations."},{"id":"C","text":"DDM is only possible when a Warehouse table is first created.","why":"The documentation allows ALTER TABLE on existing endpoint columns."},{"id":"D","text":"The Lakehouse SQL endpoint supports INSERT and UPDATE just like Warehouse.","why":"It is read-only for underlying Delta data."}],"correct":["B"],"explanation":"Avoid conflating a read-only data plane with the allowed SQL security/metadata surface.","videoSeconds":579,"refs":["vref_680730490d013633","endpoint","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=579s"},{"id":"fb-v7-ddm-019","sourceId":"V7-DDM-019","pack":"video07","topic":"Direct Lake fallback","title":"Direct Lake fallback","prompt":"A Direct Lake semantic model is built on a SQL analytics endpoint. Its source table receives SQL DDM, and the model uses default Automatic fallback behavior. Which outcome should the architect anticipate?","type":"single","options":[{"id":"A","text":"A DirectQuery fallback may occur for the masked table, potentially increasing query latency.","why":"SQL DDM is a documented Direct Lake on SQL endpoint fallback trigger."},{"id":"B","text":"The semantic model writes the masked values into Delta files and remains pure Direct Lake.","why":"DDM does not rewrite OneLake source data."},{"id":"C","text":"The table must automatically switch to Import mode permanently.","why":"Fallback uses DirectQuery rather than requiring an Import conversion."},{"id":"D","text":"DDM guarantees that Direct Lake on OneLake also masks every Spark read.","why":"SQL-based DDM does not control OneLake readers."}],"correct":["A"],"explanation":"Model storage mode and security enforcement are coupled: SQL DDM can prevent pure Direct Lake execution.","videoSeconds":1077,"refs":["vref_f888a1260a88cdd7","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models — Configure Direct Lake and security","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-020","sourceId":"V7-DDM-020","pack":"video07","topic":"DirectLakeOnly diagnosis","title":"DirectLakeOnly diagnosis","prompt":"A model that formerly worked in Direct Lake on SQL analytics endpoint is set to DirectLakeOnly. An administrator adds SQL DDM to one source table. Queries referencing that table now fail. What is the correct engineering explanation?","type":"single","options":[{"id":"A","text":"The random() mask intentionally corrupted the source parquet schema.","why":"Masking does not modify stored schema/data this way."},{"id":"B","text":"A DDM rule always adds Import partitions automatically, but DirectLakeOnly rejects Import.","why":"That is not the documented mechanism."},{"id":"C","text":"The mask creates a fallback requirement but DirectLakeOnly forbids DirectQuery fallback.","why":"The DirectLakeBehavior setting rejects queries that cannot remain Direct Lake."},{"id":"D","text":"The semantic model no longer supports any type of row-level security.","why":"The failure relates to the incompatible fallback requirement."}],"correct":["C"],"explanation":"Test with Automatic for functional fallback or redesign the source security/model to remain Direct Lake.","videoSeconds":1077,"refs":["vref_f888a1260a88cdd7","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models — Configure Direct Lake and security","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-021","sourceId":"V7-DDM-021","pack":"video07","topic":"Direct Lake implementation options","title":"Direct Lake implementation options","prompt":"A performance-sensitive semantic model currently relies on SQL-endpoint masking while the team demands no DirectQuery fallback. Which statements are defensible? Select THREE.","type":"multi","options":[{"id":"A","text":"Direct Lake on OneLake is not coupled to SQL endpoint DDM.","why":"Its protection needs OneLake-appropriate governance."},{"id":"B","text":"For a Direct Lake on SQL endpoint model, SQL DDM is a documented fallback trigger.","why":"Cannot assume pure Direct Lake for that table."},{"id":"C","text":"Set DirectLakeBehavior=DirectLakeOnly; it forces DDM to be executed inside the Direct Lake engine.","why":"It causes failure instead of forcing SQL masks into Direct Lake."},{"id":"D","text":"Revisit the security boundary and use supported semantic-model/OneLake access policies rather than relying on SQL DDM for every consumption mode.","why":"Architectural redesign may avoid fallback while protecting users."},{"id":"E","text":"Change DDM from default() to email(); email() has an exemption from fallback.","why":"Fallback is due to DDM presence, not its type."}],"correct":["A","B","D"],"explanation":"DDM introduces a design trade-off between SQL presentation rules and Direct Lake performance.","videoSeconds":1077,"refs":["vref_f888a1260a88cdd7","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models — Configure Direct Lake and security","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-022","sourceId":"V7-DDM-022","pack":"video07","topic":"Diagnose fallback with DAX","title":"Diagnose fallback with DAX","prompt":"A report became slower after a SQL security update. The Direct Lake on SQL analytics endpoint semantic model is configured Automatic. Which DAX-based diagnostic is explicitly documented for investigating fallback reasons?","type":"single","options":[{"id":"A","text":"EVALUATE SELECTEDVALUE()","why":"Not a documented per-table fallback diagnostic."},{"id":"B","text":"EVALUATE TABLETRAITS()","why":"The DirectLakeFallbackInfo column identifies fallback conditions by table."},{"id":"C","text":"EVALUATE DESCRIBE HISTORY","why":"Delta history is unrelated to Direct Lake fallback traits."},{"id":"D","text":"EVALUATE SYS.DATABASE_PERMISSIONS","why":"This mixes SQL system catalog syntax with DAX."}],"correct":["B"],"explanation":"Use TABLETRAITS to inspect fallback causes before assuming the slow query is a DAX issue.","videoSeconds":1077,"refs":["vref_f888a1260a88cdd7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models — Configure Direct Lake and security","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-023","sourceId":"V7-DDM-023","pack":"video07","topic":"Bypass through OneLake data path","title":"Bypass through OneLake data path","prompt":"A Lakehouse Delta table contains medical IDs. A developer masks a column using the delegated SQL analytics endpoint. A second developer can read the source Delta table via an authorized Spark notebook. What assumption must security reject?","type":"single","options":[{"id":"A","text":"That Spark can read a Delta table in a lakehouse.","why":"That is expected functionality."},{"id":"B","text":"That the SQL endpoint may be read-only for Lakehouse data changes.","why":"That is correct and distinct from the masking gap."},{"id":"C","text":"That SQL endpoints can present masked results to restricted SQL users.","why":"That is the intended DDM capability."},{"id":"D","text":"That a SQL DDM rule alone will protect the notebook's direct OneLake reads.","why":"DDM is enforced in the SQL query path; direct storage access has separate authorization."}],"correct":["D"],"explanation":"Align OneLake source access, Spark permissions, and SQL-layer masking separately; do not treat a SQL mask as source obfuscation.","videoSeconds":751,"refs":["masking","vref_f513e79bbf83ae3f","vref_d17fe02bcfcd59e7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models — Configure Direct Lake and security","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=751s"},{"id":"fb-v7-ddm-024","sourceId":"V7-DDM-024","pack":"video07","topic":"Correct physical-state inference","title":"Correct physical-state inference","prompt":"A Warehouse table displays 0 in a masked numeric field to a viewer. Another authorized process queries Delta data through a distinct supported OneLake path. Which observations are consistent with DDM? Select TWO.","type":"multi","options":[{"id":"A","text":"Other data paths require their own permission controls; one cannot infer identical masked rendering.","why":"Engine scopes differ."},{"id":"B","text":"A SQL mask guarantees the Parquet file physically contains 0.","why":"No underlying rewrite is performed."},{"id":"C","text":"The Warehouse SQL result may be masked although underlying numeric values remain intact.","why":"Masking changes query presentation."},{"id":"D","text":"UNMASK authorizes writing back the original salary in Spark.","why":"UNMASK is not a write/data-plane privilege."}],"correct":["A","C"],"explanation":"This question tests physical storage, logical SQL result and cross-engine permissions independently.","videoSeconds":668,"refs":["masking","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Implement and manage semantic models — Configure Direct Lake and security","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=668s"},{"id":"fb-v7-ddm-025","sourceId":"V7-DDM-025","pack":"video07","topic":"Email suffix edge case","title":"Email suffix edge case","prompt":"The stated requirement is: for external consultants, the output for a valid email `marie@research.org` must preserve the last four characters `.org` but conceal the center. Which rule can satisfy that suffix requirement?","type":"single","options":[{"id":"A","text":"Use email() because it preserves the original top-level domain.","why":"email() yields the fixed .com suffix."},{"id":"B","text":"Use random(1,9999) because it accepts any string.","why":"random() is for numeric columns."},{"id":"C","text":"Use a properly configured partial(...) mask that keeps four characters from the end.","why":"Partial masking can preserve a chosen trailing substring."},{"id":"D","text":"Use default() because it preserves the final four characters.","why":"default() hides the string content instead."}],"correct":["C"],"explanation":"Email() is not a domain-preserving mask; the video emphasizes this as a common trap.","videoSeconds":1280,"refs":["masking","vref_680730490d013633"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1280s"},{"id":"fb-v7-ddm-026","sourceId":"V7-DDM-026","pack":"video07","topic":"Nullable edge case","title":"Nullable edge case","prompt":"A table has `ContactEmail` values of NULL, an empty non-NULL string, and `alpha@example.org`; `email()` is configured. Which conclusion is justified?","type":"single","options":[{"id":"A","text":"The invalid address causes INSERT to fail because email() is a format constraint.","why":"DDM is not a CHECK constraint or email validator."},{"id":"B","text":"The NULL value stays NULL, while non-NULL values are subject to masking rather than email-format validation.","why":"The video explicitly demonstrates NULL and nonstandard strings separately."},{"id":"C","text":"The NULL value becomes xXXX@XXXX.com.","why":"NULL is not masked into a fake email."},{"id":"D","text":"The original `.org` domain is displayed unchanged by email().","why":"Email masking substitutes a fixed .com suffix."}],"correct":["B"],"explanation":"Distinguish nullable handling, arbitrary input strings, and data-validation constraints.","videoSeconds":368,"refs":["masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=368s"},{"id":"fb-v7-ddm-027","sourceId":"V7-DDM-027","pack":"video07","topic":"Mask strategy under data types","title":"Mask strategy under data types","prompt":"A table contains HireDate DATE, BasePay DECIMAL, ContactEmail VARCHAR, and AccountID VARCHAR. The requirement is to hide all dates to a constant, replace numeric pay with a bounded synthetic display, reveal only email initial, and preserve last four account characters. Which pairing is correct?","type":"single","options":[{"id":"A","text":"HireDate email(); BasePay partial(...); ContactEmail random(...); AccountID default().","why":"The functions do not match the needed data types or suffix behavior."},{"id":"B","text":"HireDate random(); BasePay email(); ContactEmail default(); AccountID partial(0,\"****\",4).","why":"Date and numeric functions are mismatched."},{"id":"C","text":"HireDate default(); BasePay default(); ContactEmail email(); AccountID email().","why":"Default pay is zero, not bounded random; email() does not preserve account suffix."},{"id":"D","text":"HireDate default(); BasePay random(low,high); ContactEmail email(); AccountID partial(0,\"****\",4).","why":"Each mask uses the documented suitable data type/intent."}],"correct":["D"],"explanation":"Under time pressure choose masks by disclosure rules and data type, not column names alone.","videoSeconds":579,"refs":["masking","vref_680730490d013633"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=579s"},{"id":"fb-v7-ddm-028","sourceId":"V7-DDM-028","pack":"video07","topic":"Short string partial masking","title":"Short string partial masking","prompt":"A column Code VARCHAR(10) is masked with partial(3,\"***\",3). Some rows contain only two characters. What is the sound design expectation?","type":"single","options":[{"id":"A","text":"Fabric pads the original string with spaces until six source characters exist.","why":"No such padding of source data is implied."},{"id":"B","text":"Do not assume all three prefix and suffix characters remain visible; short inputs can be fully covered by the padding.","why":"The short-string behavior can expose fewer original characters than requested."},{"id":"C","text":"The engine rejects any SELECT against rows shorter than six characters.","why":"The masking function does not enforce a row-length constraint."},{"id":"D","text":"Short rows automatically bypass DDM.","why":"Short input is not an UNMASK privilege."}],"correct":["B"],"explanation":"An examiner can use short values to test whether the candidate understands masking output is not simply a fixed-length substring formula.","videoSeconds":515,"refs":["masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=515s"},{"id":"fb-v7-ddm-029","sourceId":"V7-DDM-029","pack":"video07","topic":"DDL lifecycle and original data","title":"DDL lifecycle and original data","prompt":"An existing warehouse table has Email VARCHAR(256) without masking. The administrator must begin obscuring email addresses immediately and later remove the display mask without losing original values. Which ordered SQL commands are appropriate?","type":"single","options":[{"id":"A","text":"UPDATE the Email values to masked text; later REVOKE SELECT.","why":"Destructive updates destroy original email values."},{"id":"B","text":"GRANT UNMASK to every user; later GRANT SELECT to every user.","why":"These grants do not install or remove a column mask."},{"id":"C","text":"ALTER TABLE ... ALTER COLUMN Email ADD MASKED WITH (FUNCTION='email()'); later ALTER TABLE ... ALTER COLUMN Email DROP MASKED;","why":"The documented DDL manages mask metadata without rewriting user emails."},{"id":"D","text":"ALTER TABLE ... DROP COLUMN Email; later re-add Email.","why":"This loses column data."}],"correct":["C"],"explanation":"DDM is schema-level policy metadata, not a data-cleansing operation.","videoSeconds":1023,"refs":["vref_680730490d013633","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1023s"},{"id":"fb-v7-ddm-030","sourceId":"V7-DDM-030","pack":"video07","topic":"Expected masked projections","title":"Expected masked projections","prompt":"A user without UNMASK selects four masked columns: Name VARCHAR with default(), Amount DECIMAL with default(), EventDate DATE with default(), and a numeric Score with random(1,5). Which statements are justified? Select THREE.","type":"multi","options":[{"id":"A","text":"Every source NULL becomes its data type’s mask constant.","why":"NULL values stay NULL."},{"id":"B","text":"Amount is projected as zero.","why":"Default numeric mask uses 0."},{"id":"C","text":"Name becomes a string marker such as XXXX (subject to declared field length).","why":"Default mask renders a fixed-length string placeholder."},{"id":"D","text":"EventDate shows the default 1900-01-01 date representation.","why":"The date/time sentinel is the start of 1900."},{"id":"E","text":"Score must always be the same random number across separate queries.","why":"random() can produce new values each execution."}],"correct":["B","C","D"],"explanation":"Each mask type has type-specific behavior; be wary of NULL handling and nondeterministic random output.","videoSeconds":216,"refs":["masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=216s"},{"id":"fb-v7-ddm-031","sourceId":"V7-DDM-031","pack":"video07","topic":"Defense in depth","title":"Defense in depth","prompt":"A health organization argues that DDM complies with a policy forbidding all non-clinicians from obtaining patient dates of birth, because SELECT shows 1900-01-01. They still permit unbounded SQL predicates on DOB. What should the technical reviewer recommend?","type":"single","options":[{"id":"A","text":"Grant workspace Contributor so queries are faster.","why":"Elevated privileges would expose originals."},{"id":"B","text":"Reduce accessible rows/columns or expose a governed interface; retain DDM only as an additional display safeguard.","why":"DDM cannot prevent range-probing of the original DOB values."},{"id":"C","text":"Increase the number of masked X characters.","why":"Changing a placeholder does not prevent predicate inference."},{"id":"D","text":"Use email() for DOB values because it is harder to reverse.","why":"Email masking is not appropriate for dates and does not solve query inference."}],"correct":["B"],"explanation":"A compliance requirement about data nondisclosure needs strong authorization, not formatting.","videoSeconds":1077,"refs":["masking","vref_1c5d797a849bbf18","vref_152bbcc4378090d1"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-032","sourceId":"V7-DDM-032","pack":"video07","topic":"Layered security controls","title":"Layered security controls","prompt":"A sensitive benefits table must be protected from ad-hoc SQL and Spark access, but approved SQL analysts should see masked phone numbers in a reporting interface. Which two distinct policy layers are necessary? Select TWO.","type":"multi","options":[{"id":"A","text":"Replace private data permanently with 1900-01-01 in the source as an unavoidable DDM side effect.","why":"DDM does not rewrite stored source data."},{"id":"B","text":"A single default() mask to stop all row-filter and file-access attacks.","why":"Not a security boundary across engines."},{"id":"C","text":"SQL DDM for authorized restricted SQL presentations, where supported by endpoint mode.","why":"DDM is useful as a supplementary SQL-layer display rule."},{"id":"D","text":"Workspace Contributor for every approved analyst.","why":"Privileged role conflicts with least privilege."},{"id":"E","text":"Source/OneLake access controls to constrain storage and non-SQL consumers.","why":"SQL masking does not govern all OneLake readers."}],"correct":["C","E"],"explanation":"Separation of planes is essential: data access restrictions for all engines, SQL masking for SQL presentation.","videoSeconds":742,"refs":["masking","vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=742s"},{"id":"fb-v7-ddm-033","sourceId":"V7-DDM-033","pack":"video07","topic":"Audit privilege and values","title":"Audit privilege and values","prompt":"A compliance tester reports that all masking tests passed, but each test used the workspace admin's identity. Which correction is necessary to make the test meaningful?","type":"single","options":[{"id":"A","text":"Re-run positive and negative cases as a least-privileged principal with item Read and intentionally scoped SQL SELECT, without UNMASK.","why":"Admin is expected to bypass masks and cannot validate restricted-user behavior."},{"id":"B","text":"Remove DDM from all columns before performing tests.","why":"That would erase the behavior under test."},{"id":"C","text":"Continue with admin credentials because the output matches production for all users.","why":"Permission differences are central to DDM."},{"id":"D","text":"Use a shared Contributor identity to simulate untrusted analysts.","why":"Contributor is a privileged role and not representative."}],"correct":["A"],"explanation":"Test effective identities and log roles, SQL permissions, and masked/unmasked outputs.","videoSeconds":946,"refs":["vref_680730490d013633","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=946s"},{"id":"fb-v7-ddm-034","sourceId":"V7-DDM-034","pack":"video07","topic":"Security diagnostic order","title":"Security diagnostic order","prompt":"After a deployment, a user receives `SELECT permission denied` when querying a table, not a masked value. Which should the team validate rather than immediately granting UNMASK? Select THREE.","type":"multi","options":[{"id":"A","text":"Whether SQL SELECT was granted on the intended table or columns in delegated mode.","why":"SELECT is required to read the data."},{"id":"B","text":"Whether the user knows the random mask seed.","why":"No user-supplied seed controls DDM authorization."},{"id":"C","text":"Whether the data was compressed with OPTIMIZE.","why":"Compaction does not grant access or fix missing permissions."},{"id":"D","text":"Whether the user has Fabric item Read to establish a connection.","why":"Read is a prerequisite to the SQL endpoint."},{"id":"E","text":"Whether the endpoint was switched to user identity mode where OneLake governs table reads.","why":"The access mode changes the authorization source."}],"correct":["A","D","E"],"explanation":"UNMASK is irrelevant if the user has no SELECT or data-access grant. Investigate connectivity, object authorization and engine mode first.","videoSeconds":646,"refs":["vref_1c5d797a849bbf18","vref_f513e79bbf83ae3f","masking"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=646s"},{"id":"fb-v7-ddm-035","sourceId":"V7-DDM-035","pack":"video07","topic":"Difference between mask and deny","title":"Difference between mask and deny","prompt":"A contractor may see the final four characters of BankAccountNo for reconciliation but must never see the full account number, even by using arbitrary ad-hoc SQL predicates. Is `partial(0,\"***\",4)` alone sufficient?","type":"single","options":[{"id":"A","text":"Yes; partial() encrypts all hidden characters at rest.","why":"No storage encryption or ciphertext conversion is implied."},{"id":"B","text":"Yes; a masked column cannot be referenced in WHERE predicates.","why":"SQL predicates can use actual values for inference."},{"id":"C","text":"No; while it may give the desired projection, arbitrary querying could still reveal or infer sensitive source values.","why":"DDM is not a strict nondisclosure boundary for malicious ad-hoc query users."},{"id":"D","text":"No; partial() is only for dates, not strings.","why":"partial() is specifically a string masking function."}],"correct":["C"],"explanation":"Requirements must distinguish cosmetic partial display from prohibition on the ability to learn source values.","videoSeconds":1077,"refs":["masking","vref_680730490d013633"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=1077s"},{"id":"fb-v7-ddm-036","sourceId":"V7-DDM-036","pack":"video07","topic":"Cross-product controls and reporting","title":"Cross-product controls and reporting","prompt":"An enterprise uses a Lakehouse, a Warehouse, and a Direct Lake on SQL endpoint semantic model. Which statements should appear in a security architecture decision record? Select THREE.","type":"multi","options":[{"id":"A","text":"Warehouse and delegated SQL endpoint DDM apply at the SQL result layer, not as a universal OneLake policy.","why":"Enforcement depends on query path."},{"id":"B","text":"SQL-endpoint DDM can force DirectQuery fallback in compatible Direct Lake semantic models.","why":"The Direct Lake on SQL endpoint fallback rules list SQL DDM."},{"id":"C","text":"SQL DDM masks all lakehouse Spark and file reads regardless of principal.","why":"That is not a cross-engine guarantee."},{"id":"D","text":"The mask guarantees compliance even if every user is workspace Contributor.","why":"Contributors typically see unmasked values and hold broad privileges."},{"id":"E","text":"User-identity SQL endpoint reads use OneLake security rather than SQL base-table DDM.","why":"The OneLake mode does not support DDM."}],"correct":["A","B","E"],"explanation":"Correct architecture combines identity-mode analysis, SQL engine controls, physical access, and semantic-model performance.","videoSeconds":718,"refs":["masking","vref_f513e79bbf83ae3f","vref_f888a1260a88cdd7"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Maintain a data analytics solution — Implement security and governance","provenance":"original scenario, grounded in cited video/topic and Microsoft Learn; not an actual exam question","validation":"documentation-backed reasoning, not executed in live Fabric tenant","sourceVideoUrl":"https://www.youtube.com/watch?v=huq8mLss4jo&t=718s"}]
