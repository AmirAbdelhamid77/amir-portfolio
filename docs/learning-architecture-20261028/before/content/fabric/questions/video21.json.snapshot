[{"id":"fb-v21-cat-001","sourceId":"V21-CAT-001","pack":"video21","topic":"Migration availability","title":"Migration availability","prompt":"A platform owner wants to execute the interview migration today on every production tenant. Learn says general migration tooling is unavailable, while the interview describes an allowlisted API. What is the defensible plan?","type":"single","options":[{"id":"A","text":"Verify tenant eligibility and obtain the supported instructions before a pilot","why":"Conflicting availability evidence requires support confirmation and a controlled pilot."},{"id":"B","text":"Invent the API route from the table path","why":"An undisclosed endpoint must not be guessed."},{"id":"C","text":"Move every table manually and mark migration complete","why":"Folder moves alone do not establish catalog and dependency consistency."},{"id":"D","text":"Treat a video demonstration as universal production authorization","why":"A demonstration does not prove general availability."}],"correct":["A"],"explanation":"Conflicting availability evidence requires support confirmation and a controlled pilot.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-002","sourceId":"V21-CAT-002","pack":"video21","topic":"Capability versus conversion","title":"Capability versus conversion","prompt":"A legacy Lakehouse must remain unchanged, but engineers want supported cross-workspace queries. What is the key distinction?","type":"single","options":[{"id":"A","text":"Changing the notebook title enables schemas","why":"Titles do not select query capabilities."},{"id":"B","text":"Catalog capability and physical Lakehouse conversion are different decisions","why":"Supported mixed queries can be evaluated without assuming an in-place conversion exists."},{"id":"C","text":"Cross-workspace reads always require moving source bytes","why":"Query federation does not inherently require relocation."},{"id":"D","text":"A SQL schema automatically changes the Spark catalog","why":"SQL metadata and Spark catalog selection are separate."}],"correct":["B"],"explanation":"Supported mixed queries can be evaluated without assuming an in-place conversion exists.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-003","sourceId":"V21-CAT-003","pack":"video21","topic":"Migration evidence","title":"Migration evidence","prompt":"A two-step switch is shown in an interview. Only the first step moves table locations under dbo. The explorer now shows unidentified items. What should the team infer?","type":"single","options":[{"id":"A","text":"All rows were necessarily deleted","why":"Unexpected explorer state does not prove physical loss."},{"id":"B","text":"The demonstrated transition is incomplete; do not declare success from path movement alone","why":"The demonstration distinguishes storage organization and the Lakehouse property change."},{"id":"C","text":"Recreate data immediately without inspection","why":"First inspect state and follow approved recovery guidance."},{"id":"D","text":"Ignore the second control-plane step","why":"Ignoring metadata can leave the object inconsistently represented."}],"correct":["B"],"explanation":"The demonstration distinguishes storage organization and the Lakehouse property change.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-004","sourceId":"V21-CAT-004","pack":"video21","topic":"Environment parity","title":"Environment parity","prompt":"A pilot migration changes test but leaves development unchanged. Deployment then rejects different Lakehouse properties. Which TWO actions follow from the interview and sound change control?","type":"multi","options":[{"id":"A","text":"Delete deployment history to hide the difference","why":"Hiding history does not repair state mismatch."},{"id":"B","text":"Test deployment against a representative environment chain","why":"A rehearsal checks actual lifecycle behavior."},{"id":"C","text":"Inventory and align intended source/destination Lakehouse types","why":"Configuration parity must be deliberate."},{"id":"D","text":"Assume promotion automatically converts every existing environment","why":"The interview warns against relying on one environment change propagating everywhere."}],"correct":["B","C"],"explanation":"Configuration parity must be deliberate. A rehearsal checks actual lifecycle behavior.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-005","sourceId":"V21-CAT-005","pack":"video21","topic":"Rollback design","title":"Rollback design","prompt":"An approved pilot changes paths and metadata in place. The owner proposes rollback by reversing only a notebook query string. What is missing?","type":"single","options":[{"id":"A","text":"A supported rollback/recovery plan for data paths, metadata and consumers","why":"A state-changing migration can affect several layers; restoring a query string is insufficient."},{"id":"B","text":"Only a new notebook title","why":"The title does not restore state."},{"id":"C","text":"Only a screenshot of the checkbox","why":"A screenshot is not a recovery mechanism."},{"id":"D","text":"Only a wider SQL grant","why":"Permissions cannot reverse all structural changes."}],"correct":["A"],"explanation":"A state-changing migration can affect several layers; restoring a query string is insufficient.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-006","sourceId":"V21-CAT-006","pack":"video21","topic":"Principal validation","title":"Principal validation","prompt":"After a catalog-related change, the administrator can read all tables. Ordinary restricted readers were not tested. Which TWO tests are required for acceptance?","type":"multi","options":[{"id":"A","text":"Denied reads and policy-sensitive row/column results","why":"Negative and filtered tests establish intended boundaries."},{"id":"B","text":"Only count administrator-visible schemas","why":"Administrator visibility is not reader policy evidence."},{"id":"C","text":"Only confirm the API returned 200","why":"An API response does not prove authorization behavior."},{"id":"D","text":"Allowed reads for representative restricted principals","why":"Positive tests establish intended usability."}],"correct":["A","D"],"explanation":"Positive tests establish intended usability. Negative and filtered tests establish intended boundaries.","videoSeconds":780,"refs":["vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=780s"},{"id":"fb-v21-cat-007","sourceId":"V21-CAT-007","pack":"video21","topic":"Catalog performance claim","title":"Catalog performance claim","prompt":"The interview says new catalog metadata appears faster. A manager forecasts all business queries will now be twice as fast. What is the correct review finding?","type":"single","options":[{"id":"A","text":"Schema names determine scan throughput","why":"Naming does not determine physical scan throughput."},{"id":"B","text":"Metadata discovery improvement does not establish a general query-speed multiplier","why":"Discovery and query execution are different measures; benchmark both separately."},{"id":"C","text":"Catalog choice eliminates all joins","why":"Query logic remains necessary."},{"id":"D","text":"The claim guarantees every query latency","why":"No such guaranteed multiplier is established."}],"correct":["B"],"explanation":"Discovery and query execution are different measures; benchmark both separately.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-008","sourceId":"V21-CAT-008","pack":"video21","topic":"Missing configuration name","title":"Missing configuration name","prompt":"The transcript mentions setting a Spark property to true but omits its exact name. A deployment must be reproducible. Which response is appropriate?","type":"single","options":[{"id":"A","text":"Obtain the exact supported setting and runtime guidance from official instructions","why":"Missing configuration evidence is a real limitation; verify before implementation."},{"id":"B","text":"Guess a plausible property and treat silent acceptance as proof","why":"Unknown properties can be accepted without implementing the desired capability."},{"id":"C","text":"Copy any unrelated Spark boolean setting","why":"Unrelated flags do not enable the documented feature."},{"id":"D","text":"Remove all environment settings","why":"Removing settings does not establish the intended catalog."}],"correct":["A"],"explanation":"Missing configuration evidence is a real limitation; verify before implementation.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-009","sourceId":"V21-CAT-009","pack":"video21","topic":"Qualification audit","title":"Qualification audit","prompt":"A codebase contains Lakehouse.table references and an approved move introduces dbo. Which inventory is most useful before switching?","type":"single","options":[{"id":"A","text":"Search only notebook filenames","why":"References exist inside code and other consumers."},{"id":"B","text":"Replace every dot with .dbo. blindly","why":"Blind substitutions can corrupt already-qualified references."},{"id":"C","text":"Resolve each reference under its actual catalog/default context and record the intended object","why":"Names depend on context; static replacement can target the wrong object."},{"id":"D","text":"Assume all two-part names mean schema.table","why":"Two-part interpretation is context-dependent."}],"correct":["C"],"explanation":"Names depend on context; static replacement can target the wrong object.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-010","sourceId":"V21-CAT-010","pack":"video21","topic":"Mixed query correctness","title":"Mixed query correctness","prompt":"A supported Spark session must join a schema-enabled source and a legacy source across workspaces. Which design principle avoids accidental default resolution?","type":"single","options":[{"id":"A","text":"Use bare table names for both sources","why":"Bare names can bind to unintended defaults."},{"id":"B","text":"Use supported explicit namespaces for each source and test the intended identities","why":"Explicit qualification documents intent while permissions remain independently required."},{"id":"C","text":"Grant admin to make ambiguous names resolve","why":"Privilege expansion does not repair ambiguous identity of objects."},{"id":"D","text":"Assume the first attached source is always correct","why":"Attachment order is not a reliable semantic contract."}],"correct":["B"],"explanation":"Explicit qualification documents intent while permissions remain independently required.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-011","sourceId":"V21-CAT-011","pack":"video21","topic":"Feature requirements","title":"Feature requirements","prompt":"An architect proposes keeping a Lakehouse non-schema while requiring MLV authoring and schema shortcuts there. What should the requirement review do?","type":"single","options":[{"id":"A","text":"Treat folder names as full schema enablement","why":"Folder appearance alone does not enable all catalog features."},{"id":"B","text":"Promise that future support already exists","why":"Roadmap discussion is not current availability."},{"id":"C","text":"Reconcile feature prerequisites with the chosen Lakehouse type","why":"Feature prerequisites constrain the design; choose a supported configuration."},{"id":"D","text":"Create only endpoint SQL schemas","why":"SQL namespace changes do not necessarily satisfy Lakehouse prerequisites."}],"correct":["C"],"explanation":"Feature prerequisites constrain the design; choose a supported configuration.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-012","sourceId":"V21-CAT-012","pack":"video21","topic":"Producer dependencies","title":"Producer dependencies","prompt":"A schema-enabled consumer references a producer domain. The producer will rename tables during a migration. What must be assessed?","type":"single","options":[{"id":"A","text":"Only producer row counts","why":"Counts do not prove dependency compatibility."},{"id":"B","text":"Only whether the consumer has an icon","why":"An icon does not establish target correctness."},{"id":"C","text":"Only the destination display name","why":"Names alone cannot prove resolution."},{"id":"D","text":"Downstream references, shortcut targets and consumer permissions","why":"Renames can affect interfaces and access independently of preserved rows."}],"correct":["D"],"explanation":"Renames can affect interfaces and access independently of preserved rows.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-013","sourceId":"V21-CAT-013","pack":"video21","topic":"Data preservation proof","title":"Data preservation proof","prompt":"A migration pilot reports identical table counts before and after. The acceptance requirement is no data loss. Which TWO stronger checks should be added?","type":"multi","options":[{"id":"A","text":"Treat table count as sufficient","why":"Equal object counts can hide missing records."},{"id":"B","text":"Schema and representative content verification against baseline","why":"Schema and content checks catch changed interpretation."},{"id":"C","text":"Stable-key/control-total reconciliation for each table","why":"Control totals test data preservation rather than only object presence."},{"id":"D","text":"Trust the shortest notebook runtime","why":"Fast execution is not correctness evidence."}],"correct":["B","C"],"explanation":"Control totals test data preservation rather than only object presence. Schema and content checks catch changed interpretation.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-014","sourceId":"V21-CAT-014","pack":"video21","topic":"Dataflow claim","title":"Dataflow claim","prompt":"The interview says dataflows need no update because they use endpoint metadata. A production dataflow uses a different configured access path. What is the correct action?","type":"single","options":[{"id":"A","text":"Delete the dataflow and recreate without baseline","why":"Destructive replacement is unjustified before inspection."},{"id":"B","text":"Inspect the actual connector and dependencies before applying the interview generalization","why":"A statement about one path cannot prove every consumer path is unaffected."},{"id":"C","text":"Assume every dataflow implementation is identical","why":"Connector behavior and dependencies differ."},{"id":"D","text":"Skip refresh validation","why":"Consumer execution is part of migration acceptance."}],"correct":["B"],"explanation":"A statement about one path cannot prove every consumer path is unaffected.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-015","sourceId":"V21-CAT-015","pack":"video21","topic":"Semantic model handoff","title":"Semantic model handoff","prompt":"The pilot updates Lakehouse representation and raw SQL reads pass, but reports fail. What is the best next diagnostic scope?","type":"single","options":[{"id":"A","text":"Only a retry of the migration API","why":"Blind retries can repeat a state change without repairing consumers."},{"id":"B","text":"Semantic-model source references, access path and refresh/query behavior","why":"Consumption-layer references may require separate handling and validation."},{"id":"C","text":"Only administrator Spark reads","why":"One engine success does not validate another layer."},{"id":"D","text":"Only the file browser row preview","why":"File preview does not test the model."}],"correct":["B"],"explanation":"Consumption-layer references may require separate handling and validation.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-016","sourceId":"V21-CAT-016","pack":"video21","topic":"Security-support statement","title":"Security-support statement","prompt":"The interview says legacy Lakehouses can use OneLake security with the appropriate catalog. Documentation and tenant behavior need confirmation. Which TWO statements are defensible?","type":"multi","options":[{"id":"A","text":"Assume any access error proves the user needs Admin","why":"An access error can have several causes."},{"id":"B","text":"Test actual policies with supported reader paths","why":"Tests establish whether allowed and restricted behavior match requirements."},{"id":"C","text":"Treat catalog/runtime support as a prerequisite to verify","why":"Feature claims need the applicable runtime and access model."},{"id":"D","text":"Remove policies to simplify acceptance","why":"Removing restrictions changes the acceptance target."}],"correct":["B","C"],"explanation":"Feature claims need the applicable runtime and access model. Tests establish whether allowed and restricted behavior match requirements.","videoSeconds":780,"refs":["vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=780s"},{"id":"fb-v21-cat-017","sourceId":"V21-CAT-017","pack":"video21","topic":"Support lifecycle","title":"Support lifecycle","prompt":"The interview says both Lakehouse types remain supported. A team wants an immediate mandatory migration deadline. What evidence is needed?","type":"single","options":[{"id":"A","text":"Only a notebook warning unrelated to retirement","why":"An unrelated warning does not establish deprecation."},{"id":"B","text":"Only a screenshot of a preview feature","why":"A feature screenshot does not define lifecycle."},{"id":"C","text":"An authoritative dated lifecycle/deprecation announcement, if one exists","why":"A support deadline requires lifecycle evidence."},{"id":"D","text":"Only the speakers preference for new projects","why":"A recommendation is not a retirement date."}],"correct":["C"],"explanation":"A support deadline requires lifecycle evidence.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-018","sourceId":"V21-CAT-018","pack":"video21","topic":"New versus existing workload","title":"New versus existing workload","prompt":"A stable legacy workload meets its SLA. A new project requires schema-level organization. Which recommendation best fits?","type":"single","options":[{"id":"A","text":"Treat both decisions as requiring identical risk","why":"Existing dependencies change the cost/risk profile."},{"id":"B","text":"Migrate everything immediately because schemas exist","why":"Availability of a feature is not a universal urgent migration reason."},{"id":"C","text":"Keep all new projects legacy regardless of requirements","why":"The new requirement calls for schema functionality."},{"id":"D","text":"Evaluate migration benefits/cost separately for the stable workload and choose supported schemas for the new requirement","why":"The stated constraints differ; recommendations should reflect them."}],"correct":["D"],"explanation":"The stated constraints differ; recommendations should reflect them.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-019","sourceId":"V21-CAT-019","pack":"video21","topic":"Metadata source of truth","title":"Metadata source of truth","prompt":"A developer manually edits catalog metadata to point to an arbitrary folder and calls this equivalent to the supported switch. What should the reviewer require?","type":"single","options":[{"id":"A","text":"Only an SQL alias","why":"Aliases do not repair underlying metadata."},{"id":"B","text":"Only a successful file listing","why":"Listing files does not validate logical table registration."},{"id":"C","text":"Supported migration procedures and state reconciliation instead of undocumented edits","why":"Catalog and storage consistency needs supported operations."},{"id":"D","text":"Only a new display name","why":"Labels do not establish schema enablement."}],"correct":["C"],"explanation":"Catalog and storage consistency needs supported operations.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-020","sourceId":"V21-CAT-020","pack":"video21","topic":"Qualified reference fixture","title":"Qualified reference fixture","prompt":"A migration test currently checks only SELECT COUNT(*) without recording the resolved source. Two same-named tables have equal counts. Which improvement detects misbinding?","type":"single","options":[{"id":"A","text":"Check explicit namespace plus known key/value sentinels","why":"Object identity and representative content catch equal-count wrong-table reads."},{"id":"B","text":"Only compare notebook titles","why":"Titles do not prove resolution."},{"id":"C","text":"Only sort the count result","why":"Sorting a scalar does not identify a source."},{"id":"D","text":"Only repeat the count","why":"Repetition cannot distinguish equally sized sources."}],"correct":["A"],"explanation":"Object identity and representative content catch equal-count wrong-table reads.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-021","sourceId":"V21-CAT-021","pack":"video21","topic":"API allowlisting","title":"API allowlisting","prompt":"An interview participant provides a registration form for enabling a private migration API. What should be recorded in a runbook before any production use?","type":"single","options":[{"id":"A","text":"Tenant eligibility, approved endpoint/version, instructions, rollback and support contact","why":"A controlled feature needs traceable applicability and operational instructions."},{"id":"B","text":"Only the destination schema name","why":"A name does not define an API contract."},{"id":"C","text":"Only the short URL","why":"A link alone is not an executable supported procedure."},{"id":"D","text":"Only the guest job title","why":"A title does not prove tenant enablement."}],"correct":["A"],"explanation":"A controlled feature needs traceable applicability and operational instructions.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-022","sourceId":"V21-CAT-022","pack":"video21","topic":"Path consumers","title":"Path consumers","prompt":"A code audit finds both table-name reads and hard-coded Tables/Orders file paths. Why is rewriting only SQL identifiers insufficient?","type":"single","options":[{"id":"A","text":"Direct paths may also change when tables are reorganized under dbo","why":"Storage-path consumers are independent dependencies."},{"id":"B","text":"Every file path is an endpoint view","why":"Files and SQL views are different artifacts."},{"id":"C","text":"Path reads automatically follow every catalog rename","why":"A literal path need not be redirected by a logical catalog change."},{"id":"D","text":"Changing SQL grants repairs all paths","why":"Permissions do not rewrite paths."}],"correct":["A"],"explanation":"Storage-path consumers are independent dependencies.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-023","sourceId":"V21-CAT-023","pack":"video21","topic":"Default-session evidence","title":"Default-session evidence","prompt":"The same mixed-Lakehouse query passes in one notebook and fails name resolution in another with a different default Lakehouse. What should be compared first?","type":"single","options":[{"id":"A","text":"Only capacity display name","why":"A label alone does not establish runtime/capability."},{"id":"B","text":"Session catalog/runtime/environment and default source context","why":"The interview ties capabilities to session context; compare the actual configuration."},{"id":"C","text":"Only notebook cell color","why":"Visual formatting does not control resolution."},{"id":"D","text":"Only output font size","why":"Font size is unrelated."}],"correct":["B"],"explanation":"The interview ties capabilities to session context; compare the actual configuration.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-024","sourceId":"V21-CAT-024","pack":"video21","topic":"No-default session","title":"No-default session","prompt":"A team removes the default Lakehouse to evaluate a documented supported catalog path. What must its regression tests then verify?","type":"single","options":[{"id":"A","text":"Only that no data source is visible","why":"The UI state is not functional evidence."},{"id":"B","text":"Only that bare names still look short","why":"Concise names can become ambiguous or invalid."},{"id":"C","text":"Only the notebook filename","why":"Filenames do not validate bindings."},{"id":"D","text":"Explicitly qualified source binding and all required permissions","why":"Removing defaults changes resolution context; test intended sources deliberately."}],"correct":["D"],"explanation":"Removing defaults changes resolution context; test intended sources deliberately.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-025","sourceId":"V21-CAT-025","pack":"video21","topic":"Operational sequencing","title":"Operational sequencing","prompt":"An approved migration plan must coordinate producer and consumer changes without accidental mixed-state access. Which TWO safeguards help?","type":"multi","options":[{"id":"A","text":"A recorded baseline and rollback decision points","why":"A baseline and explicit decision points support recovery."},{"id":"B","text":"Ignoring downstream jobs during the switch","why":"Active consumers are dependencies, not irrelevant background work."},{"id":"C","text":"Concurrent uncoordinated edits by every team","why":"Uncoordinated changes increase uncertainty."},{"id":"D","text":"A rehearsed sequence with checkpoints and stop criteria","why":"A sequence reduces partially updated state and establishes acceptance gates."}],"correct":["A","D"],"explanation":"A sequence reduces partially updated state and establishes acceptance gates. A baseline and explicit decision points support recovery.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-026","sourceId":"V21-CAT-026","pack":"video21","topic":"Roadmap interpretation","title":"Roadmap interpretation","prompt":"The guest discusses upcoming richer metadata for agent scenarios. A procurement specification lists it as delivered functionality. What should be corrected?","type":"single","options":[{"id":"A","text":"Label it roadmap discussion until current official availability is verified","why":"Roadmap context is useful but separate from released capability."},{"id":"B","text":"Assume a product-manager interview is an API contract","why":"Interviews are not complete compatibility contracts."},{"id":"C","text":"Use it as an unconditional exam answer","why":"Unverified release status should not control a definitive answer."},{"id":"D","text":"Treat every future-tense statement as GA","why":"Future discussion does not establish GA."}],"correct":["A"],"explanation":"Roadmap context is useful but separate from released capability.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-027","sourceId":"V21-CAT-027","pack":"video21","topic":"Catalog versus endpoint sync","title":"Catalog versus endpoint sync","prompt":"Spark discovers a table promptly after catalog change, but endpoint SQL metadata is still being refreshed. What is the correct inference?","type":"single","options":[{"id":"A","text":"New catalog guarantees every interface updates simultaneously","why":"Prompt Spark discovery is not a universal propagation SLA."},{"id":"B","text":"SQL must be querying a different storage copy","why":"Shared storage can have different interface metadata."},{"id":"C","text":"Delete and recreate the Lakehouse immediately","why":"Recreation is not justified by transient discovery alone."},{"id":"D","text":"Different interfaces can have distinct metadata publication behavior","why":"Test visibility per engine rather than equating their sync paths."}],"correct":["D"],"explanation":"Test visibility per engine rather than equating their sync paths.","videoSeconds":68,"refs":["endpoint"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-028","sourceId":"V21-CAT-028","pack":"video21","topic":"Security propagation test","title":"Security propagation test","prompt":"A new reader policy was just changed. The first endpoint query disagrees with Spark. What should the engineer check before declaring data corruption?","type":"single","options":[{"id":"A","text":"Actual endpoint mode, identity and policy synchronization","why":"Authorization and propagation can explain differences between surfaces."},{"id":"B","text":"Only table comment","why":"Comments do not enforce access."},{"id":"C","text":"Only physical file size","why":"File size does not diagnose policy evaluation."},{"id":"D","text":"Only number of folders","why":"Folder counts do not establish identity behavior."}],"correct":["A"],"explanation":"Authorization and propagation can explain differences between surfaces.","videoSeconds":780,"refs":["vref_f513e79bbf83ae3f"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=780s"},{"id":"fb-v21-cat-029","sourceId":"V21-CAT-029","pack":"video21","topic":"Boundary of schema enablement","title":"Boundary of schema enablement","prompt":"A team changes a Lakehouse to schema-enabled and expects business duplicates to disappear. Which response is justified?","type":"single","options":[{"id":"A","text":"Schemas automatically select the newest business row","why":"No such precedence rule follows from a namespace."},{"id":"B","text":"dbo removes duplicate values","why":"A schema name does not deduplicate rows."},{"id":"C","text":"Namespace changes do not replace data-quality transformation rules","why":"Organization and data-quality semantics are different layers."},{"id":"D","text":"Catalog changes enforce every business primary key","why":"Catalog selection is not a universal business-key constraint."}],"correct":["C"],"explanation":"Organization and data-quality semantics are different layers.","videoSeconds":68,"refs":["schemas"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=68s"},{"id":"fb-v21-cat-030","sourceId":"V21-CAT-030","pack":"video21","topic":"Production acceptance","title":"Production acceptance","prompt":"The switch script finishes in seconds on a small sample. The team proposes skipping checks for a large estate. What is the best review action?","type":"single","options":[{"id":"A","text":"Replace all source baselines with the new output","why":"Discarding baselines prevents reliable comparison."},{"id":"B","text":"Check only one administrator notebook","why":"One privileged path is insufficient."},{"id":"C","text":"Validate supported behavior and dependencies at representative scale rather than extrapolating script time alone","why":"Fast metadata operations do not prove complete dependency compatibility."},{"id":"D","text":"Approve because pointer operations prove all consumers work","why":"Physical speed is not consumer validation."}],"correct":["C"],"explanation":"Fast metadata operations do not prove complete dependency compatibility.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-031","sourceId":"V21-CAT-031","pack":"video21","topic":"Change inventory","title":"Change inventory","prompt":"A workspace contains notebooks, semantic models, shortcut consumers and deployment pipelines. Which TWO inventories are needed for a structural Lakehouse change?","type":"multi","options":[{"id":"A","text":"Security identities/policies and environment state","why":"Authorization and deployment state can change independently of rows."},{"id":"B","text":"Logical and physical references across consumers","why":"Dependencies include identifiers and explicit paths."},{"id":"C","text":"Only Lakehouse names","why":"Names alone omit consumer bindings."},{"id":"D","text":"Only the newest notebook","why":"The newest artifact is not the entire estate."}],"correct":["A","B"],"explanation":"Dependencies include identifiers and explicit paths. Authorization and deployment state can change independently of rows.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"catalog-validation","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"},{"id":"fb-v21-cat-032","sourceId":"V21-CAT-032","pack":"video21","topic":"Evidence conflict resolution","title":"Evidence conflict resolution","prompt":"Public documentation says migration tooling is unavailable, while a video demonstrates an allowlisted switch. Which statement belongs in the study bank?","type":"single","options":[{"id":"A","text":"All users can run the switch without prerequisites","why":"That exceeds the availability evidence."},{"id":"B","text":"The documentation proves the demonstration never occurred","why":"A documentation gap does not disprove a conditional demonstration."},{"id":"C","text":"The interview must be ignored entirely","why":"The demonstration is relevant evidence with limitations."},{"id":"D","text":"The video describes a conditional path; general availability is unverified","why":"Preserve both evidence streams and scope the claim to what they establish."}],"correct":["D"],"explanation":"Preserve both evidence streams and scope the claim to what they establish.","videoSeconds":993,"refs":["schemas","vref_7920e40251daec0b"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"migration-board","sourceObjective":"Maintain a data analytics solution > Maintain the analytics development lifecycle; Prepare data > Get data / Transform data","provenance":"Original advanced practice; not official or recalled exam material. Timestamp is a thematic anchor, not an assertion all answer details are spoken there.","validation":"Official references reviewed 2026-10-24; live Fabric execution NOT TESTED","sourceVideoUrl":"https://www.youtube.com/watch?v=McWGhWagCXw&t=993s"}]
