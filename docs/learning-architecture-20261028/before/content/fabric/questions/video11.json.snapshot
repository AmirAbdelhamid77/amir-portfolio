[{"id":"fb-v11-choose-001","sourceId":"V11-CHOOSE-001","pack":"video11","topic":"Tools / continuous ingestion","title":"Tools / continuous ingestion","prompt":"ICU monitors send observations continuously. Nurses need low-code filtering before writing a historical Delta table. Compliance analysts later combine that historical data with CSV corrections using Power Query M. What is the most appropriate pair? (Select one answer.)","type":"single","options":[{"id":"A","text":"Copy activity then a Warehouse stored procedure","why":"Incorrect: Copy activity is not a native continuous event processor and SQL transformations fail the stated M preference."},{"id":"B","text":"Eventstream to Lakehouse, followed by Dataflow Gen2","why":"Correct: Matches both no-code streaming and Power Query cleaning requirements."},{"id":"C","text":"Dataflow Gen2 scheduled refresh and Eventhouse only","why":"Incorrect: Scheduled Dataflow refresh is not a substitute for processing every arriving event."},{"id":"D","text":"Spark Structured Streaming followed by a Power BI calculated table","why":"Incorrect: Spark is code-first; calculated tables are not a Power Query ingestion solution."}],"correct":["B"],"explanation":"Use Eventstream for near-real-time filtering and delivery to a Lakehouse, and Dataflow Gen2 for M-based historical preparation.","videoSeconds":1003,"refs":["vref_0b990ed020ff7e36","vref_51f8bef150248513","vref_e2df90d25000ea7c","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=1003s"},{"id":"fb-v11-choose-002","sourceId":"V11-CHOOSE-002","pack":"video11","topic":"Tools / Python and streaming","title":"Tools / Python and streaming","prompt":"Wearables emit temperature readings every second. Real-time threshold filtering must be configured with low-code UI. Monthly trend classification must run a custom Python machine-learning library. Select the minimal processing combination. (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventstream plus Spark notebook/job","why":"Correct: two engines map to separate streaming and Python requirements."},{"id":"B","text":"Dataflow Gen2 only","why":"Incorrect: A Dataflow does not replace custom Python Spark execution or streaming transforms."},{"id":"C","text":"Copy activity plus Power Query M","why":"Incorrect: Copy activity offers neither continuous stream filtering nor flexible Python processing."},{"id":"D","text":"Eventhouse only","why":"Incorrect: Eventhouse supports KQL analytics, not arbitrary Spark/Python-library execution alone."}],"correct":["A"],"explanation":"Eventstream provides low-code streaming transformations, while Spark runs the Python analytics component.","videoSeconds":1161,"refs":["vref_0b990ed020ff7e36","vref_51f8bef150248513","vref_9bc6e0fd33118950","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=1161s"},{"id":"fb-v11-choose-003","sourceId":"V11-CHOOSE-003","pack":"video11","topic":"Tools / copy versus transformation","title":"Tools / copy versus transformation","prompt":"A nightly workload copies 45 tables from a supported SQL source to a Lakehouse. Required preprocessing consists only of column mapping and format conversion. Choose the simplest principal ingestion tool. (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventstream processors","why":"Incorrect: Eventstreams optimize continuously arriving events, not this overnight table copy."},{"id":"B","text":"Dataflow Gen2 with multiple heavy M joins","why":"Incorrect: Dataflow works but adds unnecessary transformation complexity where copying is enough."},{"id":"C","text":"Spark Structured Streaming","why":"Incorrect: Structured Streaming is unnecessary for scheduled tabular loads."},{"id":"D","text":"Data pipeline Copy activity","why":"Correct: copy is sufficient and can be scheduled in a pipeline."}],"correct":["D"],"explanation":"Copy activity supports straightforward batch movement and limited mapping with orchestration around it.","videoSeconds":77,"refs":["vref_5115f35de51b4c55","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=77s"},{"id":"fb-v11-choose-004","sourceId":"V11-CHOOSE-004","pack":"video11","topic":"Tools / Power Query skill","title":"Tools / Power Query skill","prompt":"A team of analysts only knows Power Query. They must perform multi-step merges, remove duplicates, standardize text, and load a curated output into a supported Fabric destination without custom code. (Select one answer.)","type":"single","options":[{"id":"A","text":"Warehouse-only stored procedures","why":"Incorrect: This relies on T-SQL expertise the team lacks and may not fit multiple sources."},{"id":"B","text":"Eventstream filter nodes","why":"Incorrect: Eventstream filtering is oriented to events rather than historical M transformations."},{"id":"C","text":"Dataflow Gen2","why":"Correct: Dataflow Gen2 matches both skill and complex transformations."},{"id":"D","text":"Pipeline Copy activity with basic mapping","why":"Incorrect: Copy activity transformations are comparatively limited."}],"correct":["C"],"explanation":"Dataflow Gen2 has a Power Query M transformation canvas suited to multi-step analyst-managed cleansing.","videoSeconds":232,"refs":["exam","dataflow","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=232s"},{"id":"fb-v11-choose-005","sourceId":"V11-CHOOSE-005","pack":"video11","topic":"Tools / orchestration boundary","title":"Tools / orchestration boundary","prompt":"A process first copies dimensions, then runs an M cleaning step, then triggers a Spark notebook and finally alerts operators on failure. Which Fabric item is the orchestration control plane? (Select one answer.)","type":"single","options":[{"id":"A","text":"Data pipeline with activities and dependencies","why":"Correct: orchestration is a pipeline strength."},{"id":"B","text":"Eventhouse materialized views","why":"Incorrect: An eventhouse is an analytics store, not a general pipeline scheduler."},{"id":"C","text":"A single copy activity with built-in ML and M actions","why":"Incorrect: Copy activity does not encapsulate arbitrary notebook and Dataflow transformations itself."},{"id":"D","text":"The Lakehouse SQL analytics endpoint","why":"Incorrect: The Lakehouse SQL endpoint is read-only for table data and not an orchestration engine."}],"correct":["A"],"explanation":"A pipeline coordinates other activities/items and expresses dependencies; those called tools do their actual transformation work.","videoSeconds":77,"refs":["exam","vref_5115f35de51b4c55","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=77s"},{"id":"fb-v11-choose-006","sourceId":"V11-CHOOSE-006","pack":"video11","topic":"Tools / Spark execution","title":"Tools / Spark execution","prompt":"Data engineers have production-tested PySpark code for feature engineering; users do not require interactive cells, but they do require automated runs without redesigning the transformations. Which approach best preserves the implementation? (Select one answer.)","type":"single","options":[{"id":"A","text":"Reimplement algorithms as Eventstream nodes","why":"Incorrect: Eventstream nodes do not provide the same arbitrary Spark-library environment."},{"id":"B","text":"Run Spark code using a Spark job or orchestrated notebook","why":"Correct: Spark code can run outside the interactive notebook experience."},{"id":"C","text":"Move all transformations into Copy activity column mapping","why":"Incorrect: Copy activity cannot express general feature engineering code."},{"id":"D","text":"Rely only on the Lakehouse SQL analytics endpoint","why":"Incorrect: The SQL endpoint does not execute PySpark computations."}],"correct":["B"],"explanation":"Spark jobs or notebooks preserve Python/Spark code and can be orchestrated; interactive notebook UI is not essential to compute.","videoSeconds":160,"refs":["vref_9bc6e0fd33118950","lakehouse","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=160s"},{"id":"fb-v11-choose-007","sourceId":"V11-CHOOSE-007","pack":"video11","topic":"Tools / ingestion scheduling","title":"Tools / ingestion scheduling","prompt":"An architect argues that a pipeline is always streaming because a trigger can start whenever a file is deposited. What is the most accurate assessment? (Select one answer.)","type":"single","options":[{"id":"A","text":"A file-arrival trigger converts batch copy into a stateful stream processor","why":"Incorrect: A trigger determines start conditions; it does not change Copy activity into streaming compute."},{"id":"B","text":"All Copy activities automatically provide KQL windows","why":"Incorrect: KQL windowing is not injected into Copy activities."},{"id":"C","text":"Triggers are irrelevant to Data Factory pipelines","why":"Incorrect: Pipeline triggers matter for when runs execute."},{"id":"D","text":"Event-triggered batch execution is different from continuous eventstream processing","why":"Correct: differentiate orchestration triggers from persistent streaming ingestion."}],"correct":["D"],"explanation":"Triggering a copy when an event occurs still launches discrete pipeline activity; it does not provide Eventstream semantics.","videoSeconds":350,"refs":["vref_0b990ed020ff7e36","vref_5115f35de51b4c55"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=350s"},{"id":"fb-v11-choose-008","sourceId":"V11-CHOOSE-008","pack":"video11","topic":"Tools / low-code routing","title":"Tools / low-code routing","prompt":"Trucks publish JSON telemetry through an Azure Event Hubs source. The team must discard nonsafety events before landing qualified events in Lakehouse Delta tables and use no Python in that ingestion path. (Select one answer.)","type":"single","options":[{"id":"A","text":"Dataflow Gen2 on a once-daily schedule","why":"Incorrect: A scheduled refresh cannot deliver ingestion-time filtering for active streams."},{"id":"B","text":"Eventstream with event processing and Lakehouse destination","why":"Correct: supported streaming flow with Delta Lakehouse destination."},{"id":"C","text":"A Warehouse T-SQL trigger writing to OneLake Files","why":"Incorrect: SQL Warehouse triggers are not a generic Event Hubs-to-Lakehouse ingestion mechanism."},{"id":"D","text":"A Power BI import semantic model as the sole ingestion sink","why":"Incorrect: Power BI import is not the required raw-event Delta landing path."}],"correct":["B"],"explanation":"Eventstream transformation nodes and a Lakehouse destination fit real-time low-code processing and persist Delta outputs.","videoSeconds":401,"refs":["vref_0b990ed020ff7e36","vref_51f8bef150248513","dataflow","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=401s"},{"id":"fb-v11-choose-009","sourceId":"V11-CHOOSE-009","pack":"video11","topic":"Tools / historical and real-time","title":"Tools / historical and real-time","prompt":"For years of archived telematics files, analysts need graphical complex joins and type cleaning. Separately, a live vehicle geofence feed requires seconds-level filtering. Which pair properly separates the workloads? (Select one answer.)","type":"single","options":[{"id":"A","text":"Dataflow Gen2 for historical batches; Eventstream for live filtering","why":"Correct: each tool follows the shape and latency of its workload."},{"id":"B","text":"Eventstream for archives; Copy activity for live stream filtering","why":"Incorrect: The tools are assigned backwards relative to their strengths."},{"id":"C","text":"Warehouse stored procedures for both live Kafka filtering and historical M","why":"Incorrect: T-SQL transformations are not an Eventstream input replacement."},{"id":"D","text":"One Spark notebook only because UI-driven transformation cannot use two services","why":"Incorrect: Spark may implement both but violates the stated visual/no-code approach where appropriate."}],"correct":["A"],"explanation":"Dataflow Gen2 addresses visual batch transformation; Eventstream handles live event routing/filtering.","videoSeconds":282,"refs":["vref_0b990ed020ff7e36","vref_51f8bef150248513","exam","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=282s"},{"id":"fb-v11-choose-010","sourceId":"V11-CHOOSE-010","pack":"video11","topic":"Tools / custom real-time computations","title":"Tools / custom real-time computations","prompt":"A stream must compute complex stateful Python features across arriving events using external Spark libraries. The team is comfortable writing code. Which processing engine fits best? (Select one answer.)","type":"single","options":[{"id":"A","text":"Data pipeline Copy activity","why":"Incorrect: Copy activity is not a stateful streaming processor."},{"id":"B","text":"Dataflow Gen2 scheduled execution","why":"Incorrect: Dataflows are batch-style and M-based rather than arbitrary streaming Python."},{"id":"C","text":"Spark Structured Streaming","why":"Correct: Spark provides a suitable streaming code engine."},{"id":"D","text":"Lakehouse SQL analytics endpoint stored procedure","why":"Incorrect: The Lakehouse SQL endpoint does not run stored procedures that mutate stream state."}],"correct":["C"],"explanation":"Spark Structured Streaming supports code-driven streaming computation with state and custom libraries as applicable.","videoSeconds":350,"refs":["vref_9bc6e0fd33118950","lakehouse","dataflow","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=350s"},{"id":"fb-v11-choose-011","sourceId":"V11-CHOOSE-011","pack":"video11","topic":"Tools / alerting versus storage","title":"Tools / alerting versus storage","prompt":"A dispatch office wants immediate notifications when incoming refrigerated-container readings exceed thresholds. The same events must be retained for later SQL-based reporting. What is the best composition? (Select one answer.)","type":"single","options":[{"id":"A","text":"Use Activator alone as historical SQL storage","why":"Incorrect: Activator automates actions but is not the requested historical storage."},{"id":"B","text":"Use Eventstream to route to Lakehouse and an alerting path via Activator","why":"Correct: separate action and persistence paths."},{"id":"C","text":"Use only a Warehouse foreign key constraint for notifications","why":"Incorrect: A Warehouse constraint does not natively perform source stream routing and notifications."},{"id":"D","text":"Write KQL queries against a Power BI calculated column to emit the source events","why":"Incorrect: A calculated column is not an event-ingestion and notification mechanism."}],"correct":["B"],"explanation":"Eventstream routes processed events to suitable destinations and can integrate with Activator, while Lakehouse retains Delta data.","videoSeconds":442,"refs":["vref_0b990ed020ff7e36","vref_4690aa431eea69a8","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=442s"},{"id":"fb-v11-choose-012","sourceId":"V11-CHOOSE-012","pack":"video11","topic":"Tools / destination nuance","title":"Tools / destination nuance","prompt":"A reviewer states: “Eventstream can only output to Eventhouse, so low-code writes of filtered events to Lakehouse must be impossible.” Which response is accurate? (Select one answer.)","type":"single","options":[{"id":"A","text":"Correct; Lakehouse writes require Python Structured Streaming","why":"Incorrect: Spark is an alternative, not the only route to Lakehouse."},{"id":"B","text":"Correct; only Copy jobs can create Delta tables","why":"Incorrect: Copy job is not the unique path from event streams to Delta."},{"id":"C","text":"Incorrect; Eventstream supports Lakehouse destinations that convert events to Delta tables","why":"Correct: the video and official tutorial demonstrate this capability."},{"id":"D","text":"Incorrect; Eventstream writes only directly to a Warehouse T-SQL endpoint","why":"Incorrect: The proposed universal Warehouse endpoint replacement is unsupported."}],"correct":["C"],"explanation":"A Lakehouse is a documented Eventstream destination, with the incoming events written as Delta tables.","videoSeconds":428,"refs":["vref_51f8bef150248513","vref_0b990ed020ff7e36","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=428s"},{"id":"fb-v11-choose-013","sourceId":"V11-CHOOSE-013","pack":"video11","topic":"Storage / mixed formats","title":"Storage / mixed formats","prompt":"A market intelligence program needs to retain PDF research notes, image attachments, JSON news payloads, and structured prices together before later refinement. Which store is the appropriate raw landing zone? (Select one answer.)","type":"single","options":[{"id":"A","text":"Warehouse only","why":"Incorrect: Warehouse is SQL-first relational storage, not a general file area for PDFs/images."},{"id":"B","text":"SQL analytics endpoint of a Lakehouse","why":"Incorrect: The Lakehouse SQL endpoint queries tables, not arbitrary Files as relational tables."},{"id":"C","text":"Eventhouse as a general raw file drive","why":"Incorrect: Eventhouse works with event payloads, not as an arbitrary OneLake raw-files folder."},{"id":"D","text":"Lakehouse Files area","why":"Correct: retain heterogeneous raw assets in Lakehouse Files."}],"correct":["D"],"explanation":"Lakehouse Files is designed for raw unstructured and structured file assets; other stores target queryable datasets.","videoSeconds":576,"refs":["vref_e2df90d25000ea7c","vref_9bc6e0fd33118950","eastore"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=576s"},{"id":"fb-v11-choose-014","sourceId":"V11-CHOOSE-014","pack":"video11","topic":"Storage / SQL DML","title":"Storage / SQL DML","prompt":"A finance group must periodically execute T-SQL MERGE, update reporting facts, and maintain dimension tables with stored procedures. A developer proposes using the Lakehouse SQL analytics endpoint directly for those writes. Which destination should replace it? (Select one answer.)","type":"single","options":[{"id":"A","text":"Fabric Warehouse","why":"Correct: T-SQL DML workloads belong in Warehouse."},{"id":"B","text":"Eventstream","why":"Incorrect: Eventstream processes arriving events and is not a T-SQL warehouse."},{"id":"C","text":"Eventhouse SQL subset","why":"Incorrect: Eventhouse exposes limited SQL read patterns, not the same Warehouse DML surface."},{"id":"D","text":"A Lakehouse view defined over Files","why":"Incorrect: A view does not turn the Lakehouse SQL endpoint into a writable SQL warehouse."}],"correct":["A"],"explanation":"Warehouse is the principal Fabric store for T-SQL data manipulation and procedures; Lakehouse SQL analytics endpoints cannot perform table DML.","videoSeconds":576,"refs":["vref_e2df90d25000ea7c","vref_e52e15abde75f6a1","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=576s"},{"id":"fb-v11-choose-015","sourceId":"V11-CHOOSE-015","pack":"video11","topic":"Storage / atomicity","title":"Storage / atomicity","prompt":"A posting batch must update a Ledger and a LedgerAudit table as one all-or-nothing unit of work using T-SQL. The audit write can fail and must roll back the ledger update. What is the best analytical store? (Select one answer.)","type":"single","options":[{"id":"A","text":"Lakehouse Delta tables because each table has its own ACID commits","why":"Incorrect: Delta ACID guarantees are not the same as one transaction spanning arbitrary separate Lakehouse tables."},{"id":"B","text":"Eventstream retained messages","why":"Incorrect: Eventstream is not a transactional relational ledger."},{"id":"C","text":"Warehouse with a T-SQL multi-table transaction","why":"Correct: Warehouse can transact across the two tables."},{"id":"D","text":"Lakehouse SQL endpoint with two sequential INSERT statements","why":"Incorrect: Lakehouse SQL analytics endpoints do not support DML against Lakehouse tables."}],"correct":["C"],"explanation":"Warehouse provides SQL multi-table transactions to roll back dependent changes consistently.","videoSeconds":821,"refs":["vref_e2df90d25000ea7c","vref_9bc6e0fd33118950","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=821s"},{"id":"fb-v11-choose-016","sourceId":"V11-CHOOSE-016","pack":"video11","topic":"Storage / composite architecture","title":"Storage / composite architecture","prompt":"The data estate includes raw scanned reports, machine-learning text enrichment in Spark, and a governed BI star schema requiring T-SQL upserts. Select the most defensible architecture. (Select one answer.)","type":"single","options":[{"id":"A","text":"Lakehouse for raw/Spark, then Warehouse for the SQL-served star schema","why":"Correct: combine complementary Fabric items rather than force a single tool."},{"id":"B","text":"Warehouse only for PDFs and custom PySpark files","why":"Incorrect: Warehouse is not intended to be the raw arbitrary-file repository."},{"id":"C","text":"Eventhouse only for T-SQL multi-table postings","why":"Incorrect: Eventhouse is tailored to event analytics, not general warehouse T-SQL postings."},{"id":"D","text":"SQL analytics endpoint of Lakehouse for T-SQL updates","why":"Incorrect: The Lakehouse endpoint is read-only for its Delta tables."}],"correct":["A"],"explanation":"A Lakehouse handles files and Spark enrichment; a Warehouse supports the governed T-SQL relational serving layer.","videoSeconds":973,"refs":["vref_e2df90d25000ea7c","vref_e52e15abde75f6a1","lakehouse","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=973s"},{"id":"fb-v11-choose-017","sourceId":"V11-CHOOSE-017","pack":"video11","topic":"Storage / lakehouse SQL read","title":"Storage / lakehouse SQL read","prompt":"A PySpark process writes managed Delta tables into a Lakehouse. A reporting analyst needs read-only T-SQL SELECT access to those tables without exporting them. What should the architect enable/use? (Select one answer.)","type":"single","options":[{"id":"A","text":"A Warehouse stored procedure that copies the tables daily","why":"Incorrect: A copy to Warehouse is not required simply for T-SQL reading."},{"id":"B","text":"The Lakehouse SQL analytics endpoint","why":"Correct: built-in endpoint supports SQL analytics queries."},{"id":"C","text":"An Eventstream custom endpoint","why":"Incorrect: Eventstream custom output is unrelated to querying stored Lakehouse Delta."},{"id":"D","text":"A SQL database in Fabric as the mandatory intermediary","why":"Incorrect: An operational SQL database is not needed for this read-only consumption."}],"correct":["B"],"explanation":"The autogenerated Lakehouse SQL analytics endpoint exposes managed Delta tables for T-SQL reads.","videoSeconds":620,"refs":["vref_e2df90d25000ea7c","lakehouse","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=620s"},{"id":"fb-v11-choose-018","sourceId":"V11-CHOOSE-018","pack":"video11","topic":"Storage / warehouse and lakehouse delta","title":"Storage / warehouse and lakehouse delta","prompt":"An engineer says Warehouse and Lakehouse must use incompatible proprietary physical table formats, so combining them necessarily entails CSV exports. Choose the correct statement. (Select one answer.)","type":"single","options":[{"id":"A","text":"Warehouse stores all tables as CSV files in OneLake","why":"Incorrect: Warehouse physical storage is not primarily CSV."},{"id":"B","text":"Lakehouse is a T-SQL-only engine unlike Warehouse","why":"Incorrect: Lakehouse primary engineering is Spark; this reverses the tools."},{"id":"C","text":"Both use Delta-format storage in OneLake, but expose different primary write/development surfaces","why":"Correct: common open storage does not mean identical authoring semantics."},{"id":"D","text":"Neither supports shortcuts to other data","why":"Incorrect: Shortcuts and integrated access are part of the platform."}],"correct":["C"],"explanation":"Both support OneLake Delta data while maintaining different engine capabilities and management semantics.","videoSeconds":956,"refs":["vref_e2df90d25000ea7c","vref_9bc6e0fd33118950"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=956s"},{"id":"fb-v11-choose-019","sourceId":"V11-CHOOSE-019","pack":"video11","topic":"Storage / Eventhouse performance","title":"Storage / Eventhouse performance","prompt":"A SOC analyst must interactively slice billions of timestamped security events by host, time window, and IP to detect bursts and unusual spatial movement. Low-latency event queries matter more than relational postings. Select the primary store. (Select one answer.)","type":"single","options":[{"id":"A","text":"Warehouse for T-SQL multi-table rollbacks","why":"Incorrect: Relational postings are not the dominant workload here."},{"id":"B","text":"Lakehouse Files only","why":"Incorrect: Raw Lakehouse Files alone do not provide specialized KQL indexed event query patterns."},{"id":"C","text":"SQL database for per-row OLTP transactions","why":"Incorrect: OLTP is not the correct principal analytical model."},{"id":"D","text":"Eventhouse with KQL","why":"Correct: Eventhouse matches KQL real-time-event exploratory analysis."}],"correct":["D"],"explanation":"Eventhouse is optimized for event/time-series analytics and KQL, including geospatial and high-selectivity patterns.","videoSeconds":917,"refs":["vref_9bc6e0fd33118950","vref_e52e15abde75f6a1"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=917s"},{"id":"fb-v11-choose-020","sourceId":"V11-CHOOSE-020","pack":"video11","topic":"Eventhouse / eventstream roles","title":"Eventhouse / eventstream roles","prompt":"Streaming firewall records are ingested continuously; operations staff want to query last-five-minute spikes using KQL. Which two items represent ingest/processing and specialized event storage, respectively? (Select one answer.)","type":"single","options":[{"id":"A","text":"Warehouse and Dataflow Gen2","why":"Incorrect: These are batch/SQL BI building blocks not the ideal real-time event pair."},{"id":"B","text":"Eventstream and Eventhouse","why":"Correct: distinct pipeline-like event transport and a KQL store."},{"id":"C","text":"Lakehouse SQL endpoint and Copy activity","why":"Incorrect: A lakehouse read endpoint does not capture events as a stream."},{"id":"D","text":"Activator and Notebook only","why":"Incorrect: Alerts and notebooks do not by themselves provide the named event storage design."}],"correct":["B"],"explanation":"Eventstream is the no-code streaming ingestion/transform item; Eventhouse is the KQL analytics storage engine.","videoSeconds":662,"refs":["vref_0b990ed020ff7e36","vref_4690aa431eea69a8","dataflow","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=662s"},{"id":"fb-v11-choose-021","sourceId":"V11-CHOOSE-021","pack":"video11","topic":"Query / KQL versus SQL","title":"Query / KQL versus SQL","prompt":"A team must use KQL functions for time windows and geospatial joins on retained telemetry. Which statement is most accurate? (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventhouse is the natural KQL store; its T-SQL support is limited relative to Fabric Warehouse","why":"Correct: language affinity and SQL limitations both matter."},{"id":"B","text":"Warehouse supplies an Eventhouse-equivalent KQL surface by default for all queries","why":"Incorrect: Warehouse and KQL engine workloads differ; an optional Eventhouse endpoint is a distinct access path."},{"id":"C","text":"Lakehouse SQL analytics endpoint supports KQL as T-SQL stored procedures","why":"Incorrect: The Lakehouse SQL endpoint speaks T-SQL rather than directly executing KQL procedures."},{"id":"D","text":"Eventhouse is exclusively T-SQL and has no KQL features","why":"Incorrect: Eventhouse is specifically KQL-oriented."}],"correct":["A"],"explanation":"Eventhouse natively targets KQL event analytics and also exposes restricted SQL access; do not assume Warehouse-equivalent SQL write semantics.","videoSeconds":743,"refs":["vref_9bc6e0fd33118950","vref_e52e15abde75f6a1"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Query and analyze data — Query with SQL/KQL","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=743s"},{"id":"fb-v11-choose-022","sourceId":"V11-CHOOSE-022","pack":"video11","topic":"Eventhouse / role and row security","title":"Eventhouse / role and row security","prompt":"A security architect sees a training slide describing “Eventhouse = row security only” and concludes Eventhouse cannot limit access to tables or objects. Which correction is supported by current Microsoft guidance? (Select one answer.)","type":"single","options":[{"id":"A","text":"Correct: Eventhouse cannot apply any object-level authorization","why":"Incorrect: The object-level conclusion is outdated or too broad."},{"id":"B","text":"Correct: only Warehouse can apply row filters","why":"Incorrect: Eventhouse does have row-oriented access controls."},{"id":"C","text":"Eventhouse can use object-level and row-level controls; column-level support must not be assumed equivalent to Warehouse","why":"Correct: security support varies by control/engine; do not generalize column level."},{"id":"D","text":"A Lakehouse SQL endpoint is required for every Eventhouse KQL query","why":"Incorrect: Eventhouse has its own KQL query experience."}],"correct":["C"],"explanation":"Current analytical-store guidance documents Eventhouse object- and row-level permissions; the video comparison was over-compressed.","videoSeconds":876,"refs":["vref_9bc6e0fd33118950"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=876s"},{"id":"fb-v11-choose-023","sourceId":"V11-CHOOSE-023","pack":"video11","topic":"Eventhouse / OneLake integration","title":"Eventhouse / OneLake integration","prompt":"A governance team assumes Eventhouse tables are automatically exposed into OneLake exactly like Warehouse Delta tables, without any configuration or possible latency. What is the defensible correction? (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventhouse cannot integrate with OneLake in any supported fashion","why":"Incorrect: The platform documents a OneLake integration route."},{"id":"B","text":"Enable Eventhouse OneLake availability/integration as applicable; account for publication and latency characteristics","why":"Correct: unlike Warehouse/Lakehouse, Eventhouse OneLake availability has configuration considerations."},{"id":"C","text":"Change the database into a Warehouse to keep using KQL","why":"Incorrect: Warehouse is not a replacement for KQL-centric queries."},{"id":"D","text":"Disable all KQL and query Eventhouse with Spark as the main write API","why":"Incorrect: Disabling KQL is counter to the user requirement and engine design."}],"correct":["B"],"explanation":"Microsoft distinguishes Eventhouse OneLake availability as opt-in and notes publication may introduce delay.","videoSeconds":946,"refs":["vref_e52e15abde75f6a1","vref_9bc6e0fd33118950","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=946s"},{"id":"fb-v11-choose-024","sourceId":"V11-CHOOSE-024","pack":"video11","topic":"Storage / transaction limits","title":"Storage / transaction limits","prompt":"An architect proposes using two separate Lakehouse Delta-table writes and claims: “Because Delta is ACID, a failure in the second guarantees the first will roll back.” What is the best response? (Select one answer.)","type":"single","options":[{"id":"A","text":"False; atomicity of each Delta commit does not create an automatic multi-table rollback","why":"Correct: no automatic cross-table rollback merely from Delta ACID."},{"id":"B","text":"True; every Spark job is automatically atomic across all managed Delta tables","why":"Incorrect: Spark orchestration does not implicitly coordinate an arbitrary global transaction."},{"id":"C","text":"True if both Delta tables are visible through one Lakehouse SQL endpoint","why":"Incorrect: SQL read exposure does not change underlying transactional write scope."},{"id":"D","text":"True only if an Eventstream triggers the notebook","why":"Incorrect: Event-trigger conditions do not confer transactional atomicity."}],"correct":["A"],"explanation":"Lakehouse Delta transactions are generally table-scoped; cross-table T-SQL transaction guarantees favor Warehouse.","videoSeconds":821,"refs":["vref_e2df90d25000ea7c","vref_9bc6e0fd33118950","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=821s"},{"id":"fb-v11-choose-025","sourceId":"V11-CHOOSE-025","pack":"video11","topic":"Storage / Spark writes into warehouse","title":"Storage / Spark writes into warehouse","prompt":"A Microsoft Fabric Runtime 2.0 engineer says a Spark DataFrame can never write to a Fabric Warehouse under any circumstance because the original video’s comparison favors only T-SQL. What is the accurate review outcome? (Select one answer.)","type":"single","options":[{"id":"A","text":"The claim is universally correct for all current runtimes","why":"Incorrect: Official current docs describe exceptions to this categorical claim."},{"id":"B","text":"Spark can only write to Lakehouse SQL endpoint with INSERT","why":"Incorrect: Lakehouse SQL endpoints are still not arbitrary DML destinations."},{"id":"C","text":"Write into Warehouse by directly overwriting its managed Delta files with a Spark file API, bypassing the Warehouse connector","why":"Incorrect: Direct manipulation of Warehouse managed files is not equivalent to a supported connector write."},{"id":"D","text":"The current Fabric Warehouse Spark connector documents write modes with Runtime 2.0, subject to connector constraints","why":"Correct: supported write path exists with runtime and connector caveats."}],"correct":["D"],"explanation":"The documented Spark connector now supports Warehouse writes in Runtime 2.0; this qualifies a previously useful but overly absolute heuristic.","videoSeconds":777,"refs":["wspark","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=777s"},{"id":"fb-v11-choose-026","sourceId":"V11-CHOOSE-026","pack":"video11","topic":"Tools / connector identity caveat","title":"Tools / connector identity caveat","prompt":"A nightly service-principal notebook is designed around the documented Fabric Warehouse Spark connector. An engineer assumes the connector authenticates unattended using the service principal exactly as an interactive developer session would. What is the critical issue? (Select one answer.)","type":"single","options":[{"id":"A","text":"Warehouse no longer supports SQL queries","why":"Incorrect: Warehouse supports SQL read/query patterns."},{"id":"B","text":"Spark connector is a general PostgreSQL client","why":"Incorrect: This is a Fabric-native connector, not a generic PostgreSQL client."},{"id":"C","text":"The documented connector specifies interactive Entra user authentication, not service-principal support","why":"Correct: authentication is an operational constraint distinct from DataFrame write support."},{"id":"D","text":"Use a service-principal access token with this connector without validating its documented authentication restrictions","why":"Incorrect: An arbitrary service-principal token does not override a connector limitation explicitly restricting its authentication."}],"correct":["C"],"explanation":"The Warehouse Spark connector documentation explicitly cautions that only interactive Microsoft Entra user authentication is supported, so identity design needs review.","videoSeconds":777,"refs":["wspark","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=777s"},{"id":"fb-v11-choose-027","sourceId":"V11-CHOOSE-027","pack":"video11","topic":"Architecture / OLTP versus analytics","title":"Architecture / OLTP versus analytics","prompt":"A new customer-facing application has thousands of small concurrent updates, strong FK enforcement, and normalized OLTP tables. Leaders mistakenly prefer Warehouse because “it has SQL and ACID.” What is the more suitable primary operational store? (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventhouse because KQL windows imply OLTP constraints","why":"Incorrect: Eventhouse is optimized for analytical events, not relational OLTP."},{"id":"B","text":"Fabric SQL database for transactional application workload","why":"Correct: distinguish operational SQL database from analytical Warehouse."},{"id":"C","text":"Lakehouse Files with CSV record rewrites","why":"Incorrect: Files cannot provide transactional application database characteristics."},{"id":"D","text":"Warehouse because all T-SQL use cases require it","why":"Incorrect: Shared T-SQL language does not imply identical workload suitability."}],"correct":["B"],"explanation":"SQL database in Fabric targets OLTP transaction workloads; Warehouse is designed for large-scale analytical SQL workloads.","videoSeconds":973,"refs":["vref_9bc6e0fd33118950","vref_e52e15abde75f6a1"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=973s"},{"id":"fb-v11-choose-028","sourceId":"V11-CHOOSE-028","pack":"video11","topic":"Architecture / NoSQL need","title":"Architecture / NoSQL need","prompt":"An application stores globally distributed flexible JSON documents, requires low-latency transactional API lookups, and is not primarily building star-schema BI. Which Fabric-aligned store should be evaluated first? (Select one answer.)","type":"single","options":[{"id":"A","text":"Fabric Warehouse","why":"Incorrect: Warehouse is primarily structured SQL analytics."},{"id":"B","text":"Eventhouse as the only JSON-compatible store","why":"Incorrect: Eventhouse accepts flexible event payloads but is not a universal operational document database."},{"id":"C","text":"Lakehouse SQL endpoint","why":"Incorrect: The SQL analytics endpoint serves queryable Delta tables, not a general Cosmos operational API."},{"id":"D","text":"Cosmos DB in Fabric","why":"Correct: operational NoSQL is a different branch of the data-store decision tree."}],"correct":["D"],"explanation":"Fabric data-store decision guidance directs NoSQL and distributed operational document scenarios to Cosmos DB in Fabric.","videoSeconds":973,"refs":["vref_e52e15abde75f6a1"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=973s"},{"id":"fb-v11-choose-029","sourceId":"V11-CHOOSE-029","pack":"video11","topic":"Shortcuts / no-copy sharing","title":"Shortcuts / no-copy sharing","prompt":"A finance department already has governed Delta data in another accessible OneLake location. The analytics team needs an additional Lakehouse view of those files with no physical data duplication. What should be considered first? (Select one answer.)","type":"single","options":[{"id":"A","text":"Daily Copy activity into independent storage","why":"Incorrect: A daily copy creates a separately maintained replica."},{"id":"B","text":"OneLake shortcut to the accessible data","why":"Correct: Eventstream is for arriving events, not referencing a current dataset."},{"id":"C","text":"Eventstream continuously replaying the Delta files","why":"Incorrect: shortcut is the no-copy reuse primitive."},{"id":"D","text":"Warehouse T-SQL transactional replication","why":"Incorrect: Warehouse transactional operations do not implement this no-copy reference requirement."}],"correct":["B"],"explanation":"A OneLake shortcut references accessible data without duplicating its full physical bytes.","videoSeconds":905,"refs":["eastore","vref_5115f35de51b4c55","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=905s"},{"id":"fb-v11-choose-030","sourceId":"V11-CHOOSE-030","pack":"video11","topic":"Mirroring / transactional CDC","title":"Mirroring / transactional CDC","prompt":"An existing operational SQL database changes throughout the day. Analysts require an automatically maintained analytical copy in Fabric with minimal bespoke ETL. What mechanism best matches that source-of-truth relationship? (Select one answer.)","type":"single","options":[{"id":"A","text":"Mirroring an eligible supported operational database","why":"Correct: replication is what the business requires."},{"id":"B","text":"OneLake shortcut to its live transactional log without a compatible storage endpoint","why":"Incorrect: Shortcuts reference accessible data; they are not automatic replication from arbitrary OLTP tables."},{"id":"C","text":"Eventhouse KQL views as the source database writer","why":"Incorrect: KQL view design does not provide the requested operational database CDC replication by itself."},{"id":"D","text":"Power BI calculated table refreshed manually","why":"Incorrect: Calculated tables do not constitute continuous source replication."}],"correct":["A"],"explanation":"Mirroring replicates changes from supported operational sources into Fabric-managed analytics storage.","videoSeconds":973,"refs":["eastore","vref_5115f35de51b4c55"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=973s"},{"id":"fb-v11-choose-031","sourceId":"V11-CHOOSE-031","pack":"video11","topic":"Tools / CDC deletes","title":"Tools / CDC deletes","prompt":"A regulated SQL source emits inserts, updates and deletes. A team uses Copy job incremental mode and needs the destination to reflect deleted records. What must be true to meet the delete requirement? (Select one answer.)","type":"single","options":[{"id":"A","text":"An insert-time watermark is sufficient for physical deletions","why":"Incorrect: A watermark scan cannot observe a record that no longer exists."},{"id":"B","text":"Any incremental mode detects deletes even when source CDC is disabled","why":"Incorrect: Not all incremental modes have delete capture."},{"id":"C","text":"Use a connector/source that supports CDC with CDC enabled and an appropriate destination write method","why":"Correct: CDC is prerequisite for delete tracking in this strategy."},{"id":"D","text":"Use append-only mode and ignore delete events","why":"Incorrect: Append-only history does not automatically remove deleted rows from current-state destination."}],"correct":["C"],"explanation":"Documented Copy job CDC-based incremental copying handles deletes for supported sources, with appropriate merge/write semantics.","videoSeconds":493,"refs":["vref_427b57a6178e49f8","vref_6b2941f77d0c3294"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=493s"},{"id":"fb-v11-choose-032","sourceId":"V11-CHOOSE-032","pack":"video11","topic":"Tools / incremental-watermark failure","title":"Tools / incremental-watermark failure","prompt":"A nightly incremental Copy job tracks `LastModifiedUtc` on each source row. A row is hard-deleted during the day. Source CDC is unavailable. What happens under a watermark-only incremental strategy? (Select one answer.)","type":"single","options":[{"id":"A","text":"The hard delete is always inferred from changed timestamps","why":"Incorrect: Missing rows do not have a new watermark value to read."},{"id":"B","text":"The destination must automatically issue DELETE for the missing row","why":"Incorrect: Automatic delete capture is a CDC capability, not watermark logic."},{"id":"C","text":"The job is automatically converted into Eventstream","why":"Incorrect: The job remains a Copy job; stream processing is unrelated."},{"id":"D","text":"A deleted row is not detectable solely by scanning newer watermark values","why":"Correct: deleted source rows may persist at destination."}],"correct":["D"],"explanation":"Watermark-based incremental copying captures applicable inserts/updates but cannot discover physically deleted rows.","videoSeconds":493,"refs":["vref_6b2941f77d0c3294","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=493s"},{"id":"fb-v11-choose-033","sourceId":"V11-CHOOSE-033","pack":"video11","topic":"Tools / reset state and duplicates","title":"Tools / reset state and duplicates","prompt":"A Copy job incrementally appends new facts to a Lakehouse. After a source reconciliation issue, an operator resets incremental state and reruns without clearing or merging the target. What is the principal correctness risk? (Select one answer.)","type":"single","options":[{"id":"A","text":"Old records may be appended a second time after full reread","why":"Correct: reingestion and append require deduplication or target clearing/merge strategy."},{"id":"B","text":"Reset permanently drops the Lakehouse destination data","why":"Incorrect: Reset does not itself delete the existing target."},{"id":"C","text":"Reset activates automatic row-level delete reconciliation","why":"Incorrect: A reset is not a CDC delete-mirroring feature."},{"id":"D","text":"Reset implicitly changes the job into a Warehouse multi-table transaction","why":"Incorrect: Warehouse transactional rules are unrelated."}],"correct":["A"],"explanation":"Reset clears incremental tracking, not target content; append can duplicate records after a reread.","videoSeconds":493,"refs":["vref_6b2941f77d0c3294","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=493s"},{"id":"fb-v11-choose-034","sourceId":"V11-CHOOSE-034","pack":"video11","topic":"Tools / CDC history","title":"Tools / CDC history","prompt":"The business must preserve old and new versions of customer addresses while consuming source CDC, not merely overwrite current values. Which documented Copy job configuration best aligns? (Select one answer.)","type":"single","options":[{"id":"A","text":"Watermark-only plus Append with no business key","why":"Incorrect: Blind append does not implement correct validity periods and deletes."},{"id":"B","text":"CDC incremental Copy job with supported SCD Type 2 destination behavior","why":"Correct: use supported CDC + SCD Type 2 workflow."},{"id":"C","text":"Eventhouse as a forced non-KQL operational dimension table","why":"Incorrect: Eventhouse does not inherently implement relational Type 2 dimension management."},{"id":"D","text":"Pipeline Copy activity with only column-name mapping","why":"Incorrect: Simple mapping does not create versioning and effective-date history."}],"correct":["B"],"explanation":"Copy job supports CDC-driven Type 2 slowly changing dimension history on eligible connectors/destinations.","videoSeconds":493,"refs":["vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=493s"},{"id":"fb-v11-choose-035","sourceId":"V11-CHOOSE-035","pack":"video11","topic":"Tools / key-based updates","title":"Tools / key-based updates","prompt":"A source delivers revised customer rows on each run. The target should keep one current row per stable CustomerId; repeat runs must update existing rows. Which load semantics best fit, assuming supported connector and a trustworthy key? (Select one answer.)","type":"single","options":[{"id":"A","text":"Append all records without a key","why":"Incorrect: Append retains repeated versions as separate rows."},{"id":"B","text":"Daily full copy plus Eventstream alert only","why":"Incorrect: Full copy and alerting does not express key-based update behavior by itself."},{"id":"C","text":"SCD Type 2 even though history is forbidden","why":"Incorrect: Type 2 is for retaining history, contrary to current-state-only requirement."},{"id":"D","text":"Merge/upsert by stable customer key","why":"Correct: merge/upsert with key is the proper current-state load."}],"correct":["D"],"explanation":"Merge/upsert matches existing rows and updates them; append without keys would duplicate current records.","videoSeconds":493,"refs":["vref_427b57a6178e49f8","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=493s"},{"id":"fb-v11-choose-036","sourceId":"V11-CHOOSE-036","pack":"video11","topic":"Architecture / high-concurrency analytical","title":"Architecture / high-concurrency analytical","prompt":"A retail enterprise reports over a 500-million-row star schema with SQL-savvy developers, needs large aggregations and stored procedures, and has no raw files in the target model. What is the most defensible core serving store? (Select one answer.)","type":"single","options":[{"id":"A","text":"Lakehouse Files as the only query surface","why":"Incorrect: Files alone are not a SQL star-schema serving engine."},{"id":"B","text":"Fabric SQL database for tiny operational transactions despite analytic-only load","why":"Incorrect: OLTP-oriented SQL database is not first choice for very large analytical scans."},{"id":"C","text":"Fabric Warehouse","why":"Correct: Warehouse aligns SQL and structured analytics."},{"id":"D","text":"Eventstream as the star-schema SQL engine","why":"Incorrect: Eventstream is not a structured relational serving database."}],"correct":["C"],"explanation":"Warehouse is optimized for structured BI and T-SQL analytic transformations and serving.","videoSeconds":604,"refs":["vref_e2df90d25000ea7c","vref_9bc6e0fd33118950","vref_e52e15abde75f6a1","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=604s"},{"id":"fb-v11-choose-037","sourceId":"V11-CHOOSE-037","pack":"video11","topic":"Architecture / data store hybrid","title":"Architecture / data store hybrid","prompt":"A manufacturer requires IoT anomaly detection in seconds, long-term unstructured inspection photos, and SQL-authored monthly accounting marts. Which combination is architecturally coherent? (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventhouse for event analytics, Lakehouse for photos/Spark staging, Warehouse for T-SQL marts","why":"Correct: match each store to its strongest workload."},{"id":"B","text":"Warehouse only for photos, KQL windows, and accounting","why":"Incorrect: Warehouse is not best for unstructured archives and low-latency native KQL."},{"id":"C","text":"Eventhouse only because it can read JSON","why":"Incorrect: Eventhouse cannot replace raw-file storage and SQL warehouse transaction semantics."},{"id":"D","text":"Copy activity as the only durable analytical store","why":"Incorrect: Copy activity is data movement, not a data store."}],"correct":["A"],"explanation":"Different requirements justify specialized event analytics, raw-file engineering, and relational SQL BI serving layers.","videoSeconds":973,"refs":["vref_9bc6e0fd33118950","vref_e52e15abde75f6a1","vref_e2df90d25000ea7c","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=973s"},{"id":"fb-v11-choose-038","sourceId":"V11-CHOOSE-038","pack":"video11","topic":"Query / KQL window interpretation","title":"Query / KQL window interpretation","prompt":"An Eventhouse contains `TruckEvents(Timestamp:datetime, DeviceId:string, TemperatureC:real)`. An analyst runs this KQL query: `TruckEvents | where Timestamp >= ago(1h) | summarize Faults=countif(TemperatureC > 8) by DeviceId, bin(Timestamp, 5m)`. What does the result represent? (Select one answer.)","type":"single","options":[{"id":"A","text":"One record for every device on every 5-minute boundary, including boundaries with no source events","why":"Incorrect: `summarize` over existing records does not generate missing timestamp buckets unless explicitly padded."},{"id":"B","text":"A count of over-threshold readings for each device and 5-minute event-time bin among rows from the last hour; empty bins are not automatically created","why":"Correct: time-window filter, grouped timestamp bin, conditional count and missing-bin behavior must all be understood."},{"id":"C","text":"An automatically scheduled Eventstream output that writes five-minute threshold counts to a Lakehouse Delta table","why":"Incorrect: This is a query producing results, not a persistent Eventstream stream processor or storage sink."},{"id":"D","text":"A single row per DeviceId counting all events regardless of temperature or time bin","why":"Incorrect: This ignores both the Timestamp bin grouping and the countif temperature predicate."}],"correct":["B"],"explanation":"The `where` clause restricts source rows to the past hour; `bin(Timestamp, 5m)` groups rows into 5-minute buckets per device; `countif` counts only readings where TemperatureC exceeds 8. KQL summarize does not automatically fabricate empty time bins.","videoSeconds":917,"refs":["vref_4e6de2ee3567ef10","eqbin","vref_9bc6e0fd33118950","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Query and analyze data — Query with SQL/KQL","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=917s"},{"id":"fb-v11-choose-039","sourceId":"V11-CHOOSE-039","pack":"video11","topic":"Query / lakehouse SQL DML constraint","title":"Query / lakehouse SQL DML constraint","prompt":"A team reads sales from Lakehouse using T-SQL, then attempts `UPDATE dbo.Sales SET Amount = Amount * 1.05` through that same SQL analytics endpoint. The instruction fails. What change best preserves the existing Lakehouse architecture? (Select one answer.)","type":"single","options":[{"id":"A","text":"Make the endpoint a Warehouse by renaming it","why":"Incorrect: Renaming an item does not alter its SQL endpoint DML capability."},{"id":"B","text":"Run a SELECT with a WHERE clause to persist new amounts","why":"Incorrect: A SELECT cannot persist an UPDATE."},{"id":"C","text":"Use an Eventstream destination to issue UPDATE","why":"Incorrect: Eventstream routing does not make the Lakehouse SQL endpoint writable."},{"id":"D","text":"Perform the table mutation through Spark or supported ingestion/transform route","why":"Correct: use Spark to update managed Delta tables."}],"correct":["D"],"explanation":"The Lakehouse SQL analytics endpoint is for querying; writing Delta tables requires a supported write path such as Spark.","videoSeconds":753,"refs":["vref_e2df90d25000ea7c","lakehouse","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Query and analyze data — Query with SQL/KQL","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=753s"},{"id":"fb-v11-choose-040","sourceId":"V11-CHOOSE-040","pack":"video11","topic":"Tools / low-code plus heavy transform","title":"Tools / low-code plus heavy transform","prompt":"HR receives weekly CSV exports, needs joins with lookup tables, custom M functions, and PII removal before loading a curated dataset. IT policy explicitly forbids custom Python and Java. What should the team choose? (Select one answer.)","type":"single","options":[{"id":"A","text":"Spark notebook with pandas custom code","why":"Incorrect: Violates the stated no-custom-code requirement."},{"id":"B","text":"Dataflow Gen2 with Power Query transformations","why":"Correct: M and low-code are direct indicators."},{"id":"C","text":"Eventhouse KQL update policies as the weekly M engine","why":"Incorrect: KQL update policies are a different stream/event analytics method."},{"id":"D","text":"Eventstream for historical CSV cleansing","why":"Incorrect: Eventstream is oriented to live events, not multi-step weekly Power Query preparation."}],"correct":["B"],"explanation":"Dataflow Gen2 is suited to low-code M data preparation and supports complex tabular transformation chains.","videoSeconds":252,"refs":["exam","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=252s"},{"id":"fb-v11-choose-041","sourceId":"V11-CHOOSE-041","pack":"video11","topic":"Tools / requirements matrix","title":"Tools / requirements matrix","prompt":"A proposed design must (i) ingest nightly tables using limited mappings, (ii) perform advanced custom PySpark tokenization of free text, and (iii) orchestrate dependency order and retries. Which design most appropriately allocates responsibilities? (Select one answer.)","type":"single","options":[{"id":"A","text":"Eventhouse only","why":"Incorrect: Eventhouse neither performs the whole custom PySpark stage nor orchestrates that batch workflow alone."},{"id":"B","text":"Dataflow Gen2 and Eventstream only","why":"Incorrect: Low-code M/streaming services do not satisfy explicit PySpark tokenization."},{"id":"C","text":"Copy activity, Spark notebook/job, and Data pipeline orchestration","why":"Correct: three complementary responsibilities match three tool strengths."},{"id":"D","text":"Lakehouse SQL analytics endpoint with T-SQL DML only","why":"Incorrect: Lakehouse SQL analytics endpoint lacks the requested DML processing and PySpark runtime."}],"correct":["C"],"explanation":"Copy activity handles straightforward batch movement; Spark handles complex Python transformations; pipeline coordinates runs.","videoSeconds":232,"refs":["exam","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=232s"},{"id":"fb-v11-choose-042","sourceId":"V11-CHOOSE-042","pack":"video11","topic":"Tools / multi-select engine classification","title":"Tools / multi-select engine classification","prompt":"A review committee must choose technologies compatible with *native* or documented continuous ingestion/filtering of event telemetry rather than merely scheduled batch copy. Select two directly applicable services. (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"Eventstream","why":"Correct: designed for eventstream streaming ingestion and processing."},{"id":"B","text":"Data pipeline Copy activity configured nightly","why":"Incorrect: nightly copy is discrete batch movement."},{"id":"C","text":"Dataflow Gen2 with fixed hourly refresh","why":"Incorrect: scheduled refresh is periodic batch transformation."},{"id":"D","text":"Spark Structured Streaming","why":"Correct: Structured Streaming executes stream-based transformations using Spark."}],"correct":["A","D"],"explanation":"Eventstream and Spark Structured Streaming directly process streams; scheduled copy and dataflows are batch-style even if frequently triggered.","videoSeconds":350,"refs":["vref_0b990ed020ff7e36","vref_51f8bef150248513","dataflow","vref_46f9ea555bf1a81d","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=350s"},{"id":"fb-v11-choose-043","sourceId":"V11-CHOOSE-043","pack":"video11","topic":"Storage / multi-select selection","title":"Storage / multi-select selection","prompt":"A solution needs to retain raw images and also execute T-SQL multi-table transactional transformations over curated tables. The engineer may deploy more than one Fabric data store. Select the two complementary stores that satisfy these requirements. (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"Eventstream","why":"Incorrect: routing an event stream is not a general raw-file archive."},{"id":"B","text":"Lakehouse","why":"Correct: raw/unstructured file storage. This distinction controls the solution."},{"id":"C","text":"Warehouse","why":"Correct: SQL multi-table transactions. This distinction controls the solution."},{"id":"D","text":"Activator","why":"Incorrect: Activator is an action/alert component, not a transactional store."}],"correct":["B","C"],"explanation":"Lakehouse holds raw images and Warehouse supports atomic multi-table SQL transformations.","videoSeconds":821,"refs":["vref_e2df90d25000ea7c","vref_9bc6e0fd33118950","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=821s"},{"id":"fb-v11-choose-044","sourceId":"V11-CHOOSE-044","pack":"video11","topic":"Tools / multi-select operation","title":"Tools / multi-select operation","prompt":"A team is replacing a bulk-load script with Copy job. Assume a source and destination connector pair documents all required modes. Which statements about incremental behavior are correct? (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"A watermark-only incremental strategy automatically tracks physically deleted source rows","why":"Incorrect: watermark-based scanning does not see hard deletes."},{"id":"B","text":"Append after reset can never duplicate previously loaded rows","why":"Incorrect: append can create duplicates after a full reread."},{"id":"C","text":"CDC-based incremental copying can track source deletions","why":"Correct: CDC includes insert/update/delete change events with suitable connectors."},{"id":"D","text":"A reset clears the incremental checkpoint but not the already-loaded target contents","why":"Correct: documented reset semantics preserve destination contents."}],"correct":["C","D"],"explanation":"CDC can capture delete events when supported, and resetting Copy job state does not clear destination tables or files.","videoSeconds":493,"refs":["vref_427b57a6178e49f8","vref_6b2941f77d0c3294"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=493s"},{"id":"fb-v11-choose-045","sourceId":"V11-CHOOSE-045","pack":"video11","topic":"Storage / multi-select language affinity","title":"Storage / multi-select language affinity","prompt":"A candidate maps engineering requirements to a primary Fabric compute/store interface. Choose the two associations that remain broadly defensible without turning them into absolute exclusions. (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"Eventhouse is the recommended general purpose store for full T-SQL multi-table transaction processing","why":"Incorrect: Eventhouse is KQL/event analytics oriented."},{"id":"B","text":"Warehouse is the default SQL-first store for relational BI and multi-table T-SQL transactions","why":"Correct: this is a supported primary development choice."},{"id":"C","text":"Lakehouse SQL analytics endpoint is normally a DML-capable data warehouse","why":"Incorrect: Lakehouse SQL endpoint remains read-only for Delta table data."},{"id":"D","text":"Lakehouse is the usual Spark-first item for raw/Delta engineering","why":"Correct: Spark-first Lakehouse storage is the common engineering pattern."}],"correct":["B","D"],"explanation":"Primary tool affinity is SQL/transactions for Warehouse and Spark/raw engineering for Lakehouse; exceptions like a Runtime 2.0 Spark Warehouse connector do not reverse their primary roles.","videoSeconds":753,"refs":["vref_e2df90d25000ea7c","wspark","vref_9bc6e0fd33118950","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=753s"},{"id":"fb-v11-choose-046","sourceId":"V11-CHOOSE-046","pack":"video11","topic":"Storage / multi-select security","title":"Storage / multi-select security","prompt":"A stakeholder interprets Eventhouse and Lakehouse as having exactly identical fine-grained security controls. Which two corrective statements are documented? (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"Eventhouse documentation describes object-level and row-level access controls","why":"Correct: Eventhouse object- and row-level capabilities are documented."},{"id":"B","text":"Any object permission granted in a Lakehouse SQL endpoint automatically governs every possible direct Spark or OneLake access path","why":"Incorrect: the direct storage/engine access path has distinct security enforcement concerns."},{"id":"C","text":"Warehouse and Lakehouse SQL analytics endpoint support SQL engine object/row/column controls when configured appropriately","why":"Correct: the T-SQL surfaces implement SQL security features."},{"id":"D","text":"Eventhouse offers an identical column-level SQL security implementation to Warehouse by default","why":"Incorrect: current capability comparisons do not endorse identical CLS for Eventhouse."}],"correct":["A","C"],"explanation":"Different access paths and engines must be evaluated independently. Current reference material lists Eventhouse OLS/RLS and SQL endpoints with granular controls.","videoSeconds":876,"refs":["vref_9bc6e0fd33118950","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=876s"},{"id":"fb-v11-choose-047","sourceId":"V11-CHOOSE-047","pack":"video11","topic":"Storage / multi-select engine access","title":"Storage / multi-select engine access","prompt":"Choose two true statements about supported access patterns that complicate simplistic “only Spark for Lakehouse, only SQL for Warehouse” exam shortcuts. (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"The Lakehouse SQL analytics endpoint supports reading Delta tables with T-SQL","why":"Correct: built-in Lakehouse SQL analytics interface."},{"id":"B","text":"The Lakehouse SQL analytics endpoint supports arbitrary T-SQL UPDATE to managed Delta tables","why":"Incorrect: Lakehouse SQL endpoints do not permit arbitrary DML changes."},{"id":"C","text":"Eventhouse is a mandatory intermediary for every Lakehouse SELECT","why":"Incorrect: standard Lakehouse SQL SELECT does not require Eventhouse."},{"id":"D","text":"The Warehouse Spark connector can support Warehouse writes under the documented Runtime 2.0 requirements","why":"Correct: current connector documents Warehouse write support for Runtime 2.0."}],"correct":["A","D"],"explanation":"The Lakehouse has a read-only T-SQL surface, and a recent Warehouse connector write path exists with Runtime 2.0 constraints.","videoSeconds":777,"refs":["wspark","vref_e2df90d25000ea7c","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=777s"},{"id":"fb-v11-choose-048","sourceId":"V11-CHOOSE-048","pack":"video11","topic":"Tools / multi-select boundary","title":"Tools / multi-select boundary","prompt":"A design committee claims a Data pipeline Copy activity can replace every other Fabric preparation tool. Select the two scenarios where this claim is fundamentally weak. (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"Straightforward nightly table transfers and light mappings","why":"Incorrect: this is precisely a strong Copy activity use case."},{"id":"B","text":"Stateful, near-real-time transformations on telemetry events","why":"Correct: ongoing stream computation is not Copy activity’s native responsibility."},{"id":"C","text":"Arbitrary PySpark statistical feature extraction requiring external Python packages","why":"Correct: custom Python libraries demand a code-capable transformation runtime."},{"id":"D","text":"A batch copy whose sole transformation is a simple column remap","why":"Incorrect: simple mappings are within Copy activity’s capabilities."}],"correct":["B","C"],"explanation":"Stateful streaming fits Eventstream/Spark Structured Streaming; arbitrary PySpark engineering requires Spark, whereas ordinary table copy is a Copy activity strength.","videoSeconds":252,"refs":["vref_0b990ed020ff7e36","vref_51f8bef150248513","vref_5115f35de51b4c55","vref_46f9ea555bf1a81d"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data / Transform data — Select ingestion and transformation approach","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=252s"},{"id":"fb-v11-choose-049","sourceId":"V11-CHOOSE-049","pack":"video11","topic":"Architecture / multi-select full stack","title":"Architecture / multi-select full stack","prompt":"A campus platform needs (1) real-time campus sensor event exploration by KQL and (2) confidential accounting-star-schema monthly T-SQL updates with multi-table transactional consistency. Select the two primary destination stores. (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"Eventstream","why":"Incorrect: Eventstream can ingest/transform but is not the KQL query destination."},{"id":"B","text":"OneLake shortcut","why":"Incorrect: a shortcut is a reference to existing data, not a destination store with transaction semantics."},{"id":"C","text":"Eventhouse","why":"Correct: native KQL event analytics engine."},{"id":"D","text":"Warehouse","why":"Correct: analytical SQL transaction-capable store."}],"correct":["C","D"],"explanation":"Eventhouse specializes in KQL real-time analytics, while Warehouse provides SQL-transformed financial marts with multi-table transactions.","videoSeconds":917,"refs":["vref_9bc6e0fd33118950","vref_e2df90d25000ea7c","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=917s"},{"id":"fb-v11-choose-050","sourceId":"V11-CHOOSE-050","pack":"video11","topic":"Architecture / multi-select modernization","title":"Architecture / multi-select modernization","prompt":"An enterprise wants to avoid physical duplication of existing eligible Delta files while independently syncing operational SQL changes to analytical Fabric storage. Which pair directly addresses both *distinct* requirements? (Select 2 answers.)","type":"multi","options":[{"id":"A","text":"OneLake shortcuts for accessible Delta locations","why":"Correct: no-copy reference for already stored data."},{"id":"B","text":"Mirroring for supported operational databases","why":"Correct: change replication from eligible operational sources."},{"id":"C","text":"Eventstream as a universal zero-copy link to every SQL Server table","why":"Incorrect: Eventstream alone does not represent universal no-copy SQL source access."},{"id":"D","text":"Warehouse alone as a shortcut and CDC engine","why":"Incorrect: a destination Warehouse is not itself both link and mirroring service."}],"correct":["A","B"],"explanation":"Shortcuts provide no-copy access to eligible data locations; Mirroring handles supported source database replication.","videoSeconds":973,"refs":["eastore","vref_5115f35de51b4c55","events"],"code":"","origin":"extension","difficulty":5,"caseStudyId":null,"sourceObjective":"Prepare data — Get data — Choose between different data stores","provenance":"Original exam-style scenario developed from instructor discussion and independently checked against Microsoft Learn; not copied from a live or leaked certification exam.","validation":"Documentation reviewed 2026-10-23, conceptual assessment only; no live Fabric tenant exercise and no visual frame audit.","sourceVideoUrl":"https://www.youtube.com/watch?v=HsVOOuaJK7Y&t=973s"}]
