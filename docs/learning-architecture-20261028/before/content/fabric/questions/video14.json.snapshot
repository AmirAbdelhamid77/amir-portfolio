[{"id":"fb-v14-pipe-001","sourceId":"V14-PIPE-001","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"orchestration vs transformation and correct dependency sequencing","prompt":"A retailer needs one orchestration asset to copy nightly ERP extracts, launch a Notebook to normalize dates, and refresh a semantic model only after the lakehouse load succeeds. Which design fits the responsibilities best?","type":"single","options":[{"id":"A","text":"Build a Fabric Data Pipeline with Copy, Notebook, and refresh activities connected by success dependencies","why":"Correct: A pipeline orchestrates data movement and other Fabric workloads while making execution dependencies explicit."},{"id":"B","text":"Put all steps inside a semantic-model DAX measure","why":"Incorrect: DAX evaluates model expressions and cannot orchestrate ingestion activities."},{"id":"C","text":"Use one Copy Data activity to perform Spark transformations and model refresh","why":"Incorrect: Copy is for data movement and limited shaping, not a universal transformation scheduler."},{"id":"D","text":"Schedule three independent items at identical clock times","why":"Incorrect: Matching schedules cannot guarantee dependency order or prevent consuming incomplete data."}],"correct":["A"],"explanation":"A pipeline orchestrates data movement and other Fabric workloads while making execution dependencies explicit.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-002","sourceId":"V14-PIPE-002","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"authoring validation versus runtime guarantees","prompt":"A team has a functioning pipeline but has inserted a new activity with a required blank field. Validation succeeds after the field is populated; does this prove that a production API call will succeed?","type":"single","options":[{"id":"A","text":"Yes: successful validation verifies the external API response end-to-end","why":"Incorrect: Static validation is not a guaranteed integration test against every dependency."},{"id":"B","text":"No: validation catches authoring/configuration issues but cannot guarantee runtime credentials, data availability, or external endpoint health","why":"Correct: Validation checks the definition; execution still depends on live services and permissions."},{"id":"C","text":"Yes: it automatically commits the pipeline and executes a dry-run against production","why":"Incorrect: Validation does not mean a production execution occurred."},{"id":"D","text":"No: a pipeline with more than one activity can never be validated","why":"Incorrect: Multi-activity pipelines are valid and commonly validated."}],"correct":["B"],"explanation":"Validation checks the definition; execution still depends on live services and permissions.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-003","sourceId":"V14-PIPE-003","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"layout is not scheduling logic","prompt":"A data engineer adds Copy Data and a notification activity with no dependency link. The expectation is that notification waits for the copy. What change is required?","type":"single","options":[{"id":"A","text":"Rename notification with a higher alphabetic suffix","why":"Incorrect: Activity names do not define execution order."},{"id":"B","text":"Add a workspace shortcut to notification","why":"Incorrect: A data shortcut has no role in pipeline control flow."},{"id":"C","text":"Link notification to Copy Data with an Upon Success dependency and test the actual run graph","why":"Correct: Activities without dependency edges can execute independently, potentially in parallel."},{"id":"D","text":"Put both activities in the same canvas row","why":"Incorrect: Visual proximity does not establish dependency semantics."}],"correct":["C"],"explanation":"Activities without dependency edges can execute independently, potentially in parallel.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-004","sourceId":"V14-PIPE-004","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"orchestration boundary versus data processing engine","prompt":"A report must be built from transactional files with complex deduplication rules. A junior engineer insists that Copy Data is the right activity for arbitrary multi-step Spark computation. What is the best correction?","type":"single","options":[{"id":"A","text":"Encode every transformation as filename mapping rules in Copy","why":"Incorrect: Mapping is not equivalent to arbitrary distributed business transformations."},{"id":"B","text":"Push deduplication into semantic model relationships alone","why":"Incorrect: Model relationships do not repair the raw data pipeline."},{"id":"C","text":"Replace Notebook with an email activity","why":"Incorrect: Email does not transform data."},{"id":"D","text":"Use Copy for ingestion, invoke a Notebook or Dataflow Gen2 for complex transformations, then depend on successful completion","why":"Correct: The pipeline coordinates specialized compute rather than replacing that compute."}],"correct":["D"],"explanation":"The pipeline coordinates specialized compute rather than replacing that compute.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-005","sourceId":"V14-PIPE-005","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"pipeline invocation versus metadata or parameter storage","prompt":"In a cross-workspace project, a child pipeline must be run as part of a shared ingestion workflow with one execution chain. Which activity type represents the intended design?","type":"single","options":[{"id":"A","text":"Invoke Pipeline activity, with explicitly configured child input values and completion behavior","why":"Correct: Nested orchestration can centralize reusable processes and make dependency behavior visible."},{"id":"B","text":"Get Metadata activity pointed at the child pipeline item","why":"Incorrect: Get Metadata retrieves properties of data objects, not pipeline execution."},{"id":"C","text":"Copy Data activity whose destination is the child pipeline","why":"Incorrect: Pipeline items are not data destinations."},{"id":"D","text":"Set Variable with the child pipeline's name","why":"Incorrect: Storing a name does not execute that item."}],"correct":["A"],"explanation":"Nested orchestration can centralize reusable processes and make dependency behavior visible.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-006","sourceId":"V14-PIPE-006","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"trigger semantics rather than timing guesses","prompt":"A pipeline is expected to begin only after an on-premises SQL export is completed at a variable time each night. What architecture avoids an unreliable time-only assumption?","type":"single","options":[{"id":"A","text":"Schedule at the usual export time and assume the file is always complete","why":"Incorrect: A recurring clock is not an authoritative completion event."},{"id":"B","text":"Arrange an event/API-based orchestration trigger or a source-completion signal, verifying the trigger mechanism and source support","why":"Correct: A true completion signal protects against schedules starting while the source is unfinished."},{"id":"C","text":"Use a semantic-model calculated column as the completion detector","why":"Incorrect: Calculated columns cannot independently start the data pipeline."},{"id":"D","text":"Use a fixed Wait activity equal to yesterday's export duration","why":"Incorrect: Yesterday's duration does not guarantee today's completion."}],"correct":["B"],"explanation":"A true completion signal protects against schedules starting while the source is unfinished.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-007","sourceId":"V14-PIPE-007","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"control-flow composition versus unrelated Fabric features","prompt":"The BI platform needs ingestion, control-flow branching, and a custom Spark cleanse without rewriting existing Python. Which capabilities belong to a Fabric Data Pipeline solution? Select TWO.","type":"multi","options":[{"id":"A","text":"Use If Condition to route execution based on an evaluated boolean expression","why":"Correct: Control activities provide conditional branches around engineering steps."},{"id":"B","text":"Assume activities without edges execute in their visual canvas order","why":"Incorrect: No implicit ordering is guaranteed by horizontal placement."},{"id":"C","text":"Use a semantic-model slicer to decide pipeline dependencies at run time","why":"Incorrect: A report slicer does not directly implement the orchestration graph."},{"id":"D","text":"Use Copy Data to natively execute all Python libraries in the Copy mapping screen","why":"Incorrect: Copy mappings are not a general Python runtime."},{"id":"E","text":"Run a Notebook activity to execute transformation code as a pipeline step","why":"Correct: Pipelines can orchestrate Notebooks without translating PySpark to low-code copy settings."}],"correct":["A","E"],"explanation":"Pipelines can orchestrate Notebooks without translating PySpark to low-code copy settings. Control activities provide conditional branches around engineering steps.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-008","sourceId":"V14-PIPE-008","pack":"video14","topic":"Pipeline fundamentals and orchestration","title":"design-time and runtime assurance","prompt":"A governance review asks what a published pipeline definition guarantees versus what remains to be checked during execution. Select TWO safe statements.","type":"multi","options":[{"id":"A","text":"A pipeline always transforms complex data inside the Copy activity itself","why":"Incorrect: Transformation-heavy logic often belongs to called engines."},{"id":"B","text":"A successful Validate proves the copied row counts match source rows","why":"Incorrect: Data quality and execution metrics require running and comparing actual data."},{"id":"C","text":"Pipeline parameters can accept values from callers or schedule definitions","why":"Correct: Inputs let the same pipeline support multiple runs and environments."},{"id":"D","text":"A successful Save proves every gateway can authenticate indefinitely","why":"Incorrect: Stored credentials can expire or lack permissions later."},{"id":"E","text":"Activities can have dependency conditions such as success and failure","why":"Correct: The execution graph explicitly determines downstream paths."}],"correct":["C","E"],"explanation":"The execution graph explicitly determines downstream paths. Inputs let the same pipeline support multiple runs and environments.","videoSeconds":42,"refs":["vref_00ff45f03a04122b","pactivity","vref_9ed52162c3860469"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 supporting data integration; DP-700 core","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=42s"},{"id":"fb-v14-pipe-009","sourceId":"V14-PIPE-009","pack":"video14","topic":"Copy Data and ingestion","title":"bulk data movement architecture","prompt":"A payment processor copies 15 GB of daily records from SQL Server to a Lakehouse and needs a reliable bulk transfer before Notebook transformations. Which activity is appropriate?","type":"single","options":[{"id":"A","text":"Get Metadata alone","why":"Incorrect: Metadata inspection will not transfer transaction rows."},{"id":"B","text":"Set Variable iterated 15 billion times","why":"Incorrect: Variables are not a transport engine and would be unscalable."},{"id":"C","text":"Copy Data from the configured SQL source to the Lakehouse destination, with explicit mapping and reconciliation","why":"Correct: Copy is specialized for transporting supported source data into a supported sink."},{"id":"D","text":"A Power BI visual calculation","why":"Incorrect: Visual calculations do not ingest source rows."}],"correct":["C"],"explanation":"Copy is specialized for transporting supported source data into a supported sink.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-010","sourceId":"V14-PIPE-010","pack":"video14","topic":"Copy Data and ingestion","title":"success status versus correctness","prompt":"A tabular source contains decimal prices but destination fields are configured as strings. A pipeline reports Success, yet analysts see incorrect types downstream. What should be investigated first?","type":"single","options":[{"id":"A","text":"Immediately increase the capacity SKU","why":"Incorrect: Capacity changes do not correct a mapping mismatch."},{"id":"B","text":"Delete the Lakehouse SQL endpoint","why":"Incorrect: The endpoint is unrelated to source-to-destination typing."},{"id":"C","text":"Disable every activity retry","why":"Incorrect: Retries are not the root cause of systematic schema errors."},{"id":"D","text":"Review Copy mapping and source/sink schema, then validate downstream type conversion and row-level results","why":"Correct: A successful move does not guarantee semantically correct data types."}],"correct":["D"],"explanation":"A successful move does not guarantee semantically correct data types.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-011","sourceId":"V14-PIPE-011","pack":"video14","topic":"Copy Data and ingestion","title":"Bronze raw landing and Silver transformation separation","prompt":"A finance team wants source rows land in Bronze unchanged, while a separate process applies complex business rules in Silver. The analyst asks Copy Data to apply arbitrarily intricate joins during the move. Which implementation best preserves layers?","type":"single","options":[{"id":"A","text":"Use Copy Data to land raw data, and a Notebook or Dataflow Gen2 to handle complex cleansing and joins","why":"Correct: Separating movement and transformation protects provenance and enables richer logic."},{"id":"B","text":"Make a Warehouse view and call it a copy mechanism","why":"Incorrect: A view by itself is not an ingestion activity into Bronze."},{"id":"C","text":"Set the destination to the semantic model report","why":"Incorrect: Power BI reports are not general data destinations."},{"id":"D","text":"Rely on Copy Data column renaming to implement arbitrary multi-table joins","why":"Incorrect: Renaming cannot implement the required relational transformation."}],"correct":["A"],"explanation":"Separating movement and transformation protects provenance and enables richer logic.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-012","sourceId":"V14-PIPE-012","pack":"video14","topic":"Copy Data and ingestion","title":"copy bottleneck diagnosis","prompt":"A daily ingest is slow. Monitoring shows source file enumeration dominates, while actual data transfer is short. What is the most defensible next diagnostic action?","type":"single","options":[{"id":"A","text":"Increase ForEach parallelism immediately to the maximum on every pipeline","why":"Incorrect: Maximal parallelism can intensify throttling and does not fix source enumeration."},{"id":"B","text":"Inspect listing patterns, partitioned paths, source throttling and connector-specific scan behavior before blindly increasing parallel copies","why":"Correct: Source listing bottlenecks must be addressed where enumeration occurs."},{"id":"C","text":"Move the data source to a report visual","why":"Incorrect: A report visual does not solve data movement performance."},{"id":"D","text":"Turn off all monitoring to increase throughput","why":"Incorrect: Removing observability is unlikely to fix the source listing bottleneck."}],"correct":["B"],"explanation":"Source listing bottlenecks must be addressed where enumeration occurs.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-013","sourceId":"V14-PIPE-013","pack":"video14","topic":"Copy Data and ingestion","title":"replay safety and idempotent loads","prompt":"A file load is interrupted midway and its destination uses append behavior. An operator restarts the complete pipeline with no idempotency strategy. What risk must be addressed?","type":"single","options":[{"id":"A","text":"Duplicate records are impossible because every pipeline run has a new RunId","why":"Incorrect: A RunId does not enforce target uniqueness."},{"id":"B","text":"A pipeline automatically rolls back all downstream systems as one distributed transaction","why":"Incorrect: There is no universal cross-activity atomic transaction."},{"id":"C","text":"Previously committed rows or files can be ingested again; implement run-state tracking or idempotent merge/replace patterns","why":"Correct: Restarting an append operation without replay controls can duplicate data."},{"id":"D","text":"Copy activity always deletes the sink before retrying","why":"Incorrect: The write behavior depends on configuration and connector."}],"correct":["C"],"explanation":"Restarting an append operation without replay controls can duplicate data.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-014","sourceId":"V14-PIPE-014","pack":"video14","topic":"Copy Data and ingestion","title":"connector directionality and feature support","prompt":"An external system supports read-only extraction for a given connector, and an engineer attempts to use that connector as the Copy sink. What should they do?","type":"single","options":[{"id":"A","text":"Enable more notebook cores so the sink option appears","why":"Incorrect: Spark capacity does not change Copy connector feature support."},{"id":"B","text":"Change the warehouse name to match the source system","why":"Incorrect: Naming cannot add unsupported connector functionality."},{"id":"C","text":"Turn off the gateway because gateways limit bidirectional transfer","why":"Incorrect: Gateways do not determine every connector's read/write feature matrix."},{"id":"D","text":"Check source/destination support for that specific connector and choose a supported sink or alternate route","why":"Correct: Connectors and operations differ; source support does not imply sink support."}],"correct":["D"],"explanation":"Connectors and operations differ; source support does not imply sink support.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-015","sourceId":"V14-PIPE-015","pack":"video14","topic":"Copy Data and ingestion","title":"quality checks beyond execution status","prompt":"A Lakehouse ingestion must support diagnostics and correctness testing. Which practices are appropriate? Select TWO.","type":"multi","options":[{"id":"A","text":"Use a Wait activity instead of collecting metrics","why":"Incorrect: A pause does not produce reconciliation evidence."},{"id":"B","text":"Avoid handling partial retries because Copy always gives cross-system exactly-once semantics","why":"Incorrect: Exactly-once end-to-end is not a universal guarantee."},{"id":"C","text":"Inspect mappings and sample destination types after the load","why":"Correct: Schema interpretation errors can survive a successful activity status."},{"id":"D","text":"Assume a green activity icon proves all business constraints were satisfied","why":"Incorrect: Green normally indicates execution success, not quality assertions."},{"id":"E","text":"Record Copy run metrics and reconcile source and destination row/file counts where applicable","why":"Correct: Transport success is not a replacement for content validation."}],"correct":["C","E"],"explanation":"Transport success is not a replacement for content validation. Schema interpretation errors can survive a successful activity status.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-016","sourceId":"V14-PIPE-016","pack":"video14","topic":"Copy Data and ingestion","title":"copy-activity versus updated Copy Job decision","prompt":"A team needs to select data movement mechanisms for two workflows: a scheduled complex orchestration and a simple connector-supported incremental replication. Select TWO valid observations.","type":"multi","options":[{"id":"A","text":"A Copy-only pipeline is mandatory even when Copy Job fully meets simple requirements","why":"Incorrect: A standalone Copy Job can be appropriate without pipeline orchestration."},{"id":"B","text":"Every connector supports CDC and deletion capture automatically","why":"Incorrect: CDC support is source- and connector-dependent."},{"id":"C","text":"A standalone Copy Job may manage incremental state for supported connectors and modes","why":"Correct: Current Copy Job includes specialized full/incremental workflows beyond the video's primary focus."},{"id":"D","text":"Copy Data fits inside a pipeline that coordinates additional dependent tasks","why":"Correct: Pipeline orchestration adds branching, sequencing and multi-step compute."},{"id":"E","text":"Copy Data and Copy Job are both obligatory for any ingestion","why":"Incorrect: Neither is universally required in tandem."}],"correct":["C","D"],"explanation":"Pipeline orchestration adds branching, sequencing and multi-step compute. Current Copy Job includes specialized full/incremental workflows beyond the video's primary focus.","videoSeconds":1102,"refs":["vref_00ff45f03a04122b","pmonitor","vref_427b57a6178e49f8"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Get data","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1102s"},{"id":"fb-v14-pipe-017","sourceId":"V14-PIPE-017","pack":"video14","topic":"Connections, gateways and authentication","title":"gateway and network boundary","prompt":"A legacy ERP SQL Server is accessible only from the corporate network. The cloud-to-cloud connector test succeeds for another system, but the ERP cannot be reached directly. What must be assessed?","type":"single","options":[{"id":"A","text":"An approved on-premises or virtual network gateway and the supported connector path, including required network access","why":"Correct: Network-isolated sources need a supported bridge, not merely a Fabric workspace link."},{"id":"B","text":"The semantic model's RLS filters","why":"Incorrect: RLS does not establish an on-premises network route."},{"id":"C","text":"Increasing Copy batch count","why":"Incorrect: Concurrency does not fix basic network reachability."},{"id":"D","text":"Changing the notebook display name","why":"Incorrect: Display names have no effect on connectivity."}],"correct":["A"],"explanation":"Network-isolated sources need a supported bridge, not merely a Fabric workspace link.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-018","sourceId":"V14-PIPE-018","pack":"video14","topic":"Connections, gateways and authentication","title":"identity lifecycle and least privilege","prompt":"A connection made with an engineer's personal OAuth login fails after the engineer leaves the company. What design most improves operational resilience?","type":"single","options":[{"id":"A","text":"Share the former employee's password with the whole team","why":"Incorrect: Shared human credentials violate security practices and cannot be relied upon."},{"id":"B","text":"Where supported, migrate to an approved nonpersonal identity such as service principal, managed identity or workspace identity with least privilege","why":"Correct: Separating production credentials from personal accounts reduces lifecycle failures."},{"id":"C","text":"Grant every tenant user workspace Admin","why":"Incorrect: Excessive privileges are not a credentials architecture."},{"id":"D","text":"Schedule retries every minute forever without replacing authorization","why":"Incorrect: Expired/revoked authentication usually needs credential remediation."}],"correct":["B"],"explanation":"Separating production credentials from personal accounts reduces lifecycle failures.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-019","sourceId":"V14-PIPE-019","pack":"video14","topic":"Connections, gateways and authentication","title":"source credentials vs runtime connectivity","prompt":"A developer's Copy connection test fails while the same credentials can log in interactively from a laptop. Which diagnosis is strongest?","type":"single","options":[{"id":"A","text":"Copy must be defective because browser login works","why":"Incorrect: Different client paths may have different network and auth requirements."},{"id":"B","text":"Every service principal can authenticate to all Fabric sources by default","why":"Incorrect: Service principals must be authorized and supported by the connector."},{"id":"C","text":"Evaluate connector authentication mode, tenant permissions, target network path, gateway settings and service firewall separately","why":"Correct: Interactive access doesn't prove the Fabric connector runtime can reach and authenticate to the source."},{"id":"D","text":"The issue must be a CSV delimiter mismatch","why":"Incorrect: Connection establishment precedes parsing source file content."}],"correct":["C"],"explanation":"Interactive access doesn't prove the Fabric connector runtime can reach and authenticate to the source.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-020","sourceId":"V14-PIPE-020","pack":"video14","topic":"Connections, gateways and authentication","title":"connector operation matrix","prompt":"A database connector advertises Copy support but not Stored Procedure activity support. What should the team conclude?","type":"single","options":[{"id":"A","text":"Any connection that supports Copy must support Stored Procedure activity","why":"Incorrect: Activities have different capability matrices."},{"id":"B","text":"Copy automatically executes a stored procedure on every source SQL connection","why":"Incorrect: No universal procedure-execution behavior follows from Copy support."},{"id":"C","text":"Disabling encryption enables Stored Procedure support","why":"Incorrect: Encryption settings do not invent an unsupported operation."},{"id":"D","text":"Support is activity-specific; choose another supported execution mechanism for the procedure or modify the architecture","why":"Correct: A connector's compatibility matrix is not identical across all pipeline activities."}],"correct":["D"],"explanation":"A connector's compatibility matrix is not identical across all pipeline activities.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-021","sourceId":"V14-PIPE-021","pack":"video14","topic":"Connections, gateways and authentication","title":"separate source and sink permission paths","prompt":"A pipeline can read Blob Storage but fails writing to a target Lakehouse. Operators focus only on source credential refresh. Which control should be examined as well?","type":"single","options":[{"id":"A","text":"Target workspace/item permissions and the sink connection's authorization, in addition to source access","why":"Correct: Read permission at source does not imply write permission at destination."},{"id":"B","text":"The caption language of the tutorial","why":"Incorrect: Video transcript language is unrelated to destination access."},{"id":"C","text":"Whether the pipeline has a description","why":"Incorrect: Descriptions do not grant sink write access."},{"id":"D","text":"The color of the Copy activity dependency line","why":"Incorrect: Dependency color cannot substitute for credentials."}],"correct":["A"],"explanation":"Read permission at source does not imply write permission at destination.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-022","sourceId":"V14-PIPE-022","pack":"video14","topic":"Connections, gateways and authentication","title":"secure secrets and monitoring exposure","prompt":"An organization prohibits storing raw API tokens in source-controlled pipeline definitions. Which policy best supports this requirement?","type":"single","options":[{"id":"A","text":"Write the token as a pipeline variable named SecurePassword and assume naming encrypts it","why":"Incorrect: Variable names are not secret stores."},{"id":"B","text":"Use approved secret-management and credential mechanisms, avoid embedding tokens in parameters logged as plain text, and verify activity logging protections","why":"Correct: Security is achieved via credential lifecycle and constrained exposure, not plain-text pipeline fields."},{"id":"C","text":"Place the token in a report title so no one reads pipeline JSON","why":"Incorrect: A title is insecure and irrelevant."},{"id":"D","text":"Share service-principal certificates in the README to simplify troubleshooting","why":"Incorrect: Publishing secrets exposes production authorization."}],"correct":["B"],"explanation":"Security is achieved via credential lifecycle and constrained exposure, not plain-text pipeline fields.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-023","sourceId":"V14-PIPE-023","pack":"video14","topic":"Connections, gateways and authentication","title":"preflight connection governance","prompt":"A company is designing production access to four on-premises sources. Select TWO checks that must precede deployment.","type":"multi","options":[{"id":"A","text":"Omit firewall validation because a Fabric capacity exists","why":"Incorrect: Capacity allocation does not establish access across private networks."},{"id":"B","text":"Confirm each connector's supported authentication and gateway host requirements","why":"Correct: Connector capabilities and network routes vary by source and operation."},{"id":"C","text":"Grant only the minimum needed source and target privileges to the selected execution identity","why":"Correct: Least privilege reduces blast radius and authorization surprises."},{"id":"D","text":"Assume one username/password field works for every connector","why":"Incorrect: Not all connectors use the same authentication mechanisms."},{"id":"E","text":"Give the development team's accounts permanent administrator access to production sources","why":"Incorrect: Production identities should be governed and restricted."}],"correct":["B","C"],"explanation":"Connector capabilities and network routes vary by source and operation. Least privilege reduces blast radius and authorization surprises.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-024","sourceId":"V14-PIPE-024","pack":"video14","topic":"Connections, gateways and authentication","title":"service principal scope and prerequisites","prompt":"A service principal is proposed for a reusable Fabric pipeline. Which statements are sound? Select TWO.","type":"multi","options":[{"id":"A","text":"If a connection is marked Succeeded, the source will always remain reachable and authorized","why":"Incorrect: Connectivity and credentials can change after setup."},{"id":"B","text":"Apply least-privilege authorizations separately for the external source and Fabric destination","why":"Correct: The identity needs rights at every participating boundary."},{"id":"C","text":"A principal automatically bypasses MFA, licensing and tenant restrictions for all workloads","why":"Incorrect: No universal policy bypass exists."},{"id":"D","text":"Check whether each target connector and tenant policy support the intended identity before choosing it","why":"Correct: An identity type may be unsupported in a given connector or operation."},{"id":"E","text":"A principal's name is a substitute for granting item-level permissions","why":"Incorrect: Names do not confer rights."}],"correct":["B","D"],"explanation":"An identity type may be unsupported in a given connector or operation. The identity needs rights at every participating boundary.","videoSeconds":1962,"refs":["vref_00ff45f03a04122b","pactivity","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"a-national-retail-lakehouse-modernization","sourceObjective":"DP-600 Prepare data / Create a data connection","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=1962s"},{"id":"fb-v14-pipe-025","sourceId":"V14-PIPE-025","pack":"video14","topic":"Parameters, variables and nested execution","title":"pipeline parameter semantics","prompt":"An ingestion pipeline should handle five customer IDs supplied by a parent pipeline at execution time. No ID changes after that run begins. Which mechanism should carry the IDs?","type":"single","options":[{"id":"A","text":"Store the IDs only in a Set Variable task in the child with no caller input","why":"Incorrect: Without forwarding values the child cannot discover caller-specific input reliably."},{"id":"B","text":"Use the run monitor's capacity column as the source of IDs","why":"Incorrect: Capacity details are not application configuration."},{"id":"C","text":"Define an array parameter and pass it from the parent to the child pipeline","why":"Correct: Parameters are run inputs and are suitable for caller-provided stable configuration."},{"id":"D","text":"Hard-code one default ID into every Copy activity","why":"Incorrect: Hard-coding cannot meet dynamic per-run requirements."}],"correct":["C"],"explanation":"Parameters are run inputs and are suitable for caller-provided stable configuration.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-026","sourceId":"V14-PIPE-026","pack":"video14","topic":"Parameters, variables and nested execution","title":"mutable variable versus input parameter","prompt":"A pipeline must update a running processed-file counter as successive activities complete. Which mechanism matches this requirement?","type":"single","options":[{"id":"A","text":"Use a pipeline parameter and mutate it inside each activity","why":"Incorrect: Parameters are intended to remain immutable during a run."},{"id":"B","text":"Use a Lakehouse shortcut to count files in the pipeline runtime","why":"Incorrect: Shortcuts are data references rather than pipeline variables."},{"id":"C","text":"Use the pipeline name as an integer accumulator","why":"Incorrect: Names are not mutable counters."},{"id":"D","text":"Use a pipeline variable updated by activity logic, while respecting sequencing and concurrency requirements","why":"Correct: Variables hold mutable run-state within a pipeline."}],"correct":["D"],"explanation":"Variables hold mutable run-state within a pipeline.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-027","sourceId":"V14-PIPE-027","pack":"video14","topic":"Parameters, variables and nested execution","title":"parallel state collision","prompt":"An engineer stores the currently processed file name in a pipeline-scoped variable inside 20 parallel ForEach iterations. Some output paths point to the wrong file. What is the likely root cause?","type":"single","options":[{"id":"A","text":"Shared pipeline variables are not thread-safe in parallel iteration; reference the current item directly or isolate state per child run","why":"Correct: Concurrent writes can overwrite the shared value before downstream child activities read it."},{"id":"B","text":"The service always sorts file names alphabetically within a parallel loop","why":"Incorrect: Parallel ordering does not explain shared-state data races."},{"id":"C","text":"The Lakehouse SQL endpoint cannot return file names","why":"Incorrect: File names come from iteration metadata, not necessarily SQL."},{"id":"D","text":"ForEach supports only one element per pipeline","why":"Incorrect: Parallel ForEach can process collections; the issue is shared mutable state."}],"correct":["A"],"explanation":"Concurrent writes can overwrite the shared value before downstream child activities read it.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-028","sourceId":"V14-PIPE-028","pack":"video14","topic":"Parameters, variables and nested execution","title":"child parameter binding","prompt":"A master pipeline passes country='EG' to a child, but the child always reads its default country='US'. What should be investigated first?","type":"single","options":[{"id":"A","text":"Change the child's workspace description","why":"Incorrect: Workspace descriptions do not transmit parameters."},{"id":"B","text":"Check Invoke Pipeline parameter mappings and the child's parameter reference name and type","why":"Correct: A child parameter must actually receive the parent's runtime value."},{"id":"C","text":"Enable metadata scanning in the semantic model","why":"Incorrect: Semantic-model scans do not propagate pipeline arguments."},{"id":"D","text":"Increase the retry count to 1000","why":"Incorrect: Repeated execution with wrong mapping repeats the same logical error."}],"correct":["B"],"explanation":"A child parameter must actually receive the parent's runtime value.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-029","sourceId":"V14-PIPE-029","pack":"video14","topic":"Parameters, variables and nested execution","title":"typed structured parameters","prompt":"An analyst wants to iterate through a list of table descriptors, and each descriptor has tableName and partitionKey properties. Which approach avoids fragile positional parsing?","type":"single","options":[{"id":"A","text":"Concatenate all property values into one unescaped CSV string then split blindly","why":"Incorrect: Delimiter collisions and positional coupling are brittle."},{"id":"B","text":"Store descriptors in the query monitor UX and read them back as parameters","why":"Incorrect: Monitoring UX is not a configuration store."},{"id":"C","text":"Pass an array of objects as a parameter and reference properties by name from @item() within ForEach","why":"Correct: Named object properties support robust metadata-driven activity configuration."},{"id":"D","text":"Create one pipeline for each possible row index manually","why":"Incorrect: Manual duplication undermines metadata-driven design."}],"correct":["C"],"explanation":"Named object properties support robust metadata-driven activity configuration.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-030","sourceId":"V14-PIPE-030","pack":"video14","topic":"Parameters, variables and nested execution","title":"parameter typing in conditions","prompt":"A developer builds an If Condition expression using a parameter that is actually a string 'false'. The intended behavior is a true boolean condition. Which remedy is most appropriate?","type":"single","options":[{"id":"A","text":"Change the parameter name to BooleanValue without changing its type","why":"Incorrect: Naming doesn't convert the runtime value."},{"id":"B","text":"Put the string into a warehouse table and expect automatic coercion to boolean","why":"Incorrect: Storage location does not ensure expression typing."},{"id":"C","text":"Enable parallelism so strings become booleans on different workers","why":"Incorrect: Concurrency never repairs a type mismatch."},{"id":"D","text":"Use a Boolean-typed parameter or an explicit valid conversion/comparison that yields a boolean","why":"Correct: Control conditions require the expected data type rather than a merely truthy-looking string."}],"correct":["D"],"explanation":"Control conditions require the expected data type rather than a merely truthy-looking string.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-031","sourceId":"V14-PIPE-031","pack":"video14","topic":"Parameters, variables and nested execution","title":"parameter/variable ownership","prompt":"A child pipeline must perform repeatable ingestion with caller-supplied source and internally computed results. Select TWO correct designs.","type":"multi","options":[{"id":"A","text":"Use variables for intermediate state such as counters when safely sequenced","why":"Correct: Variables can hold changing internal state during the execution."},{"id":"B","text":"Use a shared variable inside parallel ForEach as a guaranteed thread-local copy","why":"Incorrect: Variables are scoped to pipeline, not automatically to each loop iteration."},{"id":"C","text":"Use pipeline parameters for caller-supplied source and execution-mode values","why":"Correct: Parameters capture immutable inputs to a particular invocation."},{"id":"D","text":"Use a parameter as a mutable accumulator after every copy","why":"Incorrect: Parameter values should not be mutated during a run."},{"id":"E","text":"Require every parameter to be stored in a semantic model","why":"Incorrect: Pipeline parameters are not Power BI model parameters."}],"correct":["A","C"],"explanation":"Parameters capture immutable inputs to a particular invocation. Variables can hold changing internal state during the execution.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-032","sourceId":"V14-PIPE-032","pack":"video14","topic":"Parameters, variables and nested execution","title":"configuration contracts and concurrency","prompt":"A deployment reviewer wants to prevent failures involving run-specific configuration. Select TWO meaningful validations.","type":"multi","options":[{"id":"A","text":"Treat missing child mappings as automatically inheriting all parent parameters","why":"Incorrect: Parameter values are not universally auto-propagated."},{"id":"B","text":"Test variable mutation with intended sequential/parallel control-flow semantics","why":"Correct: Race conditions arise when mutable state is accessed concurrently."},{"id":"C","text":"Assume every string interpolation retains the original numeric type","why":"Incorrect: String interpolation converts to text and may break typed fields."},{"id":"D","text":"Use one global variable to store every table's file path simultaneously under parallel loads","why":"Incorrect: Shared overwrites make per-item state unreliable."},{"id":"E","text":"Check required parameter values, data types, defaults and child-pipeline argument mapping","why":"Correct: Strong parameter contracts prevent silent fallback or wrong activity paths."}],"correct":["B","E"],"explanation":"Strong parameter contracts prevent silent fallback or wrong activity paths. Race conditions arise when mutable state is accessed concurrently.","videoSeconds":2538,"refs":["vref_554887adb8d7c00c","vref_9ed52162c3860469","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 Prepare data / Ingest or access data; DP-700 enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=2538s"},{"id":"fb-v14-pipe-033","sourceId":"V14-PIPE-033","pack":"video14","topic":"Expression language and dynamic content","title":"interpolation vs typed expression","prompt":"A notebook invocation expects an integer 42, but a pipeline expression supplies '@{pipeline().parameters.batchSize}' and the receiving field sees text. What explains the behavior?","type":"single","options":[{"id":"A","text":"String interpolation using @{...} yields text; a standalone @pipeline().parameters.batchSize expression retains the numeric type","why":"Correct: The Fabric expression documentation distinguishes interpolation output from typed expression evaluation."},{"id":"B","text":"Numeric parameters are never supported in Fabric pipelines","why":"Incorrect: Numbers are supported and can remain numeric with the correct syntax."},{"id":"C","text":"The notebook automatically casts every integer to text irrespective of pipeline expressions","why":"Incorrect: The pipeline expression itself can change the type."},{"id":"D","text":"A Copy activity always returns text, even without Copy in the workflow","why":"Incorrect: The error concerns expression interpolation, not Copy."}],"correct":["A"],"explanation":"The Fabric expression documentation distinguishes interpolation output from typed expression evaluation.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-034","sourceId":"V14-PIPE-034","pack":"video14","topic":"Expression language and dynamic content","title":"system runtime properties","prompt":"A pipeline needs the current pipeline run identifier for an auditable output prefix. Which expression references the runtime run identity rather than a newly generated clock timestamp?","type":"single","options":[{"id":"A","text":"@utcnow()","why":"Incorrect: This returns the current time rather than the pipeline run identity."},{"id":"B","text":"@pipeline().RunId","why":"Correct: This built-in run-scoped identifier supports correlating ingestion output with execution history."},{"id":"C","text":"@pipeline().parameters.RunId without defining a parameter","why":"Incorrect: This assumes a user parameter that might not exist."},{"id":"D","text":"@item() in an activity outside a ForEach","why":"Incorrect: The current-item context is for iteration, not pipeline run identity."}],"correct":["B"],"explanation":"This built-in run-scoped identifier supports correlating ingestion output with execution history.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-035","sourceId":"V14-PIPE-035","pack":"video14","topic":"Expression language and dynamic content","title":"expression function composition","prompt":"A file naming standard requires 'sales_2026-10-24.csv' based on the current UTC date. Which pattern most directly applies the pipeline expression language?","type":"single","options":[{"id":"A","text":"@sum('sales_', utcnow(), '.csv')","why":"Incorrect: sum is not a string concatenation operation."},{"id":"B","text":"@pipeline().name + '.csv'","why":"Incorrect: Pipeline identity alone cannot give the required date-shaped name."},{"id":"C","text":"@concat('sales_', formatDateTime(utcnow(), 'yyyy-MM-dd'), '.csv')","why":"Correct: Concatenation and date formatting explicitly construct the required filename."},{"id":"D","text":"A literal 'sales_@utcnow.csv' without interpolation","why":"Incorrect: Unescaped literal text will not evaluate the function as intended."}],"correct":["C"],"explanation":"Concatenation and date formatting explicitly construct the required filename.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-036","sourceId":"V14-PIPE-036","pack":"video14","topic":"Expression language and dynamic content","title":"activity output path and shape","prompt":"An API response is represented as an activity output object containing a property named records. A Copy activity must use that property dynamically. Which conceptual reference is correct?","type":"single","options":[{"id":"A","text":"Use pipeline().parameters.records regardless of whether the parameter exists","why":"Incorrect: An activity result is not automatically a pipeline input parameter."},{"id":"B","text":"Use item() even though there is no ForEach","why":"Incorrect: item() is specific to iteration context."},{"id":"C","text":"Use dataset('FetchAPI').records as universal activity-output syntax","why":"Incorrect: Data-source dataset notation is not the normal activity-output accessor."},{"id":"D","text":"Reference the predecessor using activity('FetchAPI').output and then its records property using the documented output shape","why":"Correct: Activity outputs are read through the activity expression, followed by properties matching the actual JSON."}],"correct":["D"],"explanation":"Activity outputs are read through the activity expression, followed by properties matching the actual JSON.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-037","sourceId":"V14-PIPE-037","pack":"video14","topic":"Expression language and dynamic content","title":"escaping expression prefix","prompt":"A developer writes a literal string that should begin with an @ sign, but Fabric interprets it as an expression. What is the documented escape convention?","type":"single","options":[{"id":"A","text":"Use @@ to express a literal leading @ in an expression-bearing string value","why":"Correct: Doubling the character escapes expression interpretation."},{"id":"B","text":"Wrap the @ sign in two dollar signs","why":"Incorrect: Dollar signs are not the documented escaping rule."},{"id":"C","text":"Always remove @ from the original business value","why":"Incorrect: Removing required content changes data semantics."},{"id":"D","text":"Move the text to a semantic-model measure","why":"Incorrect: A model measure doesn't solve pipeline literal syntax."}],"correct":["A"],"explanation":"Doubling the character escapes expression interpretation.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-038","sourceId":"V14-PIPE-038","pack":"video14","topic":"Expression language and dynamic content","title":"runtime JSON traversal","prompt":"A pipeline expressions editor accepts a property path but it fails during execution after an upstream Lookup changed from First row only to multiple rows. What should be checked?","type":"single","options":[{"id":"A","text":"Every Fabric activity output has the same JSON shape","why":"Incorrect: Different modes and activities produce different object structures."},{"id":"B","text":"The output shape changed from firstRow object to value array, so update the accessor and downstream structure","why":"Correct: Expression references must follow the real output JSON shape."},{"id":"C","text":"The source connection must be changed from SQL to KQL","why":"Incorrect: The error comes from object shape, not necessarily connector dialect."},{"id":"D","text":"Rename the data pipeline until the field reappears","why":"Incorrect: Pipeline names do not repair invalid output references."}],"correct":["B"],"explanation":"Expression references must follow the real output JSON shape.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-039","sourceId":"V14-PIPE-039","pack":"video14","topic":"Expression language and dynamic content","title":"typed expression review","prompt":"An engineering team wants expressions that are robust to downstream field types. Which TWO practices are sound?","type":"multi","options":[{"id":"A","text":"Assume any undefined property evaluates to zero","why":"Incorrect: A missing field is not guaranteed to coerce safely."},{"id":"B","text":"Use @item() as a replacement for every system and pipeline function","why":"Incorrect: item() only represents the current ForEach item."},{"id":"C","text":"Use string interpolation for every field because it preserves all data types","why":"Incorrect: Interpolation always yields text, which can be wrong for numeric fields."},{"id":"D","text":"Use typed stand-alone expressions where a numeric or Boolean output is required","why":"Correct: Standalone expressions can retain their native return types."},{"id":"E","text":"Inspect actual activity outputs before authoring nested property accessors","why":"Correct: A correct path depends on firstRow versus value arrays and source-specific fields."}],"correct":["D","E"],"explanation":"Standalone expressions can retain their native return types. A correct path depends on firstRow versus value arrays and source-specific fields.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-040","sourceId":"V14-PIPE-040","pack":"video14","topic":"Expression language and dynamic content","title":"expressions for lineage versus transaction guarantees","prompt":"A financial ingestion solution needs a date-partitioned folder and verifiable run lineage. Which TWO values can legitimately be constructed in Fabric expression language?","type":"multi","options":[{"id":"A","text":"A deterministic folder path from an explicitly supplied business date parameter","why":"Correct: A parameter stabilizes the partition key across retry attempts for the same business date."},{"id":"B","text":"A guaranteed exactly-once commitment derived solely from @utcnow()","why":"Incorrect: A timestamp string does not impose idempotent storage semantics."},{"id":"C","text":"A permission grant by concatenating a workspace name into text","why":"Incorrect: Generating a string does not confer item-level access."},{"id":"D","text":"A run-correlation field derived from @pipeline().RunId","why":"Correct: The runtime run ID identifies an execution for audit and diagnostics."},{"id":"E","text":"The secret value of any Key Vault reference from a random activity name without access checks","why":"Incorrect: Expressions do not bypass authentication or authorization."}],"correct":["A","D"],"explanation":"A parameter stabilizes the partition key across retry attempts for the same business date. The runtime run ID identifies an execution for audit and diagnostics.","videoSeconds":3556,"refs":["pexpr","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data access; DP-700 orchestration enrichment","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=3556s"},{"id":"fb-v14-pipe-041","sourceId":"V14-PIPE-041","pack":"video14","topic":"If Condition and dependency outcomes","title":"business meaning of empty result","prompt":"A data source may legitimately have zero new records. A pipeline should skip loading but still log a successful empty-batch result. Which control flow should be built?","type":"single","options":[{"id":"A","text":"Force Copy to fail whenever the count is zero","why":"Incorrect: A valid empty batch is not necessarily an error."},{"id":"B","text":"Trigger the pipeline twice and accept whichever copy finishes first","why":"Incorrect: Duplicate runs do not establish correct no-data behavior."},{"id":"C","text":"If Condition on the row-count output, with true branch running Copy and false branch writing a no-data audit","why":"Correct: Branching distinguishes an expected empty result from a failed ingestion."},{"id":"D","text":"Delete the condition and always perform a full load","why":"Incorrect: A full load violates efficient conditional processing."}],"correct":["C"],"explanation":"Branching distinguishes an expected empty result from a failed ingestion.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-042","sourceId":"V14-PIPE-042","pack":"video14","topic":"If Condition and dependency outcomes","title":"failure edge semantics","prompt":"A pipeline must execute a corrective step only if Copy Data fails. Which dependency expresses the requirement without executing on successful copies?","type":"single","options":[{"id":"A","text":"Upon Success from Copy to the corrective action","why":"Incorrect: Success edges run on the wrong status."},{"id":"B","text":"A static canvas alignment below Copy","why":"Incorrect: Placement does not set dependency semantics."},{"id":"C","text":"A simultaneous schedule for correction","why":"Incorrect: Separate timing does not correlate the failure status."},{"id":"D","text":"Upon Failure from Copy to the corrective action","why":"Correct: Failure-specific dependency targets the exceptional branch."}],"correct":["D"],"explanation":"Failure-specific dependency targets the exceptional branch.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-043","sourceId":"V14-PIPE-043","pack":"video14","topic":"If Condition and dependency outcomes","title":"completed versus succeeded","prompt":"A monitoring notification should run after both a successful and failed attempt, but needs to examine the result. Which dependency principle is appropriate?","type":"single","options":[{"id":"A","text":"Use an Upon Completion path when applicable, then inspect status or output in a downstream condition","why":"Correct: Completion-oriented dependencies do not require successful execution, while later logic can classify outcome."},{"id":"B","text":"Use only Upon Success and assume failure triggers it as well","why":"Incorrect: Success does not include failed outcomes."},{"id":"C","text":"Use a global variable changed by Copy even if Copy is skipped","why":"Incorrect: Skipped activities may not write expected values."},{"id":"D","text":"Trigger notification before Copy starts","why":"Incorrect: A prior notification cannot report the resulting run outcome."}],"correct":["A"],"explanation":"Completion-oriented dependencies do not require successful execution, while later logic can classify outcome.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-044","sourceId":"V14-PIPE-044","pack":"video14","topic":"If Condition and dependency outcomes","title":"condition type guarantee","prompt":"An If Condition child is configured with a string expression 'True' instead of an actual Boolean. What issue should be corrected?","type":"single","options":[{"id":"A","text":"Add more options to the false branch to convert its type automatically","why":"Incorrect: Branch content doesn't cast the condition expression."},{"id":"B","text":"Ensure the expression evaluates to Boolean true or false in the activity's typed field","why":"Correct: If Condition expects a Boolean result for correct routing."},{"id":"C","text":"Use a Copy Data destination to store 'True'","why":"Incorrect: Moving text does not correct the activity expression."},{"id":"D","text":"Rename the parent activity to Boolean","why":"Incorrect: Names do not enforce expression types."}],"correct":["B"],"explanation":"If Condition expects a Boolean result for correct routing.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-045","sourceId":"V14-PIPE-045","pack":"video14","topic":"If Condition and dependency outcomes","title":"branch graph correctness","prompt":"A pipeline has two downstream controls: one executes when transformation succeeds, another handles errors. The analyst proposes connecting them sequentially in one success-only chain. What is the weakness?","type":"single","options":[{"id":"A","text":"Success arrows automatically convert to failure arrows when an upstream job fails","why":"Incorrect: Dependency conditions don't dynamically change to fix a bad graph."},{"id":"B","text":"Failure handling must always happen inside a semantic model","why":"Incorrect: Semantic models are not the pipeline control-flow graph."},{"id":"C","text":"It can suppress the failure handler when the success path is skipped; model separate status dependencies on the activity being watched","why":"Correct: Failure paths must be wired for their own triggering status."},{"id":"D","text":"Every pair of activities must be connected with every possible condition","why":"Incorrect: Overbroad dependency edges can produce unwanted behavior."}],"correct":["C"],"explanation":"Failure paths must be wired for their own triggering status.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-046","sourceId":"V14-PIPE-046","pack":"video14","topic":"If Condition and dependency outcomes","title":"metadata-based validation branch","prompt":"A schema check discovers a newly added optional column. The requirement is to proceed only when supported columns are present, otherwise quarantine. What control flow belongs after metadata inspection?","type":"single","options":[{"id":"A","text":"Increase the pipeline retry interval until the column disappears","why":"Incorrect: Retries don't resolve a stable incompatible schema."},{"id":"B","text":"Use ForEach with an empty list and report success","why":"Incorrect: Skipping the processing silently does not implement quarantine."},{"id":"C","text":"Disable the Get Metadata step and copy blindly","why":"Incorrect: Skipping validation defeats the requirement."},{"id":"D","text":"Compute a Boolean compatibility expression and route through If Condition to load or quarantine","why":"Correct: Metadata and conditional branching provide a traceable quality gate."}],"correct":["D"],"explanation":"Metadata and conditional branching provide a traceable quality gate.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-047","sourceId":"V14-PIPE-047","pack":"video14","topic":"If Condition and dependency outcomes","title":"dependence and branching semantics","prompt":"In a pipeline with Copy, validation, and notification activities, which TWO statements about dependency control are correct?","type":"multi","options":[{"id":"A","text":"A failed source activity turns all later Upon Success edges into Upon Failure automatically","why":"Incorrect: Dependencies retain their configured meanings."},{"id":"B","text":"Every If Condition must have only one possible branch of activities","why":"Incorrect: Both true and false branches can contain activities."},{"id":"C","text":"Placing a notification visually right of Copy guarantees it runs afterward","why":"Incorrect: Canvas position is cosmetic without graph edges."},{"id":"D","text":"On-completion handling may require additional logic to distinguish success versus failure","why":"Correct: Completion runs for multiple terminal outcomes; route content accordingly."},{"id":"E","text":"An activity can be conditioned on the upstream activity's success or failure","why":"Correct: Dependencies attach explicit upstream status conditions."}],"correct":["D","E"],"explanation":"Dependencies attach explicit upstream status conditions. Completion runs for multiple terminal outcomes; route content accordingly.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-048","sourceId":"V14-PIPE-048","pack":"video14","topic":"If Condition and dependency outcomes","title":"empty data vs failure triage","prompt":"A payment-data quality gate should distinguish benign no-change runs from true failures. Which TWO practices best fit?","type":"multi","options":[{"id":"A","text":"Use a count or metadata check to select an explicit no-data branch without raising a fake failure","why":"Correct: Expected empty data is a supported business state, not necessarily an operational incident."},{"id":"B","text":"Wire a separate failure-specific branch for connector, permission, or load exceptions","why":"Correct: Operational errors need their own recovery or alert path."},{"id":"C","text":"Send a success notification before querying the source","why":"Incorrect: It reports success without verifying conditions."},{"id":"D","text":"Fail every scheduled run with zero new rows regardless of requirements","why":"Incorrect: This confuses unchanged data with malfunction."},{"id":"E","text":"Assume a successful If Condition proves each destination table was updated","why":"Incorrect: Branch decision success does not prove the sink data was written."}],"correct":["A","B"],"explanation":"Expected empty data is a supported business state, not necessarily an operational incident. Operational errors need their own recovery or alert path.","videoSeconds":4459,"refs":["vref_1bbb4022a97b3061","pactivity"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"b-regional-healthcare-exchange","sourceObjective":"DP-600 supporting data preparation; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4459s"},{"id":"fb-v14-pipe-049","sourceId":"V14-PIPE-049","pack":"video14","topic":"Scheduling and monitoring","title":"time-zone schedule correctness","prompt":"An Egypt-based business needs a daily 08:00 Cairo pipeline with daylight-saving behavior respected by scheduler configuration. What should the operator do?","type":"single","options":[{"id":"A","text":"Select the intended time zone in the schedule, configure both bounds and verify local-time occurrences around clock changes","why":"Correct: A named time-zone schedule expresses business-local time more reliably than fixed UTC offsets."},{"id":"B","text":"Hard-code UTC+2 forever without checking local offset changes","why":"Incorrect: A static offset may not track real local clock rules."},{"id":"C","text":"Set two activities on the canvas at 08:00 rather than schedule the pipeline","why":"Incorrect: Activity position does not create a trigger."},{"id":"D","text":"Use utcnow() in a Notebook to schedule Fabric automatically","why":"Incorrect: An expression returns a value; it is not by itself a schedule."}],"correct":["A"],"explanation":"A named time-zone schedule expresses business-local time more reliably than fixed UTC offsets.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-050","sourceId":"V14-PIPE-050","pack":"video14","topic":"Scheduling and monitoring","title":"scheduled time window requirements","prompt":"A team wants a Fabric pipeline to run indefinitely but the schedule editor requests both start and end dates. What should be configured?","type":"single","options":[{"id":"A","text":"Leave the end date empty and bypass validation with a variable","why":"Incorrect: The documented scheduling flow does not support an open-ended bound."},{"id":"B","text":"Specify a suitably distant valid end date and maintain the schedule under operational controls","why":"Correct: Current pipeline schedules require both bounds; a distant end date can support long-running use."},{"id":"C","text":"Use a report bookmark as the end date","why":"Incorrect: Bookmarks do not define schedule boundaries."},{"id":"D","text":"Use one fixed Wait activity that runs forever","why":"Incorrect: A permanently waiting activity is not a durable scheduler."}],"correct":["B"],"explanation":"Current pipeline schedules require both bounds; a distant end date can support long-running use.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-051","sourceId":"V14-PIPE-051","pack":"video14","topic":"Scheduling and monitoring","title":"event versus data readiness","prompt":"A file-triggered pipeline sometimes runs before an upstream file upload is complete. What is the safest design change?","type":"single","options":[{"id":"A","text":"Increase Copy's connector parallelism","why":"Incorrect: Parallelism won't make an incomplete file correct."},{"id":"B","text":"Turn off failure notification","why":"Incorrect: Hiding symptoms doesn't fix data readiness."},{"id":"C","text":"Use a verified completion protocol or event semantics and apply data-readiness checks before ingestion","why":"Correct: File arrival alone may not imply a finished write, depending on the source process."},{"id":"D","text":"Assume every event has exactly-once delivery with complete payload guaranteed","why":"Incorrect: Event integrations and producer behavior require explicit contracts."}],"correct":["C"],"explanation":"File arrival alone may not imply a finished write, depending on the source process.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-052","sourceId":"V14-PIPE-052","pack":"video14","topic":"Scheduling and monitoring","title":"duplicate trigger audit","prompt":"Operations sees the same pipeline begin at 08:00 and 08:05 despite one expected daily run. What should be inspected first?","type":"single","options":[{"id":"A","text":"Increase the activity timeout to 24 hours","why":"Incorrect: Timeout won't explain unexpected additional starts."},{"id":"B","text":"Delete the output tables before each invocation","why":"Incorrect: Destroying data cannot identify the trigger."},{"id":"C","text":"Switch all ForEach loops to sequential mode","why":"Incorrect: Loop iteration parallelism does not explain pipeline-level starts."},{"id":"D","text":"Review all configured schedules, event triggers, manual invocations and parent-pipeline callers using run metadata","why":"Correct: Multiple invocation mechanisms can produce additional runs independent of a single schedule."}],"correct":["D"],"explanation":"Multiple invocation mechanisms can produce additional runs independent of a single schedule.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-053","sourceId":"V14-PIPE-053","pack":"video14","topic":"Scheduling and monitoring","title":"activity-level monitoring","prompt":"A data engineer wants run-specific evidence of where an activity failed and how many rows Copy wrote. Which monitoring path is appropriate?","type":"single","options":[{"id":"A","text":"Inspect pipeline run history and activity inputs/outputs and Copy execution metrics, subject to secure logging settings","why":"Correct: Per-activity diagnostics provide operational details beyond an overall success indicator."},{"id":"B","text":"Check only the report's visual title","why":"Incorrect: A report title has no run status."},{"id":"C","text":"Inspect a Git commit author as proof of Copy row counts","why":"Incorrect: Source control history does not report runtime throughput."},{"id":"D","text":"Use the workspace display name as the row count","why":"Incorrect: Workspace names are unrelated to execution metrics."}],"correct":["A"],"explanation":"Per-activity diagnostics provide operational details beyond an overall success indicator.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-054","sourceId":"V14-PIPE-054","pack":"video14","topic":"Scheduling and monitoring","title":"interval preview limitations","prompt":"An auditor requests a precise schedule window and backfill of every missed interval after a Fabric outage. The operator assumes interval-based schedules support full historical backfill automatically. What is the verified caution?","type":"single","options":[{"id":"A","text":"Every fixed schedule already creates immutable backfilled interval jobs automatically","why":"Incorrect: Basic clock schedules are not a universal backfill engine."},{"id":"B","text":"Interval-based schedules are preview and documented time-slice monitoring/backfill gaps require a separate recovery plan","why":"Correct: Current documentation does not promise full historical backfill for this feature."},{"id":"C","text":"ForEach automatically replays past missed schedule windows","why":"Incorrect: Looping is not a historical scheduler."},{"id":"D","text":"Use the Monitor hub's filter to execute missed runs","why":"Incorrect: Filtering history does not replay executions."}],"correct":["B"],"explanation":"Current documentation does not promise full historical backfill for this feature.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-055","sourceId":"V14-PIPE-055","pack":"video14","topic":"Scheduling and monitoring","title":"multi-trigger control","prompt":"A pipeline must run after file arrival and also accommodate monthly reconciliation. Which TWO design statements are reasonable?","type":"multi","options":[{"id":"A","text":"Configure a separate monthly schedule while ensuring deduplication or concurrency controls if schedules overlap","why":"Correct: Multiple invocation paths require safe overlap handling."},{"id":"B","text":"Assume time-zone changes cannot affect local scheduled times","why":"Incorrect: Clock rules matter for local scheduling."},{"id":"C","text":"Expect the monthly run to happen automatically when an event trigger exists","why":"Incorrect: Events don't express monthly calendar requirements."},{"id":"D","text":"Depend only on a file's modification timestamp as proof it is final","why":"Incorrect: Modification is not guaranteed completion in every producer workflow."},{"id":"E","text":"Configure supported event trigger rules for arrival-driven runs, with readiness checks as needed","why":"Correct: Events can start pipelines based on qualifying upstream changes."}],"correct":["A","E"],"explanation":"Events can start pipelines based on qualifying upstream changes. Multiple invocation paths require safe overlap handling.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-056","sourceId":"V14-PIPE-056","pack":"video14","topic":"Scheduling and monitoring","title":"audit before remediation","prompt":"A team wants to diagnose unexpected reruns while avoiding unnecessary changes to production. Which TWO steps should come first?","type":"multi","options":[{"id":"A","text":"Delete run histories as an initial remediation","why":"Incorrect: Removing evidence blocks root-cause analysis."},{"id":"B","text":"Rename the pipeline because similar names cause duplicate executions automatically","why":"Incorrect: Names alone are not a documented duplicate-run mechanism."},{"id":"C","text":"Disable every trigger without documenting current state","why":"Incorrect: Blind intervention disrupts operations and loses evidence."},{"id":"D","text":"Inventory active schedule and trigger definitions before changing them","why":"Correct: Inspection can identify overlapping registrations safely."},{"id":"E","text":"Correlate Monitor run IDs with invocation sources, times and statuses","why":"Correct: Run metadata helps distinguish events, schedules and callers."}],"correct":["D","E"],"explanation":"Run metadata helps distinguish events, schedules and callers. Inspection can identify overlapping registrations safely.","videoSeconds":4986,"refs":["pruns","vref_cdc585e4090bf21a","vref_831d9c2916440c43"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=4986s"},{"id":"fb-v14-pipe-057","sourceId":"V14-PIPE-057","pack":"video14","topic":"ForEach and parallel iteration","title":"metadata-driven iteration","prompt":"A Lakehouse folder contains descriptors for 60 CSV files, each with unique delimiter settings. Which design avoids 60 manually duplicated Copy activities?","type":"single","options":[{"id":"A","text":"Write 60 identical activities with hard-coded file names and repeat every time a source is added","why":"Incorrect: This creates maintenance overhead and weak configuration control."},{"id":"B","text":"Use one Set Variable to magically split source files into destination tables","why":"Incorrect: A variable is not an ingestion loop."},{"id":"C","text":"Drive a ForEach with an array of file descriptors and parameterize the child Copy activity by @item() fields","why":"Correct: Iteration with per-item metadata scales one copy definition across changing files."},{"id":"D","text":"Use 60 report-level slicers to choose files","why":"Incorrect: Report slicers do not perform ingestion."}],"correct":["C"],"explanation":"Iteration with per-item metadata scales one copy definition across changing files.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-058","sourceId":"V14-PIPE-058","pack":"video14","topic":"ForEach and parallel iteration","title":"concurrency cap versus guaranteed actual parallelism","prompt":"A ForEach is configured for parallel processing with Batch count 30. A junior engineer says exactly 30 items will run simultaneously at all times. What's the correction?","type":"single","options":[{"id":"A","text":"Every batch must contain precisely 30 items, including the final batch","why":"Incorrect: A remainder cannot fill 30 slots without additional items."},{"id":"B","text":"Only sequential mode exists in Fabric ForEach","why":"Incorrect: Parallel mode is documented."},{"id":"C","text":"Batch count controls the number of source columns, not iterations","why":"Incorrect: Batch count is about parallel iteration execution."},{"id":"D","text":"Batch count is an upper concurrency bound; actual parallelism can be lower due to runtime limits, dependencies and resource availability","why":"Correct: The configured batch count is not an exact throughput promise."}],"correct":["D"],"explanation":"The configured batch count is not an exact throughput promise.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-059","sourceId":"V14-PIPE-059","pack":"video14","topic":"ForEach and parallel iteration","title":"parallel sink race prevention","prompt":"A loop ingests regional inventory files into the same Warehouse staging table using overwrite behavior. Parallel runs intermittently erase each other's batches. What is the most defensible change?","type":"single","options":[{"id":"A","text":"Redesign to independent destinations or a safe merge/staging strategy; use sequential iteration where writes conflict","why":"Correct: Parallel writes with incompatible overwrite semantics can produce lost data."},{"id":"B","text":"Increase Batch count to 50 to shorten the overwrite race","why":"Incorrect: More overlapping overwrites can worsen data loss."},{"id":"C","text":"Change the dataset title while leaving sink behavior unchanged","why":"Incorrect: Names don't address shared-write conflicts."},{"id":"D","text":"Set a shared variable with the current region in every parallel branch","why":"Incorrect: Shared variable races make data routing less reliable."}],"correct":["A"],"explanation":"Parallel writes with incompatible overwrite semantics can produce lost data.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-060","sourceId":"V14-PIPE-060","pack":"video14","topic":"ForEach and parallel iteration","title":"iteration-context expression","prompt":"A ForEach loops over ['EG','SA','AE'] and a child activity needs the current country string. Which expression is the direct mechanism?","type":"single","options":[{"id":"A","text":"@pipeline().RunId","why":"Incorrect: Run ID identifies a run, not the country item."},{"id":"B","text":"@item() inside the ForEach child activity","why":"Correct: The current iterator item is directly available to nested child activities."},{"id":"C","text":"@utcnow()","why":"Incorrect: Current time does not identify a country entry."},{"id":"D","text":"@activity('ForEach').output.firstRow","why":"Incorrect: ForEach is not a Lookup returning that object shape."}],"correct":["B"],"explanation":"The current iterator item is directly available to nested child activities.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-061","sourceId":"V14-PIPE-061","pack":"video14","topic":"ForEach and parallel iteration","title":"ForEach object-property binding","prompt":"A processing team wants a loop of region objects each with fileName and delimiter. The child Copy should read the delimiter property. Which accessor is conceptually correct?","type":"single","options":[{"id":"A","text":"@pipeline().delimiter with no definition","why":"Incorrect: A pipeline object does not invent a delimiter field."},{"id":"B","text":"@activity('Copy').output.delimiter before Copy executes","why":"Incorrect: A future activity's output cannot supply its own configuration."},{"id":"C","text":"@item().delimiter, after confirming the current item is an object containing that property","why":"Correct: The iterator object can expose named properties to child configurations."},{"id":"D","text":"@item()[99] regardless of object structure","why":"Incorrect: Blind positional indexing conflicts with a named-object input."}],"correct":["C"],"explanation":"The iterator object can expose named properties to child configurations.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-062","sourceId":"V14-PIPE-062","pack":"video14","topic":"ForEach and parallel iteration","title":"metadata pagination limit","prompt":"A pipeline looks up 4,800 table records and feeds them to ForEach; later the configuration grows past 5,000 records. What architecture change preserves completeness?","type":"single","options":[{"id":"A","text":"Assume ForEach will iterate all source records even if Lookup returns only 5,000","why":"Incorrect: ForEach only sees values actually returned by its upstream activity."},{"id":"B","text":"Keep the design unchanged because Lookup has no record limit","why":"Incorrect: The documented cap is 5,000 rows."},{"id":"C","text":"Store the full records in a single pipeline variable with no size considerations","why":"Incorrect: Payload and object size limits still apply."},{"id":"D","text":"Partition or page metadata retrieval and invoke appropriately bounded child pipelines or batches","why":"Correct: Lookup truncation limits require a deliberate paging/batching design."}],"correct":["D"],"explanation":"Lookup truncation limits require a deliberate paging/batching design.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-063","sourceId":"V14-PIPE-063","pack":"video14","topic":"ForEach and parallel iteration","title":"parallel loop safety","prompt":"A data engineer wants safe parallel iteration over different target tables. Which TWO conditions support that design?","type":"multi","options":[{"id":"A","text":"Batch count 50 guarantees 50 simultaneous runs despite capacity throttling","why":"Incorrect: Upper bound is not a guarantee of actual concurrency."},{"id":"B","text":"Iterations target distinct destinations or use a write mode designed for safe concurrency","why":"Correct: Disjoint outputs or controlled writes reduce destructive contention."},{"id":"C","text":"All iterations overwrite the same table without coordination","why":"Incorrect: Parallel overwrite is a data-loss risk."},{"id":"D","text":"Every iteration sets a shared global variable before Copy reads it","why":"Incorrect: Shared variable values can race."},{"id":"E","text":"Each iteration gets source/target names directly from its @item() descriptor","why":"Correct: Per-item references avoid shared mutable routing state."}],"correct":["B","E"],"explanation":"Per-item references avoid shared mutable routing state. Disjoint outputs or controlled writes reduce destructive contention.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-064","sourceId":"V14-PIPE-064","pack":"video14","topic":"ForEach and parallel iteration","title":"scale and orchestration architecture","prompt":"A scalable ForEach is being designed for 80,000 descriptors. Which TWO validation points matter?","type":"multi","options":[{"id":"A","text":"Use a single variable as a guaranteed thread-local dictionary for each iteration","why":"Incorrect: Variables are pipeline-scoped, not per-iteration storage."},{"id":"B","text":"Verify the current Fabric item-count limit and payload/lookup bounds in addition to the loop input size","why":"Correct: ForEach capacity and upstream metadata retrieval limits can each constrain design."},{"id":"C","text":"Assume every array automatically fits into a single Lookup output","why":"Incorrect: Lookup also has independent row and size caps."},{"id":"D","text":"Estimate source/sink throttling and select measured parallelism rather than maximal concurrency","why":"Correct: Uncontrolled fan-out can overload connections and destinations."},{"id":"E","text":"Put an unlimited nested ForEach directly inside the loop without checking support","why":"Incorrect: Nested control structures have limitations and require supported patterns."}],"correct":["B","D"],"explanation":"ForEach capacity and upstream metadata retrieval limits can each constrain design. Uncontrolled fan-out can overload connections and destinations.","videoSeconds":5500,"refs":["pforeach","vref_cbc6a6694d3ed9cd","vref_554887adb8d7c00c"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Ingestion scenarios; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=5500s"},{"id":"fb-v14-pipe-065","sourceId":"V14-PIPE-065","pack":"video14","topic":"Lookup and configuration row shapes","title":"firstRow accessor","prompt":"A configuration table has one row describing sourceFile='orders.csv' and targetTable='Orders'. Lookup is set to First row only. Which output path should downstream Copy use for targetTable?","type":"single","options":[{"id":"A","text":"@activity('GetConfig').output.firstRow.targetTable","why":"Correct: First-row mode wraps the selected object under firstRow."},{"id":"B","text":"@activity('GetConfig').output.value[0].targetTable","why":"Incorrect: value array belongs to multi-row output, not first-row shape."},{"id":"C","text":"@item().targetTable outside a ForEach","why":"Incorrect: The current item is undefined without an iteration context."},{"id":"D","text":"@pipeline().parameters.targetTable when no parameter is defined","why":"Incorrect: Lookup output is not automatically a pipeline parameter."}],"correct":["A"],"explanation":"First-row mode wraps the selected object under firstRow.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-066","sourceId":"V14-PIPE-066","pack":"video14","topic":"Lookup and configuration row shapes","title":"multirow Lookup shape","prompt":"A Lookup returns three metadata rows with First row only disabled. An engineer tries to iterate output.firstRow in ForEach and gets a type error. What adjustment is required?","type":"single","options":[{"id":"A","text":"Change ForEach items to @activity('GetConfig').output.count, which is an integer","why":"Incorrect: count is not an iterable collection of records."},{"id":"B","text":"Set ForEach items to @activity('GetConfig').output.value","why":"Correct: Multirow Lookup returns an array in value, suitable for iteration."},{"id":"C","text":"Force source metadata to one row and discard the other two","why":"Incorrect: Truncating the business configuration violates requirements."},{"id":"D","text":"Use @utcnow() as the metadata source","why":"Incorrect: Time expressions don't enumerate configured sources."}],"correct":["B"],"explanation":"Multirow Lookup returns an array in value, suitable for iteration.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-067","sourceId":"V14-PIPE-067","pack":"video14","topic":"Lookup and configuration row shapes","title":"Lookup one-result-set limit","prompt":"A stored procedure called by Lookup returns two result sets. The activity fails even though both are valid SQL results. Which response matches the documented constraint?","type":"single","options":[{"id":"A","text":"Use the array type for the output parameter and it will merge result sets automatically","why":"Incorrect: Lookup doesn't automatically combine multiple result sets this way."},{"id":"B","text":"Switch the pipeline to a larger capacity to permit two result sets","why":"Incorrect: The restriction isn't merely an SKU limit."},{"id":"C","text":"Refactor it to return exactly one result set for Lookup, or use a different supported control pattern","why":"Correct: Lookup requires one result set from query/procedure scenarios."},{"id":"D","text":"Wrap the procedure in a ForEach that runs the two result sets simultaneously","why":"Incorrect: Looping does not change the Lookup result-set contract."}],"correct":["C"],"explanation":"Lookup requires one result set from query/procedure scenarios.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-068","sourceId":"V14-PIPE-068","pack":"video14","topic":"Lookup and configuration row shapes","title":"silent partial metadata enumeration","prompt":"An operator uses Lookup on a 5,100-row configuration table and silently processes only 5,000. What is the most dangerous assumption behind the design?","type":"single","options":[{"id":"A","text":"That a single row is always returned in firstRow mode","why":"Incorrect: The scenario explicitly uses multirow mode and the row cap."},{"id":"B","text":"That every row from an SQL table is necessarily encrypted","why":"Incorrect: Encryption isn't the cause of truncation."},{"id":"C","text":"That ForEach can never run more than 1,000 iterations","why":"Incorrect: ForEach capacity is substantially higher; the upstream Lookup limit is the bottleneck."},{"id":"D","text":"That Lookup is a complete unbounded query-result transport; it is capped and needs pagination or partitioning","why":"Correct: The first 5,000 can appear valid while the rest are omitted."}],"correct":["D"],"explanation":"The first 5,000 can appear valid while the rest are omitted.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-069","sourceId":"V14-PIPE-069","pack":"video14","topic":"Lookup and configuration row shapes","title":"Lookup byte cap","prompt":"A few metadata records can each contain a large JSON payload. Lookup returns fewer than 5,000 rows but still fails. Which independent limit should be checked?","type":"single","options":[{"id":"A","text":"The documented Lookup output size ceiling of 4 MB","why":"Correct: A small row count can still breach the output byte limit."},{"id":"B","text":"The maximum number of Power BI report visuals","why":"Incorrect: Report visuals do not constrain Lookup output bytes."},{"id":"C","text":"The model's DAX expression depth","why":"Incorrect: DAX is not parsing Lookup result sizes."},{"id":"D","text":"The number of pipeline stages in deployment pipelines","why":"Incorrect: Deployment stages are unrelated to Lookup payload volume."}],"correct":["A"],"explanation":"A small row count can still breach the output byte limit.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-070","sourceId":"V14-PIPE-070","pack":"video14","topic":"Lookup and configuration row shapes","title":"control data vs data movement","prompt":"A Lookup activity is used to inspect table names for a pipeline and must not issue changes. A developer proposes using the Copy activity to enumerate tables and write them to a report. What is the better separation?","type":"single","options":[{"id":"A","text":"Use Copy to materialize a complete copy of every table just to find its name","why":"Incorrect: Copying all records is wasteful for metadata discovery."},{"id":"B","text":"Use Lookup to retrieve control-plane records and Copy only for the actual row movement it configures","why":"Correct: Lookup provides small control datasets to drive downstream activities."},{"id":"C","text":"Store table names as a DAX calculation and claim orchestration inputs will update automatically","why":"Incorrect: DAX is not the pipeline metadata control source."},{"id":"D","text":"Send a failure email as the discovery mechanism","why":"Incorrect: Notifications cannot enumerate source metadata."}],"correct":["B"],"explanation":"Lookup provides small control datasets to drive downstream activities.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-071","sourceId":"V14-PIPE-071","pack":"video14","topic":"Lookup and configuration row shapes","title":"Lookup output mode contracts","prompt":"A metadata-driven pipeline uses Lookup then ForEach. Which TWO statements about selecting its output are correct?","type":"multi","options":[{"id":"A","text":"With First row only enabled, use the firstRow object and its properties","why":"Correct: The activity returns one object under firstRow."},{"id":"B","text":"Lookup can return unlimited rows when source is a Fabric Warehouse","why":"Incorrect: The cap applies regardless of choosing a Warehouse connector."},{"id":"C","text":"count is an array of full row objects and should always be the ForEach items","why":"Incorrect: count is numeric metadata, not the data rows."},{"id":"D","text":"With First row only disabled, use the value array in a loop and consider count for diagnostics","why":"Correct: The activity returns collection data that can drive ForEach."},{"id":"E","text":"firstRow always contains an array of all matching records","why":"Incorrect: First-row mode is not the full-row array mode."}],"correct":["A","D"],"explanation":"The activity returns one object under firstRow. The activity returns collection data that can drive ForEach.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-072","sourceId":"V14-PIPE-072","pack":"video14","topic":"Lookup and configuration row shapes","title":"pagination and batch completeness","prompt":"A 12,000-table migration must use small metadata batches to avoid silent omissions. Which TWO steps are defensible?","type":"multi","options":[{"id":"A","text":"Assume the first 5,000 rows are the only ones that matter","why":"Incorrect: Dropping sources invalidates completeness."},{"id":"B","text":"Turn on First row only and use that as a complete list","why":"Incorrect: First-row mode retains only one row."},{"id":"C","text":"Check size and row caps for every returned batch before ForEach executes","why":"Correct: Two independent limits must both be respected."},{"id":"D","text":"Page or partition the configuration source into bounded requests feeding child pipelines","why":"Correct: Chunking avoids the single-Lookup row cap."},{"id":"E","text":"Increase ForEach batch count until Lookup emits all 12,000 rows","why":"Incorrect: Loop concurrency cannot create rows truncated upstream."}],"correct":["C","D"],"explanation":"Chunking avoids the single-Lookup row cap. Two independent limits must both be respected.","videoSeconds":6434,"refs":["plookup","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"c-multiregion-logistics-telemetry","sourceObjective":"DP-600 Prepare data / Get data; DP-700 orchestration depth","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=6434s"},{"id":"fb-v14-pipe-073","sourceId":"V14-PIPE-073","pack":"video14","topic":"Get Metadata and file discovery","title":"get metadata exists semantics","prompt":"A Lakehouse folder may or may not contain the day's inbound file. The pipeline should proceed without throwing merely because it is absent. Which metadata field supports that branch?","type":"single","options":[{"id":"A","text":"Request size and interpret a missing object as exactly zero bytes","why":"Incorrect: The size lookup can fail if the object doesn't exist and size zero is ambiguous."},{"id":"B","text":"Request rowCount from a file even if no connection is configured","why":"Incorrect: An unsupported or unavailable property cannot detect absence safely."},{"id":"C","text":"Request the exists field and branch on the Boolean result","why":"Correct: Documented exists behavior returns false when the object is missing instead of failing solely for absence."},{"id":"D","text":"Use a stored procedure activity with an unknown database","why":"Incorrect: An unknown database does not provide robust file existence testing."}],"correct":["C"],"explanation":"Documented exists behavior returns false when the object is missing instead of failing solely for absence.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-074","sourceId":"V14-PIPE-074","pack":"video14","topic":"Get Metadata and file discovery","title":"dynamic file discovery","prompt":"A pipeline must load every file directly under /inbound, without knowing their names in advance. Which metadata field is most appropriate to feed an iterator?","type":"single","options":[{"id":"A","text":"Get Metadata contentMD5 for the folder","why":"Incorrect: MD5 is file content metadata, not a directory listing."},{"id":"B","text":"Lookup firstRow from an unrelated semantic model","why":"Incorrect: A row object is not a live folder listing."},{"id":"C","text":"Set Variable with yesterday's file names only","why":"Incorrect: Historical hard-coded names miss newly arrived files."},{"id":"D","text":"Get Metadata childItems on the folder, then ForEach over the returned file/folder descriptors","why":"Correct: childItems enumerates immediate children suitable for dynamic file processing."}],"correct":["D"],"explanation":"childItems enumerates immediate children suitable for dynamic file processing.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-075","sourceId":"V14-PIPE-075","pack":"video14","topic":"Get Metadata and file discovery","title":"folder hierarchy awareness","prompt":"An auditor asks why nested files were missed after a Get Metadata childItems check on the parent directory. Which explanation is strongest?","type":"single","options":[{"id":"A","text":"childItems lists direct children; recursion into nested folders requires explicit additional traversal design","why":"Correct: One folder scan does not guarantee recursive discovery."},{"id":"B","text":"childItems always flattens all descendant folders recursively","why":"Incorrect: The default field describes immediate folder contents."},{"id":"C","text":"The Lakehouse cannot contain subfolders","why":"Incorrect: Files sections can contain nested folders."},{"id":"D","text":"Folder names containing letters are ignored by default","why":"Incorrect: No such general exclusion explains missing nested levels."}],"correct":["A"],"explanation":"One folder scan does not guarantee recursive discovery.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-076","sourceId":"V14-PIPE-076","pack":"video14","topic":"Get Metadata and file discovery","title":"metadata fields per object type","prompt":"A pipeline requires table column-count checks before a Copy. An engineer sets childItems on the table and expects column metadata. What should be used instead?","type":"single","options":[{"id":"A","text":"Use size in bytes as an exact substitute for number of columns","why":"Incorrect: Data size is not schema width."},{"id":"B","text":"Use supported table metadata fields such as columnCount and structure for the relevant connection","why":"Correct: Table and folder metadata have different applicable fields."},{"id":"C","text":"Use lastModified as a list of column names","why":"Incorrect: Modification timestamps don't describe fields."},{"id":"D","text":"Use file childItems and assume the array length equals the table's columns","why":"Incorrect: File listing is unrelated to relational schema."}],"correct":["B"],"explanation":"Table and folder metadata have different applicable fields.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-077","sourceId":"V14-PIPE-077","pack":"video14","topic":"Get Metadata and file discovery","title":"unsupported Get Metadata wildcards","prompt":"A Get Metadata task must only process CSV files changed after the last watermark. The engineer attempts a wildcard file filter inside Get Metadata and expects it to match only *.csv. What's the main risk?","type":"single","options":[{"id":"A","text":"All Get Metadata file filters use SQL LIKE syntax automatically","why":"Incorrect: Get Metadata is not a universal SQL query editor."},{"id":"B","text":"Wildcard filters become supported whenever you enable parallel ForEach","why":"Incorrect: Loop execution does not alter Get Metadata filters."},{"id":"C","text":"Get Metadata doesn't support a wildcard folder/file filter; use supported modified-time settings and filter childItems after retrieval or choose appropriate supported copy filtering","why":"Correct: Metadata filtering and wildcard capabilities are connector/activity specific."},{"id":"D","text":"A CSV extension means metadata cannot include modification time","why":"Incorrect: CSV files can have last-modified metadata where the connector supports it."}],"correct":["C"],"explanation":"Metadata filtering and wildcard capabilities are connector/activity specific.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-078","sourceId":"V14-PIPE-078","pack":"video14","topic":"Get Metadata and file discovery","title":"temporal filtering and nested structure","prompt":"The team filters folder metadata by modified time and expects every nested descendant directory to be searched. What caveat matters?","type":"single","options":[{"id":"A","text":"Date filtering transforms all nested folders into files","why":"Incorrect: Filters do not rewrite storage hierarchy."},{"id":"B","text":"Any timestamp filter makes the original file immutable","why":"Incorrect: Read metadata cannot grant immutability."},{"id":"C","text":"The result automatically contains all child folder schemas","why":"Incorrect: File timestamp filtering is not recursive schema discovery."},{"id":"D","text":"Modified-time childItems filters do not automatically recurse into nested directories; traversal needs to be explicit","why":"Correct: Current metadata documentation notes that filtered childItems covers files in the specified path, not nested subfolders."}],"correct":["D"],"explanation":"Current metadata documentation notes that filtered childItems covers files in the specified path, not nested subfolders.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-079","sourceId":"V14-PIPE-079","pack":"video14","topic":"Get Metadata and file discovery","title":"metadata-backed validation","prompt":"An ingestion validation requires existence detection and inspection of table structure. Which TWO Get Metadata fields are directly relevant where supported?","type":"multi","options":[{"id":"A","text":"childItems, to guarantee an entire recursive folder tree in one request","why":"Incorrect: childItems doesn't guarantee recursive enumeration."},{"id":"B","text":"contentMD5, to enumerate child folders","why":"Incorrect: Content MD5 applies to file content, not directory children."},{"id":"C","text":"lastModified, to derive row count exactly","why":"Incorrect: Last modification is unrelated to exact row count."},{"id":"D","text":"exists, to choose the missing-object path without an ordinary not-found failure","why":"Correct: Existence is a Boolean presence check that can drive a condition."},{"id":"E","text":"structure, to examine the reported schema of a supported table or file format","why":"Correct: Structure can return field names and types where the connector supports it."}],"correct":["D","E"],"explanation":"Existence is a Boolean presence check that can drive a condition. Structure can return field names and types where the connector supports it.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-080","sourceId":"V14-PIPE-080","pack":"video14","topic":"Get Metadata and file discovery","title":"metadata contracts and quality","prompt":"A large staging folder is reviewed through Get Metadata before ForEach. Which TWO safeguards are appropriate?","type":"multi","options":[{"id":"A","text":"Check supported field lists and connector behavior for source type (file, folder or table)","why":"Correct: Not all metadata fields work on every object/connector."},{"id":"B","text":"Replace file formats with Fabric notebook titles to enable wildcard metadata filters","why":"Incorrect: Renaming items cannot add unsupported filtering behavior."},{"id":"C","text":"Assume every childItems result contains all descendants recursively","why":"Incorrect: Only direct children are enumerated without additional traversal."},{"id":"D","text":"Interpret exists=false as a fatal error from Get Metadata in every design","why":"Incorrect: Requesting exists is intended to return a Boolean rather than fail solely for absence."},{"id":"E","text":"Handle absent items explicitly and validate child-item counts against source expectations","why":"Correct: Missing or partial enumerations can otherwise create silently incomplete loads."}],"correct":["A","E"],"explanation":"Not all metadata fields work on every object/connector. Missing or partial enumerations can otherwise create silently incomplete loads.","videoSeconds":7222,"refs":["vref_30f08f6070f7a19a","vref_f6ca1683b1f5235a","vref_cbc6a6694d3ed9cd"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Discover and get data; DP-700 primary mechanics","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7222s"},{"id":"fb-v14-pipe-081","sourceId":"V14-PIPE-081","pack":"video14","topic":"Metadata-driven pipelines","title":"metadata-driven scaling","prompt":"A manufacturer adds a new source system every month. The original pipeline has 40 hard-coded Copy activities, one per source. Which architecture best reduces ongoing maintenance?","type":"single","options":[{"id":"A","text":"Externalize source-to-target mappings in a controlled configuration table or JSON and run Lookup + ForEach + parameterized Copy","why":"Correct: Data-driven metadata allows new sources to be configured rather than duplicated in code."},{"id":"B","text":"Continue adding one activity per source indefinitely","why":"Incorrect: Manual duplication increases drift and maintenance costs."},{"id":"C","text":"Store only the current source name in a shared parallel variable","why":"Incorrect: Global mutable state introduces unsafe routing."},{"id":"D","text":"Replace the pipeline with a Power BI report filter","why":"Incorrect: Reporting filters are not a general data ingestion controller."}],"correct":["A"],"explanation":"Data-driven metadata allows new sources to be configured rather than duplicated in code.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-082","sourceId":"V14-PIPE-082","pack":"video14","topic":"Metadata-driven pipelines","title":"nested configuration object parsing","prompt":"A single JSON configuration record has common sourceFolder and an array datasets with per-file delimiter and targetTable properties. What is the right design principle?","type":"single","options":[{"id":"A","text":"Call First row only then attempt ForEach over the entire parent object itself","why":"Incorrect: ForEach needs an iterable array, not a miscellaneous object."},{"id":"B","text":"Read the object once, iterate its datasets array and combine parent-level and item-level properties in each child Copy configuration","why":"Correct: Hierarchical metadata can represent shared and per-dataset settings without duplicating records."},{"id":"C","text":"Encode the delimiter in pipeline name and assume Copy will infer it","why":"Incorrect: Names do not transmit source parser settings."},{"id":"D","text":"Create every target table manually with a DAX measure","why":"Incorrect: DAX is not the destination schema provisioning process."}],"correct":["B"],"explanation":"Hierarchical metadata can represent shared and per-dataset settings without duplicating records.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-083","sourceId":"V14-PIPE-083","pack":"video14","topic":"Metadata-driven pipelines","title":"configuration trust boundary","prompt":"A file configuration allows arbitrary destination table names supplied by untrusted users. The team proposes to concatenate these into SQL without checks. What should be added?","type":"single","options":[{"id":"A","text":"Trust every string because it is called configuration metadata","why":"Incorrect: Metadata is not automatically safe merely due to its location."},{"id":"B","text":"Grant contributors owner permissions on every Warehouse to avoid errors","why":"Incorrect: Broad access increases exposure and does not validate identifiers."},{"id":"C","text":"Validate destinations against an allowed catalog and carefully constrain dynamic identifiers before execution","why":"Correct: Metadata-driven systems still require governance and injection-resistant configuration."},{"id":"D","text":"Disable all logging so suspicious destinations aren't recorded","why":"Incorrect: Hiding audit data does not mitigate misuse."}],"correct":["C"],"explanation":"Metadata-driven systems still require governance and injection-resistant configuration.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-084","sourceId":"V14-PIPE-084","pack":"video14","topic":"Metadata-driven pipelines","title":"metadata-driven restart safety","prompt":"A monthly load reprocesses the same source files after a transient error, writing them in append mode. Which metadata field or design addition is most relevant to correctness?","type":"single","options":[{"id":"A","text":"Increase the Wait duration to a fixed 10 minutes","why":"Incorrect: A pause does not prevent duplicate appends."},{"id":"B","text":"Use a shared variable named AlreadyLoaded across unrelated pipeline runs","why":"Incorrect: Pipeline variables do not persist reliable durable cross-run state."},{"id":"C","text":"Rely solely on activity name uniqueness","why":"Incorrect: Names do not make writes idempotent."},{"id":"D","text":"Track processed batches/checkpoints and use idempotent destination writes or explicit deduplication keys","why":"Correct: Control metadata should record committed state and support safe replay."}],"correct":["D"],"explanation":"Control metadata should record committed state and support safe replay.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-085","sourceId":"V14-PIPE-085","pack":"video14","topic":"Metadata-driven pipelines","title":"configuration validation and quarantine","prompt":"A configuration table sometimes contains an unknown delimiter and missing target table. The current ForEach writes empty data silently. Which architecture most safely surfaces errors?","type":"single","options":[{"id":"A","text":"Perform per-record schema/required-field validation before Copy, quarantine invalid entries, and produce row-level audit outcomes","why":"Correct: Validating configuration avoids corrupting destinations and preserves traceability."},{"id":"B","text":"Automatically use comma for every missing delimiter and proceed without any warning","why":"Incorrect: Defaults can silently corrupt semicolon-separated files."},{"id":"C","text":"Disable error outputs because downstream users expect success","why":"Incorrect: Concealing failure increases quality risk."},{"id":"D","text":"Remove ForEach and process only the first configuration row","why":"Incorrect: Dropping records is not a scalable quality solution."}],"correct":["A"],"explanation":"Validating configuration avoids corrupting destinations and preserves traceability.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-086","sourceId":"V14-PIPE-086","pack":"video14","topic":"Metadata-driven pipelines","title":"per-item observability and concurrency budgets","prompt":"An ingestion architect wants the pipeline to run metadata for 1,200 files but limit operational blast radius. Which strategy offers controlled scaling?","type":"single","options":[{"id":"A","text":"Use the maximum concurrency on every connector regardless of throttling","why":"Incorrect: Fan-out can overload sources and increase retries."},{"id":"B","text":"Partition configuration into verified batches, choose bounded concurrency, and emit success/failure records per dataset","why":"Correct: Chunking and per-entity diagnostics isolate faults without exploding manual workflows."},{"id":"C","text":"Require one large shared variable to hold all statuses updated in parallel","why":"Incorrect: Concurrent shared-variable updates are unsafe and size-bound."},{"id":"D","text":"Ignore per-file outcomes because the parent pipeline succeeded","why":"Incorrect: Parent status may not be enough to investigate every source."}],"correct":["B"],"explanation":"Chunking and per-entity diagnostics isolate faults without exploding manual workflows.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-087","sourceId":"V14-PIPE-087","pack":"video14","topic":"Metadata-driven pipelines","title":"governed metadata-driven orchestration","prompt":"A secure metadata-driven pipeline is being promoted to production. Which TWO requirements directly strengthen the solution?","type":"multi","options":[{"id":"A","text":"Use 10,000 elements in one Lookup and assume full fidelity","why":"Incorrect: Lookup has documented row and output limits."},{"id":"B","text":"Share a plain-text token in the JSON to simplify authentication","why":"Incorrect: Secrets must be governed separately from editable routing metadata."},{"id":"C","text":"Allow anyone who can edit the JSON to use arbitrary production destinations","why":"Incorrect: Dynamic metadata should not bypass destination governance."},{"id":"D","text":"Validate allowlisted source, target, file-format and schema configuration before dynamic execution","why":"Correct: External control metadata must be treated as an input requiring validation."},{"id":"E","text":"Record per-entity ingestion outcomes and enforce replay-safe target write behavior","why":"Correct: Operational histories and idempotency enable recovery after partial failure."}],"correct":["D","E"],"explanation":"External control metadata must be treated as an input requiring validation. Operational histories and idempotency enable recovery after partial failure.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-088","sourceId":"V14-PIPE-088","pack":"video14","topic":"Metadata-driven pipelines","title":"metadata model and system boundaries","prompt":"An enterprise wants reusable metadata-driven pipelines for both files and database tables. Which TWO properties are essential to a robust design?","type":"multi","options":[{"id":"A","text":"Separation of orchestration metadata, credential management, and business data payloads","why":"Correct: Independent concerns support least privilege, audit and change control."},{"id":"B","text":"Using a report visual as a secret store for connections","why":"Incorrect: Reports are not credential vaults."},{"id":"C","text":"A single universal Get Metadata wildcard query guaranteed for all connector types","why":"Incorrect: No such universal wildcard/field semantics exists."},{"id":"D","text":"A typed configuration schema that distinguishes object kinds and supported connector operations","why":"Correct: File and table metadata and ingestion options differ; typing prevents invalid combinations."},{"id":"E","text":"Hard-coded physical file names hidden in each Copy activity while configuration claims full dynamism","why":"Incorrect: Hidden constants defeat metadata-driven flexibility."}],"correct":["A","D"],"explanation":"File and table metadata and ingestion options differ; typing prevents invalid combinations. Independent concerns support least privilege, audit and change control.","videoSeconds":7903,"refs":["plookup","pforeach","pexpr"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 Prepare data / Design ingestion; DP-700 advanced","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=7903s"},{"id":"fb-v14-pipe-089","sourceId":"V14-PIPE-089","pack":"video14","topic":"Production best practices and reliability","title":"transient vs permanent retry strategy","prompt":"A source API sporadically returns HTTP 429 due to throttling, but permanent invalid credentials return 401. Which retry approach is best for a resilient pipeline?","type":"single","options":[{"id":"A","text":"Retry every error 1000 times with zero delay","why":"Incorrect: Authentication errors won't resolve from immediate repetition and may worsen throttling."},{"id":"B","text":"Disable all retries because they always corrupt destination data","why":"Incorrect: Retry can be appropriate when target writes are replay-safe."},{"id":"C","text":"Configure bounded retries with suitable delay/backoff for transient failures and avoid blindly retrying permanent authorization errors where conditional retry is supported","why":"Correct: A selective retry policy targets recoverable errors while limiting wasted capacity and time."},{"id":"D","text":"Convert 429 into a success status without fetching any data","why":"Incorrect: Silently skipping failed reads is data loss."}],"correct":["C"],"explanation":"A selective retry policy targets recoverable errors while limiting wasted capacity and time.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-090","sourceId":"V14-PIPE-090","pack":"video14","topic":"Production best practices and reliability","title":"timeout diagnosis versus masking failures","prompt":"An activity repeatedly times out at 12 hours but usually completes within two minutes in testing. The operator proposes immediately changing timeout to 24 hours. What should be done first?","type":"single","options":[{"id":"A","text":"Assume a longer timeout always reduces source CPU use","why":"Incorrect: Timeout length does not directly optimize source performance."},{"id":"B","text":"Set the timeout to zero so errors are suppressed","why":"Incorrect: Zero timeout is not a valid way to ensure successful completion."},{"id":"C","text":"Disable activity monitoring to shorten runtime","why":"Incorrect: Hiding metrics prevents investigating the unexplained duration."},{"id":"D","text":"Inspect duration phases, source/sink throttling and stuck processes, then choose a defensible timeout and escalation policy","why":"Correct: Increasing timeout without diagnosis may only prolong a defective run."}],"correct":["D"],"explanation":"Increasing timeout without diagnosis may only prolong a defective run.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-091","sourceId":"V14-PIPE-091","pack":"video14","topic":"Production best practices and reliability","title":"retry with side effects","prompt":"A metadata-driven ingestion uses append writes and activity-level retry=3. An upstream timeout occurs after some destination rows were committed. Which extra safeguard is needed?","type":"single","options":[{"id":"A","text":"Idempotent load keys, staging plus merge, or equivalent replay-safe sink controls because retries can repeat side effects","why":"Correct: Activity retry does not make external writes automatically atomic."},{"id":"B","text":"Change Retry from 3 to 4 and assume duplicates stop","why":"Incorrect: More retries don't create uniqueness."},{"id":"C","text":"Rely on a new RunId to enforce primary keys automatically","why":"Incorrect: Run IDs have no magical uniqueness constraint over business rows."},{"id":"D","text":"Move the timeout after a notification activity","why":"Incorrect: Activity order cannot undo already committed partial writes."}],"correct":["A"],"explanation":"Activity retry does not make external writes automatically atomic.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-092","sourceId":"V14-PIPE-092","pack":"video14","topic":"Production best practices and reliability","title":"release readiness gates","prompt":"A development pipeline runs reliably but fails in production due to secret expiry and an invalid table mapping after deployment. Which release strategy is most suitable?","type":"single","options":[{"id":"A","text":"Assume a successful Git commit ensures production credentials will work","why":"Incorrect: Version control verifies files, not external secret validity."},{"id":"B","text":"Validate connection identities, environment-specific configurations, mappings and representative end-to-end test runs before promotion","why":"Correct: Production readiness requires environmental and runtime checks in addition to a deployable JSON definition."},{"id":"C","text":"Only test the first Wait activity in development","why":"Incorrect: A trivial activity can't validate production data paths."},{"id":"D","text":"Disable all production schedules permanently","why":"Incorrect: Avoiding execution isn't a release-validation strategy."}],"correct":["B"],"explanation":"Production readiness requires environmental and runtime checks in addition to a deployable JSON definition.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-093","sourceId":"V14-PIPE-093","pack":"video14","topic":"Production best practices and reliability","title":"production data quality monitoring","prompt":"A team frequently reruns successful pipelines by hand after complaints of missing rows. Which operational improvement addresses the underlying control gap?","type":"single","options":[{"id":"A","text":"Move every Copy activity two pixels left on the canvas","why":"Incorrect: Canvas coordinates don't affect data completeness."},{"id":"B","text":"Eliminate RunId logging to reduce auditor questions","why":"Incorrect: Removing lineage makes diagnosis harder."},{"id":"C","text":"Add input completeness, schema quality, reconciliation and measurable run-level alerting before declaring success","why":"Correct: Operational success should include data correctness checks, not only green activity status."},{"id":"D","text":"Increase notebook font size for all developers","why":"Incorrect: Display preferences are unrelated to data correctness."}],"correct":["C"],"explanation":"Operational success should include data correctness checks, not only green activity status.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-094","sourceId":"V14-PIPE-094","pack":"video14","topic":"Production best practices and reliability","title":"resilience policy governance","prompt":"The operational team expects every developer to change retry and timeout settings arbitrarily in production. A platform owner asks for a scalable practice. What governance should be introduced?","type":"single","options":[{"id":"A","text":"Use one billion retries as the platform default","why":"Incorrect: Indefinite retries can hide issues and consume capacity."},{"id":"B","text":"Hide all failure evidence from operators","why":"Incorrect: Unobservable systems are not more resilient."},{"id":"C","text":"Rely on the instructor's exact UI defaults forever without monitoring updates","why":"Incorrect: Product defaults and capabilities can change; policy should be documented and tested."},{"id":"D","text":"Standardize failure classifications, per-activity retry/backoff policies, timeouts and escalation runbooks with controlled exceptions","why":"Correct: Consistency reduces uncontrolled costs and protects sources from abusive retry storms."}],"correct":["D"],"explanation":"Consistency reduces uncontrolled costs and protects sources from abusive retry storms.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-095","sourceId":"V14-PIPE-095","pack":"video14","topic":"Production best practices and reliability","title":"auditability and exactly-once approximation","prompt":"A production finance load must be recoverable and auditable after intermittent transport outages. Which TWO controls are essential?","type":"multi","options":[{"id":"A","text":"Declare success based solely on pipeline execution without checking financial totals","why":"Incorrect: Execution success does not prove business completeness."},{"id":"B","text":"Turn off all retries permanently even for transient 429 responses","why":"Incorrect: This may unnecessarily fail otherwise recoverable runs."},{"id":"C","text":"Capture RunId, source identifier, reconciliation counts and diagnostic failures for each batch","why":"Correct: Run-level evidence supports recovery, traceability and incident review."},{"id":"D","text":"Design idempotent or transactional sink behavior so partial retries do not double-count financial records","why":"Correct: Replay-safe targets protect correctness after transient interruptions."},{"id":"E","text":"Store credentials inside the publicly readable config JSON for reproducibility","why":"Incorrect: Secrets should be kept in approved secure credential systems."}],"correct":["C","D"],"explanation":"Replay-safe targets protect correctness after transient interruptions. Run-level evidence supports recovery, traceability and incident review.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":4,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"},{"id":"fb-v14-pipe-096","sourceId":"V14-PIPE-096","pack":"video14","topic":"Production best practices and reliability","title":"resilience and deployment discipline","prompt":"An architect is defining production hardening for 90 heterogeneous ingestion flows. Which TWO practices are appropriate?","type":"multi","options":[{"id":"A","text":"Use configurable, bounded retry and timeout policies tailored to source failure behavior","why":"Correct: Source-aware backoff avoids retry storms and excessive hangs."},{"id":"B","text":"Allow parallel writers to overwrite shared destinations without controls","why":"Incorrect: Concurrent destructive writes risk corruption."},{"id":"C","text":"Separate developer, tester and production identities/configurations and validate promotion behavior","why":"Correct: Environment separation reduces accidental access and configuration drift."},{"id":"D","text":"Disable metadata validation to speed up ingestion regardless of schema drift","why":"Incorrect: Unvalidated changes create silent data corruption."},{"id":"E","text":"Assume every failure is transient so all errors should be retried identically","why":"Incorrect: Different failure classes require different responses."}],"correct":["A","C"],"explanation":"Source-aware backoff avoids retry storms and excessive hangs. Environment separation reduces accidental access and configuration drift.","videoSeconds":8658,"refs":["vref_3fc7f9efbf0b8944","pactivity","vref_cdc585e4090bf21a"],"code":"","origin":"extension","difficulty":5,"caseStudyId":"d-bank-regulatory-ingestion","sourceObjective":"DP-600 operational enrichment; DP-700 primary","provenance":"Original technical certification-style scenario informed by the named source lecture and separate Microsoft Learn verification; not a Microsoft exam item or question from the video.","validation":"Literature checked October 2026; conceptual exercise only; no actual Fabric tenant execution test. Video timestamp is a chapter anchor, not a claim that this invented scenario was shown on-screen.","sourceVideoUrl":"https://www.youtube.com/watch?v=cQWkms3tUgM&t=8658s"}]
