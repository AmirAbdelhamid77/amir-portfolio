    {
      "id": "lesson:creative:insight-and-trust",
      "slug": "insight-and-trust",
      "title": "Turn an insight into an inspectable decision chain",
      "explanation": "An insight card should expose a meaningful comparison and an evidence path. It needs scope, metric meaning, why it matters and a legitimate next step. Freshness and completeness are part of the interpretation: a partial current period is not automatically comparable with a complete prior period. A publication date must represent an actual publication event, not the source’s last edit or an invented feed timestamp. Hansa’s Timeline and Card Dealer should navigate the same stable insight records, so moving a card does not duplicate its content identity or imply a new finding.",
      "objectives": [
        "Write a discovery card with an evidence trail",
        "Separate source timestamps, collection time and publication scheduling"
      ],
      "walkthrough": [
        "Choose a source-backed claim and record the exact source unit.",
        "Write a short hook that does not invent a number or causal explanation.",
        "Add why it matters, an application, and a meaningful limitation.",
        "Link to the lesson, Atlas candidate and optional assessment/challenge.",
        "Leave published_at null until the implementation process publishes the record.",
        "Reuse the insight ID across Timeline, deck, hand and collected pile; preserve focus and reading state."
      ],
      "misconceptions_and_tradeoffs": [
        "A source’s last-edited time is not a publication date.",
        "Moving a card must not change its scientific validation state."
      ],
      "practice": "The feed wants a “new insight every day”, but only old verified material is available. What must remain truthful?",
      "model_feedback": "The source and publication timestamps must remain distinct. Schedule a review or publication event honestly; do not fabricate a new research date or fresh observation.",
      "prerequisite_slugs": [
        "decision-contract",
        "story-framework"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:decision-contract",
        "lesson:creative:story-framework"
      ],
      "code_ids": [],
      "doc_patterns": [],
