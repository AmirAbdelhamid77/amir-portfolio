    {
      "id": "lesson:creative:mobile-export",
      "slug": "mobile-export",
      "title": "Mobile and export are distinct consumption modes",
      "explanation": "A scaled-down desktop page is not necessarily a usable mobile experience, and a PDF cannot preserve every interactive affordance. Prioritize the evidence needed for the mobile task, then verify the actual client. Hover explanations, hidden states, thin SVG lines, custom fonts and uncertified visuals need explicit export checks. The source Field Guide proposes separate mobile layout and export QA; current documentation must determine exact support and limitations for the installed version and visual edition. Do not infer support from a desktop screenshot.",
      "objectives": [
        "Specify mobile evidence priority",
        "Define export checks for a custom visual and an interactive report"
      ],
      "walkthrough": [
        "Identify the mobile user’s primary decision and required controls.",
        "Define a reading order and readable labels for the actual target size.",
        "Provide non-hover evidence access and usable touch/keyboard alternatives.",
        "Verify the intended Power BI client and report layout behavior.",
        "Export representative pages and compare numbers, labels, fonts and visible states.",
        "Document any missing custom visual, clipped annotation or unsupported interaction."
      ],
      "misconceptions_and_tradeoffs": [
        "Responsive web behavior in Hansa does not prove a Power BI mobile layout.",
        "A PDF is an evidence artifact, not a full interactive report clone."
      ],
      "practice": "A rich HTML metric tree exports without its disclosure interaction. What does the static version need?",
      "model_feedback": "A deliberately selected readable state or equivalent table/narrative, with the important formulas and scope visible rather than hidden behind hover.",
      "prerequisite_slugs": [
        "accessibility",
        "renderer-choice"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:accessibility",
        "lesson:creative:renderer-choice"
      ],
