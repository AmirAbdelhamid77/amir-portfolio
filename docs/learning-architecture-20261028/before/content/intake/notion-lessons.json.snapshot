    {
      "id": "lesson:creative:source-contract",
      "slug": "source-contract",
      "title": "Maintain a traceable knowledge package without inventing approval",
      "explanation": "Knowledge extraction, educational synthesis, source-based claim review, product execution and publication are different states. Keep the source text, source position and transformation together. The existing DP-600 and PL-300 checkpoints in this chat are ungraded/no-final material, not authority to append generated questions to an approved bank. The public Hansa Atlas currently exposes a publication-pending state, so canonical hidden concept IDs and current internal schemas cannot be verified from that page. Use provisional namespaced IDs and a reconciliation contract rather than inventing mappings. Exam alignment is limited to actual current objective text; advanced creative chart names are enrichment topics unless a specific covered skill is being assessed.",
      "objectives": [
        "Separate evidence levels and acceptance states",
        "Deliver additive records with reversible source mappings"
      ],
      "walkthrough": [
        "Retain source page identity, edit metadata, raw content and hash.",
        "Label every record as extracted, externally verified enrichment or derived educational content.",
        "Use stable provisional IDs and explicit typed relations; keep page ownership separate from semantic prerequisites.",
        "Match existing IDs only when the current authoritative catalogue is actually available.",
        "Map an assessment to exact current exam objectives or label it enrichment.",
        "Validate all referenced IDs and separate private answer material from public stems.",
        "Leave grading and publication disabled until the responsible review gates are satisfied."
      ],
      "misconceptions_and_tradeoffs": [
        "A downloaded source is not automatically a verified claim.",
        "A proposed edge is not a published semantic relationship.",
        "Old bank counts do not establish current approval or deployment state."
      ],
      "practice": "The importer cannot find the current Atlas catalogue. Should it generate canonical-looking IDs and create nodes immediately?",
      "model_feedback": "No. Preserve provisional IDs, deliver candidate mappings and require an explicit reconciliation against the actual catalogue before import.",
      "prerequisite_slugs": [
        "decision-contract"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:decision-contract"
      ],
