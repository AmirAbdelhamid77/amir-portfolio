    {
      "id": "lesson:creative:accessibility",
      "slug": "accessibility",
      "title": "Design interaction that does not depend on hover or color",
      "explanation": "Accessibility is part of communicating the evidence. Red/green alone cannot carry the meaning of a change, and a hover tooltip cannot be the only source of essential information. Provide meaningful titles, alt text, logical tab order and non-color labels. Remove purely decorative objects from keyboard navigation while keeping functional controls reachable. Dynamic descriptions should reflect the active context; a fixed description can become inaccurate after filtering. Automated structure checks do not replace actual keyboard, screen-reader, high-contrast and touch testing.",
      "objectives": [
        "Create redundant semantic cues",
        "Specify meaningful keyboard and screen-reader tests"
      ],
      "walkthrough": [
        "List every fact required to solve the task; ensure each is available without hovering.",
        "Pair color with words, signs, shapes or direct labels that preserve the distinction.",
        "Set meaningful titles/descriptions and verify their accuracy under changed filters.",
        "Arrange focus order around the reading and decision sequence; exclude decorative shapes.",
        "Test every interactive control using keyboard alone, then high contrast and a real screen reader.",
        "For custom maps, provide a linear text/table representation and focus-based explanations."
      ],
      "misconceptions_and_tradeoffs": [
        "A single numeric contrast threshold is not a substitute for classifying text size and applicable standards.",
        "An axe PASS is not proof of full WCAG conformance or analytical readability."
      ],
      "practice": "A red cost delta is explained only by a tooltip. Revise the representation for a keyboard-only reader.",
      "model_feedback": "Expose a signed numeric delta and an explicit cost/direction label in visible or accessible content, with focusable detail; retain color as a supplementary cue.",
      "prerequisite_slugs": [
        "decision-contract"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:decision-contract"
      ],
      "code_ids": [],
