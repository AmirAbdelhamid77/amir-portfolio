    {
      "id": "lesson:creative:renderer-choice",
      "slug": "renderer-choice",
      "title": "Native, Deneb or HTML: choose the smallest adequate capability",
      "explanation": "Use native visuals as a baseline, Deneb when a grammar of graphics adds analytical capability, and HTML Content for justified rich composition under its constraints. HTML in a Power BI custom visual is not a general browser application: sandboxing, edition, host and permissions affect behavior. The regular and secure editions have different allowed content and export characteristics. A certified visual is not automatically accessible or suitable for every workload. The authoring choice must preserve selection identity, filter interaction, readability and maintainability.",
      "objectives": [
        "Make a capability-based renderer decision",
        "Avoid assuming browser behavior inside a custom visual"
      ],
      "walkthrough": [
        "Write the exact unsupported requirement: encoding, formula layout, interaction or rich text.",
        "Try a native baseline with equivalent semantics.",
        "If considering Deneb, validate dataset grain, selection identity and the specific version’s interactivity contract.",
        "If considering HTML, review edition and sandbox limitations before writing the interaction.",
        "Test the required host: Desktop, service, mobile and export can differ.",
        "Keep a readable fallback and record maintenance ownership."
      ],
      "misconceptions_and_tradeoffs": [
        "Certification is not unrestricted HTML execution.",
        "A local HTML prototype cannot prove report filtering or export behavior.",
        "A complex renderer with no analytical gain fails the Shortlist acceptance rule."
      ],
      "practice": "A prototype works as a standalone HTML page. Which report capabilities are still unproven?",
      "model_feedback": "Host sandbox compatibility, selection/filter integration, accessibility, performance and export remain separate tests.",
      "prerequisite_slugs": [
        "decision-contract",
        "accessibility"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:decision-contract",
        "lesson:creative:accessibility"
      ],
