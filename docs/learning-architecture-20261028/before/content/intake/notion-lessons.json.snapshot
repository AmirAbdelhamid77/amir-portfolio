    {
      "id": "lesson:creative:pbip-lifecycle",
      "slug": "pbip-lifecycle",
      "title": "Structured report files support review, not automatic correctness",
      "explanation": "PBIP/PBIR enables a file-based authoring workflow with reviewable changes; it does not make generated measures correct. The Field Guide distinguishes report design, authoring, planning, model tools and Desktop review. Treat preview maturity and version support as live documentation questions. Validate schema, rendering, arithmetic, permissions and accessibility as separate gates. A tool able to write a file is not evidence that the report opened or behaved correctly in Desktop. This lesson specifies a workflow only; no Hansa or Power BI production file is edited by the package.",
      "objectives": [
        "Separate artifact validation from technical behavior",
        "Design a reversible review sequence for report changes"
      ],
      "walkthrough": [
        "Save an immutable baseline with model/report versions and dependencies.",
        "Produce a visual-to-measure brief and identify unsupported requirements.",
        "Review generated source changes and schemas before opening them in a target runtime.",
        "Open/reload a disposable copy in the appropriate Desktop/host environment.",
        "Compare calculations, filter behavior, selection, screenshots and accessibility independently.",
        "Promote only the scoped reviewed changes with rollback information; retain open scientific gates."
      ],
      "misconceptions_and_tradeoffs": [
        "Design-skill output is not necessarily PBIR source.",
        "Local Desktop bridge availability does not imply remote access to the user’s machine.",
        "A schema-valid report may still contain a wrong denominator or unsafe access policy."
      ],
      "practice": "An authoring agent reports valid JSON and a successful screenshot. Which approvals remain separate?",
      "model_feedback": "Measure correctness, security/identity behavior, interactions, accessibility and representative performance still require evidence.",
      "prerequisite_slugs": [
        "filter-context",
        "performance"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:filter-context",
        "lesson:creative:performance"
      ],
