    {
      "id": "lesson:creative:performance",
      "slug": "performance",
      "title": "Measure the bottleneck before changing the renderer",
      "explanation": "Performance is a measured property of a workload, not a visual brand. The source Playbook separates query/model work from visual display; the Field Guide asks for controlled before/after comparisons. Performance Analyzer provides visual-level timing categories, while DAX Studio server timings can investigate model-query behavior in an appropriate environment. Rendering fewer primitives may help one bottleneck and do nothing for an expensive measure. Keep dataset, filter context, device, connection mode and cache conditions comparable. Do not quote a benchmark result that has not been run.",
      "objectives": [
        "Interpret visual and DAX timing separately",
        "Design a repeatable comparison between native and custom approaches"
      ],
      "walkthrough": [
        "Record version, storage mode, row counts, selected filters and target device.",
        "Capture initial load and representative interactions with Performance Analyzer.",
        "Separate DAX-query duration from visual display and other timing categories.",
        "Change one relevant factor: cardinality, measure expression, visual count or renderer.",
        "Repeat comparable cold/warm runs and preserve logs rather than a single favorable screenshot.",
        "Recheck calculation correctness, accessibility and service/mobile behavior before accepting the optimization."
      ],
      "misconceptions_and_tradeoffs": [
        "Replacing native visuals with HTML or Deneb is not a guaranteed speedup.",
        "Screenshot equality does not prove KPI or security correctness."
      ],
      "practice": "A slow map has a long DAX query but a short display time. Should you first animate fewer nodes?",
      "model_feedback": "Investigate the query/model and repeated expensive calculations first. Reducing nodes may help later, but the current timing evidence points elsewhere.",
      "prerequisite_slugs": [
        "filter-context"
      ],
      "prerequisite_lesson_ids": [
        "lesson:creative:filter-context"
      ],
