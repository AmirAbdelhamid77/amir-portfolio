+export const TOPIC_GOALS:Record<string,string>={
+ 'fabric.foundations':'Explain what each storage and query surface is responsible for before selecting an architecture.',
+ 'fabric.ingestion':'Choose reference, replication or retained movement from the actual freshness, access and ownership constraints.',
+ 'fabric.transform':'Reason about transformations and committed table state without confusing files with a table.',
+ 'fabric.query':'Choose and explain a query surface, its supported operations and its boundaries.',
+ 'fabric.model':'Connect grain, relationships, calculations and storage mode to the analytical question.',
+ 'fabric.security':'Trace who can access which object through which permission boundary.',
+ 'fabric.delivery':'Separate development, deployment and operational monitoring responsibilities.',
+ 'fabric.streaming':'Choose and inspect an event-processing path using the documented source conditions.',
+ 'statistics.foundations':'Identify the population, sample, variable and observation grain in a claim.',
+ 'statistics.describe':'Explain what a summary reveals and what it hides about a distribution.',
+ 'statistics.probability':'Express uncertainty and conditional information before calculating a result.',
+ 'statistics.distributions':'Choose and inspect a distribution model and its assumptions.',
+ 'statistics.sampling':'Distinguish variation in observations from uncertainty in an estimate.',
+ 'statistics.hypothesis':'State the hypotheses, test conditions and limits of the conclusion.',
+ 'statistics.experiments':'Distinguish experimental evidence from an observational association.',
+ 'statistics.relationships':'Describe a relationship and explain the limits of prediction.',
+ 'statistics.synthesis':'Choose a method from the question and evidence rather than from a familiar formula.',
+ 'visualization.foundations':'Define the decision, variable types and observation grain before selecting an encoding.',
+ 'visualization.comparison':'Choose an encoding that supports accurate comparison and ranking.',
+ 'visualization.distribution':'Read shape, spread and unusual observations without hiding the underlying variation.',
+ 'visualization.relationships':'Investigate association while separating visual pattern from causal explanation.',
+ 'visualization.time':'Explain change over time with an explicit interval and comparison baseline.',
+ 'visualization.composition':'Organize a visual explanation around its audience and decision.',
+ 'visualization.accessibility':'Check whether the visual remains honest and usable with different access needs.',
+ 'power-bi.prepare':'Choose a preparation step that matches the data and ownership requirements.',
+ 'power-bi.model':'Explain model grain, relationships and calculations in their reporting context.',
+ 'power-bi.report':'Choose report interactions and visuals that support the intended decision.',
+ 'power-bi.govern':'Explain delivery, access and lifecycle constraints in a Power BI scenario.',
+};
